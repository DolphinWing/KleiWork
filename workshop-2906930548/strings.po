msgid "<link=\"EXTERIORWALL\">Tower Kelp Base</link>"
msgstr "<link=\"EXTERIORWALL\">塔藻林根</link>"

#. STRINGS.BLUEPRINTS.PERMIT_WALLS_AQUA_KELP_TOP.DESC
msgctxt "STRINGS.BLUEPRINTS.PERMIT_WALLS_AQUA_KELP_TOP.DESC"
msgid "An aquatic wallpaper featuring just the very top of a lush kelp forest."
msgstr "一款水生風格的牆紙，特寫了茂密海帶林的最頂端。"

#. STRINGS.BLUEPRINTS.PERMIT_WALLS_AQUA_KELP_TOP.NAME
msgctxt "STRINGS.BLUEPRINTS.PERMIT_WALLS_AQUA_KELP_TOP.NAME"
msgid "<link=\"EXTERIORWALL\">Tower Kelp Canopy</link>"
msgstr "<link=\"EXTERIORWALL\">塔藻林冠</link>"

#. STRINGS.BLUEPRINTS.PERMIT_WALLS_AQUA_PACU.DESC
