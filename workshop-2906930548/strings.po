#. STRINGS.BLUEPRINTS.PERMIT_JET_HELMET_00_ULTRA_OBELUS.DESC
msgctxt "STRINGS.BLUEPRINTS.PERMIT_JET_HELMET_00_ULTRA_OBELUS.DESC"
