msgstr "洗盆打底衣"

#. STRINGS.BLUEPRINTS.PERMIT_TOP_GOTCH_CANKER_SATSUMA.DESC
msgctxt "STRINGS.BLUEPRINTS.PERMIT_TOP_GOTCH_CANKER_SATSUMA.DESC"
