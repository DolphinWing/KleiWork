#. STRINGS.CREATURES.SPECIES.LIGHTBUG.VARIANT_RADIOACTIVE.NAME
msgctxt "STRINGS.CREATURES.SPECIES.LIGHTBUG.VARIANT_RADIOACTIVE.NAME"
msgid "<link=\"LIGHTBUGRADIOACTIVE\">Ionizing Bug</link>"
msgstr "<link=\"LIGHTBUGRADIOACTIVE\">電離發光蟲</link>"

#. STRINGS.CREATURES.SPECIES.METHANEGEYSER.DESC
msgctxt "STRINGS.CREATURES.SPECIES.METHANEGEYSER.DESC"
msgid "A highly pressurized geyser that periodically erupts with <link=\"METHANE\">Natural Gas</link>."
msgstr "定期噴發<link=\"METHANE\">天然氣</link>的高壓間歇泉。"

#. STRINGS.CREATURES.SPECIES.METHANEGEYSER.NAME
msgctxt "STRINGS.CREATURES.SPECIES.METHANEGEYSER.NAME"
msgid "<link=\"GEYSERGENERICMETHANE\">Natural Gas Geyser</link>"
msgstr "<link=\"GEYSERGENERICMETHANE\">天然氣噴泉</link>"

#. STRINGS.CREATURES.SPECIES.MOLE.BABY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.MOLE.BABY.DESC"
msgid "A snuggly little pup.\n\nOne day it will grow into an adult <link=\"MOLE\">Shove Vole</link>."
msgstr "一隻依偎的鑽地田鼠寶寶。\n\n隨著時間經過牠會成長為成年的<link=\"MOLE\">鑽地田鼠</link>。"

#. STRINGS.CREATURES.SPECIES.MOLE.BABY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.MOLE.BABY.NAME"
msgid "<link=\"MOLE\">Vole Pup</link>"
msgstr "<link=\"MOLE\">鑽地田鼠寶寶</link>"

#. STRINGS.CREATURES.SPECIES.MOLE.DESC
msgctxt "STRINGS.CREATURES.SPECIES.MOLE.DESC"
msgid "Shove Voles are burrowing critters that eat the <link=\"REGOLITH\">Regolith</link> collected on terrestrial surfaces.\n\nThey cannot burrow through <link=\"REFINEDMETAL\">Refined Metals</link>."
msgstr "鑽地田鼠是喜愛挖掘的動物，會收集並食用地表中的<link=\"REGOLITH\">表土</link>。\n\n牠們無法穿過<link=\"REFINEDMETAL\">精煉金屬</link>。"

#. STRINGS.CREATURES.SPECIES.MOLE.EGG_NAME
msgctxt "STRINGS.CREATURES.SPECIES.MOLE.EGG_NAME"
msgid "<link=\"MOLE\">Shove Vole Egg</link>"
msgstr "<link=\"MOLE\">鑽地田鼠蛋</link>"

#. STRINGS.CREATURES.SPECIES.MOLE.NAME
msgctxt "STRINGS.CREATURES.SPECIES.MOLE.NAME"
msgid "<link=\"MOLE\">Shove Vole</link>"
msgstr "<link=\"MOLE\">鑽地田鼠</link>"

#. STRINGS.CREATURES.SPECIES.MOLE.VARIANT_DELICACY.BABY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.MOLE.VARIANT_DELICACY.BABY.DESC"
msgid "A tender little Delecta Vole pup.\n\nOne day it will grow into an adult Shove Vole morph, the <link=\"MOLEDELICACY\">Delecta Vole</link>."
msgstr "一隻細嫩的辛香田鼠寶寶。\n\n隨著時間經過牠會成長為一隻成年的<link=\"MOLEDELICACY\">辛香田鼠</link>。"

#. STRINGS.CREATURES.SPECIES.MOLE.VARIANT_DELICACY.BABY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.MOLE.VARIANT_DELICACY.BABY.NAME"
msgid "<link=\"MOLEDELICACY\">Delecta Vole Pup</link>"
msgstr "<link=\"MOLEDELICACY\">辛香田鼠寶寶</link>"

#. STRINGS.CREATURES.SPECIES.MOLE.VARIANT_DELICACY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.MOLE.VARIANT_DELICACY.DESC"
msgid "Delecta Voles are burrowing critters whose bodies sprout shearable <link=\"GINGERCONFIG\">Tonic Root</link> when <link=\"REGOLITH\">Regolith</link> is ingested at preferred temperatures.\n\nThey cannot burrow through <link=\"REFINEDMETAL\">Refined Metals</link>."
msgstr "辛香田鼠是穴居小動物，當在適合溫度下攝取<link=\"REGOLITH\">表土</link>時，牠們的身體會長出可修剪的<link=\"GINGERCONFIG\">辛香根</link>。\n\n牠們無法穿過<link=\"REFINEDMETAL\">精煉金屬</link>。"

#. STRINGS.CREATURES.SPECIES.MOLE.VARIANT_DELICACY.EGG_NAME
msgctxt "STRINGS.CREATURES.SPECIES.MOLE.VARIANT_DELICACY.EGG_NAME"
msgid "<link=\"MOLEDELICACY\">Delecta Vole Egg</link>"
msgstr "<link=\"MOLEDELICACY\">辛香田鼠蛋</link>"

#. STRINGS.CREATURES.SPECIES.MOLE.VARIANT_DELICACY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.MOLE.VARIANT_DELICACY.NAME"
msgid "<link=\"MOLEDELICACY\">Delecta Vole</link>"
msgstr "<link=\"MOLEDELICACY\">辛香田鼠</link>"

#. STRINGS.CREATURES.SPECIES.MOO.DESC
msgctxt "STRINGS.CREATURES.SPECIES.MOO.DESC"
msgid "Moos are extraterrestrial critters that feed on <link=\"GASGRASS\">Gas Grass</link> and excrete <link=\"METHANE\">Natural Gas</link>.\n\nWhen domesticated and fed, they can be milked for <link=\"MILK\">Brackene</link>."
msgstr "瓦斯牛是一種以<link=\"GASGRASS\">瓦斯草</link>為食物的外星小動物，會排出<link=\"METHANE\">天然氣</link>。當馴化且吃飽，可以擠出<link=\"MILK\">鹹乳</link>。"

#. STRINGS.CREATURES.SPECIES.MOO.NAME
msgctxt "STRINGS.CREATURES.SPECIES.MOO.NAME"
msgid "<link=\"MOO\">Gassy Moo</link>"
msgstr "<link=\"MOO\">瓦斯牛</link>"

#. STRINGS.CREATURES.SPECIES.MOSQUITO.BABY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.MOSQUITO.BABY.DESC"
msgid "A wiggly little Gnit Larva.\n\nIn time, it will mature into an irritating <link=\"MOSQUITO\">Gnit</link>."
msgstr "一隻蠕動的匿蚊幼蟲。\n\n隨著時間經過，牠會成長為一隻令人討厭的<link=\"MOSQUITO\">匿蚊</link>。"

#. STRINGS.CREATURES.SPECIES.MOSQUITO.BABY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.MOSQUITO.BABY.NAME"
msgid "<link=\"MOSQUITO\">Gnit Larva</link>"
msgstr "<link=\"MOSQUITO\">匿蚊幼蟲</link>"

#. STRINGS.CREATURES.SPECIES.MOSQUITO.DESC
msgctxt "STRINGS.CREATURES.SPECIES.MOSQUITO.DESC"
msgid "Gnits are hostile airborne critters primarily bred as food for the carnivorous <link=\"FLYTRAPPLANT\">Lura Plants</link> to produce <link=\"AMBER\">Amber</link>.\n\nTheir offspring must be exposed to <link=\"ELEMENTSLIQUID\">Liquid</link> in order to survive."
msgstr "匿蚊是一種敵對的空中小動物，主要被飼養作為肉食性<link=\"FLYTRAPPLANT\">誘捕花</link>的食物，以生產<link=\"AMBER\">琥珀</link>。\n\n匿蚊的後代必須接觸<link=\"ELEMENTSLIQUID\">液體</link>才能存活。"

#. STRINGS.CREATURES.SPECIES.MOSQUITO.EGG_NAME
msgctxt "STRINGS.CREATURES.SPECIES.MOSQUITO.EGG_NAME"
msgid "<link=\"MOSQUITO\">Gnit Egg</link>"
msgstr "<link=\"MOSQUITO\">匿蚊卵</link>"

#. STRINGS.CREATURES.SPECIES.MOSQUITO.NAME
msgctxt "STRINGS.CREATURES.SPECIES.MOSQUITO.NAME"
msgid "<link=\"MOSQUITO\">Gnit</link>"
msgstr "<link=\"MOSQUITO\">匿蚊</link>"

#. STRINGS.CREATURES.SPECIES.MUSHROOMPLANT.DESC
msgctxt "STRINGS.CREATURES.SPECIES.MUSHROOMPLANT.DESC"
msgid "Dusk Caps produce <link=\"MUSHROOM\">Mushrooms</link>, fungal growths that can be harvested for <link=\"FOOD\">Food</link>."
msgstr "黃昏蘑菇生產<link=\"MUSHROOM\">蘑菇</link>，採收的菌絲體能作為<link=\"FOOD\">食物</link>。"

#. STRINGS.CREATURES.SPECIES.MUSHROOMPLANT.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.MUSHROOMPLANT.DOMESTICATEDDESC"
msgid "This plant produces edible <link=\"MUSHROOM\">Mushrooms</link>."
msgstr "這株植物生產可食用的<link=\"MUSHROOM\">蘑菇</link>。"

#. STRINGS.CREATURES.SPECIES.MUSHROOMPLANT.NAME
msgctxt "STRINGS.CREATURES.SPECIES.MUSHROOMPLANT.NAME"
msgid "<link=\"MUSHROOMPLANT\">Dusk Cap</link>"
msgstr "<link=\"MUSHROOMPLANT\">黃昏蘑菇</link>"

#. STRINGS.CREATURES.SPECIES.MUSSELSPROUT.DESC
msgctxt "STRINGS.CREATURES.SPECIES.MUSSELSPROUT.DESC"
msgid "Mussel Sprouts are incapable of propagating but can be harvested for a single low quality <link=\"FOOD\">Food</link> serving."
msgstr "貽貝芽無法繁育，但可以收穫作為一次性的低品質<link=\"FOOD\">食物</link>。"

#. STRINGS.CREATURES.SPECIES.MUSSELSPROUT.NAME
msgctxt "STRINGS.CREATURES.SPECIES.MUSSELSPROUT.NAME"
msgid "<link=\"MUSSELSPROUT\">Mussel Sprout</link>"
msgstr "<link=\"MUSSELSPROUT\">貽貝芽</link>"

#. STRINGS.CREATURES.SPECIES.MYSTERYEGG.DESC
msgctxt "STRINGS.CREATURES.SPECIES.MYSTERYEGG.DESC"
msgid "What's growing inside? Something nice? Something mean?"
msgstr "是誰住在裡面？友善的？兇猛的？"

#. STRINGS.CREATURES.SPECIES.MYSTERYEGG.NAME
msgctxt "STRINGS.CREATURES.SPECIES.MYSTERYEGG.NAME"
msgid "<link=\"MYSTERYEGG\">Mysterious Egg</link>"
msgstr "<link=\"MYSTERYEGG\">神祕的蛋</link>"

#. STRINGS.CREATURES.SPECIES.OIL_WELL.DESC
msgctxt "STRINGS.CREATURES.SPECIES.OIL_WELL.DESC"
msgid "Oil Reservoirs are rock formations with <link=\"CRUDEOIL\">Crude Oil</link> deposits beneath their surface.\n\nOil can be extracted from a reservoir with sufficient pressure."
msgstr "油田是下方蘊藏<link=\"CRUDEOIL\">原油</link>岩層。\n\n藉由適當壓力可以從油田提取原油。"

#. STRINGS.CREATURES.SPECIES.OIL_WELL.NAME
msgctxt "STRINGS.CREATURES.SPECIES.OIL_WELL.NAME"
msgid "<link=\"OILWELL\">Oil Reservoir</link>"
msgstr "<link=\"OIL_WELL\">油田</link>"

#. STRINGS.CREATURES.SPECIES.OILFLOATER.BABY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.OILFLOATER.BABY.DESC"
msgid "A goopy little Slickster Larva.\n\nOne day it will grow into an adult <link=\"OILFLOATER\">Slickster</link>."
msgstr "一隻黏糊糊的小油怪寶寶。\n\n有一天牠會成長為一隻成年的<link=\"OILFLOATER\">小油怪</link>。"

#. STRINGS.CREATURES.SPECIES.OILFLOATER.BABY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.OILFLOATER.BABY.NAME"
msgid "<link=\"OILFLOATER\">Slickster Larva</link>"
msgstr "<link=\"OILFLOATER\">小油怪寶寶</link>"

#. STRINGS.CREATURES.SPECIES.OILFLOATER.DESC
msgctxt "STRINGS.CREATURES.SPECIES.OILFLOATER.DESC"
msgid "Slicksters are slimy critters that consume <link=\"CARBONDIOXIDE\">Carbon Dioxide</link> and exude <link=\"CRUDEOIL\">Crude Oil</link>."
msgstr "小油怪是吸收<link=\"CARBONDIOXIDE\">二氧化碳</link>的史萊姆生物，會分泌<link=\"CRUDEOIL\">原油</link>。"

#. STRINGS.CREATURES.SPECIES.OILFLOATER.EGG_NAME
msgctxt "STRINGS.CREATURES.SPECIES.OILFLOATER.EGG_NAME"
msgid "<link=\"OILFLOATER\">Slickster Egg</link>"
msgstr "<link=\"OILFLOATER\">小油怪蛋</link>"

#. STRINGS.CREATURES.SPECIES.OILFLOATER.NAME
msgctxt "STRINGS.CREATURES.SPECIES.OILFLOATER.NAME"
msgid "<link=\"OILFLOATER\">Slickster</link>"
msgstr "<link=\"OILFLOATER\">小油怪</link>"

#. STRINGS.CREATURES.SPECIES.OILFLOATER.VARIANT_DECOR.BABY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.OILFLOATER.VARIANT_DECOR.BABY.DESC"
msgid "A snuggly little Longhair Larva.\n\nOne day it will grow into an adult Slickster morph, the <link=\"OILFLOATERDECOR\">Longhair Slickster</link>."
msgstr "一隻依偎的長髮小油怪寶寶。\n\n有一天牠會成長為一隻成年的<link=\"OILFLOATERDECOR\">長髮小油怪</link>。"

#. STRINGS.CREATURES.SPECIES.OILFLOATER.VARIANT_DECOR.BABY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.OILFLOATER.VARIANT_DECOR.BABY.NAME"
msgid "<link=\"OILFLOATERDECOR\">Longhair Larva</link>"
msgstr "<link=\"OILFLOATERDECOR\">長髮小油怪寶寶</link>"

#. STRINGS.CREATURES.SPECIES.OILFLOATER.VARIANT_DECOR.DESC
msgctxt "STRINGS.CREATURES.SPECIES.OILFLOATER.VARIANT_DECOR.DESC"
msgid "Longhair Slicksters are friendly critters that consume <link=\"OXYGEN\">Oxygen</link> and thrive in close contact with Duplicant companions.\n\nLonghairs have extremely beautiful and luxurious coats."
msgstr "長髮小油怪是友善的動物，牠會消耗<link=\"OXYGEN\">氧氣</link>，並在與複製人親密接觸後會快速發展。\n\n長髮小油怪擁有極美麗和奢華的外表。"

#. STRINGS.CREATURES.SPECIES.OILFLOATER.VARIANT_DECOR.EGG_NAME
msgctxt "STRINGS.CREATURES.SPECIES.OILFLOATER.VARIANT_DECOR.EGG_NAME"
msgid "<link=\"OILFLOATERDECOR\">Longhair Slickster Egg</link>"
msgstr "<link=\"OILFLOATERDECOR\">長髮小油怪蛋</link>"

#. STRINGS.CREATURES.SPECIES.OILFLOATER.VARIANT_DECOR.NAME
msgctxt "STRINGS.CREATURES.SPECIES.OILFLOATER.VARIANT_DECOR.NAME"
msgid "<link=\"OILFLOATERDECOR\">Longhair Slickster</link>"
msgstr "<link=\"OILFLOATERDECOR\">長髮小油怪</link>"

#. STRINGS.CREATURES.SPECIES.OILFLOATER.VARIANT_HIGHTEMP.BABY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.OILFLOATER.VARIANT_HIGHTEMP.BABY.DESC"
msgid "A goopy little Molten Larva.\n\nOne day it will grow into an adult Slickster morph, the <link=\"OILFLOATERHIGHTEMP\">Molten Slickster</link>."
msgstr "一隻黏糊糊的熔岩小油怪寶寶。\n\n有一天牠會成長為一隻成年的<link=\"OILFLOATERHIGHTEMP\">熔岩小油怪</link>。"

#. STRINGS.CREATURES.SPECIES.OILFLOATER.VARIANT_HIGHTEMP.BABY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.OILFLOATER.VARIANT_HIGHTEMP.BABY.NAME"
msgid "<link=\"OILFLOATERHIGHTEMP\">Molten Larva</link>"
msgstr "<link=\"OILFLOATERHIGHTEMP\">熔岩小油怪寶寶</link>"

#. STRINGS.CREATURES.SPECIES.OILFLOATER.VARIANT_HIGHTEMP.DESC
msgctxt "STRINGS.CREATURES.SPECIES.OILFLOATER.VARIANT_HIGHTEMP.DESC"
msgid "Molten Slicksters are slimy critters that consume <link=\"CARBONDIOXIDE\">Carbon Dioxide</link> and exude <link=\"PETROLEUM\">Petroleum</link>."
msgstr "熔岩小油怪是吸收<link=\"CARBONDIOXIDE\">二氧化碳</link>的史萊姆生物，會分泌<link=\"PETROLEUM\">石油</link>。"

#. STRINGS.CREATURES.SPECIES.OILFLOATER.VARIANT_HIGHTEMP.EGG_NAME
msgctxt "STRINGS.CREATURES.SPECIES.OILFLOATER.VARIANT_HIGHTEMP.EGG_NAME"
msgid "<link=\"OILFLOATERHIGHTEMP\">Molten Slickster Egg</link>"
msgstr "<link=\"OILFLOATERHIGHTEMP\">熔岩小油怪蛋</link>"

#. STRINGS.CREATURES.SPECIES.OILFLOATER.VARIANT_HIGHTEMP.NAME
msgctxt "STRINGS.CREATURES.SPECIES.OILFLOATER.VARIANT_HIGHTEMP.NAME"
msgid "<link=\"OILFLOATERHIGHTEMP\">Molten Slickster</link>"
msgstr "<link=\"OILFLOATERHIGHTEMP\">熔岩小油怪</link>"

#. STRINGS.CREATURES.SPECIES.OILSPOUT.DESC
msgctxt "STRINGS.CREATURES.SPECIES.OILSPOUT.DESC"
msgid "A rocky vent that spouts <link=\"CRUDEOIL\">Crude Oil</link>."
msgstr "噴出<link=\"CRUDEOIL\">原油</link>的岩石噴口。"

#. STRINGS.CREATURES.SPECIES.OILSPOUT.NAME
msgctxt "STRINGS.CREATURES.SPECIES.OILSPOUT.NAME"
msgid "<link=\"OILSPOUT\">Oil Spout</link>"
msgstr "<link=\"OILSPOUT\">原油噴口</link>"

#. STRINGS.CREATURES.SPECIES.OXYCORAL.DESC
msgctxt "STRINGS.CREATURES.SPECIES.OXYCORAL.DESC"
msgid "Flue Corals are aquatic organisms that use <link=\"LIGHT\">Light</link> to produce <link=\"OXYGEN\">Oxygen</link>.\n\nDue to their size, they can only be planted in a <link=\"WIDEFARMTILE\">Wide Hydroponic Farm</link>."
msgstr "煙囪珊瑚是一種會利用<link=\"LIGHT\">光</link>來產生<link=\"OXYGEN\">氧氣</link>的水生生物。\n\n由於牠們的體型，只能種植在<link=\"WIDEFARMTILE\">寬水耕磚</link>中。"

#. STRINGS.CREATURES.SPECIES.OXYCORAL.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.OXYCORAL.DOMESTICATEDDESC"
msgid "This plant produces <link=\"OXYGEN\">Oxygen</link>."
msgstr "這種植物可產出<link=\"OXYGEN\">氧氣</link>。"

#. STRINGS.CREATURES.SPECIES.OXYCORAL.NAME
msgctxt "STRINGS.CREATURES.SPECIES.OXYCORAL.NAME"
msgid "<link=\"OXYCORAL\">Flue Coral</link>"
msgstr "<link=\"OXYCORAL\">煙囪珊瑚</link>"

#. STRINGS.CREATURES.SPECIES.OXYFERN.DESC
msgctxt "STRINGS.CREATURES.SPECIES.OXYFERN.DESC"
msgid "Oxyferns absorb <link=\"CARBONDIOXIDE\">Carbon Dioxide Gas</link> and exude breathable <link=\"OXYGEN\">Oxygen</link>."
msgstr "氧氣蕨吸收<link=\"CARBONDIOXIDE\">二氧化碳</link>並排放可呼吸的<link=\"OXYGEN\">氧氣</link>。"

#. STRINGS.CREATURES.SPECIES.OXYFERN.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.OXYFERN.DOMESTICATEDDESC"
msgid "This plant converts <link=\"CARBONDIOXIDE\">Carbon Dioxide</link> into <link=\"OXYGEN\">Oxygen</link>."
msgstr "這株植物轉換<link=\"CARBONDIOXIDE\">CO<sub>2</sub></link> 成為<link=\"OXYGEN\">氧氣</link>。"

#. STRINGS.CREATURES.SPECIES.OXYFERN.NAME
msgctxt "STRINGS.CREATURES.SPECIES.OXYFERN.NAME"
msgid "<link=\"OXYFERN\">Oxyfern</link>"
msgstr "<link=\"OXYFERN\">氧氣蕨</link>"

#. STRINGS.CREATURES.SPECIES.PACU.BABY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.PACU.BABY.DESC"
msgid "A wriggly little Pacu Fry.\n\nIn time, it will mature into an adult <link=\"PACU\">Pacu</link>."
msgstr "一隻無辜的小帕庫苗。\n\n隨著時間經過，牠會成長為一隻成年的<link=\"PACU\">帕庫</link>。"

#. STRINGS.CREATURES.SPECIES.PACU.BABY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.PACU.BABY.NAME"
msgid "<link=\"PACU\">Pacu Fry</link>"
msgstr "<link=\"PACU\">帕庫苗</link>"

#. STRINGS.CREATURES.SPECIES.PACU.DESC
msgctxt "STRINGS.CREATURES.SPECIES.PACU.DESC"
msgid "Pacus are aquatic creatures that can live in any liquid, such as <link=\"WATER\">Water</link> or <link=\"DIRTYWATER\">Polluted Water</link>.\n\nEvery organism in the known universe finds the Pacu extremely delicious."
msgstr "帕庫是水生生物，牠們可以生活在任何液體中，例如<link=\"WATER\">水</link>或<link=\"DIRTYWATER\">汙水</link>。\n\n已知宇宙中的每一個生物體都覺得帕庫極其美味。"

#. STRINGS.CREATURES.SPECIES.PACU.EGG_NAME
msgctxt "STRINGS.CREATURES.SPECIES.PACU.EGG_NAME"
msgid "<link=\"PACU\">Pacu Egg</link>"
msgstr "<link=\"PACU\">帕庫卵</link>"

#. STRINGS.CREATURES.SPECIES.PACU.NAME
msgctxt "STRINGS.CREATURES.SPECIES.PACU.NAME"
msgid "<link=\"PACU\">Pacu</link>"
msgstr "<link=\"PACU\">帕庫</link>"

#. STRINGS.CREATURES.SPECIES.PACU.VARIANT_CLEANER.BABY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.PACU.VARIANT_CLEANER.BABY.DESC"
msgid "A wriggly little Gulp Fry.\n\nIn time, it will mature into an adult <link=\"PACUCLEANER\">Gulp Fish</link>."
msgstr "一隻無辜的寒帶帕庫苗。\n\n隨著時間經過，牠會成長為一隻成年的<link=\"PACUCLEANER\">寒帶帕庫</link>。"

#. STRINGS.CREATURES.SPECIES.PACU.VARIANT_CLEANER.BABY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.PACU.VARIANT_CLEANER.BABY.NAME"
msgid "<link=\"PACUCLEANER\">Gulp Fry</link>"
msgstr "<link=\"PACUCLEANER\">寒帶帕庫苗</link>"

#. STRINGS.CREATURES.SPECIES.PACU.VARIANT_CLEANER.DESC
msgctxt "STRINGS.CREATURES.SPECIES.PACU.VARIANT_CLEANER.DESC"
msgid "Gulp Fishes are aquatic critters who inhabit cold liquid pools.\n\nTheir gills filter <link=\"DIRTYWATER\">Polluted Water</link> into <link=\"WATER\">Water</link>."
msgstr "寒帶帕庫是水生生物，牠們棲息在寒冷的液體水池中。\n\n牠們的魚鰓能將<link=\"DIRTYWATER\">汙水</link>過濾成<link=\"WATER\">水</link>。"

#. STRINGS.CREATURES.SPECIES.PACU.VARIANT_CLEANER.EGG_NAME
msgctxt "STRINGS.CREATURES.SPECIES.PACU.VARIANT_CLEANER.EGG_NAME"
msgid "<link=\"PACUCLEANER\">Gulp Fish Egg</link>"
msgstr "<link=\"PACUCLEANER\">寒帶帕庫卵</link>"

#. STRINGS.CREATURES.SPECIES.PACU.VARIANT_CLEANER.NAME
msgctxt "STRINGS.CREATURES.SPECIES.PACU.VARIANT_CLEANER.NAME"
msgid "<link=\"PACUCLEANER\">Gulp Fish</link>"
msgstr "<link=\"PACUCLEANER\">寒帶帕庫</link>"

#. STRINGS.CREATURES.SPECIES.PACU.VARIANT_TROPICAL.BABY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.PACU.VARIANT_TROPICAL.BABY.DESC"
msgid "A wriggly little Tropical Fry.\n\nIn time it will mature into an adult Pacu morph, the <link=\"PACUTROPICAL\">Tropical Pacu</link>."
msgstr "一隻無辜的熱帶帕庫苗。\n\n隨著時間經過，牠會成長為一隻成年的<link=\"PACUTROPICAL\">熱帶帕庫</link>。"

#. STRINGS.CREATURES.SPECIES.PACU.VARIANT_TROPICAL.BABY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.PACU.VARIANT_TROPICAL.BABY.NAME"
msgid "<link=\"PACUTROPICAL\">Tropical Fry</link>"
msgstr "<link=\"PACUTROPICAL\">熱帶帕庫苗</link>"

#. STRINGS.CREATURES.SPECIES.PACU.VARIANT_TROPICAL.DESC
msgctxt "STRINGS.CREATURES.SPECIES.PACU.VARIANT_TROPICAL.DESC"
msgid "Tropical Pacus are aquatic critters who inhabit warm liquid pools.\n\nTheir vibrant colors provide a significant <link=\"DECOR\">Decor</link> boost to their environment."
msgstr "熱帶帕庫是水生生物，牠們棲息在溫暖的液體水池中。\n\n牠們鮮豔的色彩為牠們的環境提供了顯著的<link=\"DECOR\">裝飾度</link>提升。"

#. STRINGS.CREATURES.SPECIES.PACU.VARIANT_TROPICAL.EGG_NAME
msgctxt "STRINGS.CREATURES.SPECIES.PACU.VARIANT_TROPICAL.EGG_NAME"
msgid "<link=\"PACUTROPICAL\">Tropical Pacu Egg</link>"
msgstr "<link=\"PACUTROPICAL\">熱帶帕庫卵</link>"

#. STRINGS.CREATURES.SPECIES.PACU.VARIANT_TROPICAL.NAME
msgctxt "STRINGS.CREATURES.SPECIES.PACU.VARIANT_TROPICAL.NAME"
msgid "<link=\"PACUTROPICAL\">Tropical Pacu</link>"
msgstr "<link=\"TROPICALPACU\">熱帶帕庫</link>"

#. STRINGS.CREATURES.SPECIES.PACUEGG.DESC
msgctxt "STRINGS.CREATURES.SPECIES.PACUEGG.DESC"
msgid "A tiny Pacu is nestled inside.\n\nIt is not yet ready for the world."
msgstr "一隻小小的帕庫在裡面。\n\n牠還沒準備好迎接這個世界。"

#. STRINGS.CREATURES.SPECIES.PACUEGG.NAME
msgctxt "STRINGS.CREATURES.SPECIES.PACUEGG.NAME"
msgid "<link=\"PACUEGG\">Pacu Egg</link>"
msgstr "<link=\"PACUEGG\">帕庫蛋</link>"

#. STRINGS.CREATURES.SPECIES.PARROTFISH.BABY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.PARROTFISH.BABY.DESC"
msgid "A wriggly little Beakon Fry.\n\nIn time, it will mature into an adult <link=\"PARROTFISH\">Beakon</link>."
msgstr "一條扭動著的小燈喙魚苗。\n\n隨著時間經過，牠會成長為一隻成年的<link=\"PARROTFISH\">燈喙魚</link>。"

#. STRINGS.CREATURES.SPECIES.PARROTFISH.BABY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.PARROTFISH.BABY.NAME"
msgid "<link=\"PARROTFISH\">Beakon Fry</link>"
msgstr "<link=\"PARROTFISH\">燈喙魚苗</link>"

#. STRINGS.CREATURES.SPECIES.PARROTFISH.DESC
msgctxt "STRINGS.CREATURES.SPECIES.PARROTFISH.DESC"
msgid "Beakons are aquatic critters who feast on <link=\"PHOSPHORITE\">Phosphorite</link> and <link=\"PLANKTONCORAL\">Starnacle</link>, and excrete <link=\"LIME\">Lime</link>.\n\nThey produce <link=\"LIGHT\">Light</link> when <link=\"CREATURES::GUIDE::MOOD\">Happy</link>, and enjoy consuming <link=\"OXYGEN\">Oxygen</link>."
msgstr "燈喙魚是水生生物，以<link=\"PHOSPHORITE\">磷礦</link>和<link=\"PLANKTONCORAL\">藤壺星</link>為食，並會排出<link=\"LIME\">石灰</link>。\n\n牠們在<link=\"CREATURES::GUIDE::MOOD\">快樂</link>時會產生<link=\"LIGHT\">光線</link>，且喜歡消耗<link=\"OXYGEN\">氧氣</link>。"

#. STRINGS.CREATURES.SPECIES.PARROTFISH.EGG_NAME
msgctxt "STRINGS.CREATURES.SPECIES.PARROTFISH.EGG_NAME"
msgid "<link=\"PARROTFISH\">Beakon Egg</link>"
msgstr "<link=\"PARROTFISH\">燈喙魚卵</link>"

#. STRINGS.CREATURES.SPECIES.PARROTFISH.NAME
msgctxt "STRINGS.CREATURES.SPECIES.PARROTFISH.NAME"
msgid "<link=\"PARROTFISH\">Beakon</link>"
msgstr "<link=\"PARROTFISH\">燈喙魚</link>"

#. STRINGS.CREATURES.SPECIES.PINKROCK.CODEX
msgctxt "STRINGS.CREATURES.SPECIES.PINKROCK.CODEX"
msgid "Lumen quartz is a naturally occurring object found in the <link=\"BIOMECARROTQUARRY\">Cool Pool</link> biome."
msgstr "輝亮石英是一種天然存在的物件，可在<link=\"BIOMECARROTQUARRY\">冷池</link>生態中找到。"

#. STRINGS.CREATURES.SPECIES.PINKROCK.DESC
msgctxt "STRINGS.CREATURES.SPECIES.PINKROCK.DESC"
msgid "Lumen quartz emits a soft glowing <link=\"LIGHT\">Light</link> that makes everything look and feel a little rosier.\n\nIt's even brighter and more beautiful once it's been carved."
msgstr "輝亮石英會發出柔和的<link=\"LIGHT\">光</link>，使一切看起來和感覺都變得更加玫瑰色。\n\n經過雕刻後，它更加明亮、更加美麗。"

#. STRINGS.CREATURES.SPECIES.PINKROCK.EFFECT
msgctxt "STRINGS.CREATURES.SPECIES.PINKROCK.EFFECT"
msgid ""
msgstr ""

#. STRINGS.CREATURES.SPECIES.PINKROCK.NAME
msgctxt "STRINGS.CREATURES.SPECIES.PINKROCK.NAME"
msgid "<link=\"PINKROCK\">Lumen Quartz</link>"
msgstr "<link=\"PINKROCK\">輝亮石英</link>"

#. STRINGS.CREATURES.SPECIES.PINKROCKCARVED.DESC
msgctxt "STRINGS.CREATURES.SPECIES.PINKROCKCARVED.DESC"
msgid "A Duplicant has carved this Lumen quartz in a way that really maximizes its <link=\"DECOR\">Decor</link> value and <link=\"LIGHT\">brightness</link>."
msgstr "複製人以真正最大化其<link=\"DECOR\">裝飾</link>價值和<link=\"LIGHT\">亮度</link>的方式雕刻了這顆輝亮石英。"

#. STRINGS.CREATURES.SPECIES.PINKROCKCARVED.EFFECT
msgctxt "STRINGS.CREATURES.SPECIES.PINKROCKCARVED.EFFECT"
msgid ""
msgstr ""

#. STRINGS.CREATURES.SPECIES.PINKROCKCARVED.NAME
msgctxt "STRINGS.CREATURES.SPECIES.PINKROCKCARVED.NAME"
msgid "<link=\"PINKROCK\">Carved Lumen Quartz</link>"
msgstr "<link=\"PINKROCK\">精雕輝石</link>"

#. STRINGS.CREATURES.SPECIES.PLANKTONCORAL.DESC
msgctxt "STRINGS.CREATURES.SPECIES.PLANKTONCORAL.DESC"
msgid "Starnacles are aquatic organisms that consume <link=\"COQUINA\">Coquina</link>.\n\n Its <link=\"PHOSPHORITE\">Phosphorite</link> build-up can be consumed by <link=\"PARROTFISH\">Beakons</link> or harvested by Duplicants."
msgstr "藤壺星是一種以<link=\"COQUINA\">殼灰岩</link>為食的水生生物。\n\n其生成的<link=\"PHOSPHORITE\">磷礦</link>可供<link=\"PARROTFISH\">燈喙魚</link>食用，或由複製人進行收穫。"

#. STRINGS.CREATURES.SPECIES.PLANKTONCORAL.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.PLANKTONCORAL.DOMESTICATEDDESC"
msgid "This coral produces <link=\"PHOSPHORITE\">Phosphorite</link>."
msgstr "這種珊瑚可產出<link=\"PHOSPHORITE\">磷礦</link>。"

#. STRINGS.CREATURES.SPECIES.PLANKTONCORAL.LIQUID_CONSUMPTION
msgctxt "STRINGS.CREATURES.SPECIES.PLANKTONCORAL.LIQUID_CONSUMPTION"
msgid "Filtering {ElementTypes}: {FlowRate}"
msgstr "過濾{ElementTypes}：{FlowRate}"

#. STRINGS.CREATURES.SPECIES.PLANKTONCORAL.NAME
msgctxt "STRINGS.CREATURES.SPECIES.PLANKTONCORAL.NAME"
msgid "<link=\"PLANKTONCORAL\">Starnacle</link>"
msgstr "<link=\"PLANKTONCORAL\">藤壺星</link>"

#. STRINGS.CREATURES.SPECIES.PREHISTORICPACU.BABY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.PREHISTORICPACU.BABY.DESC"
msgid "A grumpy little Jawbo fry.\n\nIn time, it will grow into a toothy <link=\"PREHISTORICPACU\">Jawbo</link>."
msgstr "一隻脾氣暴躁的顎魚苗。\n\n它會逐漸長大成熟，變成多齒的<link=\"PREHISTORICPACU\">顎魚</link>。"

#. STRINGS.CREATURES.SPECIES.PREHISTORICPACU.BABY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.PREHISTORICPACU.BABY.NAME"
msgid "<link=\"PREHISTORICPACU\">Jawbo Fry</link>"
msgstr "<link=\"PREHISTORICPACU\">顎魚苗</link>"

#. STRINGS.CREATURES.SPECIES.PREHISTORICPACU.DESC
msgctxt "STRINGS.CREATURES.SPECIES.PREHISTORICPACU.DESC"
msgid "Jawbos are carnivorous aquatic critters that feed on <link=\"PACU\">Pacus</link> and produce <link=\"RUST\">Rust</link>.\n\nThey pose no danger to Duplicants."
msgstr "顎魚是一種食肉水生小動物，以<link=\"PACU\">帕庫魚</link>為食並產出<link=\"RUST\">鐵鏽</link>。\n\n顎魚對複製人沒有危險。"

#. STRINGS.CREATURES.SPECIES.PREHISTORICPACU.EGG_NAME
msgctxt "STRINGS.CREATURES.SPECIES.PREHISTORICPACU.EGG_NAME"
msgid "<link=\"PREHISTORICPACU\">Jawbo Egg</link>"
msgstr "<link=\"PREHISTORICPACU\">顎魚卵</link>"

#. STRINGS.CREATURES.SPECIES.PREHISTORICPACU.NAME
msgctxt "STRINGS.CREATURES.SPECIES.PREHISTORICPACU.NAME"
msgid "<link=\"PREHISTORICPACU\">Jawbo</link>"
msgstr "<link=\"PREHISTORICPACU\">顎魚</link>"

#. STRINGS.CREATURES.SPECIES.PRICKLEFLOWER.DESC
msgctxt "STRINGS.CREATURES.SPECIES.PRICKLEFLOWER.DESC"
msgid "Bristle Blossoms produce <link=\"PRICKLEFRUIT\">Bristle Berry</link>, a prickly edible bud."
msgstr "鬃花生產可食用的<link=\"PRICKLEFRUIT\">鬃果</link>。"

#. STRINGS.CREATURES.SPECIES.PRICKLEFLOWER.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.PRICKLEFLOWER.DOMESTICATEDDESC"
msgid "This plant produces edible <link=\"PRICKLEFRUIT\">Bristle Berries</link>."
msgstr "這株植物生產可食用的<link=\"PRICKLEFRUIT\">鬃果</link>。"

#. STRINGS.CREATURES.SPECIES.PRICKLEFLOWER.NAME
msgctxt "STRINGS.CREATURES.SPECIES.PRICKLEFLOWER.NAME"
msgid "<link=\"PRICKLEFLOWER\">Bristle Blossom</link>"
msgstr "<link=\"PRICKLEFLOWER\">鬃花</link>"

#. STRINGS.CREATURES.SPECIES.PRICKLEGRASS.DESC
msgctxt "STRINGS.CREATURES.SPECIES.PRICKLEGRASS.DESC"
msgid "Bluff Briars exude pheromones causing critters to view them as especially beautiful."
msgstr "魅惑棘散發費洛蒙，使生物將它們視為特別美麗。"

#. STRINGS.CREATURES.SPECIES.PRICKLEGRASS.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.PRICKLEGRASS.DOMESTICATEDDESC"
msgid "This plant improves ambient <link=\"DECOR\">Decor</link>."
msgstr "這株植物可改善環境<link=\"DECOR\">裝飾</link>。"

#. STRINGS.CREATURES.SPECIES.PRICKLEGRASS.GROWTH_BONUS
msgctxt "STRINGS.CREATURES.SPECIES.PRICKLEGRASS.GROWTH_BONUS"
msgid "Growth Bonus"
msgstr "生長加成"

#. STRINGS.CREATURES.SPECIES.PRICKLEGRASS.NAME
msgctxt "STRINGS.CREATURES.SPECIES.PRICKLEGRASS.NAME"
msgid "<link=\"PRICKLEGRASS\">Bluff Briar</link>"
msgstr "<link=\"PRICKLEGRASS\">魅惑棘</link>"

#. STRINGS.CREATURES.SPECIES.PRICKLEGRASS.WILT_PENALTY
msgctxt "STRINGS.CREATURES.SPECIES.PRICKLEGRASS.WILT_PENALTY"
msgid "Wilt Penalty"
msgstr "枯萎懲罰"

#. STRINGS.CREATURES.SPECIES.PROPANESPOUT.DESC
msgctxt "STRINGS.CREATURES.SPECIES.PROPANESPOUT.DESC"
msgid "A rocky vent that spouts <link=\"PROPANE\">Propane Gas</link>."
msgstr "噴出<link=\"PROPANE\">丙烷</link>的噴出口。"

#. STRINGS.CREATURES.SPECIES.PROPANESPOUT.NAME
msgctxt "STRINGS.CREATURES.SPECIES.PROPANESPOUT.NAME"
msgid "<link=\"GEYSERS\">Propane Spout</link>"
msgstr "<link=\"GEYSERS\">丙烷噴口</link>"

#. STRINGS.CREATURES.SPECIES.PUFFERFISH.BABY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.PUFFERFISH.BABY.DESC"
msgid "A precious little Blowter Fry.\n\nIn time, it will mature into an adult <link=\"PUFFERFISH\">Blowter</link>."
msgstr "一條珍貴的小鼓氣魚苗。\n\n隨著時間經過，牠會成長為一隻成年的<link=\"PUFFERFISH\">鼓氣魚</link>。"

#. STRINGS.CREATURES.SPECIES.PUFFERFISH.BABY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.PUFFERFISH.BABY.NAME"
msgid "<link=\"SQUID\">Blowter Fry</link>"
msgstr "<link=\"SQUID\">鼓氣魚苗</link>"

#. STRINGS.CREATURES.SPECIES.PUFFERFISH.DESC
msgctxt "STRINGS.CREATURES.SPECIES.PUFFERFISH.DESC"
msgid "Blowters are aquatic critters who produce <link=\"OXYGEN\">Oxygen</link> after eating leaves from <link=\"SEALETTUCE\">Waterweed</link> plants."
msgstr "鼓氣魚是一種水生小動物，吃過<link=\"SEALETTUCE\">水草</link>葉子後會產生<link=\"OXYGEN\">氧氣</link>。"

#. STRINGS.CREATURES.SPECIES.PUFFERFISH.EGG_NAME
msgctxt "STRINGS.CREATURES.SPECIES.PUFFERFISH.EGG_NAME"
msgid "<link=\"PUFFERFISH\">Blowter Egg</link>"
msgstr "<link=\"PUFFERFISH\">鼓氣魚卵</link>"

#. STRINGS.CREATURES.SPECIES.PUFFERFISH.NAME
msgctxt "STRINGS.CREATURES.SPECIES.PUFFERFISH.NAME"
msgid "<link=\"PUFFERFISH\">Blowter</link>"
msgstr "<link=\"PUFFERFISH\">鼓氣魚</link>"

#. STRINGS.CREATURES.SPECIES.PUFT.BABY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.PUFT.BABY.DESC"
msgid "A gassy little Puftlet.\n\nIn time it will grow into an adult <link=\"PUFT\">Puft</link>."
msgstr "一隻氣喘吁吁的小帕夫寶寶。\n\n隨著時間經過牠會成長為一隻成年的<link=\"PUFT\">帕夫</link>。"

#. STRINGS.CREATURES.SPECIES.PUFT.BABY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.PUFT.BABY.NAME"
msgid "<link=\"PUFT\">Puftlet</link>"
msgstr "<link=\"PUFT\">帕夫寶寶</link>"

#. STRINGS.CREATURES.SPECIES.PUFT.DESC
msgctxt "STRINGS.CREATURES.SPECIES.PUFT.DESC"
msgid "Pufts are non-aggressive critters that excrete lumps of <link=\"SLIMEMOLD\">Slime</link> with each breath."
msgstr "帕夫是沒有侵略性的動物，每次呼吸會排出<link=\"SLIMEMOLD\">軟泥</link>。"

#. STRINGS.CREATURES.SPECIES.PUFT.EGG_NAME
msgctxt "STRINGS.CREATURES.SPECIES.PUFT.EGG_NAME"
msgid "<link=\"PUFT\">Puft Egg</link>"
msgstr "<link=\"PUFT\">帕夫蛋</link>"

#. STRINGS.CREATURES.SPECIES.PUFT.NAME
msgctxt "STRINGS.CREATURES.SPECIES.PUFT.NAME"
msgid "<link=\"PUFT\">Puft</link>"
msgstr "<link=\"PUFT\">帕夫</link>"

#. STRINGS.CREATURES.SPECIES.PUFT.VARIANT_ALPHA.BABY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.PUFT.VARIANT_ALPHA.BABY.DESC"
msgid "A gassy little Puftlet Prince.\n\nOne day it will grow into an adult Puft morph, the <link=\"PUFTALPHA\">Puft Prince</link>.\n\nIt seems a bit snobby..."
msgstr "一隻氣喘吁吁的小帕夫王子寶寶。\n\n有一天牠會成長為一隻成年的<link=\"PUFT\">帕夫王子</link>。\n\n看起來有點勢利…"

#. STRINGS.CREATURES.SPECIES.PUFT.VARIANT_ALPHA.BABY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.PUFT.VARIANT_ALPHA.BABY.NAME"
msgid "<link=\"PUFTALPHA\">Puftlet Prince</link>"
msgstr "<link=\"PUFTALPHA\">帕夫王子寶寶</link>"

#. STRINGS.CREATURES.SPECIES.PUFT.VARIANT_ALPHA.DESC
msgctxt "STRINGS.CREATURES.SPECIES.PUFT.VARIANT_ALPHA.DESC"
msgid "The Puft Prince is a lazy critter that excretes little <link=\"SOLID\">Solid</link> lumps of whatever it has been breathing."
msgstr "帕夫王子是隻懶惰的小動物，牠會排出牠所呼吸的任何<link=\"SOLID\">固體</link>小碎塊。"

#. STRINGS.CREATURES.SPECIES.PUFT.VARIANT_ALPHA.EGG_NAME
msgctxt "STRINGS.CREATURES.SPECIES.PUFT.VARIANT_ALPHA.EGG_NAME"
msgid "<link=\"PUFTALPHA\">Puft Prince Egg</link>"
msgstr "<link=\"PUFTALPHA\">帕夫王子蛋</link>"

#. STRINGS.CREATURES.SPECIES.PUFT.VARIANT_ALPHA.NAME
msgctxt "STRINGS.CREATURES.SPECIES.PUFT.VARIANT_ALPHA.NAME"
msgid "<link=\"PUFTALPHA\">Puft Prince</link>"
msgstr "<link=\"PUFTALPHA\">帕夫王子</link>"

#. STRINGS.CREATURES.SPECIES.PUFT.VARIANT_BLEACHSTONE.BABY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.PUFT.VARIANT_BLEACHSTONE.BABY.DESC"
msgid "A frazzled little Squeaky Puftlet.\n\nOne day it will grow into an adult Puft morph, the <link=\"PUFTBLEACHSTONE\">Squeaky Puft</link>."
msgstr "一隻疲憊不堪的氯氣帕夫寶寶。\n\n有一天牠會成長為一隻成年的帕夫變種：<link=\"PUFTBLEACHSTONE\">氯氣帕夫</link>。"

#. STRINGS.CREATURES.SPECIES.PUFT.VARIANT_BLEACHSTONE.BABY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.PUFT.VARIANT_BLEACHSTONE.BABY.NAME"
msgid "<link=\"PUFTBLEACHSTONE\">Squeaky Puftlet</link>"
msgstr "<link=\"PUFTBLEACHSTONE\">氯氣帕夫寶寶</link>"

#. STRINGS.CREATURES.SPECIES.PUFT.VARIANT_BLEACHSTONE.DESC
msgctxt "STRINGS.CREATURES.SPECIES.PUFT.VARIANT_BLEACHSTONE.DESC"
msgid "Squeaky Pufts are non-aggressive critters that excrete lumps of <link=\"BLEACHSTONE\">Bleachstone</link> with each breath."
msgstr "氯氣帕夫是沒有侵略性的動物，每次呼吸會排出<link=\"BLEACHSTONE\">漂白石</link>。"

#. STRINGS.CREATURES.SPECIES.PUFT.VARIANT_BLEACHSTONE.EGG_NAME
msgctxt "STRINGS.CREATURES.SPECIES.PUFT.VARIANT_BLEACHSTONE.EGG_NAME"
msgid "<link=\"PUFTBLEACHSTONE\">Squeaky Puft Egg</link>"
msgstr "<link=\"PUFTBLEACHSTONE\">氯氣帕夫蛋</link>"

#. STRINGS.CREATURES.SPECIES.PUFT.VARIANT_BLEACHSTONE.NAME
msgctxt "STRINGS.CREATURES.SPECIES.PUFT.VARIANT_BLEACHSTONE.NAME"
msgid "<link=\"PUFTBLEACHSTONE\">Squeaky Puft</link>"
msgstr "<link=\"PUFTBLEACHSTONE\">氯氣帕夫</link>"

#. STRINGS.CREATURES.SPECIES.PUFT.VARIANT_OXYLITE.BABY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.PUFT.VARIANT_OXYLITE.BABY.DESC"
msgid "A stocky little Dense Puftlet.\n\nOne day it will grow into an adult Puft morph, the <link=\"PUFTOXYLITE\">Dense Puft</link>."
msgstr "一隻敦實的氧氣帕夫寶寶。\n\n有一天牠會成長為一隻成年的帕夫變種：<link=\"PUFTOXYLITE\">氧氣帕夫</link>。"

#. STRINGS.CREATURES.SPECIES.PUFT.VARIANT_OXYLITE.BABY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.PUFT.VARIANT_OXYLITE.BABY.NAME"
msgid "<link=\"PUFTOXYLITE\">Dense Puftlet</link>"
msgstr "<link=\"PUFTOXYLITE\">氧氣帕夫寶寶</link>"

#. STRINGS.CREATURES.SPECIES.PUFT.VARIANT_OXYLITE.DESC
msgctxt "STRINGS.CREATURES.SPECIES.PUFT.VARIANT_OXYLITE.DESC"
msgid "Dense Pufts are non-aggressive critters that excrete condensed <link=\"OXYROCK\">Oxylite</link> with each breath."
msgstr "氧氣帕夫是沒有侵略性的動物，每次呼吸會排出<link=\"OXYROCK\">氧石</link>。"

#. STRINGS.CREATURES.SPECIES.PUFT.VARIANT_OXYLITE.EGG_NAME
msgctxt "STRINGS.CREATURES.SPECIES.PUFT.VARIANT_OXYLITE.EGG_NAME"
msgid "<link=\"PUFTOXYLITE\">Dense Puft Egg</link>"
msgstr "<link=\"PUFTOXYLITE\">氧氣帕夫蛋</link>"

#. STRINGS.CREATURES.SPECIES.PUFT.VARIANT_OXYLITE.NAME
msgctxt "STRINGS.CREATURES.SPECIES.PUFT.VARIANT_OXYLITE.NAME"
msgid "<link=\"PUFTOXYLITE\">Dense Puft</link>"
msgstr "<link=\"PUFTOXYLITE\">氧氣帕夫</link>"

#. STRINGS.CREATURES.SPECIES.RAPTOR.BABY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.RAPTOR.BABY.DESC"
msgid "A feathery little Rhex fledgling.\n\nOne day, it will grow into a fearsome <link=\"RAPTOR\">Rhex</link>."
msgstr "一隻長滿羽毛的霸王鸚幼鳥。\n\n總有一天它會長成可怕的<link=\"RAPTOR\">霸王鸚</link>。"

#. STRINGS.CREATURES.SPECIES.RAPTOR.BABY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.RAPTOR.BABY.NAME"
msgid "<link=\"RAPTOR\">Rhex Baby</link>"
msgstr "<link=\"RAPTOR\">霸王鸚寶寶</link>"

#. STRINGS.CREATURES.SPECIES.RAPTOR.DESC
msgctxt "STRINGS.CREATURES.SPECIES.RAPTOR.DESC"
msgid "Rhexes are carnivorous critters that feed on smaller <link=\"CREATURES\">Critters</link> and produce <link=\"BRINEICE\">Brine Ice</link>.\n\nTheir tailfeathers can be shorn for <link=\"FEATHERFABRIC\">Feather Fiber</link>."
msgstr "霸王鸚是一種食肉小動物，以更小型的<link=\"CREATURES\">小動物</link>為食，並會產生<link=\"BRINEICE\">濃鹽水冰</link>。\n\n牠們的尾羽可以剪下用來生產<link=\"FEATHERFABRIC\">羽毛纖維</link>。"

#. STRINGS.CREATURES.SPECIES.RAPTOR.EGG_NAME
msgctxt "STRINGS.CREATURES.SPECIES.RAPTOR.EGG_NAME"
msgid "<link=\"RAPTOR\">Rhex Egg</link>"
msgstr "<link=\"RAPTOR\">霸王鸚蛋</link>"

#. STRINGS.CREATURES.SPECIES.RAPTOR.NAME
msgctxt "STRINGS.CREATURES.SPECIES.RAPTOR.NAME"
msgid "<link=\"RAPTOR\">Rhex</link>"
msgstr "<link=\"RAPTOR\">霸王鸚</link>"

#. STRINGS.CREATURES.SPECIES.SALTPLANT.DESC
msgctxt "STRINGS.CREATURES.SPECIES.SALTPLANT.DESC"
msgid "Dasha Saltvines consume small amounts of <link=\"CHLORINEGAS\">Chlorine Gas</link> and form sodium deposits as they grow, producing harvestable <link=\"SALT\">Salt</link>."
msgstr "沙鹽藤在生長時會消耗少量的<link=\"CHLORINE\">氯氣</link>，形成鈉結晶，產生可收穫的<link=\"SALT\">鹽</link>。"

#. STRINGS.CREATURES.SPECIES.SALTPLANT.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.SALTPLANT.DOMESTICATEDDESC"
msgid "This plant produces unrefined <link=\"SALT\">Salt</link>."
msgstr "這株植物生產未精製的<link=\"SALT\">鹽</link>。"

#. STRINGS.CREATURES.SPECIES.SALTPLANT.NAME
msgctxt "STRINGS.CREATURES.SPECIES.SALTPLANT.NAME"
msgid "<link=\"SALTPLANT\">Dasha Saltvine</link>"
msgstr "<link=\"SALTPLANT\">沙鹽藤</link>"

#. STRINGS.CREATURES.SPECIES.SALTYSTICKSPLANT.DESC
msgctxt "STRINGS.CREATURES.SPECIES.SALTYSTICKSPLANT.DESC"
msgid "Sodicane produces <link=\"SALTYSTICKSFOOD\">Salty Sticks</link>, a sodium-rich <link=\"FOOD\">Food</link> that leaves Duplicants feeling quite parched."
msgstr "鹹蔗可產出<link=\"SALTYSTICKSFOOD\">鹽棒</link>，一種富含鈉元素且會讓複製人感到相當口渴的<link=\"FOOD\">食物</link>。"

#. STRINGS.CREATURES.SPECIES.SALTYSTICKSPLANT.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.SALTYSTICKSPLANT.DOMESTICATEDDESC"
msgid "This plant produces edible <link=\"SALTYSTICKSFOOD\">Salty Sticks</link>."
msgstr "這種植物可產出可食用的<link=\"SALTYSTICKSFOOD\">鹽棒</link>。"

#. STRINGS.CREATURES.SPECIES.SALTYSTICKSPLANT.NAME
msgctxt "STRINGS.CREATURES.SPECIES.SALTYSTICKSPLANT.NAME"
msgid "<link=\"SALTYSTICKSPLANT\">Sodicane</link>"
msgstr "<link=\"SALTYSTICKSPLANT\">鹹蔗</link>"

#. STRINGS.CREATURES.SPECIES.SAPTREE.DESC
msgctxt "STRINGS.CREATURES.SPECIES.SAPTREE.DESC"
msgid "A <link=\"RESIN\">Sap</link>-producing cybernetic tree that shows signs of sentience.\n\nIt is rooted firmly in place, and is waiting for some brave soul to bring it food."
msgstr "一棵生產<link=\"RESIN\">原生膠</link>的仿生樹，似乎擁有一定的感知能力。\n\n它牢牢地紮根在原地，等待著某個勇敢的靈魂給它帶來食物。"

#. STRINGS.CREATURES.SPECIES.SAPTREE.NAME
msgctxt "STRINGS.CREATURES.SPECIES.SAPTREE.NAME"
msgid "<link=\"SAPTREE\">Experiment 52B</link>"
msgstr "<link=\"SAPTREE\">實驗體 52B</link>"

#. STRINGS.CREATURES.SPECIES.SEAFAIRY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.SEAFAIRY.DESC"
msgid "Kelpoles are non-hostile aquatic critters that spawn along <link=\"SEATREE\">Tower Kelp</link> stalks.\n\nThey can be harvested for <link=\"NORI\">Nori</link>."
msgstr "藻蝌蚪是一種無害的水生生物，會附著在<link=\"SEATREE\">塔藻</link>的莖稈上繁衍。\n\n採收後可獲得<link=\"NORI\">海苔</link>。"

#. STRINGS.CREATURES.SPECIES.SEAFAIRY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.SEAFAIRY.NAME"
msgid "<link=\"SEAFAIRY\">Kelpole</link>"
msgstr "<link=\"SEAFAIRY\">藻蝌蚪</link>"

#. STRINGS.CREATURES.SPECIES.SEAHORSE.BABY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.SEAHORSE.BABY.DESC"
msgid "A flouncy little Seaquine Fry.\n\nIn time, it will mature into an adult <link=\"SEAHORSE\">Seaquine</link>."
msgstr "一隻俏皮的海馬魚苗。\n\n隨著時間經過，牠會成長為一隻成年的<link=\"SEAHORSE\">海馬</link>。"

#. STRINGS.CREATURES.SPECIES.SEAHORSE.BABY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.SEAHORSE.BABY.NAME"
msgid "<link=\"SEAHORSE\">Seaquine Fry</link>"
msgstr "<link=\"SEAHORSE\">海馬魚苗</link>"

#. STRINGS.CREATURES.SPECIES.SEAHORSE.DESC
msgctxt "STRINGS.CREATURES.SPECIES.SEAHORSE.DESC"
msgid "Seaquines are aquatic critters that live in liquid pools.\n\nThey feed on <link=\"PEARL\">Pearl</link> and produce <link=\"FISHMILK\">Ovolene</link> at the <link=\"UNDERWATERMILKINGSTATION\">Aquatic Milking Station</link>."
msgstr "海馬是一種棲息於液體水池中的水生小動物。\n\n它們以<link=\"PEARL\">珍珠</link>為食，並能在<link=\"UNDERWATERMILKINGSTATION\">水生擠奶站</link>產出<link=\"FISHMILK\">卵漿</link>。"

#. STRINGS.CREATURES.SPECIES.SEAHORSE.EGG_NAME
msgctxt "STRINGS.CREATURES.SPECIES.SEAHORSE.EGG_NAME"
msgid "<link=\"SEAHORSE\">Seaquine Egg</link>"
msgstr "<link=\"SEAHORSE\">海馬卵</link>"

#. STRINGS.CREATURES.SPECIES.SEAHORSE.NAME
msgctxt "STRINGS.CREATURES.SPECIES.SEAHORSE.NAME"
msgid "<link=\"SEAHORSE\">Seaquine</link>"
msgstr "<link=\"SEAHORSE\">海馬</link>"

#. STRINGS.CREATURES.SPECIES.SEAL.BABY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.SEAL.BABY.DESC"
msgid "A wobbly little Spigot Pup.\n\nIn time, it will mature into an adult <link=\"SEAL\">Spigot Seal</link>."
msgstr "一隻搖搖晃晃的栓角海豹寶寶。\n\n隨著時間經過，牠會成長為一隻成年的<link=\"SEAL\">栓角海豹</link>。"

#. STRINGS.CREATURES.SPECIES.SEAL.BABY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.SEAL.BABY.NAME"
msgid "<link=\"SEAL\">Spigot Pup</link>"
msgstr "<link=\"SEAL\">栓角海豹寶寶</link>"

#. STRINGS.CREATURES.SPECIES.SEAL.DESC
msgctxt "STRINGS.CREATURES.SPECIES.SEAL.DESC"
msgid "Spigot Seals are charismatic creatures who produce <link=\"ETHANOL\">Ethanol</link>.\n\nThey eat <link=\"SUCROSE\">Sucrose</link>, and drink <link=\"SUGARWATER\">Nectar</link> straight from the <link=\"SPACETREE\">Bonbon Tree</link>."
msgstr "栓角海豹是具有魅力的生物，能產生<link=\"ETHANOL\">乙醇</link>。\n\n牠們能吃<link=\"SUCROSE\">蔗糖</link>，也可以直接從<link=\"SPACETREE\">糖心樹</link>吸取<link=\"SUGARWATER\">花蜜</link>。"

#. STRINGS.CREATURES.SPECIES.SEAL.EGG_NAME
msgctxt "STRINGS.CREATURES.SPECIES.SEAL.EGG_NAME"
msgid "<link=\"SEAL\">Spigot Seal Egg</link>"
msgstr "<link=\"SEAL\">栓角海豹蛋</link>"

#. STRINGS.CREATURES.SPECIES.SEAL.NAME
msgctxt "STRINGS.CREATURES.SPECIES.SEAL.NAME"
msgid "<link=\"SEAL\">Spigot Seal</link>"
msgstr "<link=\"SEAL\">栓角海豹</link>"

#. STRINGS.CREATURES.SPECIES.SEALETTUCE.DESC
msgctxt "STRINGS.CREATURES.SPECIES.SEALETTUCE.DESC"
msgid "Waterweeds thrive in liquid environments and can be harvested for fresh, edible <link=\"LETTUCE\">Lettuce</link>."
msgstr "水草在液體環境中生長旺盛，可採收新鮮、可食用的<link=\"LETTUCE\">生菜</link>。"

#. STRINGS.CREATURES.SPECIES.SEALETTUCE.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.SEALETTUCE.DOMESTICATEDDESC"
msgid "This plant produces <link=\"LETTUCE\">Lettuce</link>."
msgstr "這株植物生產<link=\"LETTUCE\">生菜</link>。"

#. STRINGS.CREATURES.SPECIES.SEALETTUCE.NAME
msgctxt "STRINGS.CREATURES.SPECIES.SEALETTUCE.NAME"
msgid "<link=\"SEALETTUCE\">Waterweed</link>"
msgstr "<link=\"SEALETTUCE\">水草</link>"

#. STRINGS.CREATURES.SPECIES.SEATREE.DESC
msgctxt "STRINGS.CREATURES.SPECIES.SEATREE.DESC"
msgid "Tower Kelp is an aquatic plant that grows in temperate pools.\n\nIt can be harvested for <link=\"NORI\">Nori</link>."
msgstr "塔藻是一種生長於溫和水域的水生植物。\n\n可採收其葉片獲得<link=\"NORI\">海苔</link>。"

#. STRINGS.CREATURES.SPECIES.SEATREE.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.SEATREE.DOMESTICATEDDESC"
msgid "This plant produces <link=\"NORI\">Nori</link>."
msgstr "這種植物可產出<link=\"NORI\">海苔</link>。"

#. STRINGS.CREATURES.SPECIES.SEATREE.NAME
msgctxt "STRINGS.CREATURES.SPECIES.SEATREE.NAME"
msgid "<link=\"SEATREE\">Tower Kelp</link>"
msgstr "<link=\"SEATREE\">塔藻</link>"

#. STRINGS.CREATURES.SPECIES.SEATREEBRANCH.DESC
msgctxt "STRINGS.CREATURES.SPECIES.SEATREEBRANCH.DESC"
msgid "These stalks are the individual shoots of the <link=\"SEATREE\">Tower Kelp</link> plant.\n\nThey act as cross-species nurseries for <link=\"SEATREEFAIRY\">Kelpoles</link> that can be harvested for <link=\"NORI\">Nori</link>."
msgstr "這些莖是<link=\"SEATREE\">塔藻</link>植株上的獨立枝條。\n\n它們為<link=\"SEATREEFAIRY\">藻蝌蚪</link>提供跨物種的育嬰環境，同時也可採收獲得<link=\"NORI\">海苔</link>。"

#. STRINGS.CREATURES.SPECIES.SEATREEBRANCH.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.SEATREEBRANCH.DOMESTICATEDDESC"
msgid "This plant produces <link=\"NORI\">Nori</link>."
msgstr "這種植物可產出<link=\"NORI\">海苔</link>。"

#. STRINGS.CREATURES.SPECIES.SEATREEBRANCH.NAME
msgctxt "STRINGS.CREATURES.SPECIES.SEATREEBRANCH.NAME"
msgid "<link=\"SEATREE\">Tower Kelp</link>"
