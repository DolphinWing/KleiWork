msgctxt "STRINGS.MISC.NOTIFICATIONS.NEEDENERGYSOURCE.TOOLTIP"
msgid "<link=\"POWER\">Power</link> is required to operate electrical buildings\n\n<link=\"MANUALGENERATOR\">Manual Generators</link> and <link=\"WIRE\">Wire</link> can be built from the <link=\"[3]\">Power Tab</link>"
