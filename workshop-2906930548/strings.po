msgstr "<link=\"EXTERIORWALL\">噬菌體電路</link>"

#. STRINGS.BLUEPRINTS.PERMIT_WALLS_DIAGONAL_BLUE_NAUTICAL_WHITE.DESC
msgctxt "STRINGS.BLUEPRINTS.PERMIT_WALLS_DIAGONAL_BLUE_NAUTICAL_WHITE.DESC"
