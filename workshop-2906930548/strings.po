msgid "A temperature reactive, subterranean <link=\"PLANTS\">Plant</link>."
msgstr "一種對溫度有反應，地下生長的<link=\"PLANTS\">植物</link>。"

#. STRINGS.CREATURES.SPECIES.HEATBULBSEED.NAME
msgctxt "STRINGS.CREATURES.SPECIES.HEATBULBSEED.NAME"
msgid "<link=\"HEATBULBSEED\">Fervine Bulb</link>"
msgstr "<link=\"HEATBULBSEED\">熱帶藤蔓種子</link>"

#. STRINGS.CREATURES.SPECIES.ICEBELLY.BABY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.ICEBELLY.BABY.DESC"
msgid "A floofy little Bammini.\n\nIn time it will mature into a fully grown <link=\"ICEBELLY\">Bammoth</link>."
msgstr "一隻毛茸茸的猛瑪絨兔寶寶。\n\n隨著時間，牠會長大成為一隻成年的<link=\"ICEBELLY\">猛瑪絨兔</link>。"

#. STRINGS.CREATURES.SPECIES.ICEBELLY.BABY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.ICEBELLY.BABY.NAME"
msgid "<link=\"ICEBELLY\">Bammini</link>"
msgstr "<link=\"ICEBELLY\">猛瑪絨兔寶寶</link>"

#. STRINGS.CREATURES.SPECIES.ICEBELLY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.ICEBELLY.DESC"
msgid "Bammoths are lumbering, nonhostile creatures that subsist on <link=\"CARROT\">Plume Squash</link>, <link=\"BEANPLANTSEED\">Nosh Beans</link> and <link=\"FRIESCARROT\">Squash Fries</link>.\n\nTheir thick overcoats can be shorn for <link=\"BASICFABRIC\">Reed Fiber</link>."
msgstr "猛瑪絨兔是一種笨拙但沒有敵意的生物，依靠<link=\"CARROT\">羽葉南瓜</link>、<link=\"BEANPLANTSEED\">小吃豆</link>和<link=\"FRIESCARROT\">南瓜條</link>生存。\n\n其厚厚的外層毛可以修剪為<link=\"BASICFABRIC\">蘆葦纖維</link>。"

#. STRINGS.CREATURES.SPECIES.ICEBELLY.EGG_NAME
msgctxt "STRINGS.CREATURES.SPECIES.ICEBELLY.EGG_NAME"
msgid "<link=\"ICEBELLY\">Bammoth Egg</link>"
msgstr "<link=\"ICEBELLY\">猛瑪絨兔蛋</link>"

#. STRINGS.CREATURES.SPECIES.ICEBELLY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.ICEBELLY.NAME"
msgid "<link=\"ICEBELLY\">Bammoth</link>"
msgstr "<link=\"ICEBELLY\">猛瑪絨兔</link>"

#. STRINGS.CREATURES.SPECIES.ICEBELLY.VARIANT_GOLD.BABY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.ICEBELLY.VARIANT_GOLD.BABY.DESC"
msgid "A haughty little Regal Bammini.\n\nIn time it will mature into a fully grown <link=\"GOLDBELLY\">Regal Bammoth</link>."
msgstr "一隻傲慢的帝王絨兔寶寶。\n\n隨著時間，牠會長大成為一隻成年的<link=\"ICEBELLY\">帝王絨兔</link>。"

#. STRINGS.CREATURES.SPECIES.ICEBELLY.VARIANT_GOLD.BABY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.ICEBELLY.VARIANT_GOLD.BABY.NAME"
msgid "<link=\"GOLDBELLY\">Regal Bammini</link>"
msgstr "<link=\"ICEBELLY\">帝王絨兔寶寶</link>"

#. STRINGS.CREATURES.SPECIES.ICEBELLY.VARIANT_GOLD.DESC
msgctxt "STRINGS.CREATURES.SPECIES.ICEBELLY.VARIANT_GOLD.DESC"
msgid "Regal Bammoths are nonhostile creatures that subsist on <link=\"CARROT\">Plume Squash</link> and <link=\"BEANPLANTSEED\">Nosh Beans</link>.\n\nTheir ornate crests grow only when they are fed <link=\"FRIESCARROT\">Squash Fries</link>."
msgstr "帝王絨兔是一種沒有敵意的生物，依靠<link=\"CARROT\">羽葉南瓜</link>和<link=\"BEANPLANTSEED\">小吃豆</link>生存。\n\n牠們華麗的羽冠只有在吃<link=\"FRIESCARROT\">南瓜條</link>時才會生長。"

#. STRINGS.CREATURES.SPECIES.ICEBELLY.VARIANT_GOLD.EGG_NAME
msgctxt "STRINGS.CREATURES.SPECIES.ICEBELLY.VARIANT_GOLD.EGG_NAME"
msgid "<link=\"GOLDBELLY\">Regal Bammoth Egg</link>"
msgstr "<link=\"ICEBELLY\">帝王絨兔蛋</link>"

#. STRINGS.CREATURES.SPECIES.ICEBELLY.VARIANT_GOLD.NAME
msgctxt "STRINGS.CREATURES.SPECIES.ICEBELLY.VARIANT_GOLD.NAME"
msgid "<link=\"GOLDBELLY\">Regal Bammoth</link>"
msgstr "<link=\"ICEBELLY\">帝王絨兔</link>"

#. STRINGS.CREATURES.SPECIES.ICECAVESFORAGEPLANTPLANTED.DESC
msgctxt "STRINGS.CREATURES.SPECIES.ICECAVESFORAGEPLANTPLANTED.DESC"
msgid "Sherberries are incapable of propagating, but can be harvested for a single <link=\"FOOD\">Food</link> serving."
msgstr "雪漿果無法繁育，生長在原生冰錐內，只能作為一次性<link=\"FOOD\">食物</link>被收成。"

#. STRINGS.CREATURES.SPECIES.ICECAVESFORAGEPLANTPLANTED.NAME
msgctxt "STRINGS.CREATURES.SPECIES.ICECAVESFORAGEPLANTPLANTED.NAME"
msgid "<link=\"ICECAVESFORAGEPLANTPLANTED\">Sherberry Plant</link>"
msgstr "<link=\"ICECAVESFORAGEPLANTPLANTED\">雪漿果藤</link>"

#. STRINGS.CREATURES.SPECIES.ICEFLOWER.DESC
msgctxt "STRINGS.CREATURES.SPECIES.ICEFLOWER.DESC"
msgid "Idyllas are <link=\"DECOR\">Decorative</link> <link=\"PLANTS\">Plants</link> with soft, pompom-shaped blossoms.\n\nGazing dreamily at them has a positive effect on <link=\"MORALE\">Morale</link>."
msgstr "恬靜花是一種<link=\"DECOR\">裝飾性</link><link=\"PLANTS\">植物</link>，絨球形狀的花朵十分柔軟。\n\n出神地盯著它看對<link=\"MORALE\">士氣</link>有積極效果。"

#. STRINGS.CREATURES.SPECIES.ICEFLOWER.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.ICEFLOWER.DOMESTICATEDDESC"
msgid "This plant improves ambient <link=\"DECOR\">Decor</link>."
msgstr "這株植物可改善環境<link=\"DECOR\">裝飾度</link>。"

#. STRINGS.CREATURES.SPECIES.ICEFLOWER.GROWTH_BONUS
msgctxt "STRINGS.CREATURES.SPECIES.ICEFLOWER.GROWTH_BONUS"
msgid "Growth Bonus"
msgstr "生長加成"

#. STRINGS.CREATURES.SPECIES.ICEFLOWER.NAME
msgctxt "STRINGS.CREATURES.SPECIES.ICEFLOWER.NAME"
msgid "<link=\"ICEFLOWER\">Idylla Flower</link>"
msgstr "<link=\"ICEFLOWER\">恬靜花</link>"

#. STRINGS.CREATURES.SPECIES.ICEFLOWER.WILT_PENALTY
msgctxt "STRINGS.CREATURES.SPECIES.ICEFLOWER.WILT_PENALTY"
msgid "Wilt Penalty"
msgstr "枯萎懲罰"

#. STRINGS.CREATURES.SPECIES.JUNGLEGASPLANT.DESC
msgctxt "STRINGS.CREATURES.SPECIES.JUNGLEGASPLANT.DESC"
msgid "A large, chlorine-dwelling <link=\"PLANTS\">Plant</link> that can be grown in farm buildings.\n\nPalmeras grow inedible buds that emit unbreathable hydrogen gas."
msgstr "一種巨大、喜歡氯氣的<link=\"PLANTS\">植物</link>，可以在農田中生長。\n\n棕櫚樹開出的花不可食用且會釋放氫氣。"

#. STRINGS.CREATURES.SPECIES.JUNGLEGASPLANT.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.JUNGLEGASPLANT.DOMESTICATEDDESC"
msgid "A large, chlorine-dwelling <link=\"PLANTS\">Plant</link> that grows inedible buds which emit unbreathable hydrogen gas."
msgstr "一種巨大、喜歡氯氣的<link=\"PLANTS\">植物</link>，開出的花不可食用且會釋放氫氣。"

#. STRINGS.CREATURES.SPECIES.JUNGLEGASPLANT.NAME
msgctxt "STRINGS.CREATURES.SPECIES.JUNGLEGASPLANT.NAME"
msgid "<link=\"JUNGLEGASPLANT\">Palmera Tree</link>"
msgstr "<link=\"JUNGLEGASPLANT\">棕櫚樹</link>"

#. STRINGS.CREATURES.SPECIES.KELPPLANT.DESC
msgctxt "STRINGS.CREATURES.SPECIES.KELPPLANT.DESC"
msgid "Seakombs consume <link=\"TOXICSAND\">Polluted Dirt</link>.\n\nTheir leaves can be processed to extract <link=\"PHYTOOIL\">Phyto Oil</link>."
msgstr "海梳蕨會消耗<link=\"TOXICSAND\">汙染土</link>。\n\n其葉子可以加工提取出<link=\"PHYTOOIL\">植物油</link>。"

#. STRINGS.CREATURES.SPECIES.KELPPLANT.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.KELPPLANT.DOMESTICATEDDESC"
msgid "This plant produces <link=\"KELP\">Seakomb Leaf</link>."
msgstr "這種植物可產出<link=\"KELP\">海梳葉</link>。"

#. STRINGS.CREATURES.SPECIES.KELPPLANT.NAME
msgctxt "STRINGS.CREATURES.SPECIES.KELPPLANT.NAME"
msgid "<link=\"KELPPLANT\">Seakomb</link>"
msgstr "<link=\"KELPPLANT\">海梳蕨</link>"

#. STRINGS.CREATURES.SPECIES.LEAFYPLANT.DESC
msgctxt "STRINGS.CREATURES.SPECIES.LEAFYPLANT.DESC"
msgid "Mirth Leaves sport a calm green hue known for alleviating <link=\"STRESS\">Stress</link> and improving <link=\"MORALE\">Morale</link>."
msgstr "合歡葉綠色的葉子可緩和<link=\"STRESS\">壓力</link>，並提升<link=\"MORALE\">士氣</link>。"

#. STRINGS.CREATURES.SPECIES.LEAFYPLANT.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.LEAFYPLANT.DOMESTICATEDDESC"
msgid "This plant improves ambient <link=\"DECOR\">Decor</link>."
msgstr "這株植物可改善環境<link=\"DECOR\">裝飾</link>。"

#. STRINGS.CREATURES.SPECIES.LEAFYPLANT.GROWTH_BONUS
msgctxt "STRINGS.CREATURES.SPECIES.LEAFYPLANT.GROWTH_BONUS"
msgid "Growth Bonus"
msgstr "生長加成"

#. STRINGS.CREATURES.SPECIES.LEAFYPLANT.NAME
msgctxt "STRINGS.CREATURES.SPECIES.LEAFYPLANT.NAME"
msgid "<link=\"LEAFYPLANT\">Mirth Leaf</link>"
msgstr "<link=\"LEAFYPLANT\">合歡葉</link>"

#. STRINGS.CREATURES.SPECIES.LEAFYPLANT.WILT_PENALTY
msgctxt "STRINGS.CREATURES.SPECIES.LEAFYPLANT.WILT_PENALTY"
