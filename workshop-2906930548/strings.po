msgstr "擁抱喬木長褲"

#. STRINGS.BLUEPRINTS.PERMIT_PANTS_SWIM_BLACK.DESC
msgctxt "STRINGS.BLUEPRINTS.PERMIT_PANTS_SWIM_BLACK.DESC"
