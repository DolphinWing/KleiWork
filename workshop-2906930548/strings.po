msgctxt "STRINGS.CODEX.STORY_TRAITS.LONELYMINION.ANCIENTPODENTRY.TITLE"
msgid "Recovered Pod Entry #022"
msgstr "恢復的艙條目 #022"

#. STRINGS.CODEX.STORY_TRAITS.LONELYMINION.BEGIN_POPUP.CODEX_NAME
