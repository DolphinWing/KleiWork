msgstr "脹氣打底衣"

#. STRINGS.BLUEPRINTS.PERMIT_TOP_GOTCH_GLUON_PETAL.DESC
msgctxt "STRINGS.BLUEPRINTS.PERMIT_TOP_GOTCH_GLUON_PETAL.DESC"
