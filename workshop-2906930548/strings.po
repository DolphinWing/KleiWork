#. STRINGS.DUPLICANTS.TRAITS.NOODLEARMS.NAME
msgctxt "STRINGS.DUPLICANTS.TRAITS.NOODLEARMS.NAME"
msgid "Noodle Arms"
msgstr "麵條手"

#. STRINGS.DUPLICANTS.TRAITS.RADIATIONEATER.DESC
msgctxt "STRINGS.DUPLICANTS.TRAITS.RADIATIONEATER.DESC"
