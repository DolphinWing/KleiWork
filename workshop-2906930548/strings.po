msgstr "<link=\"FARMABLE\">可耕種土壤</link>"

#. STRINGS.MISC.TAGS.FARMABLE_DESC
msgctxt "STRINGS.MISC.TAGS.FARMABLE_DESC"
msgid "Cultivable soil is a fundamental building block of basic agricultural systems and can also be useful in the production of clean <link=\"OXYGEN\">Oxygen</link>."
msgstr "可耕種土壤是基本農業系統的基礎構成，還可以用於潔淨<link=\"OXYGEN\">氧氣</link>的生產。"

#. STRINGS.MISC.TAGS.FARMING
msgctxt "STRINGS.MISC.TAGS.FARMING"
msgid "Farm Build-Delivery"
msgstr "農場建造運送"

#. STRINGS.MISC.TAGS.FARMINGMATERIAL
