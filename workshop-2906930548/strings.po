msgctxt "STRINGS.CREATURES.STATS.INCUBATION.TOOLTIP"
msgid "Eggs hatch into brand new <link=\"CREATURES\">Critters</link> at the end of their incubation period"
msgstr "孵化期結束時，動物蛋會孵出新<link=\"CREATURES\">動物</link>"

