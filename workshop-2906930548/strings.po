msgctxt "STRINGS.EQUIPMENT.PREFABS.OXYGEN_TANK.EFFECT"
msgid "Allows Duplicants to breathe in hazardous environments.\n\nDoes not work when submerged in <style=\"liquid\">Liquid</style>."
msgstr "讓複製人可以在危險的環境下呼吸。\n\n當泡在<style=\"liquid\">液體</style>中時無法作用"

