msgstr "這只是場友誼賽，但並非所有參與者都清楚這一點。"

#. STRINGS.BLUEPRINTS.PERMIT_PAINTING_WIDE_ART_RHEX.NAME
msgctxt "STRINGS.BLUEPRINTS.PERMIT_PAINTING_WIDE_ART_RHEX.NAME"
msgid "Hide and Seek"
msgstr "捉迷藏"

#. STRINGS.BLUEPRINTS.PERMIT_PAINTING_WIDE_ART_VENUS.DESC
msgctxt "STRINGS.BLUEPRINTS.PERMIT_PAINTING_WIDE_ART_VENUS.DESC"
