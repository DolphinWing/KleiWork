#. STRINGS.MISC.TAGS.FILTER
msgctxt "STRINGS.MISC.TAGS.FILTER"
msgid "<link=\"FILTER\">Filtration Medium</link>"
msgstr "<link=\"FILTER\">過濾介質</link>"

#. STRINGS.MISC.TAGS.FILTER_DESC
msgctxt "STRINGS.MISC.TAGS.FILTER_DESC"
msgid "Filtration mediums are materials used to separate purified <link=\"ELEMENTSGAS\">gases</link> or <link=\"ELEMENTSLIQUID\">liquids</link> from their polluted forms.\n\nThey are consumables that will be transformed by the filtering process. For example, <link=\"SAND\">Sand</link> that has been used to filter <link=\"DIRTYWATER\">Polluted Water</link> will become <link=\"TOXICSAND\">Polluted Dirt</link>."
msgstr "過濾介質是一種用於將純淨<link=\"ELEMENTSGAS\">氣體</link>或<link=\"ELEMENTSLIQUID\">液體</link>從其汙染形式中分離出來的材料。\n\n它們是消耗品，將在過濾過程中被轉化。例如，用於過濾<link=\"DIRTYWATER\">汙水</link>的<link=\"SAND\">沙子</link>將會轉變成<link=\"TOXICSAND\">汙土</link>。"

#. STRINGS.MISC.TAGS.FLYINGCRITTEREDIBLE
msgctxt "STRINGS.MISC.TAGS.FLYINGCRITTEREDIBLE"
msgid "Bait"
msgstr "誘餌"

#. STRINGS.MISC.TAGS.FOSSIL
msgctxt "STRINGS.MISC.TAGS.FOSSIL"
msgid "Fossil"
msgstr "化石"

#. STRINGS.MISC.TAGS.FOSSILS
msgctxt "STRINGS.MISC.TAGS.FOSSILS"
msgid "<link=\"FOSSILS\">Fossil</link>"
msgstr "<link=\"FOSSILS\">化石</link>"

#. STRINGS.MISC.TAGS.FOSSILS_DESC
msgctxt "STRINGS.MISC.TAGS.FOSSILS_DESC"
msgid "Fossil is a category of composite rocks and minerals that contain traces of petrified lifeforms.\n\nThey have varied uses as basic building materials, sculpting blocks, or raw ingredients in the production of higher-grade materials."
msgstr "化石是一類岩石和礦物的複合體，含有微量的石化生命形式。\n\n化石有多種用途，比如基礎建造材料、雕塑塊或作為高階材料的生產原料。"

#. STRINGS.MISC.TAGS.GAS
msgctxt "STRINGS.MISC.TAGS.GAS"
msgid "Gas"
msgstr "氣體"

#. STRINGS.MISC.TAGS.GENE_SHUFFLER
msgctxt "STRINGS.MISC.TAGS.GENE_SHUFFLER"
msgid "Neural Vacillator"
msgstr "神經振盪器"

#. STRINGS.MISC.TAGS.GLASS
msgctxt "STRINGS.MISC.TAGS.GLASS"
msgid "Glass"
msgstr "玻璃"

#. STRINGS.MISC.TAGS.GLASSES
msgctxt "STRINGS.MISC.TAGS.GLASSES"
msgid "<link=\"GLASSES\">Glassy</link>"
msgstr "<link=\"GLASS\">玻璃質</link>"

#. STRINGS.MISC.TAGS.GLASSES_DESC
msgctxt "STRINGS.MISC.TAGS.GLASSES_DESC"
msgid "Glassy materials are smooth and transparent, allowing <link=\"LIGHT\">Light</link> to pass through them.\n\nThey are useful in the construction of buildings that require internal illumination, as well as those that display their currently stored resources."
msgstr "玻璃質材料光滑且透明，可使<link=\"LIGHT\">光</link>線穿透。\n\n這類材料適用於需要內部照明的建築，或用於展示儲存資源的建築構造中。"

#. STRINGS.MISC.TAGS.HABITAT_MODULE
msgctxt "STRINGS.MISC.TAGS.HABITAT_MODULE"
msgid "Habitat Module"
msgstr "居住模組"

#. STRINGS.MISC.TAGS.ICE
msgctxt "STRINGS.MISC.TAGS.ICE"
msgid "Ice"
msgstr "冰"

#. STRINGS.MISC.TAGS.ICEORE
msgctxt "STRINGS.MISC.TAGS.ICEORE"
msgid "<link=\"ICEORE\">Ice</link>"
msgstr "<link=\"ICEORE\">冰</link>"

#. STRINGS.MISC.TAGS.ICEORE_DESC
msgctxt "STRINGS.MISC.TAGS.ICEORE_DESC"
msgid "Ice is a class of materials made up mostly (if not completely) of <link=\"WATER\">Water</link> in a frozen or partially frozen form.\n\nAs a material in a frigid solid or semi-solid state, these elements are very useful as a low-cost way to cool the environment around them.\n\nWhen heated, ice will melt into its original liquified form (ie.<link=\"BRINEICE\">Brine Ice</link> will liquify into <link=\"BRINE\">Brine</link>). Each ice element has a different freezing and melting point based upon its composition and state."
msgstr "冰是一種材料，主要由（但不完全是）<link=\"WATER\">水</link>結冰或部分結冰形成。\n\n作為低溫固體或半固體的材料，這些元素作為低成本的方式來冰卻環境是很有用的。\n\n當加熱時，冰會融化為原始的液體形態。（例如：<link=\"BRINEICE\">濃鹽水冰</link>會液化成<link=\"BRINE\">濃鹽水</link>）。\n每一種冰元素基於它們的組成與狀態都有不同的冰點與熔點。"

#. STRINGS.MISC.TAGS.INDUSTRIALINGREDIENT
msgctxt "STRINGS.MISC.TAGS.INDUSTRIALINGREDIENT"
msgid "<link=\"INDUSTRIALINGREDIENT\">Industrial Ingredient</link>"
msgstr "<link=\"INDUSTRIALINGREDIENT\">工業原料</link>"

#. STRINGS.MISC.TAGS.INDUSTRIALPRODUCT
msgctxt "STRINGS.MISC.TAGS.INDUSTRIALPRODUCT"
msgid "Industrial Product"
msgstr "工業產品"

#. STRINGS.MISC.TAGS.INSULATOR
msgctxt "STRINGS.MISC.TAGS.INSULATOR"
msgid "<link=\"INSULATOR\">Insulator</link>"
msgstr "<link=\"INSULATOR\">隔熱質</link>"

#. STRINGS.MISC.TAGS.INSULATOR_DESC
msgctxt "STRINGS.MISC.TAGS.INSULATOR_DESC"
msgid "Insulators have low thermal conductivity, and effectively reduce the speed at which <link=\"HEAT\">Heat</link> is transferred through them."
msgstr "隔熱質有著低熱導率，能有效地降低<link=\"HEAT\">熱量</link>傳導速度。"

