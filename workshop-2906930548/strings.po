msgstr "黑色鱗紋褲子"

#. STRINGS.BLUEPRINTS.PERMIT_PANTS_WADER_ALGAE.DESC
msgctxt "STRINGS.BLUEPRINTS.PERMIT_PANTS_WADER_ALGAE.DESC"
