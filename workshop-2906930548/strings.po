msgstr "倦怠打底衣"

#. STRINGS.BLUEPRINTS.PERMIT_TOP_GOTCH_FLATUS_MUCK.DESC
msgctxt "STRINGS.BLUEPRINTS.PERMIT_TOP_GOTCH_FLATUS_MUCK.DESC"
