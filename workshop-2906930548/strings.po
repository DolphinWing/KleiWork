msgid "Pressure: {Amount}"
msgstr "壓力：{Amount}"

#. STRINGS.COLONY_ACHIEVEMENTS.ACTIVATEGEOTHERMALPLANT.STATUSITEMS.CONTROLLER.STORAGE_STATUS_TOOLTIP
msgctxt "STRINGS.COLONY_ACHIEVEMENTS.ACTIVATEGEOTHERMALPLANT.STATUSITEMS.CONTROLLER.STORAGE_STATUS_TOOLTIP"
msgid "When pressure reaches {Threshold}, this building's contents will be heated and pumped out to connected geo vents\n\nCurrent pressure: {Amount}/{Threshold}"
msgstr "當壓力到達 {Threshold}時，這個建築的內容物會被加熱並從地理排放口排出\n\n目前壓力：{Amount} / {Threshold}"

#. STRINGS.COLONY_ACHIEVEMENTS.ACTIVATEGEOTHERMALPLANT.STATUSITEMS.CONTROLLER.STORAGE_TEMPERATURE_NAME
msgctxt "STRINGS.COLONY_ACHIEVEMENTS.ACTIVATEGEOTHERMALPLANT.STATUSITEMS.CONTROLLER.STORAGE_TEMPERATURE_NAME"
msgid "Liquid Temperature: {Temp}"
msgstr "液體溫度：{Temp}"

#. STRINGS.COLONY_ACHIEVEMENTS.ACTIVATEGEOTHERMALPLANT.STATUSITEMS.CONTROLLER.STORAGE_TEMPERATURE_TOOLTIP
msgctxt "STRINGS.COLONY_ACHIEVEMENTS.ACTIVATEGEOTHERMALPLANT.STATUSITEMS.CONTROLLER.STORAGE_TEMPERATURE_TOOLTIP"
msgid "The average <style=\"KKeyword\">Temperature</style> of <style=\"KKeyword\">Liquids</style> stored in this building is {Temp}\n\nThe initial input <style=\"KKeyword\">Temperature</style> determines the type of materials emitted"
msgstr "該建築物內儲存<style=\"KKeyword\">液體</style>的平均<style=\"KKeyword\">溫度</style>為 {Temp}\n\n輸入液體的初始<style=\"KKeyword\">溫度</style>會影響排放的材料類型"

#. STRINGS.COLONY_ACHIEVEMENTS.ACTIVATEGEOTHERMALPLANT.STATUSITEMS.VENT.BLOCKED_NAME
