msgstr "<link=\"STORYTRAITFOSSILHUNT\">化石採集場</link>"

#. STRINGS.BUILDINGS.PREFABS.FOSSILSCULPTURE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.FOSSILSCULPTURE.DESC"
