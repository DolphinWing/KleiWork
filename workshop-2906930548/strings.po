msgstr "<link=\"HEADQUARTERS\">寒霜列印元</link>"

#. STRINGS.BLUEPRINTS.PERMIT_HQBASE_AQUATIC.DESC
msgctxt "STRINGS.BLUEPRINTS.PERMIT_HQBASE_AQUATIC.DESC"
msgid "It looks like it spent some time in an underwater research facility."
msgstr "它看起來像是曾在水下研究設施裡待過一段時間。"

#. STRINGS.BLUEPRINTS.PERMIT_HQBASE_AQUATIC.NAME
msgctxt "STRINGS.BLUEPRINTS.PERMIT_HQBASE_AQUATIC.NAME"
msgid "<link=\"HEADQUARTERS\">Aquarius Printing Pod</link>"
msgstr "<link=\"EADQUARTER\">水瓶座列印元</link>"

#. STRINGS.BLUEPRINTS.PERMIT_HQBASE_CYBERPUNK.DESC
msgctxt "STRINGS.BLUEPRINTS.PERMIT_HQBASE_CYBERPUNK.DESC"
msgid "There's something profoundly hopeful about it."
msgstr "這其中蘊含著某種深切的盼望。"

#. STRINGS.BLUEPRINTS.PERMIT_HQBASE_CYBERPUNK.NAME
msgctxt "STRINGS.BLUEPRINTS.PERMIT_HQBASE_CYBERPUNK.NAME"
msgid "<link=\"HEADQUARTERS\">Retro LED Printing Pod</link>"
msgstr "<link=\"HEADQUARTERS\">復古 LED 列印元</link>"

#. STRINGS.BLUEPRINTS.PERMIT_HQBASE_DINO.DESC
msgctxt "STRINGS.BLUEPRINTS.PERMIT_HQBASE_DINO.DESC"
msgid "Reclaimed by nature after centuries of neglect. It's a wonder that it still works."
msgstr "經過幾個世紀被大自然改造之後還能用，真是個奇蹟。"

#. STRINGS.BLUEPRINTS.PERMIT_HQBASE_DINO.NAME
msgctxt "STRINGS.BLUEPRINTS.PERMIT_HQBASE_DINO.NAME"
msgid "<link=\"HEADQUARTERS\">Forgotten Printing Pod</link>"
msgstr "<link=\"HEADQUARTERS\">被遺忘的列印元</link>"

#. STRINGS.BLUEPRINTS.PERMIT_HQBASE_NEUTRONIUM.DESC
msgctxt "STRINGS.BLUEPRINTS.PERMIT_HQBASE_NEUTRONIUM.DESC"
msgid "A grandiose machine that makes even the most haphazard colony feel like a distinguished outpost."
msgstr "一台宏偉的機器，能讓即使是最雜亂無章的殖民地，也感覺像是一個卓越的前哨站。"

#. STRINGS.BLUEPRINTS.PERMIT_HQBASE_NEUTRONIUM.NAME
msgctxt "STRINGS.BLUEPRINTS.PERMIT_HQBASE_NEUTRONIUM.NAME"
msgid "<link=\"HEADQUARTERS\">Regal Neutronium Printing Pod</link>"
msgstr "<link=\"HEADQUARTERS\">帝王零號列印元</link>"

#. STRINGS.BLUEPRINTS.PERMIT_ICESCULPTURE_AMAZING_IDLE_BAMMOTH.DESC
msgctxt "STRINGS.BLUEPRINTS.PERMIT_ICESCULPTURE_AMAZING_IDLE_BAMMOTH.DESC"
msgid "It's not a real party until someone tries to feed the sculpture a Frost Bun."
msgstr "除非有人嘗試給雕塑餵食冰霜麵包，否則這不是真正的聚會。"

#. STRINGS.BLUEPRINTS.PERMIT_ICESCULPTURE_AMAZING_IDLE_BAMMOTH.NAME
