msgstr "飛行衣的預設頭盔"

#. STRINGS.EQUIPMENT.PREFABS.JET_SUIT_HELMET.NAME
msgctxt "STRINGS.EQUIPMENT.PREFABS.JET_SUIT_HELMET.NAME"
msgid "Default Jet Helmet"
msgstr "預設飛行頭盔"

#. STRINGS.EQUIPMENT.PREFABS.JET_SUIT_SHOES.DESC
