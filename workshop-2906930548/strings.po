msgctxt "STRINGS.COLONY_ACHIEVEMENTS.ASTEROID_DESTROYED.REQUIREMENT_DESCRIPTION"
msgid "Destroyed Demolior before it arrived: {0}/{1}"
msgstr "在毀神星抵達前將其摧毀：{0} / {1}"

