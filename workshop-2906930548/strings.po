msgstr "<link=\"ADVANCEDRESEARCHCENTER\">復古 LED 超級電腦</link>"

#. STRINGS.BLUEPRINTS.PERMIT_RESPECCER_NEUTRONIUM.DESC
msgctxt "STRINGS.BLUEPRINTS.PERMIT_RESPECCER_NEUTRONIUM.DESC"
