#. STRINGS.DUPLICANTS.TRAITS.THRIVER.NAME
msgctxt "STRINGS.DUPLICANTS.TRAITS.THRIVER.NAME"
msgid "Duress to Impress"
msgstr "逼迫自己"

#. STRINGS.DUPLICANTS.TRAITS.THRIVER.SHORT_DESC
msgctxt "STRINGS.DUPLICANTS.TRAITS.THRIVER.SHORT_DESC"
msgid "Attribute bonuses while stressed"
msgstr "壓力過大時獲得屬性加成"

#. STRINGS.DUPLICANTS.TRAITS.THRIVER.SHORT_DESC_TOOLTIP
msgctxt "STRINGS.DUPLICANTS.TRAITS.THRIVER.SHORT_DESC_TOOLTIP"
msgid "More than 60% Stress: <b>+7</b> bonus to all <style=\"KKeyword\">Attributes</style>"
msgstr "壓力超過 60%：全部<style=\"KKeyword\">屬性</style> <b>+7</b>"

#. STRINGS.DUPLICANTS.TRAITS.TRAIT_DESCRIPTION_LIST_ENTRY
msgctxt "STRINGS.DUPLICANTS.TRAITS.TRAIT_DESCRIPTION_LIST_ENTRY"
msgid "\n• "
msgstr "\n• "

#. STRINGS.DUPLICANTS.TRAITS.TWINKLETOES.DESC
msgctxt "STRINGS.DUPLICANTS.TRAITS.TWINKLETOES.DESC"
msgid "This Duplicant is light as a feather on their feet"
msgstr "這名複製人的腿像羽毛一樣輕盈"

#. STRINGS.DUPLICANTS.TRAITS.TWINKLETOES.NAME
msgctxt "STRINGS.DUPLICANTS.TRAITS.TWINKLETOES.NAME"
msgid "Twinkletoes"
msgstr "身輕如燕"

#. STRINGS.DUPLICANTS.TRAITS.UGLYCRIER.DESC
msgctxt "STRINGS.DUPLICANTS.TRAITS.UGLYCRIER.DESC"
msgid "If this Duplicant gets too <style=\"KKeyword\">Stressed</style> it won't be pretty"
msgstr "如果這名複製人的<style=\"KKeyword\">壓力</style>太大，後果不堪設想。"

#. STRINGS.DUPLICANTS.TRAITS.UGLYCRIER.NAME
msgctxt "STRINGS.DUPLICANTS.TRAITS.UGLYCRIER.NAME"
msgid "Ugly Crier"
msgstr "愛哭鬼"

#. STRINGS.DUPLICANTS.TRAITS.UNCULTURED.DESC
msgctxt "STRINGS.DUPLICANTS.TRAITS.UNCULTURED.DESC"
msgid "This Duplicant has simply no appreciation for the arts"
msgstr "這名複製人對藝術根本不感興趣"

#. STRINGS.DUPLICANTS.TRAITS.UNCULTURED.NAME
msgctxt "STRINGS.DUPLICANTS.TRAITS.UNCULTURED.NAME"
msgid "Uncultured"
msgstr "毫無品味"

#. STRINGS.DUPLICANTS.TRAITS.WEAKIMMUNESYSTEM.DESC
msgctxt "STRINGS.DUPLICANTS.TRAITS.WEAKIMMUNESYSTEM.DESC"
msgid "All the vitamin C in space couldn't stop this Duplicant from getting sick"
msgstr "太空中所有的維他命 C 都不能讓這名複製人停止生病"

#. STRINGS.DUPLICANTS.TRAITS.WEAKIMMUNESYSTEM.NAME
msgctxt "STRINGS.DUPLICANTS.TRAITS.WEAKIMMUNESYSTEM.NAME"
msgid "Biohazardous"
msgstr "體弱多病"

#. STRINGS.ELEMENTS.AEROGEL.DESC
msgctxt "STRINGS.ELEMENTS.AEROGEL.DESC"
msgid ""
msgstr ""

#. STRINGS.ELEMENTS.AEROGEL.NAME
msgctxt "STRINGS.ELEMENTS.AEROGEL.NAME"
msgid "<link=\"AEROGEL\">Aerogel</link>"
msgstr "<link=\"AEROGEL\">氣凝膠</link>"

#. STRINGS.ELEMENTS.ALGAE.DESC
msgctxt "STRINGS.ELEMENTS.ALGAE.DESC"
msgid "Algae is a cluster of non-motile, single-celled lifeforms.\n\nIt can be used to produce <link=\"OXYGEN\">Oxygen</link> when used in an <link=\"MINERALDEOXIDIZER\">Oxygen Diffuser</link>."
msgstr "藻類是一群不會移動的單細胞生物。\n\n將其投入<link=\"MINERALDEOXIDIZER\">氧氣擴散機</link>，可以生產<link=\"OXYGEN\">氧氣</link>"

#. STRINGS.ELEMENTS.ALGAE.NAME
msgctxt "STRINGS.ELEMENTS.ALGAE.NAME"
msgid "<link=\"ALGAE\">Algae</link>"
msgstr "<link=\"ALGAE\">藻類</link>"

#. STRINGS.ELEMENTS.ALUMINUM.DESC
msgctxt "STRINGS.ELEMENTS.ALUMINUM.DESC"
msgid "(Al) Aluminum is a low density <link=\"REFINEDMETAL\">Metal</link>.\n\nIt has high Thermal Conductivity and is suitable for building <link=\"POWER\">Power</link> systems."
msgstr "(Al) 鋁是一種低密度的<link=\"REFINEDMETAL\">金屬</link>。\n\n它的導熱係數高，適合用來建造<link=\"POWER\">電力</link>系統。"

#. STRINGS.ELEMENTS.ALUMINUM.NAME
msgctxt "STRINGS.ELEMENTS.ALUMINUM.NAME"
msgid "<link=\"ALUMINUM\">Aluminum</link>"
msgstr "<link=\"ALUMINUM\">鋁</link>"

#. STRINGS.ELEMENTS.ALUMINUMGAS.DESC
msgctxt "STRINGS.ELEMENTS.ALUMINUMGAS.DESC"
msgid "(Al) Aluminum Gas is a low density <link=\"REFINEDMETAL\">Metal</link> heated into a <link=\"ELEMENTSGAS\">Gaseous</link> state."
msgstr "(Al) 鋁是一種被加熱到<link=\"ELEMENTSGAS\">氣體</link>狀態的低密度<link=\"REFINEDMETAL\">金屬</link>。"

#. STRINGS.ELEMENTS.ALUMINUMGAS.NAME
msgctxt "STRINGS.ELEMENTS.ALUMINUMGAS.NAME"
msgid "<link=\"ALUMINUMGAS\">Aluminum Gas</link>"
msgstr "<link=\"ALUMINUMGAS\">鋁</link>"

#. STRINGS.ELEMENTS.ALUMINUMORE.DESC
msgctxt "STRINGS.ELEMENTS.ALUMINUMORE.DESC"
msgid "Aluminum ore, also known as Bauxite, is a sedimentary rock high in metal content.\n\nIt can be refined into <link=\"ALUMINUM\">Aluminum</link>."
msgstr "鋁礦，也稱為鋁土礦，是一種金屬含量高的沉積岩。\n\n可以精煉成<link=\"ALUMINUM\">鋁</link>。"

#. STRINGS.ELEMENTS.ALUMINUMORE.NAME
msgctxt "STRINGS.ELEMENTS.ALUMINUMORE.NAME"
msgid "<link=\"ALUMINUMORE\">Aluminum Ore</link>"
msgstr "<link=\"ALUMINUMORE\">鋁礦</link>"

#. STRINGS.ELEMENTS.AMBER.DESC
msgctxt "STRINGS.ELEMENTS.AMBER.DESC"
msgid "Amber is a <link=\"ELEMENTSSOLID\">Solid</link> organic composite of <link=\"NATURALRESIN\">Resin</link> and <link=\"FOSSIL\">Fossil</link>."
msgstr "琥珀是一種由<link=\"NATURALRESIN\">樹脂</link>和<link=\"FOSSIL\">化石</link>組成的<link=\"ELEMENTSSOLID\">固體</link>有機物。"

#. STRINGS.ELEMENTS.AMBER.NAME
msgctxt "STRINGS.ELEMENTS.AMBER.NAME"
msgid "<link=\"AMBER\">Amber</link>"
msgstr "<link=\"AMBER\">琥珀</link>"

#. STRINGS.ELEMENTS.BASALT.DESC
msgctxt "STRINGS.ELEMENTS.BASALT.DESC"
msgid "Basalt is a natural volcanic rock that forms when <link=\"MAGMA\">Magma</link> cools rapidly."
msgstr "玄武岩是一種天然火山岩，在<link=\"MAGMA\">岩漿</link>快速冷卻時形成。"

#. STRINGS.ELEMENTS.BASALT.NAME
msgctxt "STRINGS.ELEMENTS.BASALT.NAME"
msgid "<link=\"BASALT\">Basalt</link>"
msgstr "<link=\"BASALT\">玄武岩</link>"

#. STRINGS.ELEMENTS.BITUMEN.DESC
msgctxt "STRINGS.ELEMENTS.BITUMEN.DESC"
msgid "Bitumen is a sticky viscous residue left behind from <link=\"PETROLEUM\">Petroleum</link> production."
msgstr "瀝青是<link=\"PETROLEUM\">石油</link>生產過程所殘留的黏性物質。"

#. STRINGS.ELEMENTS.BITUMEN.NAME
msgctxt "STRINGS.ELEMENTS.BITUMEN.NAME"
msgid "<link=\"BITUMEN\">Bitumen</link>"
msgstr "<link=\"BITUMEN\">瀝青</link>"

#. STRINGS.ELEMENTS.BLEACHSTONE.DESC
msgctxt "STRINGS.ELEMENTS.BLEACHSTONE.DESC"
msgid "Bleach stone is an unstable compound that emits unbreathable <link=\"CHLORINEGAS\">Chlorine Gas</link>.\n\nIt is often used in <link=\"HANDSANITIZER\">Hygienic</link> processes."
msgstr "漂白石是一種不穩定的化合物，會釋放不能呼吸的<link=\"CHLORINEGAS\">氯氣</link>。\n\n它常被用於<link=\"HANDSANITIZER\">衛生</link>處理過程。"

#. STRINGS.ELEMENTS.BLEACHSTONE.NAME
msgctxt "STRINGS.ELEMENTS.BLEACHSTONE.NAME"
msgid "<link=\"BLEACHSTONE\">Bleach Stone</link>"
msgstr "<link=\"BLEACHSTONE\">漂白石</link>"

#. STRINGS.ELEMENTS.BOTTLEDWATER.DESC
msgctxt "STRINGS.ELEMENTS.BOTTLEDWATER.DESC"
msgid "(H<sub>2</sub>O) Clean <link=\"WATER\">Water</link>, prepped for transport."
msgstr "(H<sub>2</sub>O) 乾淨的<link=\"WATER\">水</link>，準備運送。"

#. STRINGS.ELEMENTS.BOTTLEDWATER.NAME
msgctxt "STRINGS.ELEMENTS.BOTTLEDWATER.NAME"
msgid "<link=\"BOTTLEDWATER\">Water</link>"
msgstr "<link=\"BOTTLEDWATER\">水</link>"

#. STRINGS.ELEMENTS.BREATHABLEDESC
msgctxt "STRINGS.ELEMENTS.BREATHABLEDESC"
msgid "<color=#{0}>({1})</color>"
msgstr "<color=#{0}>({1})</color>"

#. STRINGS.ELEMENTS.BRICK.DESC
msgctxt "STRINGS.ELEMENTS.BRICK.DESC"
msgid "Brick is a hard, brittle material formed from heated <link=\"CLAY\">Clay</link>.\n\nIt is a reliable <b>Construction Material</b>."
msgstr "黏土磚是一種堅硬且易碎的材料，由加熱後的<link=\"CLAY\">黏土</link>燒製而成。\n它是一種可靠的<b>建築材料</b>。"

#. STRINGS.ELEMENTS.BRICK.NAME
msgctxt "STRINGS.ELEMENTS.BRICK.NAME"
msgid "<link=\"BRICK\">Brick</link>"
msgstr "<link=\"BRICK\">黏土磚</link>"

#. STRINGS.ELEMENTS.BRINE.DESC
msgctxt "STRINGS.ELEMENTS.BRINE.DESC"
msgid "Brine is a natural, highly concentrated solution of <link=\"SALT\">Salt</link> dissolved in <link=\"WATER\">Water</link>.\n\nIt can be used in desalination processes, separating out usable salt."
msgstr "濃鹽水是一種天然、高濃度的<link=\"SALT\">鹽</link>溶於<link=\"WATER\">水</link>中。\n\n可用於鹽水淡化過程，分離出可用的鹽。"

#. STRINGS.ELEMENTS.BRINE.NAME
msgctxt "STRINGS.ELEMENTS.BRINE.NAME"
msgid "<link=\"BRINE\">Brine</link>"
msgstr "<link=\"BRINE\">濃鹽水</link>"

#. STRINGS.ELEMENTS.BRINEICE.DESC
msgctxt "STRINGS.ELEMENTS.BRINEICE.DESC"
msgid "Brine Ice is a natural, highly concentrated solution of <link=\"SALT\">Salt</link> dissolved in <link=\"WATER\">Water</link> and frozen into a <link=\"ELEMENTSSOLID\">Solid</link> state.\n\nIt can be used in desalination processes, separating out usable salt."
msgstr "濃鹽水冰是一種天然且高濃度的<link=\"SALT\">鹽</link>溶於<link=\"WATER\">水</link>中，並凍結成<link=\"ELEMENTSSOLID\">固體</link>的狀態。\n\n它可用於淡化處理，以分離出可用的鹽。"

#. STRINGS.ELEMENTS.BRINEICE.NAME
msgctxt "STRINGS.ELEMENTS.BRINEICE.NAME"
msgid "<link=\"BRINEICE\">Brine Ice</link>"
msgstr "<link=\"BRINEICE\">濃鹽水冰</link>"

#. STRINGS.ELEMENTS.CARBON.DESC
msgctxt "STRINGS.ELEMENTS.CARBON.DESC"
msgid "(C) Coal is a combustible fossil fuel composed of carbon.\n\nIt is useful in <link=\"POWER\">Power</link> production."
msgstr "煤炭是一種由炭組成可燃燒的化石燃料。\n\n它對生產<link=\"POWER\">電力</link>有幫助。"

#. STRINGS.ELEMENTS.CARBON.NAME
msgctxt "STRINGS.ELEMENTS.CARBON.NAME"
msgid "<link=\"CARBON\">Coal</link>"
msgstr "<link=\"CARBON\">煤炭</link>"

#. STRINGS.ELEMENTS.CARBONDIOXIDE.DESC
msgctxt "STRINGS.ELEMENTS.CARBONDIOXIDE.DESC"
msgid "(CO<sub>2</sub>) Carbon Dioxide is an atomically heavy chemical compound in a <link=\"ELEMENTSGAS\">Gaseous</link> state.\n\nIt tends to sink below other gases."
msgstr "(CO<sub>2</sub>) 二氧化碳是一種原子量重的化合物，處於<link=\"ELEMENTSGAS\">氣體</link>狀態。\n\n它通常比其它種類的氣體重。"

#. STRINGS.ELEMENTS.CARBONDIOXIDE.NAME
msgctxt "STRINGS.ELEMENTS.CARBONDIOXIDE.NAME"
msgid "<link=\"CARBONDIOXIDE\">Carbon Dioxide</link>"
msgstr "<link=\"CARBONDIOXIDE\">二氧化碳</link>"

#. STRINGS.ELEMENTS.CARBONFIBRE.DESC
msgctxt "STRINGS.ELEMENTS.CARBONFIBRE.DESC"
msgid "Carbon Fiber is a <link=\"REFINEDMINERAL\">Manufactured Material</link> with high tensile strength."
msgstr "碳纖維是一種擁有高強度的<link=\"REFINEDMINERAL\">加工材料</link>。"

#. STRINGS.ELEMENTS.CARBONFIBRE.NAME
msgctxt "STRINGS.ELEMENTS.CARBONFIBRE.NAME"
msgid "<link=\"CARBONFIBRE\">Carbon Fiber</link>"
msgstr "<link=\"CARBONFIBRE\">碳纖維</link>"

#. STRINGS.ELEMENTS.CARBONGAS.DESC
msgctxt "STRINGS.ELEMENTS.CARBONGAS.DESC"
msgid "(C) Carbon is an abundant, versatile element heated into a <link=\"ELEMENTSGAS\">Gaseous</link> state."
msgstr "(C) 碳是一種豐富多功能的元素，被加熱到<link=\"ELEMENTSGAS\">氣體</link>狀態。"

#. STRINGS.ELEMENTS.CARBONGAS.NAME
msgctxt "STRINGS.ELEMENTS.CARBONGAS.NAME"
msgid "<link=\"CARBONGAS\">Carbon Gas</link>"
msgstr "<link=\"CARBONGAS\">碳</link>"

#. STRINGS.ELEMENTS.CEMENT.DESC
msgctxt "STRINGS.ELEMENTS.CEMENT.DESC"
msgid "Cement is a refined building material used for assembling advanced buildings."
msgstr "水泥是一種精煉過的建築材料，被用來建造高級建築物。"

#. STRINGS.ELEMENTS.CEMENT.NAME
msgctxt "STRINGS.ELEMENTS.CEMENT.NAME"
msgid "<link=\"CEMENT\">Cement</link>"
msgstr "<link=\"CEMENT\">水泥</link>"

#. STRINGS.ELEMENTS.CEMENTMIX.DESC
msgctxt "STRINGS.ELEMENTS.CEMENTMIX.DESC"
msgid "Cement Mix can be used to create <link=\"CEMENT\">Cement</link> for advanced building assembly."
msgstr "水泥混合料可被用來製作<link=\"CEMENT\">水泥</link>建造高級建築物。"

#. STRINGS.ELEMENTS.CEMENTMIX.NAME
msgctxt "STRINGS.ELEMENTS.CEMENTMIX.NAME"
msgid "<link=\"CEMENTMIX\">Cement Mix</link>"
msgstr "<link=\"CEMENTMIX\">水泥混合料</link>"

#. STRINGS.ELEMENTS.CERAMIC.DESC
msgctxt "STRINGS.ELEMENTS.CERAMIC.DESC"
msgid "Ceramic is a hard, brittle material formed from heated <link=\"CLAY\">Clay</link>.\n\nIt is a reliable <b>Construction Material</b>."
msgstr "陶瓷是一種堅硬的、易碎的的材料，由<link=\"CLAY\">黏土</link>燒製而成。\n\n它是一種可靠的<b>建築材料</b>。"

#. STRINGS.ELEMENTS.CERAMIC.NAME
msgctxt "STRINGS.ELEMENTS.CERAMIC.NAME"
msgid "<link=\"CERAMIC\">Ceramic</link>"
msgstr "<link=\"CERAMIC\">陶瓷</link>"

#. STRINGS.ELEMENTS.CHLORINE.DESC
msgctxt "STRINGS.ELEMENTS.CHLORINE.DESC"
msgid "(Cl) Chlorine is a natural <link=\"DISEASE\">Germ</link>-killing element in a <link=\"ELEMENTSLIQUID\">Liquid</link> state."
msgstr "(Cl) 氯是一種天然的<link=\"DISEASE\">殺菌</link>元素，處於<link=\"ELEMENTSLIQUID\">液體</link>狀態。"

#. STRINGS.ELEMENTS.CHLORINE.NAME
msgctxt "STRINGS.ELEMENTS.CHLORINE.NAME"
msgid "<link=\"CHLORINE\">Liquid Chlorine</link>"
msgstr "<link=\"CHLORINE\">氯</link>"

#. STRINGS.ELEMENTS.CHLORINEGAS.DESC
msgctxt "STRINGS.ELEMENTS.CHLORINEGAS.DESC"
msgid "(Cl) Chlorine is a natural <link=\"DISEASE\">Germ</link>-killing element in a <link=\"ELEMENTSGAS\">Gaseous</link> state."
msgstr "(Cl) 氯是一種天然的<link=\"DISEASE\">殺菌</link>元素，處於<link=\"ELEMENTSGAS\">氣體</link>狀態。"

#. STRINGS.ELEMENTS.CHLORINEGAS.NAME
msgctxt "STRINGS.ELEMENTS.CHLORINEGAS.NAME"
msgid "<link=\"CHLORINEGAS\">Chlorine Gas</link>"
msgstr "<link=\"CHLORINEGAS\">氯</link>"

#. STRINGS.ELEMENTS.CINNABAR.DESC
msgctxt "STRINGS.ELEMENTS.CINNABAR.DESC"
msgid "(HgS) Cinnabar Ore, also known as mercury sulfide, is a conductive <link=\"METAL\">Metal</link> that can be refined into <link=\"MERCURY\">Mercury</link>.\n\nIt is suitable for building <link=\"POWER\">Power</link> systems."
msgstr "(HgS) 辰砂，也稱為硫化汞，是一種導電<link=\"METAL\">金屬</link>，可以精煉為<link=\"MERCURY\">汞</link>。\n\n它適合用來建造<link=\"POWER\">電力</link>系統。"

#. STRINGS.ELEMENTS.CINNABAR.NAME
msgctxt "STRINGS.ELEMENTS.CINNABAR.NAME"
msgid "<link=\"CINNABAR\">Cinnabar Ore</link>"
msgstr "<link=\"CINNABAR\">辰砂</link>"

#. STRINGS.ELEMENTS.CLAY.DESC
msgctxt "STRINGS.ELEMENTS.CLAY.DESC"
msgid "Clay is a soft, naturally occurring composite of stone and soil that hardens at high <link=\"HEAT\">Temperatures</link>.\n\nIt is a reliable <b>Construction Material</b>."
msgstr "黏土是一種柔軟，天然的混合物，存在於石頭和土壤之間，在<link=\"HEAT\">高溫</link>下會變硬。\n\n它是一種可靠的<b>建築材料</b>。"

#. STRINGS.ELEMENTS.CLAY.NAME
msgctxt "STRINGS.ELEMENTS.CLAY.NAME"
msgid "<link=\"CLAY\">Clay</link>"
msgstr "<link=\"CLAY\">黏土</link>"

#. STRINGS.ELEMENTS.COBALT.DESC
msgctxt "STRINGS.ELEMENTS.COBALT.DESC"
msgid "(Co) Cobalt is a <link=\"REFINEDMETAL\">Refined Metal</link> made from <link=\"COBALTITE\">Cobalt Ore</link>."
msgstr "(Co) 鈷是一種由<link=\"COBALTITE\">鈷礦</link>精煉而成的<link=\"REFINEDMETAL\">精煉金屬</link>。"

#. STRINGS.ELEMENTS.COBALT.NAME
msgctxt "STRINGS.ELEMENTS.COBALT.NAME"
msgid "<link=\"COBALT\">Cobalt</link>"
msgstr "<link=\"COBALT\">鈷</link>"

#. STRINGS.ELEMENTS.COBALTGAS.DESC
msgctxt "STRINGS.ELEMENTS.COBALTGAS.DESC"
msgid "(Co) Cobalt is a <link=\"REFINEDMETAL\">Refined Metal</link>, heated into a <link=\"ELEMENTSGAS\">Gas</link>."
msgstr "(Co) 氣態鈷是一種<link=\"REFINEDMETAL\">精煉金屬</link>，被加熱到<link=\"ELEMENTSGAS\">氣體</link>狀態。"

#. STRINGS.ELEMENTS.COBALTGAS.NAME
msgctxt "STRINGS.ELEMENTS.COBALTGAS.NAME"
msgid "<link=\"COBALTGAS\">Cobalt Gas</link>"
msgstr "<link=\"COBALTGAS\">鈷</link>"

#. STRINGS.ELEMENTS.COBALTITE.DESC
msgctxt "STRINGS.ELEMENTS.COBALTITE.DESC"
msgid "(Co) Cobalt Ore is a blue-hued <link=\"BUILDINGMATERIALCLASSES\">Metal</link>.\n\nIt is suitable for building <link=\"POWER\">Power</link> systems."
msgstr "(Co) 鈷礦是一種藍色的<link=\"BUILDINGMATERIALCLASSES\">金屬</link>。\n\n它適合用來建造<link=\"POWER\">電力</link>系統。"

#. STRINGS.ELEMENTS.COBALTITE.NAME
msgctxt "STRINGS.ELEMENTS.COBALTITE.NAME"
msgid "<link=\"COBALTITE\">Cobalt Ore</link>"
msgstr "<link=\"COBALTITE\">鈷礦</link>"

#. STRINGS.ELEMENTS.COMPOSITION.DESC
msgctxt "STRINGS.ELEMENTS.COMPOSITION.DESC"
msgid "A mixture of two or more elements."
msgstr "混合兩種或更多的元素。"

#. STRINGS.ELEMENTS.COMPOSITION.NAME
msgctxt "STRINGS.ELEMENTS.COMPOSITION.NAME"
msgid "<link=\"COMPOSITION\">Composition</link>"
msgstr "<link=\"COMPOSITION\">組合物</link>"

#. STRINGS.ELEMENTS.CONTAMINATEDOXYGEN.DESC
msgctxt "STRINGS.ELEMENTS.CONTAMINATEDOXYGEN.DESC"
msgid "(O<sub>2</sub>) Polluted Oxygen is dirty, unfiltered air.\n\nIt is breathable."
msgstr "(O<sub>2</sub>) 汙氧是骯髒、未過濾的空氣。\n\n它可以呼吸。"

#. STRINGS.ELEMENTS.CONTAMINATEDOXYGEN.NAME
msgctxt "STRINGS.ELEMENTS.CONTAMINATEDOXYGEN.NAME"
msgid "<link=\"CONTAMINATEDOXYGEN\">Polluted Oxygen</link>"
msgstr "<link=\"CONTAMINATEDOXYGEN\">汙氧</link>"

#. STRINGS.ELEMENTS.COPPER.DESC
msgctxt "STRINGS.ELEMENTS.COPPER.DESC"
msgid "(Cu) Copper is a conductive <link=\"METAL\">Metal</link>.\n\nIt is suitable for building <link=\"POWER\">Power</link> systems."
msgstr "(Cu) 銅是一種導電的<link=\"METAL\">金屬</link>。\n\n它適合用來建造<link=\"POWER\">電力</link>系統。"

#. STRINGS.ELEMENTS.COPPER.NAME
msgctxt "STRINGS.ELEMENTS.COPPER.NAME"
msgid "<link=\"COPPER\">Copper</link>"
msgstr "<link=\"COPPER\">銅</link>"

#. STRINGS.ELEMENTS.COPPERGAS.DESC
msgctxt "STRINGS.ELEMENTS.COPPERGAS.DESC"
msgid "(Cu) Copper Gas is a conductive <link=\"METAL\">Metal</link> heated into a <link=\"ELEMENTSGAS\">Gas</link> state."
msgstr "(Cu) 銅是一種導電的 <link=\"METAL\">金屬</link>被加熱到<link=\"ELEMENTSGAS\">氣體</link>狀態。"

#. STRINGS.ELEMENTS.COPPERGAS.NAME
msgctxt "STRINGS.ELEMENTS.COPPERGAS.NAME"
msgid "<link=\"COPPERGAS\">Copper Gas</link>"
msgstr "<link=\"COPPERGAS\">銅</link>"

#. STRINGS.ELEMENTS.COQUINA.DESC
msgctxt "STRINGS.ELEMENTS.COQUINA.DESC"
msgid "Coquina is a brittle <link=\"ELEMENTSSOLID\">Solid</link> mineral made up of the calcified remains of aquatic invertebrates.\n\nIt is useful as a <b>Construction Material</b>."
msgstr "殼灰岩是一種脆性<link=\"ELEMENTSSOLID\">固體</link>礦物，由水生無脊椎動物的鈣化殘骸組成。\n\n適合作為<b>建造材料</b>使用。"

#. STRINGS.ELEMENTS.COQUINA.NAME
msgctxt "STRINGS.ELEMENTS.COQUINA.NAME"
msgid "<link=\"COQUINA\">Coquina</link>"
msgstr "<link=\"COQUINA\">殼灰岩</link>"

#. STRINGS.ELEMENTS.CORALLIUM.DESC
msgctxt "STRINGS.ELEMENTS.CORALLIUM.DESC"
msgid "Corallium is a dense coral primarily composed of (CaCO<sub>3</sub>) <link=\"LIME\">Lime</link>.\n\nIt is useful as a <b>Construction Material</b>."
msgstr "紅珊瑚是一種緻密的珊瑚，主要成分為 (CaCO<sub>3</sub>) <link=\"LIME\">石灰</link>。\n\n適合作為<b>建造材料</b>使用。"

#. STRINGS.ELEMENTS.CORALLIUM.NAME
msgctxt "STRINGS.ELEMENTS.CORALLIUM.NAME"
msgid "<link=\"CORALLIUM\">Corallium</link>"
msgstr "<link=\"CORALLIUM\">紅珊瑚</link>"

#. STRINGS.ELEMENTS.CORIUM.DESC
msgctxt "STRINGS.ELEMENTS.CORIUM.DESC"
msgid "A radioactive mixture of nuclear waste and melted reactor materials.\n\nReleases <link=\"FALLOUT\">Nuclear Fallout</link> gas."
msgstr "核廢料與熔毀的反應爐材料所形成的混合物\n\n釋放<link=\"FALLOUT\">核輻射</link>氣體。"

#. STRINGS.ELEMENTS.CORIUM.NAME
msgctxt "STRINGS.ELEMENTS.CORIUM.NAME"
msgid "<link=\"CORIUM\">Corium</link>"
msgstr "<link=\"CORIUM\">爐心熔融物</link>"

#. STRINGS.ELEMENTS.CREATURE.DESC
msgctxt "STRINGS.ELEMENTS.CREATURE.DESC"
msgid "(DuPe) Ooze is a slurry of water, carbon, and dozens and dozens of trace elements.\n\nDuplicants are printed from pure Ooze."
msgstr "(DuPe) 基因軟泥是由水、碳及數十種以上的微量元素組成的濃稠混合物。\n複製人是使用純淨的基因軟泥列印出來。"

#. STRINGS.ELEMENTS.CREATURE.NAME
msgctxt "STRINGS.ELEMENTS.CREATURE.NAME"
msgid "<link=\"CREATURE\">Genetic Ooze</link>"
msgstr "<link=\"CREATURE\">基因軟泥</link>"

#. STRINGS.ELEMENTS.CRUDEOIL.DESC
msgctxt "STRINGS.ELEMENTS.CRUDEOIL.DESC"
msgid "Crude Oil is a raw potential <link=\"POWER\">Power</link> source composed of billions of dead, primordial organisms.\n\nIt is also a useful lubricant for certain types of machinery."
msgstr "原油是一種<link=\"POWER\">發電</link>資源，由數十億死亡的原始有機物構成。\n\n它也是某些類型機械的有用潤滑劑。"

#. STRINGS.ELEMENTS.CRUDEOIL.NAME
msgctxt "STRINGS.ELEMENTS.CRUDEOIL.NAME"
msgid "<link=\"CRUDEOIL\">Crude Oil</link>"
msgstr "<link=\"CRUDEOIL\">原油</link>"

#. STRINGS.ELEMENTS.CRUSHEDICE.DESC
msgctxt "STRINGS.ELEMENTS.CRUSHEDICE.DESC"
msgid "(H<sub>2</sub>O) A slush of crushed, semi-solid ice."
msgstr "(H<sub>2</sub>O) 碎成一片，半固體狀的冰。"

#. STRINGS.ELEMENTS.CRUSHEDICE.NAME
msgctxt "STRINGS.ELEMENTS.CRUSHEDICE.NAME"
msgid "<link=\"CRUSHEDICE\">Crushed Ice</link>"
msgstr "<link=\"CRUSHEDICE\">碎冰</link>"

#. STRINGS.ELEMENTS.CRUSHEDROCK.DESC
msgctxt "STRINGS.ELEMENTS.CRUSHEDROCK.DESC"
msgid "Crushed Rock is <link=\"IGNEOUSROCK\">Igneous Rock</link> crushed into a mechanical mixture."
msgstr "碎石是<link=\"IGNEOUSROCK\">火成岩</link>粉碎成一種細小的混合物。"

#. STRINGS.ELEMENTS.CRUSHEDROCK.NAME
msgctxt "STRINGS.ELEMENTS.CRUSHEDROCK.NAME"
msgid "<link=\"CRUSHEDROCK\">Crushed Rock</link>"
msgstr "<link=\"CRUSHEDROCK\">碎石</link>"

#. STRINGS.ELEMENTS.CUPRITE.DESC
msgctxt "STRINGS.ELEMENTS.CUPRITE.DESC"
msgid "(Cu<sub>2</sub>O) Copper Ore is a conductive <link=\"METAL\">Metal</link>.\n\nIt is suitable for building <link=\"POWER\">Power</link> systems."
msgstr "(Cu<sub>2</sub>O) 銅礦是一種導電的<link=\"METAL\">金屬</link>。\n\n它適合用來建造<link=\"POWER\">電力</link>系統。"

#. STRINGS.ELEMENTS.CUPRITE.NAME
msgctxt "STRINGS.ELEMENTS.CUPRITE.NAME"
msgid "<link=\"CUPRITE\">Copper Ore</link>"
msgstr "<link=\"CUPRITE\">銅礦</link>"

#. STRINGS.ELEMENTS.DEPLETEDURANIUM.DESC
msgctxt "STRINGS.ELEMENTS.DEPLETEDURANIUM.DESC"
msgid "(U) Depleted Uranium is <link=\"URANIUMORE\">Uranium</link> with a low U-235 content.\n\nIt is created as a byproduct of <link=\"ENRICHEDURANIUM\">Enriched Uranium</link> and is no longer suitable as fuel."
msgstr "(U) 貧鈾是 U-235 含量低的<link=\"URANIUM\">鈾</link>。\n\n它是生產<link=\"ENRICHEDURANIUM\">濃縮鈾</link>的副產品且不適合再作為燃料。"

#. STRINGS.ELEMENTS.DEPLETEDURANIUM.NAME
msgctxt "STRINGS.ELEMENTS.DEPLETEDURANIUM.NAME"
msgid "<link=\"DEPLETEDURANIUM\">Depleted Uranium</link>"
msgstr "<link=\"DEPLETEDURANIUM\">貧鈾</link>"

#. STRINGS.ELEMENTS.DIAMOND.DESC
msgctxt "STRINGS.ELEMENTS.DIAMOND.DESC"
msgid "(C) Diamond is industrial-grade, high density carbon.\n\nIt is very difficult to excavate."
msgstr "(C) 鑽石是工業級高密度的碳。\n\n它很難挖掘。"

#. STRINGS.ELEMENTS.DIAMOND.NAME
msgctxt "STRINGS.ELEMENTS.DIAMOND.NAME"
msgid "<link=\"DIAMOND\">Diamond</link>"
msgstr "<link=\"DIAMOND\">鑽石</link>"

#. STRINGS.ELEMENTS.DIRT.DESC
msgctxt "STRINGS.ELEMENTS.DIRT.DESC"
msgid "Dirt is a soft, nutrient-rich substance capable of supporting life.\n\nIt is necessary in some forms of <link=\"FOOD\">Food</link> production."
msgstr "泥土是一種柔軟、營養豐富的物質，可以維持生命。\n\n在生產某些<link=\"FOOD\">食物</link>的形式中，是必要的材料。"

#. STRINGS.ELEMENTS.DIRT.NAME
msgctxt "STRINGS.ELEMENTS.DIRT.NAME"
msgid "<link=\"DIRT\">Dirt</link>"
msgstr "<link=\"DIRT\">泥土</link>"

#. STRINGS.ELEMENTS.DIRTYICE.DESC
msgctxt "STRINGS.ELEMENTS.DIRTYICE.DESC"
msgid "Polluted Ice is dirty, unfiltered water frozen into a <link=\"ELEMENTSSOLID\">Solid</link> state."
msgstr "汙冰是骯髒、未過濾的水，結凍成<link=\"ELEMENTSSOLID\">固體</link>的狀態。"

#. STRINGS.ELEMENTS.DIRTYICE.NAME
msgctxt "STRINGS.ELEMENTS.DIRTYICE.NAME"
msgid "<link=\"DIRTYICE\">Polluted Ice</link>"
msgstr "<link=\"DIRTYICE\">汙冰</link>"

#. STRINGS.ELEMENTS.DIRTYWATER.DESC
msgctxt "STRINGS.ELEMENTS.DIRTYWATER.DESC"
msgid "Polluted Water is dirty, unfiltered <link=\"WATER\">Water</link>.\n\nIt is not fit for consumption."
msgstr "汙水是骯髒、未過濾的<link=\"WATER\">水</link>。\n\n它不適合飲用。"

#. STRINGS.ELEMENTS.DIRTYWATER.NAME
msgctxt "STRINGS.ELEMENTS.DIRTYWATER.NAME"
msgid "<link=\"DIRTYWATER\">Polluted Water</link>"
msgstr "<link=\"DIRTYWATER\">汙水</link>"

#. STRINGS.ELEMENTS.ELECTRUM.DESC
msgctxt "STRINGS.ELEMENTS.ELECTRUM.DESC"
msgid "Electrum is a conductive <link=\"METAL\">Metal</link> alloy composed of gold and silver.\n\nIt is suitable for building <link=\"POWER\">Power</link> systems."
msgstr "琥珀金是一種導電的<link=\"METAL\">金屬</link>由金和銀組成。\n\n它適合用來建造<link=\"POWER\">電力</link>系統。"

#. STRINGS.ELEMENTS.ELECTRUM.NAME
msgctxt "STRINGS.ELEMENTS.ELECTRUM.NAME"
msgid "<link=\"ELECTRUM\">Electrum</link>"
msgstr "<link=\"ELECTRUM\">琥珀金</link>"

#. STRINGS.ELEMENTS.ELEMENTDESCGAS
msgctxt "STRINGS.ELEMENTS.ELEMENTDESCGAS"
msgid "Resource Type: {0}\nCondensation point: {1}"
msgstr "資源種類：{0}\n冷凝點：{1}"

#. STRINGS.ELEMENTS.ELEMENTDESCLIQUID
msgctxt "STRINGS.ELEMENTS.ELEMENTDESCLIQUID"
msgid "Resource Type: {0}\nFreezing point: {1}\nEvaporation point: {2}"
msgstr "資源種類：{0}\n凝固點：{1}\n蒸發點：{2}"

#. STRINGS.ELEMENTS.ELEMENTDESCSOLID
msgctxt "STRINGS.ELEMENTS.ELEMENTDESCSOLID"
msgid "Resource Type: {0}\nMelting point: {1}\nHardness: {2}"
msgstr "資源種類：{0}\n熔點：{1}\n硬度：{2}"

#. STRINGS.ELEMENTS.ELEMENTDESCVACUUM
msgctxt "STRINGS.ELEMENTS.ELEMENTDESCVACUUM"
msgid "Resource Type: {0}"
msgstr "資源種類：{0}"

#. STRINGS.ELEMENTS.ELEMENTPROPERTIES
msgctxt "STRINGS.ELEMENTS.ELEMENTPROPERTIES"
msgid "Properties: {0}"
msgstr "屬性：{0}"

#. STRINGS.ELEMENTS.ENRICHEDURANIUM.DESC
msgctxt "STRINGS.ELEMENTS.ENRICHEDURANIUM.DESC"
msgid "(U) Enriched Uranium is a refined substance primarily used to <link=\"POWER\">Power</link> potent research reactors.\n\nIt becomes highly <link=\"RADIATION\">Radioactive</link> when consumed."
msgstr "(U) 濃縮鈾是一種精煉過的物質，主要用於<link=\"POWER\">功率</link>強大的研究反應爐。\n\n使用後會產生高度<link=\"RADIATION\">放射性</link>。"

#. STRINGS.ELEMENTS.ENRICHEDURANIUM.NAME
msgctxt "STRINGS.ELEMENTS.ENRICHEDURANIUM.NAME"
msgid "<link=\"ENRICHEDURANIUM\">Enriched Uranium</link>"
msgstr "<link=\"ENRICHEDURANIUM\">濃縮鈾</link>"

#. STRINGS.ELEMENTS.ETHANOL.DESC
msgctxt "STRINGS.ELEMENTS.ETHANOL.DESC"
msgid "(C<sub>2</sub>H<sub>6</sub>O) Ethanol is an advanced chemical compound in a <link=\"ELEMENTSLIQUID\">Liquid</link> state.\n\nIt can be used as a highly effective fuel source when burned."
msgstr "(C<sub>2</sub>H<sub>6</sub>O) 乙醇是一種高級化學化合物，處於<link=\"ELEMENTSLIQUID\">液體</link>狀態。\n\n它可以用來作為一種高效率的燃料。"

#. STRINGS.ELEMENTS.ETHANOL.NAME
msgctxt "STRINGS.ELEMENTS.ETHANOL.NAME"
msgid "<link=\"ETHANOL\">Ethanol</link>"
msgstr "<link=\"ETHANOL\">乙醇</link>"

#. STRINGS.ELEMENTS.ETHANOLGAS.DESC
msgctxt "STRINGS.ELEMENTS.ETHANOLGAS.DESC"
msgid "(C<sub>2</sub>H<sub>6</sub>O) Ethanol Gas is an advanced chemical compound heated into a <link=\"ELEMENTSGAS\">Gaseous</link> state."
msgstr "(C<sub>2</sub>H<sub>6</sub>O) 乙醇是一種高級化合物，被加熱到<link=\"ELEMENTSGAS\">氣體</link>狀態。"

#. STRINGS.ELEMENTS.ETHANOLGAS.NAME
msgctxt "STRINGS.ELEMENTS.ETHANOLGAS.NAME"
msgid "<link=\"ETHANOLGAS\">Ethanol Gas</link>"
msgstr "<link=\"ETHANOL\">乙醇</link>"

#. STRINGS.ELEMENTS.FABRICATEDWOOD.DESC
msgctxt "STRINGS.ELEMENTS.FABRICATEDWOOD.DESC"
msgid "Plywood is a good source of <link=\"HEAT\">Heat</link> and <link=\"POWER\">Power</link>.\n\nIts insulation properties make it a useful <b>Construction Material</b>."
msgstr "膠合板是<link=\"HEAT\">熱能</link>和<link=\"POWER\">電力</link>的良好來源。\n\n它的隔熱特性使其成為一種有用的<b>建築材料</b>。"

#. STRINGS.ELEMENTS.FABRICATEDWOOD.NAME
msgctxt "STRINGS.ELEMENTS.FABRICATEDWOOD.NAME"
msgid "<link=\"FABRICATEDWOOD\">Plywood</link>"
msgstr "<link=\"FABRICATEDWOOD\">膠合板</link>"

#. STRINGS.ELEMENTS.FALLOUT.DESC
msgctxt "STRINGS.ELEMENTS.FALLOUT.DESC"
msgid "Nuclear Fallout is a highly toxic gas full of <link=\"RADIATION\">Radioactive Contaminants</link>. Condenses into <link=\"NUCLEARWASTE\">Liquid Nuclear Waste</link>."
msgstr "核輻射是一種充滿<link=\"RADIATION\">輻射汙染</link>的劇毒氣體。可以凝結成<link=\"NUCLEARREACTOR\">核廢料</link>。"

#. STRINGS.ELEMENTS.FALLOUT.NAME
msgctxt "STRINGS.ELEMENTS.FALLOUT.NAME"
msgid "<link=\"FALLOUT\">Nuclear Fallout</link>"
msgstr "<link=\"FALLOUT\">核輻射</link>"

#. STRINGS.ELEMENTS.FERTILIZER.DESC
msgctxt "STRINGS.ELEMENTS.FERTILIZER.DESC"
msgid "Fertilizer is a processed mixture of biological nutrients.\n\nIt aids in the growth of certain <link=\"PLANTS\">Plants</link>."
msgstr "肥料是一種加工過的生物養分混合物。\n\n它被用來幫助<link=\"PLANTS\">植物</link>生長。"

#. STRINGS.ELEMENTS.FERTILIZER.NAME
msgctxt "STRINGS.ELEMENTS.FERTILIZER.NAME"
msgid "<link=\"FERTILIZER\">Fertilizer</link>"
msgstr "<link=\"FERTILIZER\">肥料</link>"

#. STRINGS.ELEMENTS.FISHMILK.DESC
msgctxt "STRINGS.ELEMENTS.FISHMILK.DESC"
msgid "Ovolene is a protein-rich <link=\"ELEMENTSLIQUID\">Liquid</link> produced by aquatic critters.\n\nIt can be processed into <link=\"CAVIAR\">Caviar</link> and <link=\"MUCUS\">Mucin</link>."
msgstr "卵漿是一種由水生動物產生的富含蛋白質<link=\"ELEMENTSLIQUID\">液體</link>。\n\n它可加工成<link=\"CAVIAR\">魚子醬</link>與<link=\"MUCUS\">黏蛋白</link>。"

#. STRINGS.ELEMENTS.FISHMILK.NAME
msgctxt "STRINGS.ELEMENTS.FISHMILK.NAME"
msgid "<link=\"FISHMILK\">Ovolene</link>"
msgstr "<link=\"FISHMILK\">卵漿</link>"

#. STRINGS.ELEMENTS.FISHMILKICE.DESC
msgctxt "STRINGS.ELEMENTS.FISHMILKICE.DESC"
msgid "Frozen Ovolene is <link=\"FISHMILK\">Ovolene</link> frozen into a <link=\"ELEMENTSSOLID\">Solid</link> state."
msgstr "凝凍卵漿是一種凍結成<link=\"ELEMENTSSOLID\">固態</link>的<link=\"FISHMILK\">卵漿</link>。"

#. STRINGS.ELEMENTS.FISHMILKICE.NAME
msgctxt "STRINGS.ELEMENTS.FISHMILKICE.NAME"
msgid "<link=\"FISHMILKICE\">Frozen Ovolene</link>"
msgstr "<link=\"FISHMILKICE\">凝凍卵漿</link>"

#. STRINGS.ELEMENTS.FOOLSGOLD.DESC
msgctxt "STRINGS.ELEMENTS.FOOLSGOLD.DESC"
msgid "(FeS<sub>2</sub>) Pyrite is a conductive <link=\"METAL\">Metal</link>.\n\nAlso known as \"Fool's Gold\", is suitable for building <link=\"POWER\">Power</link> systems."
msgstr "(FeS<sub>2</sub>) 黃鐵礦是一種導電的<link=\"METAL\">金屬</link>。\n\n也被稱作「愚人金」，可用來建造<link=\"POWER\">電力</link>系統。"

#. STRINGS.ELEMENTS.FOOLSGOLD.NAME
msgctxt "STRINGS.ELEMENTS.FOOLSGOLD.NAME"
msgid "<link=\"FOOLSGOLD\">Pyrite</link>"
msgstr "<link=\"FOOLSGOLD\">黃鐵礦</link>"

#. STRINGS.ELEMENTS.FOSSIL.DESC
msgctxt "STRINGS.ELEMENTS.FOSSIL.DESC"
msgid "Fossil is organic matter, highly compressed and hardened into a mineral state.\n\nIt is useful as a <b>Construction Material</b>."
msgstr "化石是有機物，經過高壓與硬化變成礦物狀態。\n\n它可作為有用的<b>建築材料</b>。"

#. STRINGS.ELEMENTS.FOSSIL.NAME
msgctxt "STRINGS.ELEMENTS.FOSSIL.NAME"
msgid "<link=\"FOSSIL\">Fossil</link>"
msgstr "<link=\"FOSSIL\">化石</link>"

#. STRINGS.ELEMENTS.FROZENINK.DESC
msgctxt "STRINGS.ELEMENTS.FROZENINK.DESC"
msgid "Frozen Ink is <link=\"INK\">Squid Ink</link> cooled to a <link=\"ELEMENTSSOLID\">Solid</link> state."
msgstr "凝凍墨魚汁是一種凍結成<link=\"ELEMENTSSOLID\">固態</link>的<link=\"INK\">墨魚汁</link>。"

#. STRINGS.ELEMENTS.FROZENINK.NAME
msgctxt "STRINGS.ELEMENTS.FROZENINK.NAME"
msgid "<link=\"FROZENINK\">Frozen Squid Ink</link>"
msgstr "<link=\"FROZENINK\">凝凍墨魚汁</link>"

#. STRINGS.ELEMENTS.FROZENPHYTOOIL.DESC
msgctxt "STRINGS.ELEMENTS.FROZENPHYTOOIL.DESC"
msgid "Frozen Phyto Oil is thick, slippery <link=\"SLIME\">Slime</link> extract, frozen into a <link=\"ELEMENTSSOLID\">Solid</link> state."
msgstr "冷凍植物油是一種濃厚滑溜的<link=\"SLIME\">軟泥</link>提取物，凍結成<link=\"ELEMENTSSOLID\">固體</link>狀態。"

#. STRINGS.ELEMENTS.FROZENPHYTOOIL.NAME
msgctxt "STRINGS.ELEMENTS.FROZENPHYTOOIL.NAME"
msgid "<link=\"FROZENPHYTOOIL\">Frozen Phyto Oil</link>"
msgstr "<link=\"FROZENPHYTOOIL\">植物油</link>"

#. STRINGS.ELEMENTS.FULLERENE.DESC
msgctxt "STRINGS.ELEMENTS.FULLERENE.DESC"
msgid "(C<sub>60</sub>) Fullerene is a form of <link=\"CARBON\">Coal</link> consisting of spherical molecules."
msgstr "(C<sub>60</sub>) 富勒烯是一種完全由<link=\"CARBON\">碳</link>組成的球狀分子。"

#. STRINGS.ELEMENTS.FULLERENE.NAME
msgctxt "STRINGS.ELEMENTS.FULLERENE.NAME"
msgid "<link=\"FULLERENE\">Fullerene</link>"
msgstr "<link=\"FULLERENE\">富勒烯</link>"

#. STRINGS.ELEMENTS.GALENA.DESC
msgctxt "STRINGS.ELEMENTS.GALENA.DESC"
msgid "(PbS) Galena is a raw <link=\"METAL\">Metal Ore</link> primarily composed of <link=\"LEAD\">Lead</link> with <link=\"SULFUR\">Sulfur</link> impurities."
msgstr "(PbS) 方鉛礦是一種原礦，屬於<link=\"METAL\">金屬礦石</link>，主要成分為<link=\"LEAD\">鉛</link>，並含有<link=\"SULFUR\">硫</link>雜質。"

#. STRINGS.ELEMENTS.GALENA.NAME
msgctxt "STRINGS.ELEMENTS.GALENA.NAME"
msgid "<link=\"GALENA\">Galena</link>"
msgstr "<link=\"GALENA\">方鉛礦</link>"

#. STRINGS.ELEMENTS.GLASS.DESC
msgctxt "STRINGS.ELEMENTS.GLASS.DESC"
msgid "Glass is a brittle, transparent substance formed from <link=\"SAND\">Sand</link> fired at high temperatures."
msgstr "玻璃易碎、透光的物質，由<link=\"SAND\">沙子</link>加熱至高溫製成。"

#. STRINGS.ELEMENTS.GLASS.NAME
msgctxt "STRINGS.ELEMENTS.GLASS.NAME"
msgid "<link=\"GLASS\">Glass</link>"
msgstr "<link=\"GLASS\">玻璃</link>"

#. STRINGS.ELEMENTS.GOLD.DESC
msgctxt "STRINGS.ELEMENTS.GOLD.DESC"
msgid "(Au) Gold is a conductive precious <link=\"REFINEDMETAL\">Metal</link>.\n\nIt is suitable for building <link=\"POWER\">Power</link> systems."
msgstr "(Au) 金是一種珍貴的導電<link=\"METAL\">金屬</link>。\n\n它適合用來建造<link=\"POWER\">電力</link>系統。"

#. STRINGS.ELEMENTS.GOLD.NAME
msgctxt "STRINGS.ELEMENTS.GOLD.NAME"
msgid "<link=\"GOLD\">Gold</link>"
msgstr "<link=\"GOLD\">金</link>"

#. STRINGS.ELEMENTS.GOLDAMALGAM.DESC
msgctxt "STRINGS.ELEMENTS.GOLDAMALGAM.DESC"
msgid "Gold Amalgam is a conductive amalgam of gold and mercury.\n\nIt is suitable for building <link=\"POWER\">Power</link> systems."
msgstr "金汞齊是一種導電的金與汞的合金。\n\n它適合用來建造<link=\"POWER\">電力</link>系統。"

#. STRINGS.ELEMENTS.GOLDAMALGAM.NAME
msgctxt "STRINGS.ELEMENTS.GOLDAMALGAM.NAME"
msgid "<link=\"GOLDAMALGAM\">Gold Amalgam</link>"
msgstr "<link=\"GOLDAMALGAM\">金汞齊</link>"

#. STRINGS.ELEMENTS.GOLDGAS.DESC
msgctxt "STRINGS.ELEMENTS.GOLDGAS.DESC"
msgid "(Au) Gold Gas is a conductive precious <link=\"REFINEDMETAL\">Metal</link>, heated into a <link=\"ELEMENTSGAS\">Gaseous</link> state."
msgstr "(Au) 金氣是一種導電良好的<link=\"METAL\">金屬</link>被加熱到<link=\"ELEMENTSGAS\">氣體</link>狀態。"

#. STRINGS.ELEMENTS.GOLDGAS.NAME
msgctxt "STRINGS.ELEMENTS.GOLDGAS.NAME"
msgid "<link=\"GOLDGAS\">Gold Gas</link>"
msgstr "<link=\"GOLDGAS\">金</link>"

#. STRINGS.ELEMENTS.GRANITE.DESC
msgctxt "STRINGS.ELEMENTS.GRANITE.DESC"
msgid "Granite is a dense composite of <link=\"IGNEOUSROCK\">Igneous Rock</link>.\n\nIt is useful as a <b>Construction Material</b>."
msgstr "花崗岩是一種高密度的<link=\"IGNEOUSROCK\">火成岩</link>。\n\n它是有用的<b>建築材料</b>。"

#. STRINGS.ELEMENTS.GRANITE.NAME
msgctxt "STRINGS.ELEMENTS.GRANITE.NAME"
msgid "<link=\"GRANITE\">Granite</link>"
msgstr "<link=\"GRANITE\">花崗岩</link>"

#. STRINGS.ELEMENTS.GRAPHITE.DESC
msgctxt "STRINGS.ELEMENTS.GRAPHITE.DESC"
msgid "(C) Graphite is the most stable form of carbon.\n\nIt has high thermal conductivity and is useful as a <b>Construction Material</b>."
msgstr "(C) 石墨是碳最穩定的形式。\n\n它有高導熱性且適合當作的<b>建築材料</b>。"

#. STRINGS.ELEMENTS.GRAPHITE.NAME
msgctxt "STRINGS.ELEMENTS.GRAPHITE.NAME"
msgid "<link=\"GRAPHITE\">Graphite</link>"
msgstr "<link=\"GRAPHITE\">石墨</link>"

#. STRINGS.ELEMENTS.GUNK.DESC
msgctxt "STRINGS.ELEMENTS.GUNK.DESC"
msgid "Solid Gunk is the built-up grime and grit produced by Duplicants' bionic mechanisms, which has been frozen into a <link=\"ELEMENTSSOLID\">Solid</link> state."
msgstr "黏渣是由複製人的仿生機械運作時堆積的汙垢和砂礫，凍結成<link=\"ELEMENTSSOLID\">固體</link>狀態。"

#. STRINGS.ELEMENTS.GUNK.NAME
msgctxt "STRINGS.ELEMENTS.GUNK.NAME"
msgid "<link=\"GUNK\">Solid Gunk</link>"
msgstr "<link=\"GUNK\">黏渣</link>"

#. STRINGS.ELEMENTS.HARDNESS.FIRM
msgctxt "STRINGS.ELEMENTS.HARDNESS.FIRM"
msgid "{0} (Firm)"
msgstr "{0}（堅硬）"

#. STRINGS.ELEMENTS.HARDNESS.HARDNESS_DESCRIPTOR.FIRM
msgctxt "STRINGS.ELEMENTS.HARDNESS.HARDNESS_DESCRIPTOR.FIRM"
msgid "Firm"
msgstr "堅硬"

#. STRINGS.ELEMENTS.HARDNESS.HARDNESS_DESCRIPTOR.IMPENETRABLE
