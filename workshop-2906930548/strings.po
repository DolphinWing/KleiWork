#. STRINGS.BLUEPRINTS.PERMIT_JUMPSUIT_VSUIT_STELLAR.DESC
msgctxt "STRINGS.BLUEPRINTS.PERMIT_JUMPSUIT_VSUIT_STELLAR.DESC"
