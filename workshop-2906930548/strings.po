#. STRINGS.MISC.TAGS.COMBUSTIBLEGAS
msgctxt "STRINGS.MISC.TAGS.COMBUSTIBLEGAS"
msgid "<link=\"COMBUSTIBLEGAS\">Combustible Gas</link>"
msgstr "<link=\"COMBUSTIBLEGAS\">氣體燃料</link>"

#. STRINGS.MISC.TAGS.COMBUSTIBLEGAS_DESC
msgctxt "STRINGS.MISC.TAGS.COMBUSTIBLEGAS_DESC"
msgid "Combustible Gases can be burned as fuel to be used in the production of <link=\"POWER\">Power</link> and <link=\"FOOD\">Food</link>."
msgstr "可燃固體可作為燃料，用於<link=\"POWER\">電力</link>和<link=\"FOOD\">食物</link>生產。"

#. STRINGS.MISC.TAGS.COMBUSTIBLELIQUID
msgctxt "STRINGS.MISC.TAGS.COMBUSTIBLELIQUID"
msgid "<link=\"COMBUSTIBLELIQUID\">Combustible Liquid</link>"
msgstr "<link=\"COMBUSTIBLELIQUID\">可燃液體</link>"

#. STRINGS.MISC.TAGS.COMBUSTIBLELIQUID_DESC
msgctxt "STRINGS.MISC.TAGS.COMBUSTIBLELIQUID_DESC"
msgid "Combustible Liquids can be burned as fuels to be used in energy production, such as in a <link=\"PETROLEUMGENERATOR\">Petroleum Generator</link> or a <link=\"KEROSENEENGINECLUSTER\">Petroleum Engine</link>.\n\nThough these liquids have other uses, such as fertilizer for growing a <link=\"BEANPLANTSEED\">Nosh Bean</link>, their primary usefulness lies in their ability to be burned for <link=\"POWER\">Power</link>."
msgstr "可燃液體是能夠用來作為燃料產生能源的液體，例如用在<link=\"PETROLEUMGENERATOR\">石油發電機</link>或<link=\"KEROSENEENGINECLUSTER\">石油引擎</link>。\n\n雖然這些還有其它用途，像是作為<link=\"BEANPLANTSEED\">小吃豆</link>的肥料，但它們的主要用途是用來<link=\"POWER\">發電</link>。"

#. STRINGS.MISC.TAGS.COMBUSTIBLESOLID
msgctxt "STRINGS.MISC.TAGS.COMBUSTIBLESOLID"
msgid "<link=\"COMBUSTIBLESOLID\">Combustible Solid</link>"
msgstr "<link=\"COMBUSTIBLESOLID\">固體燃料</link>"

#. STRINGS.MISC.TAGS.COMBUSTIBLESOLID_DESC
msgctxt "STRINGS.MISC.TAGS.COMBUSTIBLESOLID_DESC"
msgid "Combustible Solids can be burned as fuel to be used in <link=\"POWER\">Power</link> production."
msgstr "可燃固體可作為燃料，用於<link=\"POWER\">電力</link>生產。"

