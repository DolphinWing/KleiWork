msgstr "高腰冰樹褲子"

#. STRINGS.BLUEPRINTS.PERMIT_PANTS_NAUTICAL_WHITE.DESC
msgctxt "STRINGS.BLUEPRINTS.PERMIT_PANTS_NAUTICAL_WHITE.DESC"
