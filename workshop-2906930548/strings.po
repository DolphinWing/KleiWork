msgstr "黑色飛行靴"

#. STRINGS.BLUEPRINTS.PERMIT_JET_SHOES_BASIC_WHITE.DESC
msgctxt "STRINGS.BLUEPRINTS.PERMIT_JET_SHOES_BASIC_WHITE.DESC"
