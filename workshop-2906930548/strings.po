msgstr "<link=\"EXTERIORWALL\">森林</link>"

#. STRINGS.BLUEPRINTS.PERMIT_WALLS_FOSSIL_CHAMELEO.DESC
msgctxt "STRINGS.BLUEPRINTS.PERMIT_WALLS_FOSSIL_CHAMELEO.DESC"
