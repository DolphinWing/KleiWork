msgctxt "STRINGS.DUPLICANTS.MODEL.REMOTEWORKER.NAME"
msgid "Remote Worker"
msgstr "遙控機器人"

#. STRINGS.DUPLICANTS.MODEL.STANDARD.DESC
msgctxt "STRINGS.DUPLICANTS.MODEL.STANDARD.DESC"
msgid "Standard Duplicants are hard workers who enjoy good <link=\"FOOD\">Food</link>, fresh <link=\"OXYGEN\">Oxygen</link> and creative colony-building.\n\nThey will complete errands in order of <link=\"PRIORITY\">Priority</link>."
msgstr "標準複製人是勤勞的工作者，喜歡美味的<link=\"FOOD\">食物</link>，新鮮的<link=\"OXYGEN\">氧氣</link>，具有創造力的殖民地建築。\n\n他們會按照<link=\"PRIORITY\">優先度</link>順序完成任務。"

#. STRINGS.DUPLICANTS.MODEL.STANDARD.NAME
msgctxt "STRINGS.DUPLICANTS.MODEL.STANDARD.NAME"
