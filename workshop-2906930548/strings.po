msgstr "藍狐鹿克斯寶貝"

#. STRINGS.BLUEPRINTS.PERMIT_PAINTING_WIDE_ART_RHEX.DESC
msgctxt "STRINGS.BLUEPRINTS.PERMIT_PAINTING_WIDE_ART_RHEX.DESC"
