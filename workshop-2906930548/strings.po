msgstr "<link=\"ARTTALLL\">反射球</link>"

#. STRINGS.BUILDINGS.PREFABS.CANVASTALL.FACADES.ART_TALL_M.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.CANVASTALL.FACADES.ART_TALL_M.DESC"
