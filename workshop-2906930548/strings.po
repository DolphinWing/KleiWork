msgstr "一件白色飛行衣，搭配一件氣勢強烈的深灰色胸骨護甲。"

#. STRINGS.BLUEPRINTS.PERMIT_JETSUIT_WHITE_CHARCOAL.NAME
msgctxt "STRINGS.BLUEPRINTS.PERMIT_JETSUIT_WHITE_CHARCOAL.NAME"
msgid "Crisp Charcoal Jet Suit"
msgstr "俐落木炭飛行衣"

#. STRINGS.BLUEPRINTS.PERMIT_JETSUIT_WHITE_MAGENTA.DESC
msgctxt "STRINGS.BLUEPRINTS.PERMIT_JETSUIT_WHITE_MAGENTA.DESC"
msgid "A white jet suit with a warm coral-hued sternum protector."
msgstr "一件白色飛行衣，搭配一件溫暖珊瑚色的胸骨護甲。"

#. STRINGS.BLUEPRINTS.PERMIT_JETSUIT_WHITE_MAGENTA.NAME
msgctxt "STRINGS.BLUEPRINTS.PERMIT_JETSUIT_WHITE_MAGENTA.NAME"
