msgstr "<link=\"DUPLICANTS\">仿生複製人</link>"

#. STRINGS.DUPLICANTS.MODEL.BIONIC.NAME_ADJECTIVE
msgctxt "STRINGS.DUPLICANTS.MODEL.BIONIC.NAME_ADJECTIVE"
