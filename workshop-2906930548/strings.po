#. STRINGS.DUPLICANTS.NEEDS.FOOD_QUALITY.NORMAL_FOOD_MOD
msgctxt "STRINGS.DUPLICANTS.NEEDS.FOOD_QUALITY.NORMAL_FOOD_MOD"
msgid "Food Quality"
msgstr "食物品質"

#. STRINGS.DUPLICANTS.NEEDS.FOOD_QUALITY.PROFESSION_NAME
msgctxt "STRINGS.DUPLICANTS.NEEDS.FOOD_QUALITY.PROFESSION_NAME"
msgid "Gourmet"
msgstr "美食"

#. STRINGS.DUPLICANTS.NEEDS.NOISE.NAME
msgctxt "STRINGS.DUPLICANTS.NEEDS.NOISE.NAME"
msgid "Noise Expectation"
msgstr "噪音期望"

#. STRINGS.DUPLICANTS.NEEDS.QUALITYOFLIFE.APTITUDE_SKILLS_MOD_NAME
msgctxt "STRINGS.DUPLICANTS.NEEDS.QUALITYOFLIFE.APTITUDE_SKILLS_MOD_NAME"
msgid "Interested Skills Learned"
msgstr "學會有興趣的技能"

#. STRINGS.DUPLICANTS.NEEDS.QUALITYOFLIFE.BAD_MODIFIER
msgctxt "STRINGS.DUPLICANTS.NEEDS.QUALITYOFLIFE.BAD_MODIFIER"
msgid "Low Morale"
msgstr "低士氣"

#. STRINGS.DUPLICANTS.NEEDS.QUALITYOFLIFE.EXPECTATION_MOD_NAME
msgctxt "STRINGS.DUPLICANTS.NEEDS.QUALITYOFLIFE.EXPECTATION_MOD_NAME"
msgid "Skills Learned"
msgstr "學會技能"

#. STRINGS.DUPLICANTS.NEEDS.QUALITYOFLIFE.EXPECTATION_TOOLTIP
msgctxt "STRINGS.DUPLICANTS.NEEDS.QUALITYOFLIFE.EXPECTATION_TOOLTIP"
msgid "The more responsibilities and stressors a Duplicant has, the more they will desire additional leisure time and improved amenities.\n\nFailing to keep a Duplicant's <style=\"KKeyword\">Morale</style> at or above their <style=\"KKeyword\">Morale Need</style> means they will not be able to unwind, causing them <style=\"KKeyword\">Stress</style> over time."
msgstr "複製人的責任與壓力愈大，他們越需要額外的休閒時間與更好的設施。\n\n複製人的<style=\"KKeyword\">士氣</style>未能達到或超過<style=\"KKeyword\">士氣需求</style>，將導致他們無法放鬆，長期下來會累積<style=\"KKeyword\">壓力</style>。"

#. STRINGS.DUPLICANTS.NEEDS.QUALITYOFLIFE.GOOD_MODIFIER
msgctxt "STRINGS.DUPLICANTS.NEEDS.QUALITYOFLIFE.GOOD_MODIFIER"
msgid "High Morale"
msgstr "高士氣"

#. STRINGS.DUPLICANTS.NEEDS.QUALITYOFLIFE.NAME
msgctxt "STRINGS.DUPLICANTS.NEEDS.QUALITYOFLIFE.NAME"
msgid "Morale Requirements"
msgstr "士氣要求"

#. STRINGS.DUPLICANTS.NEEDS.QUALITYOFLIFE.NEUTRAL_MODIFIER
msgctxt "STRINGS.DUPLICANTS.NEEDS.QUALITYOFLIFE.NEUTRAL_MODIFIER"
msgid "Sufficient Morale"
msgstr "充滿士氣"

#. STRINGS.DUPLICANTS.NEEDS.QUALITYOFLIFE.TOTAL_SKILL_POINTS
msgctxt "STRINGS.DUPLICANTS.NEEDS.QUALITYOFLIFE.TOTAL_SKILL_POINTS"
msgid "Total Skill Points: {0}"
msgstr "全部技能點：{0}"

#. STRINGS.DUPLICANTS.PERSONALITIES.ABE.DESC
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.ABE.DESC"
msgid "{0}s are sweet, delicate flowers. They need to be treated gingerly, with great consideration for their feelings."
msgstr "{0} 是甜美纖細的花朵。對待他要格外小心，一定要充分考慮他的感受。"

#. STRINGS.DUPLICANTS.PERSONALITIES.ABE.NAME
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.ABE.NAME"
msgid "Abe"
msgstr "Abe"

#. STRINGS.DUPLICANTS.PERSONALITIES.ADA.DESC
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.ADA.DESC"
msgid "{0}s enjoy writing poetry in their downtime. Dark poetry."
msgstr "{0} 喜歡在休息時寫詩。黑暗的詩。"

#. STRINGS.DUPLICANTS.PERSONALITIES.ADA.NAME
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.ADA.NAME"
msgid "Ada"
msgstr "Ada"

#. STRINGS.DUPLICANTS.PERSONALITIES.AMARI.DESC
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.AMARI.DESC"
msgid "{0}s likes to keep the peace. Ironically, they're a riot at parties."
msgstr "{0} 喜歡保持平靜。但具有諷刺意味的是，在聚會時非常吵鬧。"

#. STRINGS.DUPLICANTS.PERSONALITIES.AMARI.NAME
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.AMARI.NAME"
msgid "Amari"
msgstr "Amari"

#. STRINGS.DUPLICANTS.PERSONALITIES.ARI.DESC
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.ARI.DESC"
msgid "{0}s tend to space out from time to time, but they always pay attention when it counts."
msgstr "{0} 常常放空，但在重要時刻總會集中注意力。"

#. STRINGS.DUPLICANTS.PERSONALITIES.ARI.NAME
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.ARI.NAME"
msgid "Ari"
msgstr "Ari"

#. STRINGS.DUPLICANTS.PERSONALITIES.ASHKAN.DESC
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.ASHKAN.DESC"
msgid "{0}s have what can only be described as a \"seriously infectious giggle\"."
msgstr "{0} 有的只是「病毒傳染似的傻笑」。"

#. STRINGS.DUPLICANTS.PERSONALITIES.ASHKAN.NAME
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.ASHKAN.NAME"
msgid "Ashkan"
msgstr "Ashkan"

#. STRINGS.DUPLICANTS.PERSONALITIES.BANHI.DESC
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.BANHI.DESC"
msgid "The \"cool loner\" vibes that radiate off a {0} never fail to make the colony swoon."
msgstr "{0} 散發著「獨行酷者」，永遠讓殖民地為之瘋狂。"

#. STRINGS.DUPLICANTS.PERSONALITIES.BANHI.NAME
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.BANHI.NAME"
msgid "Banhi"
msgstr "Banhi"

#. STRINGS.DUPLICANTS.PERSONALITIES.BUBBLES.DESC
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.BUBBLES.DESC"
msgid "This {0} is constantly challenging others to fight her, regardless of whether or not she can actually take them."
msgstr "{0} 總是在挑釁別人跟她打架，不管她是否有把握能打倒對方。"

#. STRINGS.DUPLICANTS.PERSONALITIES.BUBBLES.NAME
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.BUBBLES.NAME"
msgid "Bubbles"
msgstr "Bubbles"

#. STRINGS.DUPLICANTS.PERSONALITIES.BURT.DESC
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.BURT.DESC"
msgid "This {0} always feels great after a bubble bath and a good long cry."
msgstr "{0} 在洗了泡泡浴與長時間哭泣後，總是覺得心情變好。"

#. STRINGS.DUPLICANTS.PERSONALITIES.BURT.NAME
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.BURT.NAME"
msgid "Burt"
msgstr "Burt"

#. STRINGS.DUPLICANTS.PERSONALITIES.CAMILLE.DESC
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.CAMILLE.DESC"
msgid "This {0} loves anything that makes her feel nostalgic, including things that haven't aged well."
msgstr "這個 {0} 喜歡任何讓他感到懷舊的東西，包括那些還不嫌老的東西。"

#. STRINGS.DUPLICANTS.PERSONALITIES.CAMILLE.NAME
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.CAMILLE.NAME"
msgid "Camille"
msgstr "Camille"

#. STRINGS.DUPLICANTS.PERSONALITIES.CATALINA.DESC
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.CATALINA.DESC"
msgid "A {0} is admired by all for her seemingly tireless work ethic. Little do people know, she's dying on the inside."
msgstr "{0} 因為那看起來努力不懈的工作態度受到大家敬佩。但很少人知道，她的內心正在死亡。"

#. STRINGS.DUPLICANTS.PERSONALITIES.CATALINA.NAME
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.CATALINA.NAME"
msgid "Catalina"
msgstr "Catalina"

#. STRINGS.DUPLICANTS.PERSONALITIES.CHIP.DESC
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.CHIP.DESC"
msgid "This {0} is extremely good at guessing their friends' passwords."
msgstr "{0} 非常擅長猜測朋友的密碼。"

#. STRINGS.DUPLICANTS.PERSONALITIES.CHIP.NAME
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.CHIP.NAME"
msgid "Chip"
msgstr "Chip"

#. STRINGS.DUPLICANTS.PERSONALITIES.DEVON.DESC
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.DEVON.DESC"
msgid "This {0} dreams of owning their own personal computer so they can start a blog full of pictures of toast."
msgstr "{0} 夢想有一天可以擁有一台自己的個人電腦，這樣就可以在網誌上狂發烤麵包的美照了"

#. STRINGS.DUPLICANTS.PERSONALITIES.DEVON.NAME
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.DEVON.NAME"
msgid "Devon"
msgstr "Devon"

#. STRINGS.DUPLICANTS.PERSONALITIES.EDWIREDO.DESC
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.EDWIREDO.DESC"
msgid "This {0} once rolled his eye so hard that he powered himself off and on again."
msgstr "{0} 曾經翻白眼過於用力，以至於不得不把自己重啟才恢復。"

#. STRINGS.DUPLICANTS.PERSONALITIES.EDWIREDO.NAME
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.EDWIREDO.NAME"
msgid "Edwiredo"
msgstr "Edwiredo"

#. STRINGS.DUPLICANTS.PERSONALITIES.ELLIE.DESC
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.ELLIE.DESC"
msgid "Nothing makes an {0} happier than a big tin of glitter and a pack of unicorn stickers."
msgstr "沒什麼能比一大片閃光和一包獨角獸貼紙能更讓 {0} 開心了。"

#. STRINGS.DUPLICANTS.PERSONALITIES.ELLIE.NAME
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.ELLIE.NAME"
msgid "Ellie"
msgstr "Ellie"

#. STRINGS.DUPLICANTS.PERSONALITIES.FRANKIE.DESC
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.FRANKIE.DESC"
msgid "There's nothing {0}s are more proud of than their thick, dignified eyebrows."
msgstr "沒什麼比 {0} 那又粗又莊嚴的眉毛更令他自豪了。"

#. STRINGS.DUPLICANTS.PERSONALITIES.FRANKIE.NAME
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.FRANKIE.NAME"
msgid "Frankie"
msgstr "Frankie"

#. STRINGS.DUPLICANTS.PERSONALITIES.FREYJA.DESC
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.FREYJA.DESC"
msgid "This {0} has never stopped anyone from eating yellow snow."
msgstr "{0} 從不阻止任何人吃黃色的雪。"

#. STRINGS.DUPLICANTS.PERSONALITIES.FREYJA.NAME
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.FREYJA.NAME"
msgid "Freyja"
msgstr "Freyja"

#. STRINGS.DUPLICANTS.PERSONALITIES.GIZMO.DESC
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.GIZMO.DESC"
msgid "{0}s love nothing more than a big juicy info dump."
msgstr "{0} 最喜歡大型資訊轉儲站。"

#. STRINGS.DUPLICANTS.PERSONALITIES.GIZMO.NAME
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.GIZMO.NAME"
msgid "Gizmo"
msgstr "Gizmo"

#. STRINGS.DUPLICANTS.PERSONALITIES.GOSSMANN.DESC
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.GOSSMANN.DESC"
msgid "{0}s are major goofballs who can make anyone laugh."
msgstr "{0} 是個讓人大笑的大傻瓜。"

#. STRINGS.DUPLICANTS.PERSONALITIES.GOSSMANN.NAME
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.GOSSMANN.NAME"
msgid "Gossmann"
msgstr "Gossmann"

#. STRINGS.DUPLICANTS.PERSONALITIES.HAROLD.DESC
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.HAROLD.DESC"
msgid "Get a bunch of {0}s together in a room, and you'll have... a bunch of {0}s together in a room."
msgstr "房間內有一堆的 {0}，然後你會有…一堆的 {0} 在房間內。"

#. STRINGS.DUPLICANTS.PERSONALITIES.HAROLD.NAME
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.HAROLD.NAME"
msgid "Harold"
msgstr "Harold"

#. STRINGS.DUPLICANTS.PERSONALITIES.HASSAN.DESC
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.HASSAN.DESC"
msgid "If someone says something nice to a {0} he'll think about it nonstop for no less than three weeks."
msgstr "如果有人對 {0} 說某某好，他將會不停的想著它超過三個禮拜。"

#. STRINGS.DUPLICANTS.PERSONALITIES.HASSAN.NAME
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.HASSAN.NAME"
msgid "Hassan"
msgstr "Hassan"

#. STRINGS.DUPLICANTS.PERSONALITIES.HIGBY.DESC
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.HIGBY.DESC"
msgid "This {0}'s got a song in his heart. Now if only he could remember how it goes."
msgstr "{0} 心中有一首曲子。要是他記得怎麼唱就好了。"

#. STRINGS.DUPLICANTS.PERSONALITIES.HIGBY.NAME
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.HIGBY.NAME"
msgid "Higby"
msgstr "Higby"

#. STRINGS.DUPLICANTS.PERSONALITIES.JEAN.DESC
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.JEAN.DESC"
msgid "Just because {0}s are a little slow doesn't mean they can't suffer from soul-crushing existential crises."
msgstr "只因為 {0} 有點慢，但這並不代表他們不會對自己的存亡危機而深感憂患。"

#. STRINGS.DUPLICANTS.PERSONALITIES.JEAN.NAME
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.JEAN.NAME"
msgid "Jean"
msgstr "Jean"

#. STRINGS.DUPLICANTS.PERSONALITIES.JORGE.DESC
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.JORGE.DESC"
msgid "{0} loves his new colony, even if their collective body odor makes his eyes water."
msgstr "{0} 喜歡他的新殖民地，即使他們集體的體味讓他熱淚盈眶。"

#. STRINGS.DUPLICANTS.PERSONALITIES.JORGE.NAME
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.JORGE.NAME"
msgid "Jorge"
msgstr "Jorge"

#. STRINGS.DUPLICANTS.PERSONALITIES.JOSHUA.DESC
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.JOSHUA.DESC"
msgid "{0}s are precious goobers. Other Duplicants are strangely incapable of cursing in a {0}'s presence."
msgstr "{0} 是少見的好人。其他複製人都無法說 {0} 的壞話。"

#. STRINGS.DUPLICANTS.PERSONALITIES.JOSHUA.NAME
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.JOSHUA.NAME"
msgid "Joshua"
msgstr "Joshua"

#. STRINGS.DUPLICANTS.PERSONALITIES.KAI.DESC
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.KAI.DESC"
msgid "The secret to a {0}'s perfectly soft hair is marine mineral hair masks."
msgstr "{0} 擁有一頭完美柔軟秀髮的秘訣，在於海洋礦物質髮膜。"

#. STRINGS.DUPLICANTS.PERSONALITIES.KAI.NAME
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.KAI.NAME"
msgid "Kai"
msgstr "Kai"

#. STRINGS.DUPLICANTS.PERSONALITIES.LEIRA.DESC
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.LEIRA.DESC"
msgid "{0}s just want everyone to be happy."
msgstr "{0} 只是希望大家開心。"

#. STRINGS.DUPLICANTS.PERSONALITIES.LEIRA.NAME
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.LEIRA.NAME"
msgid "Leira"
msgstr "Leira"

#. STRINGS.DUPLICANTS.PERSONALITIES.LIAM.DESC
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.LIAM.DESC"
msgid "No matter how much this {0} scrubs, he can never truly feel clean."
msgstr "不管 {0} 洗了多少遍，他永遠不會感到乾淨。"

#. STRINGS.DUPLICANTS.PERSONALITIES.LIAM.NAME
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.LIAM.NAME"
msgid "Liam"
msgstr "Liam"

#. STRINGS.DUPLICANTS.PERSONALITIES.LINDSAY.DESC
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.LINDSAY.DESC"
msgid "A {0} is a charming woman, unless you make the mistake of messing with one of her friends."
msgstr "{0} 是個可愛又迷人的女人，只要你不跟她的朋友亂搞關係的話。"

#. STRINGS.DUPLICANTS.PERSONALITIES.LINDSAY.NAME
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.LINDSAY.NAME"
msgid "Lindsay"
msgstr "Lindsay"

#. STRINGS.DUPLICANTS.PERSONALITIES.MAE.DESC
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.MAE.DESC"
msgid "There's nothing a {0} can't do if she sets her mind to it."
msgstr "只要是 {0} 想做的事情，沒有她辦不到的。"

#. STRINGS.DUPLICANTS.PERSONALITIES.MAE.NAME
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.MAE.NAME"
msgid "Mae"
msgstr "Mae"

#. STRINGS.DUPLICANTS.PERSONALITIES.MARIE.DESC
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.MARIE.DESC"
msgid "This {0} is positively glowing! What's her secret? Radioactive isotopes, of course."
msgstr "{0} 閃耀著幸福的光芒。她的祕密是什麼？放射性同位素，肯定是這樣的。"

#. STRINGS.DUPLICANTS.PERSONALITIES.MARIE.NAME
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.MARIE.NAME"
msgid "Marie"
msgstr "Marie"

#. STRINGS.DUPLICANTS.PERSONALITIES.MAX.DESC
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.MAX.DESC"
msgid "At any given moment a {0} is viscerally reliving ten different humiliating memories."
msgstr "{0} 在任何時候都能想起自己十件不同的糗事。"

#. STRINGS.DUPLICANTS.PERSONALITIES.MAX.NAME
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.MAX.NAME"
msgid "Max"
msgstr "Max"

#. STRINGS.DUPLICANTS.PERSONALITIES.MAYA.DESC
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.MAYA.DESC"
msgid "This {0} got her hand crushed in a pneumatic door once. It was the most alive she's ever felt."
msgstr "有一次 {0} 的手讓透氣門夾了。那是她感到自己最有活力的一次。"

#. STRINGS.DUPLICANTS.PERSONALITIES.MAYA.NAME
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.MAYA.NAME"
msgid "Maya"
msgstr "Maya"

#. STRINGS.DUPLICANTS.PERSONALITIES.MEEP.DESC
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.MEEP.DESC"
msgid "{0}s have a face only a two tonne Printing Pod could love."
msgstr "{0} 的臉恐怕只有那兩噸的列印元才會喜歡。"

#. STRINGS.DUPLICANTS.PERSONALITIES.MEEP.NAME
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.MEEP.NAME"
msgid "Meep"
msgstr "Meep"

#. STRINGS.DUPLICANTS.PERSONALITIES.MIMA.DESC
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.MIMA.DESC"
msgid "Ol' {0} here can't stand lookin' at people's knees."
msgstr "對於盯著別人膝蓋看這件事，老 {0} 實在是無法忍受。"

#. STRINGS.DUPLICANTS.PERSONALITIES.MIMA.NAME
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.MIMA.NAME"
msgid "Mi-Ma"
msgstr "Mi-Ma"

#. STRINGS.DUPLICANTS.PERSONALITIES.MINNOW.DESC
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.MINNOW.DESC"
msgid "{0} always goes with the flow. Unless the flow is going somewhere boring."
msgstr "{0} 總是隨波逐流，除非那條流向的目的地很無聊。"

#. STRINGS.DUPLICANTS.PERSONALITIES.MINNOW.NAME
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.MINNOW.NAME"
msgid "Minnow"
msgstr "Minnow"

#. STRINGS.DUPLICANTS.PERSONALITIES.NAILS.DESC
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.NAILS.DESC"
msgid "People often expect a Duplicant named \"{0}\" to be tough, but they're all pretty huge wimps."
msgstr "人們常常期待名叫「{0}」的複製人是堅強的，不過他們全都是非常的懦弱。"

#. STRINGS.DUPLICANTS.PERSONALITIES.NAILS.NAME
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.NAILS.NAME"
msgid "Nails"
msgstr "Nails"

#. STRINGS.DUPLICANTS.PERSONALITIES.NIKOLA.DESC
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.NIKOLA.DESC"
msgid "This {0} once claimed he could build a laser so powerful it would rip the colony in half. No one asked him to prove it."
msgstr "{0} 曾聲稱他能製造足以把殖民地撕成兩半的雷射，可沒人希望他證明這件事。"

#. STRINGS.DUPLICANTS.PERSONALITIES.NIKOLA.NAME
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.NIKOLA.NAME"
msgid "Nikola"
msgstr "Nikola"

#. STRINGS.DUPLICANTS.PERSONALITIES.NISBET.DESC
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.NISBET.DESC"
msgid "This {0} likes to punch people to show her affection. Everyone's too afraid of her to tell her it hurts."
msgstr "{0} 喜歡用拳頭來表達她的關愛。沒人敢跟她說，她打起來其實很痛的。"

#. STRINGS.DUPLICANTS.PERSONALITIES.NISBET.NAME
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.NISBET.NAME"
msgid "Nisbet"
msgstr "Nisbet"

#. STRINGS.DUPLICANTS.PERSONALITIES.OTTO.DESC
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.OTTO.DESC"
msgid "{0}s always insult people by accident and generally exist in a perpetual state of deep regret."
msgstr "{0} 總是不小心冒犯別人，然後又陷入深深的自責。"

#. STRINGS.DUPLICANTS.PERSONALITIES.OTTO.NAME
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.OTTO.NAME"
msgid "Otto"
msgstr "Otto"

#. STRINGS.DUPLICANTS.PERSONALITIES.PEI.DESC
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.PEI.DESC"
msgid "Every {0} spends at least half the day pretending that they remember what they came into this room for."
msgstr "每個 {0} 都會花至少半天的時間，假裝記得自己來到這個房間的目的。"

#. STRINGS.DUPLICANTS.PERSONALITIES.PEI.NAME
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.PEI.NAME"
msgid "Pei"
msgstr "Pei"

#. STRINGS.DUPLICANTS.PERSONALITIES.QUINN.DESC
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.QUINN.DESC"
msgid "This {0}'s favorite genre of music is \"festive power ballad\"."
msgstr "這個 {0} 最喜歡的音樂類型是「節日力量民謠」。"

#. STRINGS.DUPLICANTS.PERSONALITIES.QUINN.NAME
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.QUINN.NAME"
msgid "Quinn"
msgstr "Quinn"

#. STRINGS.DUPLICANTS.PERSONALITIES.REN.DESC
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.REN.DESC"
msgid "Every {0} has this unshakable feeling that his life's already happened and he's just watching it unfold from a memory."
msgstr "{0} 有一種無法動搖的感覺，就是他的生命已然發生，而他只是從記憶中看著它發生。"

#. STRINGS.DUPLICANTS.PERSONALITIES.REN.NAME
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.REN.NAME"
msgid "Ren"
msgstr "Ren"

#. STRINGS.DUPLICANTS.PERSONALITIES.ROWAN.DESC
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.ROWAN.DESC"
msgid "{0}s have exceptionally large hearts and express their emotions most efficiently by yelling."
msgstr "{0} 真的是豪邁不羈，喜怒哀樂都是用喊的。"

#. STRINGS.DUPLICANTS.PERSONALITIES.ROWAN.NAME
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.ROWAN.NAME"
msgid "Rowan"
msgstr "Rowan"

#. STRINGS.DUPLICANTS.PERSONALITIES.RUBY.DESC
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.RUBY.DESC"
msgid "This {0} asks the pressing questions, like \"Where can I get a leather jacket in space?\""
msgstr "{0} 喜歡問一些刁鑽問題，像是「在太空那裡能買到皮夾克？」"

#. STRINGS.DUPLICANTS.PERSONALITIES.RUBY.NAME
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.RUBY.NAME"
msgid "Ruby"
msgstr "Ruby"

#. STRINGS.DUPLICANTS.PERSONALITIES.SENA.DESC
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.SENA.DESC"
msgid "{0}s only care about three things: gold accents, true crime, and the advancement of nuclear physics."
msgstr "{0}只關心三件事：金色點綴、真實犯罪和核物理的進展。"

#. STRINGS.DUPLICANTS.PERSONALITIES.SENA.NAME
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.SENA.NAME"
msgid "Sena"
msgstr "Sena"

#. STRINGS.DUPLICANTS.PERSONALITIES.SONYAR.DESC
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.SONYAR.DESC"
msgid "{0}s would sooner burn down the colony than read an instruction manual."
msgstr "{0} 寧願把殖民地燒了，也不願讀說明書。"

#. STRINGS.DUPLICANTS.PERSONALITIES.SONYAR.NAME
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.SONYAR.NAME"
msgid "Sonyar"
msgstr "Sonyar"

#. STRINGS.DUPLICANTS.PERSONALITIES.STEELA.DESC
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.STEELA.DESC"
msgid "{0}s aren't programmed to put up with nonsense, but they do enjoy the occasional shenanigan."
msgstr "{0} 雖然不會容忍無意義的事情，但他們偶爾還是會搞點小惡作劇。"

#. STRINGS.DUPLICANTS.PERSONALITIES.STEELA.NAME
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.STEELA.NAME"
msgid "Steela"
msgstr "Steela"

#. STRINGS.DUPLICANTS.PERSONALITIES.STEVE.DESC
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.STEVE.DESC"
msgid "This {0} is convinced that he has psychic powers. And he knows exactly what his friends think about that."
msgstr "{0} 確信他有超能力。他知道他的朋友具體在想什麼。"

#. STRINGS.DUPLICANTS.PERSONALITIES.STEVE.NAME
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.STEVE.NAME"
msgid "Steve"
msgstr "Steve"

#. STRINGS.DUPLICANTS.PERSONALITIES.STINKY.DESC
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.STINKY.DESC"
msgid "This {0} has never been invited to a party, which is a shame. His dance moves are incredible."
msgstr "從來都沒人邀請 {0} 參加派對。可惜得很，他的舞蹈動作帥得令人難以置信。"

#. STRINGS.DUPLICANTS.PERSONALITIES.STINKY.NAME
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.STINKY.NAME"
msgid "Stinky"
msgstr "Stinky"

#. STRINGS.DUPLICANTS.PERSONALITIES.TRAVALDO.DESC
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.TRAVALDO.DESC"
msgid "A {0}'s monotonous voice and lack of facial expression makes it impossible for others to tell when he's messing with them."
msgstr "{0} 那單調的聲音和缺乏臉部表情，讓別人很難明白是不是被他排擠。"

#. STRINGS.DUPLICANTS.PERSONALITIES.TRAVALDO.NAME
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.TRAVALDO.NAME"
msgid "Travaldo"
msgstr "Travaldo"

#. STRINGS.DUPLICANTS.PERSONALITIES.TURNER.DESC
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.TURNER.DESC"
msgid "This {0} is paralyzed by the knowledge that others have memories and perceptions of them they can't control."
msgstr "{0} 對於別人擁有他無法控制的記憶和看法感到震驚。"

#. STRINGS.DUPLICANTS.PERSONALITIES.TURNER.NAME
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.TURNER.NAME"
msgid "Turner"
msgstr "Turner"

#. STRINGS.DUPLICANTS.PERSONALITIES.ULTI.DESC
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.ULTI.DESC"
msgid "This {0}'s favorite dance move is The Robot. They don't get why others think that's funny."
msgstr "{0} 最喜歡的舞蹈動作是「機械舞」。他們不明白為什麼其他人認為這很有趣。"

#. STRINGS.DUPLICANTS.PERSONALITIES.ULTI.NAME
msgctxt "STRINGS.DUPLICANTS.PERSONALITIES.ULTI.NAME"
msgid "Ulti"
msgstr "Ulti"

#. STRINGS.DUPLICANTS.RACE
msgctxt "STRINGS.DUPLICANTS.RACE"
msgid "Duplicant"
msgstr "複製人"

#. STRINGS.DUPLICANTS.RACE_PREFIX
msgctxt "STRINGS.DUPLICANTS.RACE_PREFIX"
msgid "Species: {0}"
msgstr "物種：{0}"

#. STRINGS.DUPLICANTS.ROLES.ARTIST.DESCRIPTION
msgctxt "STRINGS.DUPLICANTS.ROLES.ARTIST.DESCRIPTION"
msgid "Allows moderately attractive art to be created"
msgstr "允許適當地創造有吸引力的藝術"

#. STRINGS.DUPLICANTS.ROLES.ARTIST.NAME
msgctxt "STRINGS.DUPLICANTS.ROLES.ARTIST.NAME"
msgid "<link=\"ARTING2\">Aesthetic Design</link>"
msgstr "<link=\"ARTING2\">美學設計</link>"

#. STRINGS.DUPLICANTS.ROLES.ASTRONAUT.DESCRIPTION
msgctxt "STRINGS.DUPLICANTS.ROLES.ASTRONAUT.DESCRIPTION"
msgid "Improves the speed that space missions are completed"
msgstr "加快完成太空任務的速度"

#. STRINGS.DUPLICANTS.ROLES.ASTRONAUT.NAME
msgctxt "STRINGS.DUPLICANTS.ROLES.ASTRONAUT.NAME"
msgid "<link=\"ASTRONAUTING2\">Rocket Navigation</link>"
msgstr "<link=\"ASTRONAUTING2\">火箭導航</link>"

#. STRINGS.DUPLICANTS.ROLES.ASTRONAUTTRAINEE.DESCRIPTION
msgctxt "STRINGS.DUPLICANTS.ROLES.ASTRONAUTTRAINEE.DESCRIPTION"
msgid "Allows a Duplicant to operate a <link=\"COMMANDMODULE\">Command Capsule</link> to pilot a rocket ship"
msgstr "複製人可操作<link=\"COMMANDMODULE\">指揮太空艙</link>來駕駛火箭"

#. STRINGS.DUPLICANTS.ROLES.ASTRONAUTTRAINEE.NAME
msgctxt "STRINGS.DUPLICANTS.ROLES.ASTRONAUTTRAINEE.NAME"
msgid "<link=\"ASTRONAUTING1\">Rocket Piloting</link>"
msgstr "<link=\"ASTRONAUTING1\">火箭駕駛</link>"

#. STRINGS.DUPLICANTS.ROLES.BIONICS_A1.DESCRIPTION
msgctxt "STRINGS.DUPLICANTS.ROLES.BIONICS_A1.DESCRIPTION"
msgid "Allows Bionic Duplicants to install an additional booster."
msgstr "允許仿生複製人安裝額外的增效卡匣。"

#. STRINGS.DUPLICANTS.ROLES.BIONICS_A1.NAME
msgctxt "STRINGS.DUPLICANTS.ROLES.BIONICS_A1.NAME"
msgid "<link=\"BIONICSA1\">Booster Processing I</link>"
msgstr "<link=\"BIONICSA1\">增效卡匣處理 I</link>"

#. STRINGS.DUPLICANTS.ROLES.BIONICS_A2.DESCRIPTION
msgctxt "STRINGS.DUPLICANTS.ROLES.BIONICS_A2.DESCRIPTION"
msgid "Allows Bionic Duplicants to install an additional booster, and increases runspeed."
msgstr "允許仿生複製人安裝額外的增效卡匣，並提高移動速度。"

#. STRINGS.DUPLICANTS.ROLES.BIONICS_A2.NAME
msgctxt "STRINGS.DUPLICANTS.ROLES.BIONICS_A2.NAME"
msgid "<link=\"BIONICSA2\">Booster Processing II</link>"
msgstr "<link=\"BIONICSA2\">增效卡匣處理 II</link>"

#. STRINGS.DUPLICANTS.ROLES.BIONICS_A3.DESCRIPTION
msgctxt "STRINGS.DUPLICANTS.ROLES.BIONICS_A3.DESCRIPTION"
msgid "Allows Bionic Duplicants to install an additional booster, and reduces the runspeed loss experienced while wearing exosuits."
msgstr "允許仿生複製人安裝額外的增效卡匣，並減少穿著太空衣時的移動速度損失。"

#. STRINGS.DUPLICANTS.ROLES.BIONICS_A3.NAME
msgctxt "STRINGS.DUPLICANTS.ROLES.BIONICS_A3.NAME"
msgid "<link=\"BIONICSA3\">Complex Processing</link>"
msgstr "<link=\"BIONICSA3\">複雜處理</link>"

#. STRINGS.DUPLICANTS.ROLES.BIONICS_B1.DESCRIPTION
msgctxt "STRINGS.DUPLICANTS.ROLES.BIONICS_B1.DESCRIPTION"
msgid "Significantly reduces the negative impacts of low <link=\"LUBRICATINGOIL\">Gear Oil</link>."
msgstr "大幅減少低<link=\"LUBRICATINGOIL\">齒輪油</link>的負面影響。"

#. STRINGS.DUPLICANTS.ROLES.BIONICS_B1.NAME
msgctxt "STRINGS.DUPLICANTS.ROLES.BIONICS_B1.NAME"
msgid "<link=\"BIONICSB1\">Improved Gears I</link>"
msgstr "<link=\"BIONICSB1\">改良齒輪 I</link>"

#. STRINGS.DUPLICANTS.ROLES.BIONICS_B2.DESCRIPTION
msgctxt "STRINGS.DUPLICANTS.ROLES.BIONICS_B2.DESCRIPTION"
msgid "Allows Bionic Duplicants to install an additional booster."
msgstr "允許仿生複製人安裝額外的增效卡匣。"

#. STRINGS.DUPLICANTS.ROLES.BIONICS_B2.NAME
msgctxt "STRINGS.DUPLICANTS.ROLES.BIONICS_B2.NAME"
msgid "<link=\"BIONICSB2\">Improved Gears II</link>"
msgstr "<link=\"BIONICSB2\">改良齒輪 II</link>"

#. STRINGS.DUPLICANTS.ROLES.BIONICS_B3.DESCRIPTION
msgctxt "STRINGS.DUPLICANTS.ROLES.BIONICS_B3.DESCRIPTION"
msgid "Allows Bionic Duplicants to install an additional booster, and eliminates the runspeed loss experienced while wearing exosuits."
msgstr "允許仿生複製人安裝額外的增效卡匣，並消除穿著太空衣時的移動速度損失。"

#. STRINGS.DUPLICANTS.ROLES.BIONICS_B3.NAME
msgctxt "STRINGS.DUPLICANTS.ROLES.BIONICS_B3.NAME"
msgid "<link=\"BIONICSB3\">Top Gear</link>"
msgstr "<link=\"BIONICSB3\">頂級齒輪</link>"

#. STRINGS.DUPLICANTS.ROLES.BIONICS_C1.DESCRIPTION
msgctxt "STRINGS.DUPLICANTS.ROLES.BIONICS_C1.DESCRIPTION"
msgid "Allows Bionic Duplicants to perform research using a <link=\"ADVANCEDRESEARCHCENTER\">Super Computer</link>, and craft items at the <link=\"ADVANCEDCRAFTINGTABLE\">Soldering Station</link>."
msgstr "允許仿生複製人使用<link=\"ADVANCEDRESEARCHCENTER\">超級電腦</link>進行研究，並能在<link=\"ADVANCEDCRAFTINGTABLE\">焊接台</link>上製作物品。"

#. STRINGS.DUPLICANTS.ROLES.BIONICS_C1.NAME
msgctxt "STRINGS.DUPLICANTS.ROLES.BIONICS_C1.NAME"
msgid "<link=\"BIONICSC1\">Schematics</link>"
msgstr "<link=\"BIONICSC1\">原理示意</link>"

#. STRINGS.DUPLICANTS.ROLES.BIONICS_C2.DESCRIPTION
msgctxt "STRINGS.DUPLICANTS.ROLES.BIONICS_C2.DESCRIPTION"
msgid "Allows Bionic Duplicants to install an additional booster and increase their runspeed."
msgstr "允許仿生複製人能安裝額外的增效卡匣，藉此提升移動速度。"

#. STRINGS.DUPLICANTS.ROLES.BIONICS_C2.NAME
msgctxt "STRINGS.DUPLICANTS.ROLES.BIONICS_C2.NAME"
msgid "<link=\"BIONICSC2\">Advanced Schematics</link>"
msgstr "<link=\"BIONICSC2\">進階原理</link>"

#. STRINGS.DUPLICANTS.ROLES.BIONICS_C3.DESCRIPTION
msgctxt "STRINGS.DUPLICANTS.ROLES.BIONICS_C3.DESCRIPTION"
msgid "Increases <link=\"ELECTROBANK\">Power Bank</link> storage capacity to maximize work time between replacements."
msgstr "提高<link=\"ELECTROBANK\">行動電源</link>的儲存容量，大幅延長每次更換前的作業時間。"

#. STRINGS.DUPLICANTS.ROLES.BIONICS_C3.NAME
msgctxt "STRINGS.DUPLICANTS.ROLES.BIONICS_C3.NAME"
msgid "<link=\"BIONICSC3\">Power Banking</link>"
msgstr "<link=\"BIONICSC3\">電力強化</link>"

#. STRINGS.DUPLICANTS.ROLES.BIONICS_D1.DESCRIPTION
msgctxt "STRINGS.DUPLICANTS.ROLES.BIONICS_D1.DESCRIPTION"
msgid "Increases resistance to environmental irritants and pressure-related injuries"
msgstr "增加對環境刺激物和壓力相關傷害的抵抗力。"

#. STRINGS.DUPLICANTS.ROLES.BIONICS_D1.NAME
msgctxt "STRINGS.DUPLICANTS.ROLES.BIONICS_D1.NAME"
msgid "<link=\"BIONICSD1\">Improved Hardware</link>"
msgstr "<link=\"BIONICSD1\">改良硬體</link>"

#. STRINGS.DUPLICANTS.ROLES.BIONICS_D2.DESCRIPTION
msgctxt "STRINGS.DUPLICANTS.ROLES.BIONICS_D2.DESCRIPTION"
msgid "Allows Bionic Duplicants to work comfortably in a wider range of ambient temperatures"
msgstr "使仿生複製人能夠在更廣泛的環境溫度範圍內舒適地工作"

#. STRINGS.DUPLICANTS.ROLES.BIONICS_D2.NAME
msgctxt "STRINGS.DUPLICANTS.ROLES.BIONICS_D2.NAME"
msgid "<link=\"BIONICSD2\">Climate Control</link>"
msgstr "<link=\"BIONICSD2\">氣候控制</link>"

#. STRINGS.DUPLICANTS.ROLES.BUILDER.DESCRIPTION
msgctxt "STRINGS.DUPLICANTS.ROLES.BUILDER.DESCRIPTION"
msgid "Further increases a Duplicant's construction speeds"
msgstr "加快複製人的建造速度"

#. STRINGS.DUPLICANTS.ROLES.BUILDER.NAME
msgctxt "STRINGS.DUPLICANTS.ROLES.BUILDER.NAME"
msgid "<link=\"BUILDING2\">Improved Construction II</link>"
msgstr "<link=\"BUILDING2\">建造技術改良 II</link>"

#. STRINGS.DUPLICANTS.ROLES.COOK.DESCRIPTION
msgctxt "STRINGS.DUPLICANTS.ROLES.COOK.DESCRIPTION"
msgid "Allows Duplicants to cook using the <link=\"GOURMETCOOKINGSTATION\">Gas Range</link>, <link=\"SMOKER\">Smoker</link>, <link=\"DEEPFRYER\">Deep Fryer</link>, <link=\"SUSHIBAR\">Sushi Bar</link>, and <link=\"SPICEGRINDER\">Spice Grinder</link>"
msgstr "允許複製人使用<link=\"GOURMETCOOKINGSTATION\">瓦斯爐</link>、<link=\"SMOKER\">煙燻機</link>、<link=\"DEEPFRYER\">油炸鍋</link>、<link=\"SUSHIBAR\">壽司吧</link>與<link=\"SPICEGRINDER\">香料研磨機</link>進行烹飪。"

#. STRINGS.DUPLICANTS.ROLES.COOK.NAME
msgctxt "STRINGS.DUPLICANTS.ROLES.COOK.NAME"
msgid "<link=\"COOKING2\">Enhanced Seasoning</link>"
msgstr "<link=\"COOKING2\">風味增強</link>"

#. STRINGS.DUPLICANTS.ROLES.EXPERT_SWIMMER.DESCRIPTION
msgctxt "STRINGS.DUPLICANTS.ROLES.EXPERT_SWIMMER.DESCRIPTION"
msgid "Grants Duplicants expert proficiency in liquid environment navigation."
msgstr "使複製人在液體環境中的移動更為熟練。"

#. STRINGS.DUPLICANTS.ROLES.EXPERT_SWIMMER.NAME
msgctxt "STRINGS.DUPLICANTS.ROLES.EXPERT_SWIMMER.NAME"
msgid "<link=\"SWIMMING2\">Divemaster</link>"
msgstr "<link=\"SWIMMING2\">潛水大師</link>"

#. STRINGS.DUPLICANTS.ROLES.FARMER.DESCRIPTION
msgctxt "STRINGS.DUPLICANTS.ROLES.FARMER.DESCRIPTION"
msgid "Enables tending <style=\"KKeyword\">Plants</style>, which will increase their growth speed"
msgstr "可以管理<style=\"KKeyword\">植物</style>，增加它們的生長速度"

#. STRINGS.DUPLICANTS.ROLES.FARMER.NAME
msgctxt "STRINGS.DUPLICANTS.ROLES.FARMER.NAME"
msgid "<link=\"FARMING2\">Crop Tending</link>"
msgstr "<link=\"FARMING2\">作物照料</link>"

#. STRINGS.DUPLICANTS.ROLES.GROUPS.APTITUDE_DESCRIPTION
msgctxt "STRINGS.DUPLICANTS.ROLES.GROUPS.APTITUDE_DESCRIPTION"
msgid "This Duplicant will gain <b>{1}</b> <style=\"KKeyword\">Morale</style> when learning <style=\"KKeyword\">{0}</style> Skills"
msgstr "當複製人學會<style=\"KKeyword\">{0}</style>技能後，會獲得 <b>{1}</b> <style=\"KKeyword\">士氣</style>"

#. STRINGS.DUPLICANTS.ROLES.GROUPS.APTITUDE_DESCRIPTION_CHOREGROUP
msgctxt "STRINGS.DUPLICANTS.ROLES.GROUPS.APTITUDE_DESCRIPTION_CHOREGROUP"
msgid "{2}\n\nThis Duplicant will gain <b>+{1}</b> <style=\"KKeyword\">Morale</style> when learning <style=\"KKeyword\">{0}</style> Skills"
msgstr "{2}\n\n當複製人學會<style=\"KKeyword\">{0}</style>技能後，會獲得 <b>+{1}</b> <style=\"KKeyword\">士氣</style>"

#. STRINGS.DUPLICANTS.ROLES.GROUPS.SUITS
msgctxt "STRINGS.DUPLICANTS.ROLES.GROUPS.SUITS"
msgid "Suit Wearing"
msgstr "裝備穿著"

#. STRINGS.DUPLICANTS.ROLES.HANDYMAN.DESCRIPTION
msgctxt "STRINGS.DUPLICANTS.ROLES.HANDYMAN.DESCRIPTION"
msgid "Minorly improves a Duplicant's physical strength"
msgstr "少量增加複製人的力量"

#. STRINGS.DUPLICANTS.ROLES.HANDYMAN.NAME
msgctxt "STRINGS.DUPLICANTS.ROLES.HANDYMAN.NAME"
msgid "<link=\"BASEKEEPING1\">Improved Strength</link>"
msgstr "<link=\"BASEKEEPING1\">力量強化</link>"

#. STRINGS.DUPLICANTS.ROLES.HAULER.DESCRIPTION
msgctxt "STRINGS.DUPLICANTS.ROLES.HAULER.DESCRIPTION"
msgid "Minorly increase a Duplicant's strength and carrying capacity"
msgstr "少量增加複製人的力量與負重"

#. STRINGS.DUPLICANTS.ROLES.HAULER.NAME
msgctxt "STRINGS.DUPLICANTS.ROLES.HAULER.NAME"
msgid "<link=\"HAULING1\">Improved Carrying I</link>"
msgstr "<link=\"HAULING1\">負重強化 I</link>"

#. STRINGS.DUPLICANTS.ROLES.JUNIOR_ARTIST.DESCRIPTION
msgctxt "STRINGS.DUPLICANTS.ROLES.JUNIOR_ARTIST.DESCRIPTION"
msgid "Teaches the most basic level of art skill"
msgstr "教導最基本的藝術技能"

#. STRINGS.DUPLICANTS.ROLES.JUNIOR_ARTIST.NAME
msgctxt "STRINGS.DUPLICANTS.ROLES.JUNIOR_ARTIST.NAME"
msgid "<link=\"ARTING1\">Art Fundamentals</link>"
msgstr "<link=\"ARTING1\">藝術基礎</link>"

#. STRINGS.DUPLICANTS.ROLES.JUNIOR_BUILDER.DESCRIPTION
msgctxt "STRINGS.DUPLICANTS.ROLES.JUNIOR_BUILDER.DESCRIPTION"
msgid "Marginally improves a Duplicant's construction speeds"
msgstr "小幅增加複製人的建造速度"

#. STRINGS.DUPLICANTS.ROLES.JUNIOR_BUILDER.NAME
msgctxt "STRINGS.DUPLICANTS.ROLES.JUNIOR_BUILDER.NAME"
msgid "<link=\"BUILDING1\">Improved Construction I</link>"
msgstr "<link=\"BUILDING1\">建造技術改良 I</link>"

#. STRINGS.DUPLICANTS.ROLES.JUNIOR_COOK.DESCRIPTION
msgctxt "STRINGS.DUPLICANTS.ROLES.JUNIOR_COOK.DESCRIPTION"
msgid "Allows Duplicants to cook using the <link=\"COOKINGSTATION\">Electric Grill</link>"
msgstr "允許複製人使用<link=\"COOKINGSTATION\">電烤爐</link>進行烹飪。"

#. STRINGS.DUPLICANTS.ROLES.JUNIOR_COOK.NAME
msgctxt "STRINGS.DUPLICANTS.ROLES.JUNIOR_COOK.NAME"
