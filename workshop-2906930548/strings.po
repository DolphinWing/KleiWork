msgctxt "STRINGS.BUILDINGS.PREFABS.FLOWERVASEHANGINGFANCY.DESC"
msgid "Aero pots can be hung from the ceiling and have extremely high Decor."
msgstr "透明花盆可以吊掛在天花板上，並有很高的裝飾值。"

#. STRINGS.BUILDINGS.PREFABS.FLOWERVASEHANGINGFANCY.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.FLOWERVASEHANGINGFANCY.EFFECT"
msgid "Houses a single <link=\"PLANTS\">Plant</link> when sown with a <link=\"PLANTS\">Seed</link>.\n\nIncreases <link=\"DECOR\">Decor</link> even when empty, contributing to <link=\"MORALE\">Morale</link>.\n\nMust be hung from a ceiling."
msgstr "播下<link=\"PLANTS\">種子</link>後，即可容納單株<link=\"PLANTS\">植物</link>。\n\n即使空著，也會增加<link=\"DECOR\">裝飾度</link>，有助於<link=\"MORALE\">士氣</link>。\n\n必須懸掛在天花板上。"

#. STRINGS.BUILDINGS.PREFABS.FLOWERVASEHANGINGFANCY.NAME
