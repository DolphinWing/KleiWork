msgstr "石榴飛行頭盔"

#. STRINGS.BLUEPRINTS.PERMIT_JET_HELMET_00_TORPOR_OBELUS.DESC
msgctxt "STRINGS.BLUEPRINTS.PERMIT_JET_HELMET_00_TORPOR_OBELUS.DESC"
