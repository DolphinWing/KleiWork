msgstr "<link=\"DUPLICANTS\">仿生</link>"

#. STRINGS.DUPLICANTS.MODEL.BIONIC.NAME_TOOLTIP
msgctxt "STRINGS.DUPLICANTS.MODEL.BIONIC.NAME_TOOLTIP"
