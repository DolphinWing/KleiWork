msgctxt "STRINGS.CREATURES.ATTRIBUTES.FERTILITYDELTA.NAME"
msgid "Reproduction Rate"
msgstr "繁殖率"

#. STRINGS.CREATURES.ATTRIBUTES.INCUBATIONDELTA.DESC
msgctxt "STRINGS.CREATURES.ATTRIBUTES.INCUBATIONDELTA.DESC"
msgid ""
