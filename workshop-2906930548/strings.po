msgid "<link=\"SNAIL\">Slogo Egg</link>"
msgstr "<link=\"SNAIL\">緩螺蛋</link>"

#. STRINGS.CREATURES.SPECIES.SNAIL.NAME
msgctxt "STRINGS.CREATURES.SPECIES.SNAIL.NAME"
msgid "<link=\"SNAIL\">Slogo</link>"
msgstr "<link=\"SNAIL\">緩螺</link>"

#. STRINGS.CREATURES.SPECIES.SNAIL.VARIANT_IRON.BABY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.SNAIL.VARIANT_IRON.BABY.DESC"
msgid "A tiny little Gildgo Baby.\n\nIn time it will mature into a fully grown <link=\"SNAILIRON\">Gildgo</link>."
msgstr "一隻小小的金曜螺寶寶。\n\n隨著時間經過，牠會成長為一隻成年的<link=\"SNAILIRON\">金曜螺</link>。"

#. STRINGS.CREATURES.SPECIES.SNAIL.VARIANT_IRON.BABY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.SNAIL.VARIANT_IRON.BABY.NAME"
msgid "<link=\"SNAILIRON\">Gildgo Baby</link>"
msgstr "<link=\"SNAILIRON\">金曜螺寶寶</link>"

#. STRINGS.CREATURES.SPECIES.SNAIL.VARIANT_IRON.DESC
msgctxt "STRINGS.CREATURES.SPECIES.SNAIL.VARIANT_IRON.DESC"
msgid "Gildgos are nonhostile critters that consume <link=\"SULFUR\">Sulfur</link> and excrete <link=\"OBSIDIAN\">Obsidian</link>.\n\nThe shells they leave behind after molting can be crushed into <link=\"GOLDAMALGAM\">Gold Amalgam</link>.\n\nThey also leave large amounts of <link=\"MUCUS\">Mucin</link> in their wake."
msgstr "金曜螺是一種無攻擊性的小動物，以<link=\"SULFUR\">硫</link>為食並排出<link=\"OBSIDIAN\">黑曜石</link>。\n\n牠們蛻殼後留下的殼可以粉碎成<link=\"GOLDAMALGAM\">金汞齊</link>。\n\n牠們爬行經過的地方會留下大量的<link=\"MUCUS\">黏蛋白</link>。"

#. STRINGS.CREATURES.SPECIES.SNAIL.VARIANT_IRON.EGG_NAME
msgctxt "STRINGS.CREATURES.SPECIES.SNAIL.VARIANT_IRON.EGG_NAME"
msgid "<link=\"SNAILIRON\">Gildgo Egg</link>"
msgstr "<link=\"SNAILIRON\">金曜螺蛋</link>"

#. STRINGS.CREATURES.SPECIES.SNAIL.VARIANT_IRON.NAME
msgctxt "STRINGS.CREATURES.SPECIES.SNAIL.VARIANT_IRON.NAME"
msgid "<link=\"SNAILIRON\">Gildgo</link>"
msgstr "<link=\"SNAILIRON\">金曜螺</link>"

#. STRINGS.CREATURES.SPECIES.SPACETREE.DESC
msgctxt "STRINGS.CREATURES.SPECIES.SPACETREE.DESC"
msgid "Bonbon Tree branches synthesize <link=\"LIGHT\">Light</link> to produce <link=\"SUGARWATER\">Nectar</link>.\n\nBranches can be harvested for <link=\"WOOD\">Wood</link>.\n\nBonbon Trees can shed most environmental debris, and rarely become entombed."
msgstr "糖心樹枝結合<link=\"LIGHT\">光</link>並產生<link=\"SUGARWATER\">花蜜</link>。分枝可收成<link=\"WOOD\">木材</link>。\n\n糖心樹可以遮擋大部分環境碎片，並且很少被掩埋。"

#. STRINGS.CREATURES.SPECIES.SPACETREE.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.SPACETREE.DOMESTICATEDDESC"
msgid "This plant produces <link=\"SUGARWATER\">Nectar</link> and <link=\"WOOD\">Wood</link>."
msgstr "這株植物生產<link=\"SUGARWATER\">花蜜</link>和<link=\"WOOD\">木材</link>。"

#. STRINGS.CREATURES.SPECIES.SPACETREE.NAME
msgctxt "STRINGS.CREATURES.SPECIES.SPACETREE.NAME"
msgid "<link=\"SPACETREE\">Bonbon Tree</link>"
msgstr "<link=\"SPACETREE\">糖心樹</link>"

#. STRINGS.CREATURES.SPECIES.SPICE_VINE.DESC
msgctxt "STRINGS.CREATURES.SPECIES.SPICE_VINE.DESC"
msgid "Pincha Pepperplants produce flavorful <link=\"SPICENUT\">Pincha Peppernut</link> for spicing <link=\"FOOD\">Food</link>."
msgstr "胡椒藤生產美味的<link=\"SPICENUT\">胡椒</link>，用於<link=\"FOOD\">食物</link>調味。"

#. STRINGS.CREATURES.SPECIES.SPICE_VINE.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.SPICE_VINE.DOMESTICATEDDESC"
msgid "This plant produces <link=\"SPICENUT\">Pincha Peppernut</link> spices."
msgstr "這株植物生產<link=\"SPICENUT\">胡椒</link>香料。"

#. STRINGS.CREATURES.SPECIES.SPICE_VINE.NAME
msgctxt "STRINGS.CREATURES.SPECIES.SPICE_VINE.NAME"
msgid "<link=\"SPICEVINE\">Pincha Pepperplant</link>"
msgstr "<link=\"SPICEVINE\">胡椒藤</link>"

#. STRINGS.CREATURES.SPECIES.SQUID.BABY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.SQUID.BABY.DESC"
msgid "A rubbery little Glo Squid Larva.\n\nOne day, it will grow into a radiant <link=\"SQUID\">Glo Squid</link>."
msgstr "一隻橡膠質地的小型彩斑魷幼體。\n\n終有一天，牠會長成光彩奪目的<link=\"SQUID\">彩斑魷</link>。"

#. STRINGS.CREATURES.SPECIES.SQUID.BABY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.SQUID.BABY.NAME"
msgid "<link=\"SQUID\">Glo Squid Larva</link>"
msgstr "<link=\"SQUID\">彩斑魷幼體</link>"

#. STRINGS.CREATURES.SPECIES.SQUID.DESC
msgctxt "STRINGS.CREATURES.SPECIES.SQUID.DESC"
msgid "Glo Squids are nonhostile critters unless their eggs are nearby.\n\nThey eat <link=\"TUBEWORM\">Tublia</link> and excrete <link=\"KATAIRITE\">Abyssalite</link> .\n\nThey can be milked for <link=\"INK\">Squid Ink</link>."
msgstr "除非蛋在附近，否則彩斑魷是非敵對的小動物。\n\n牠們以<link=\"TUBEWORM\">暖管蟲</link>為食，並會排出<link=\"KATAIRITE\">深淵晶石</link>。\n\n牠們可以被採集以獲取<link=\"INK\">墨魚汁</link>。"

#. STRINGS.CREATURES.SPECIES.SQUID.EGG_NAME
msgctxt "STRINGS.CREATURES.SPECIES.SQUID.EGG_NAME"
msgid "<link=\"SQUID\">Glo Squid Egg</link>"
msgstr "<link=\"SQUID\">彩斑魷卵</link>"

#. STRINGS.CREATURES.SPECIES.SQUID.INK_PUNCH
msgctxt "STRINGS.CREATURES.SPECIES.SQUID.INK_PUNCH"
msgid "Ink Shot"
msgstr "墨汁噴射"

#. STRINGS.CREATURES.SPECIES.SQUID.NAME
msgctxt "STRINGS.CREATURES.SPECIES.SQUID.NAME"
msgid "<link=\"SQUID\">Glo Squid</link>"
msgstr "<link=\"SQUID\">彩斑魷</link>"

#. STRINGS.CREATURES.SPECIES.SQUIRREL.BABY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.SQUIRREL.BABY.DESC"
msgid "A little purring Pipsqueak.\n\nIn time it will mature into a fully grown <link=\"SQUIRREL\">Pip</link>."
msgstr "一隻發出咕嚕叫聲的樹鼠寶寶。\n\n隨著時間，牠會長大成為一隻成年的<link=\"SQUIRREL\">樹鼠</link>。"

#. STRINGS.CREATURES.SPECIES.SQUIRREL.BABY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.SQUIRREL.BABY.NAME"
msgid "<link=\"SQUIRREL\">Pipsqueak</link>"
msgstr "<link=\"SQUIRREL\">樹鼠寶寶</link>"

#. STRINGS.CREATURES.SPECIES.SQUIRREL.DESC
msgctxt "STRINGS.CREATURES.SPECIES.SQUIRREL.DESC"
msgid "Pips are pesky, nonhostile critters that subsist on <link=\"BASICFABRICPLANT\">Thimble Reeds</link> and <link=\"FORESTTREE\">Arbor Tree</link> branches.\n\nThey are known to bury <link=\"PLANTS\">Seeds</link> in the ground whenever they can find a suitable area with enough space."
msgstr "樹鼠是頑皮，友善的小動物，以<link=\"BASICFABRICPLANT\">頂針蘆葦</link>和<link=\"FORESTTREE\">喬木樹</link>的分枝為食。\n\n衆所周知，牠們一旦找到足夠大的合適區域，就會把<link=\"PLANTS\">種子</link>種到地上。"

#. STRINGS.CREATURES.SPECIES.SQUIRREL.EGG_NAME
msgctxt "STRINGS.CREATURES.SPECIES.SQUIRREL.EGG_NAME"
msgid "<link=\"SQUIRREL\">Pip Egg</link>"
msgstr "<link=\"SQUIRREL\">樹鼠蛋</link>"

#. STRINGS.CREATURES.SPECIES.SQUIRREL.NAME
msgctxt "STRINGS.CREATURES.SPECIES.SQUIRREL.NAME"
msgid "<link=\"SQUIRREL\">Pip</link>"
msgstr "<link=\"SQUIRREL\">樹鼠</link>"

#. STRINGS.CREATURES.SPECIES.SQUIRREL.VARIANT_HUG.BABY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.SQUIRREL.VARIANT_HUG.BABY.DESC"
msgid "A fuzzy little Cuddle Pipsqueak.\n\nIn time it will mature into a fully grown <link=\"SQUIRREL\">Cuddle Pip</link>."
msgstr "一隻嗷嗷叫的抱抱樹鼠寶寶。\n\n隨著時間經過，牠會成長為一隻成年的<link=\"SQUIRREL\">抱抱樹鼠</link>。"

#. STRINGS.CREATURES.SPECIES.SQUIRREL.VARIANT_HUG.BABY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.SQUIRREL.VARIANT_HUG.BABY.NAME"
msgid "<link=\"SQUIRREL\">Cuddle Pipsqueak</link>"
msgstr "<link=\"SQUIRREL\">抱抱樹鼠寶寶</link>"

#. STRINGS.CREATURES.SPECIES.SQUIRREL.VARIANT_HUG.DESC
msgctxt "STRINGS.CREATURES.SPECIES.SQUIRREL.VARIANT_HUG.DESC"
msgid "Cuddle Pips are fluffy, affectionate critters who exhibit a strong snuggling instinct towards all types of eggs.\n\nThis is temporarily amplified when they are hugged by a passing Duplicant."
msgstr "抱抱樹鼠是毛茸茸的、深情的小動物，牠們對所有類型的蛋都表現出強烈的擁抱本能。\n\n當牠們被路過的複製人擁抱時，這種情況會暫時加強。"

#. STRINGS.CREATURES.SPECIES.SQUIRREL.VARIANT_HUG.EGG_NAME
msgctxt "STRINGS.CREATURES.SPECIES.SQUIRREL.VARIANT_HUG.EGG_NAME"
msgid "<link=\"SQUIRREL\">Cuddle Pip Egg</link>"
msgstr "<link=\"SQUIRREL\">抱抱樹鼠蛋</link>"

#. STRINGS.CREATURES.SPECIES.SQUIRREL.VARIANT_HUG.NAME
msgctxt "STRINGS.CREATURES.SPECIES.SQUIRREL.VARIANT_HUG.NAME"
msgid "<link=\"SQUIRREL\">Cuddle Pip</link>"
msgstr "<link=\"SQUIRREL\">抱抱樹鼠</link>"

#. STRINGS.CREATURES.SPECIES.STATERPILLAR.BABY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.STATERPILLAR.BABY.DESC"
msgid "A chubby little Plug Sluglet.\n\nIn time it will mature into a fully grown <link=\"STATERPILLAR\">Plug Slug</link>."
msgstr "一隻圓滾滾的電氣蛞蝓寶寶。\n\n隨著時間經過，牠會成長為一隻成年的<link=\"STATERPILLAR\">電氣蛞蝓</link>。"

#. STRINGS.CREATURES.SPECIES.STATERPILLAR.BABY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.STATERPILLAR.BABY.NAME"
msgid "<link=\"STATERPILLAR\">Plug Sluglet</link>"
msgstr "<link=\"STATERPILLAR\">電氣蛞蝓寶寶</link>"

#. STRINGS.CREATURES.SPECIES.STATERPILLAR.DESC
msgctxt "STRINGS.CREATURES.SPECIES.STATERPILLAR.DESC"
msgid "Plug Slugs are dynamic creatures that generate electrical <link=\"POWER\">Power</link> during the night.\n\nTheir power can be harnessed by leaving an exposed wire near areas where they like to sleep."
msgstr "電氣蛞蝓是一種在晚上會<link=\"POWER\">發電</link>的動物。\n\n在牠們睡覺的附近拉一些電線，就可以利用牠們發出的電力。"

#. STRINGS.CREATURES.SPECIES.STATERPILLAR.EGG_NAME
msgctxt "STRINGS.CREATURES.SPECIES.STATERPILLAR.EGG_NAME"
msgid "<link=\"STATERPILLAR\">Plug Slug Egg</link>"
msgstr "<link=\"STATERPILLAR\">電氣蛞蝓蛋</link>"

#. STRINGS.CREATURES.SPECIES.STATERPILLAR.NAME
msgctxt "STRINGS.CREATURES.SPECIES.STATERPILLAR.NAME"
msgid "<link=\"STATERPILLAR\">Plug Slug</link>"
msgstr "<link=\"STATERPILLAR\">電氣蛞蝓</link>"

#. STRINGS.CREATURES.SPECIES.STATERPILLAR.VARIANT_GAS.BABY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.STATERPILLAR.VARIANT_GAS.BABY.DESC"
msgid "A tubby little Smog Sluglet.\n\nIn time it will mature into a fully grown <link=\"STATERPILLAR\">Smog Slug</link>."
msgstr "一隻胖嘟嘟的煙霧蛞蝓寶寶。\n\n隨著時間經過，牠會成長為一隻成年的<link=\"STATERPILLAR\">煙霧蛞蝓</link>。"

#. STRINGS.CREATURES.SPECIES.STATERPILLAR.VARIANT_GAS.BABY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.STATERPILLAR.VARIANT_GAS.BABY.NAME"
msgid "<link=\"STATERPILLAR\">Smog Sluglet</link>"
msgstr "<link=\"STATERPILLAR\">煙霧蛞蝓寶寶</link>"

#. STRINGS.CREATURES.SPECIES.STATERPILLAR.VARIANT_GAS.DESC
msgctxt "STRINGS.CREATURES.SPECIES.STATERPILLAR.VARIANT_GAS.DESC"
msgid "Smog Slugs are porous creatures that draw in unbreathable <link=\"ELEMENTSGAS\">Gases</link> during the day.\n\nAt night, they sleep near exposed <link=\"GASCONDUIT\">Gas Pipes,</link> where they deposit their cache."
msgstr "煙霧蛞蝓是一種多孔生物，能夠在白天吸入不可呼吸的<link=\"ELEMENTSGAS\">氣體</link>。\n\n在晚上，牠們會睡在<link=\"GASCONDUIT\">氣體管</link>附近，向其中存放其吸收物。"

#. STRINGS.CREATURES.SPECIES.STATERPILLAR.VARIANT_GAS.EGG_NAME
msgctxt "STRINGS.CREATURES.SPECIES.STATERPILLAR.VARIANT_GAS.EGG_NAME"
msgid "<link=\"STATERPILLAR\">Smog Slug Egg</link>"
msgstr "<link=\"STATERPILLAR\">煙霧蛞蝓蛋</link>"

#. STRINGS.CREATURES.SPECIES.STATERPILLAR.VARIANT_GAS.NAME
msgctxt "STRINGS.CREATURES.SPECIES.STATERPILLAR.VARIANT_GAS.NAME"
msgid "<link=\"STATERPILLAR\">Smog Slug</link>"
msgstr "<link=\"STATERPILLAR\">煙霧蛞蝓</link>"

#. STRINGS.CREATURES.SPECIES.STATERPILLAR.VARIANT_LIQUID.BABY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.STATERPILLAR.VARIANT_LIQUID.BABY.DESC"
msgid "A chonky little Sponge Sluglet.\n\nIn time it will mature into a fully grown <link=\"STATERPILLAR\">Sponge Slug</link>."
msgstr "一隻結實的海綿蛞蝓寶寶。\n\n隨著時間經過，牠會成長為一隻成年的<link=\"STATERPILLAR\">海綿蛞蝓</link>。"

#. STRINGS.CREATURES.SPECIES.STATERPILLAR.VARIANT_LIQUID.BABY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.STATERPILLAR.VARIANT_LIQUID.BABY.NAME"
msgid "<link=\"STATERPILLAR\">Sponge Sluglet</link>"
msgstr "<link=\"STATERPILLAR\">海綿蛞蝓寶寶</link>"

#. STRINGS.CREATURES.SPECIES.STATERPILLAR.VARIANT_LIQUID.DESC
msgctxt "STRINGS.CREATURES.SPECIES.STATERPILLAR.VARIANT_LIQUID.DESC"
msgid "Sponge Slugs are thirsty creatures that soak up <link=\"ELEMENTSLIQUID\">Liquids</link> during the day.\n\nThey deposit their stored <link=\"ELEMENTSLIQUID\">Liquids</link> into the exposed <link=\"LIQUIDCONDUIT\">Liquid Pipes</link> they sleep next to at night."
msgstr "海綿蛞蝓是一種缺水生物，能夠在白天吸收<link=\"ELEMENTSLIQUID\">液體</link>。\n\n在晚上睡覺時，牠們會將保存的<link=\"ELEMENTSLIQUID\">液體</link>存放到其附近的<link=\"LIQUIDCONDUIT\">液體管</link>中。"

#. STRINGS.CREATURES.SPECIES.STATERPILLAR.VARIANT_LIQUID.EGG_NAME
msgctxt "STRINGS.CREATURES.SPECIES.STATERPILLAR.VARIANT_LIQUID.EGG_NAME"
msgid "<link=\"STATERPILLAR\">Sponge Slug Egg</link>"
msgstr "<link=\"STATERPILLAR\">海綿蛞蝓蛋</link>"

#. STRINGS.CREATURES.SPECIES.STATERPILLAR.VARIANT_LIQUID.NAME
msgctxt "STRINGS.CREATURES.SPECIES.STATERPILLAR.VARIANT_LIQUID.NAME"
msgid "<link=\"STATERPILLAR\">Sponge Slug</link>"
msgstr "<link=\"STATERPILLAR\">海綿蛞蝓</link>"

#. STRINGS.CREATURES.SPECIES.STEAMSPOUT.DESC
msgctxt "STRINGS.CREATURES.SPECIES.STEAMSPOUT.DESC"
msgid "A rocky vent that spouts <link=\"STEAM\">Steam</link>."
msgstr "噴出<link=\"STEAM\">蒸氣</link>的岩洞。"

#. STRINGS.CREATURES.SPECIES.STEAMSPOUT.NAME
msgctxt "STRINGS.CREATURES.SPECIES.STEAMSPOUT.NAME"
msgid "<link=\"GEYSERS\">Steam Spout</link>"
msgstr "<link=\"GEYSERS\">蒸氣噴口</link>"

#. STRINGS.CREATURES.SPECIES.STEGO.BABY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.STEGO.BABY.DESC"
msgid "A heavy-footed little Lumb baby.\n\nIn time, it will grow into a stompy <link=\"STEGO\">Lumb</link>."
msgstr "一隻腳步沉重的豐足劍龍寶寶。\n\n假以時日，牠將會長大成一隻大步跺地的<link=\"STEGO\">豐足劍龍</link>。"

#. STRINGS.CREATURES.SPECIES.STEGO.BABY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.STEGO.BABY.NAME"
msgid "<link=\"STEGO\">Lumblet</link>"
msgstr "<link=\"STEGO\">豐足劍龍寶寶</link>"

#. STRINGS.CREATURES.SPECIES.STEGO.DESC
msgctxt "STRINGS.CREATURES.SPECIES.STEGO.DESC"
msgid "Lumbs are non-hostile critters that subsist on <link=\"VINEMOTHER\">Ovagro</link> vines.\n\nWhen they stomp heavily near <link=\"PLANTS\">plants</link>, the commotion causes harvestable items to fall to the ground."
msgstr "豐足劍龍是沒有敵意的小動物，牠們以<link=\"VINEMOTHER\">蔓殖母藤</link>的藤蔓為生。\n\n當牠們靠近<link=\"PLANTS\">植物</link>重踏時，這種騷動會導致可收穫的物品掉落地面。"

#. STRINGS.CREATURES.SPECIES.STEGO.EGG_NAME
msgctxt "STRINGS.CREATURES.SPECIES.STEGO.EGG_NAME"
msgid "<link=\"STEGO\">Lumb Egg</link>"
msgstr "<link=\"STEGO\">豐足劍龍蛋</link>"

#. STRINGS.CREATURES.SPECIES.STEGO.NAME
msgctxt "STRINGS.CREATURES.SPECIES.STEGO.NAME"
msgid "<link=\"STEGO\">Lumb</link>"
msgstr "<link=\"STEGO\">豐足劍龍</link>"

#. STRINGS.CREATURES.SPECIES.SUPERWORMPLANT.DESC
msgctxt "STRINGS.CREATURES.SPECIES.SUPERWORMPLANT.DESC"
msgid "A Grubfruit Plant that has flourished after being tended by a <link=\"DIVERGENTSPECIES\">Divergent</link> critter.\n\nIt will produce high quality <link=\"WORMSUPERFRUIT\">Grubfruits</link>."
msgstr "蟲蜜草在感受到<link=\"DIVERGENTSPECIES\">變異蟲</link>親近時會長得很茂盛。\n\n它會生產高品質的<link=\"WORMSUPERFRUIT\">蟲蜜果</link>。"

#. STRINGS.CREATURES.SPECIES.SUPERWORMPLANT.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.SUPERWORMPLANT.DOMESTICATEDDESC"
msgid "This plant produces edible <link=\"WORMSUPERFRUIT\">Grubfruit</link>."
msgstr "這株植物生產可食用的<link=\"WORMSUPERFRUIT\">蟲蜜果</link>。"

#. STRINGS.CREATURES.SPECIES.SUPERWORMPLANT.NAME
msgctxt "STRINGS.CREATURES.SPECIES.SUPERWORMPLANT.NAME"
msgid "<link=\"WORMPLANT\">Grubfruit Plant</link>"
msgstr "<link=\"WORMPLANT\">蟲蜜草</link>"

#. STRINGS.CREATURES.SPECIES.SWAMPFORAGEPLANTPLANTED.DESC
msgctxt "STRINGS.CREATURES.SPECIES.SWAMPFORAGEPLANTPLANTED.DESC"
msgid "Swamp Chards are incapable of propagating but can be harvested for a single low quality and calorie dense <link=\"FOOD\">Food</link> serving."
msgstr "沼澤甜菜不能繁殖，但可以收成單顆果實，作為高卡路里的<link=\"FOOD\">食物</link>。"

#. STRINGS.CREATURES.SPECIES.SWAMPFORAGEPLANTPLANTED.NAME
msgctxt "STRINGS.CREATURES.SPECIES.SWAMPFORAGEPLANTPLANTED.NAME"
msgid "<link=\"SWAMPFORAGEPLANTPLANTED\">Swamp Chard</link>"
msgstr "<link=\"SWAMPFORAGEPLANTPLANTED\">沼澤甜菜</link>"

#. STRINGS.CREATURES.SPECIES.SWAMPHARVESTPLANT.DESC
msgctxt "STRINGS.CREATURES.SPECIES.SWAMPHARVESTPLANT.DESC"
msgid "Bog Buckets produce juicy, sweet <link=\"SWAMPFRUIT\">Bog Jellies</link> for <link=\"FOOD\">Food</link>."
msgstr "沼澤豬籠草生產多汁，香甜的<link=\"SWAMPFRUIT\">沼澤果凍</link>可作為<link=\"FOOD\">食物</link>。"

#. STRINGS.CREATURES.SPECIES.SWAMPHARVESTPLANT.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.SWAMPHARVESTPLANT.DOMESTICATEDDESC"
msgid "This plant produces edible <link=\"SWAMPFRUIT\">Bog Jellies</link>."
msgstr "這株植物生產可食用的<link=\"SWAMPFRUIT\">沼澤果凍</link>。"

#. STRINGS.CREATURES.SPECIES.SWAMPHARVESTPLANT.NAME
msgctxt "STRINGS.CREATURES.SPECIES.SWAMPHARVESTPLANT.NAME"
msgid "<link=\"SWAMPHARVESTPLANT\">Bog Bucket</link>"
msgstr "<link=\"SWAMPHARVESTPLANT\">沼澤豬籠草</link>"

#. STRINGS.CREATURES.SPECIES.SWAMPLILY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.SWAMPLILY.DESC"
msgid "Balm Lilies produce <link=\"SWAMPLILYFLOWER\">Balm Lily Flower</link>, a lovely bloom with medicinal properties."
msgstr "香水百合會開出<link=\"SWAMPLILYFLOWER\">香水百合花</link>，一種有藥用性質的美麗花朵。"

#. STRINGS.CREATURES.SPECIES.SWAMPLILY.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.SWAMPLILY.DOMESTICATEDDESC"
msgid "This plant produces medicinal <link=\"SWAMPLILYFLOWER\">Balm Lily Flower</link>."
msgstr "這株植物生產醫療用的<link=\"SWAMPLILYFLOWER\">香水百合花</link>。"

#. STRINGS.CREATURES.SPECIES.SWAMPLILY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.SWAMPLILY.NAME"
msgid "<link=\"SWAMPLILY\">Balm Lily</link>"
msgstr "<link=\"SWAMPLILY\">香水百合</link>"

#. STRINGS.CREATURES.SPECIES.TOEPLANT.DESC
msgctxt "STRINGS.CREATURES.SPECIES.TOEPLANT.DESC"
msgid "Tranquil Toes improve <link=\"DECOR\">Decor</link> by giving their surroundings the visual equivalent of a foot rub."
msgstr "安寧芷提升<link=\"DECOR\">裝飾</link>，它們的周圍視覺效果像是搓腳一般。"

#. STRINGS.CREATURES.SPECIES.TOEPLANT.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.TOEPLANT.DOMESTICATEDDESC"
msgid "This plant improves ambient <link=\"DECOR\">Decor</link>."
msgstr "這株植物可改善環境<link=\"DECOR\">裝飾</link>。"

#. STRINGS.CREATURES.SPECIES.TOEPLANT.GROWTH_BONUS
msgctxt "STRINGS.CREATURES.SPECIES.TOEPLANT.GROWTH_BONUS"
msgid "Growth Bonus"
msgstr "生長加成"

#. STRINGS.CREATURES.SPECIES.TOEPLANT.NAME
msgctxt "STRINGS.CREATURES.SPECIES.TOEPLANT.NAME"
msgid "<link=\"TOEPLANT\">Tranquil Toes</link>"
msgstr "<link=\"TOEPLANT\">安寧芷</link>"

#. STRINGS.CREATURES.SPECIES.TOEPLANT.WILT_PENALTY
msgctxt "STRINGS.CREATURES.SPECIES.TOEPLANT.WILT_PENALTY"
msgid "Wilt Penalty"
msgstr "枯萎懲罰"

#. STRINGS.CREATURES.SPECIES.TUBEWORM.DESC
msgctxt "STRINGS.CREATURES.SPECIES.TUBEWORM.DESC"
msgid "Tublias are aquatic organisms that sprout in <link=\"HEAT\">Hot</link> liquid environments.\n\nThey can be harvested for <link=\"POLYPROPYLENE\">Plastic</link>."
msgstr "暖管蟲是生長於<link=\"HEAT\">高溫</link>液體環境中的水生生物。\n\n採收後可獲得<link=\"POLYPROPYLENE\">塑膠</link>。"

#. STRINGS.CREATURES.SPECIES.TUBEWORM.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.TUBEWORM.DOMESTICATEDDESC"
msgid "This organism produces <link=\"POLYPROPYLENE\">Plastic</link>."
msgstr "這種生物可產出<link=\"POLYPROPYLENE\">塑膠</link>。"

#. STRINGS.CREATURES.SPECIES.TUBEWORM.NAME
msgctxt "STRINGS.CREATURES.SPECIES.TUBEWORM.NAME"
msgid "<link=\"TUBEWORM\">Tublia</link>"
msgstr "<link=\"TUBEWORM\">暖管蟲</link>"

#. STRINGS.CREATURES.SPECIES.URCHINPLANT.DESC
msgctxt "STRINGS.CREATURES.SPECIES.URCHINPLANT.DESC"
msgid "Pinpokets produce <link=\"URCHIN\">Pinpoki</link>, which can be processed into <link=\"URCHINMEAT\">Uni</link> or <link=\"DIAMOND\">Diamond</link>."
msgstr "針膽團可產生<link=\"SEAURCHIN\">針膽</link>，後者可加工成<link=\"URCHINMEAT\">針膽黃</link>或<link=\"DIAMOND\">鑽石</link>。"

#. STRINGS.CREATURES.SPECIES.URCHINPLANT.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.URCHINPLANT.DOMESTICATEDDESC"
msgid "This organism produces edible <link=\"URCHIN\">Pinpoki</link>."
msgstr "這種生物可產出可食用的<link=\"SEAURCHIN\">針膽</link>。"

#. STRINGS.CREATURES.SPECIES.URCHINPLANT.NAME
msgctxt "STRINGS.CREATURES.SPECIES.URCHINPLANT.NAME"
msgid "<link=\"URCHINPLANT\">Pinpoket</link>"
msgstr "<link=\"URCHINPLANT\">針膽團</link>"

#. STRINGS.CREATURES.SPECIES.VINEBRANCH.DESC
msgctxt "STRINGS.CREATURES.SPECIES.VINEBRANCH.DESC"
msgid "Ovagro Vines are plants that produce edible <link=\"VINEFRUIT\">Ovagro Fig</link>.\n\nIf a vine is cut off from its <link=\"VINEMOTHER\">Ovagro Node</link>, it will perish."
msgstr "蔓殖藤是會結出可食用的<link=\"VINEFRUIT\">蔓殖燈籠果</link>的植物。\n\n如果藤蔓與<link=\"VINEMOTHER\">蔓殖母藤</link>的聯繫被切斷，它就會死亡。"

#. STRINGS.CREATURES.SPECIES.VINEBRANCH.NAME
msgctxt "STRINGS.CREATURES.SPECIES.VINEBRANCH.NAME"
msgid "<link=\"VINEMOTHER\">Ovagro Vine</link>"
msgstr "<link=\"VINEMOTHER\">蔓殖藤</link>"

#. STRINGS.CREATURES.SPECIES.VINEMOTHER.DESC
msgctxt "STRINGS.CREATURES.SPECIES.VINEMOTHER.DESC"
msgid "Ovagro Nodes are trellis plants that spread onto nearby available surfaces.\n\nA single <link=\"VINEMOTHER\">Ovagro Node</link> can support several <link=\"VINEMOTHER\">Ovagro Vines</link> without any increase in its <link=\"WATER\">Water</link> requirements."
msgstr "蔓殖母藤是一種蔓棚植物，會侵佔附近的可用表面。\n\n單個<link=\"VINEMOTHER\">蔓殖母藤</link>能供養多條<link=\"VINEMOTHER\">蔓殖藤</link>，而不會增加它對<link=\"WATER\">水</link>的需求量。"

#. STRINGS.CREATURES.SPECIES.VINEMOTHER.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.VINEMOTHER.DOMESTICATEDDESC"
msgid "This plant produces <link=\"VINEFRUIT\">Ovagro Fig</link>."
msgstr "這種植物可產出<link=\"VINEFRUIT\">蔓殖燈籠果</link>。"

#. STRINGS.CREATURES.SPECIES.VINEMOTHER.NAME
msgctxt "STRINGS.CREATURES.SPECIES.VINEMOTHER.NAME"
msgid "<link=\"VINEMOTHER\">Ovagro Node</link>"
msgstr "<link=\"VINEMOTHER\">蔓殖母藤</link>"

#. STRINGS.CREATURES.SPECIES.WATERCUPS.DESC
msgctxt "STRINGS.CREATURES.SPECIES.WATERCUPS.DESC"
msgid "Husha Cups are <link=\"DECOR\">Decorative</link> <link=\"PLANTS\">Plants</link> with a temper-cooling blue hue.\n\nTheir presence provides a <link=\"MORALE\">Morale</link>-boosting \"cup half-full\" energy."
msgstr "靜杯花是一種擁有冷藍色調的<link=\"DECOR\">裝飾性</link><link=\"PLANTS\">植物</link>，能使情緒冷靜下來。\n\n它們的存在能營造出一種「半杯滿」的樂觀氛圍，進而提升<link=\"MORALE\">士氣</link>。"

#. STRINGS.CREATURES.SPECIES.WATERCUPS.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.WATERCUPS.DOMESTICATEDDESC"
msgid "This plant improves ambient <link=\"DECOR\">Decor</link>."
msgstr "這種植物可提高環境<link=\"DECOR\">裝飾度</link>。"

#. STRINGS.CREATURES.SPECIES.WATERCUPS.NAME
msgctxt "STRINGS.CREATURES.SPECIES.WATERCUPS.NAME"
msgid "<link=\"WATERCUPS\">Husha Cups</link>"
msgstr "<link=\"WATERCUPS\">靜杯花</link>"

#. STRINGS.CREATURES.SPECIES.WINECUPS.DESC
msgctxt "STRINGS.CREATURES.SPECIES.WINECUPS.DESC"
msgid "Mellow Mallows heighten <link=\"DECOR\">Decor</link> and alleviate <link=\"STRESS\">Stress</link> with their calming color and cradle shape."
msgstr "錦醇菇令人平靜的顏色與像搖籃的外觀，可提高<link=\"DECOR\">裝飾</link>與減少<link=\"STRESS\">壓力</link>。"

#. STRINGS.CREATURES.SPECIES.WINECUPS.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.WINECUPS.DOMESTICATEDDESC"
msgid "This plant improves ambient <link=\"DECOR\">Decor</link>."
msgstr "這株植物可改善環境<link=\"DECOR\">裝飾</link>。"

#. STRINGS.CREATURES.SPECIES.WINECUPS.GROWTH_BONUS
msgctxt "STRINGS.CREATURES.SPECIES.WINECUPS.GROWTH_BONUS"
msgid "Growth Bonus"
msgstr "生長加成"

#. STRINGS.CREATURES.SPECIES.WINECUPS.NAME
msgctxt "STRINGS.CREATURES.SPECIES.WINECUPS.NAME"
msgid "<link=\"WINECUPS\">Mellow Mallow</link>"
msgstr "<link=\"WINECUPS\">錦醇菇</link>"

#. STRINGS.CREATURES.SPECIES.WINECUPS.WILT_PENALTY
msgctxt "STRINGS.CREATURES.SPECIES.WINECUPS.WILT_PENALTY"
msgid "Wilt Penalty"
msgstr "枯萎懲罰"

#. STRINGS.CREATURES.SPECIES.WOOD_TREE.DESC
msgctxt "STRINGS.CREATURES.SPECIES.WOOD_TREE.DESC"
msgid "Arbor Trees grow <link=\"FORESTTREE\">Arbor Tree Branches</link> and can be harvested for <link=\"WOOD\">Wood</link>."
msgstr "喬木樹可以長出<link=\"FORESTTREE\">喬木樹枝</link>，可收成為<link=\"WOOD\">木材</link>。"

#. STRINGS.CREATURES.SPECIES.WOOD_TREE.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.WOOD_TREE.DOMESTICATEDDESC"
msgid "This plant produces <link=\"FORESTTREE\">Arbor Tree Branches</link> that can be harvested for <link=\"WOOD\">Wood</link>."
msgstr "這株植物生產<link=\"FORESTTREE\">喬木樹枝</link>，可收成為<link=\"WOOD\">木材</link>。"

#. STRINGS.CREATURES.SPECIES.WOOD_TREE.NAME
msgctxt "STRINGS.CREATURES.SPECIES.WOOD_TREE.NAME"
msgid "<link=\"FORESTTREE\">Arbor Tree</link>"
msgstr "<link=\"FORESTTREE\">喬木樹</link>"

#. STRINGS.CREATURES.SPECIES.WOOD_TREE_BRANCH.DESC
msgctxt "STRINGS.CREATURES.SPECIES.WOOD_TREE_BRANCH.DESC"
msgid "Arbor Trees Branches can be harvested for <link=\"WOOD\">Wood</link>."
msgstr "喬木樹枝可以收成為<link=\"WOOD\">木材</link>。"

#. STRINGS.CREATURES.SPECIES.WOOD_TREE_BRANCH.NAME
msgctxt "STRINGS.CREATURES.SPECIES.WOOD_TREE_BRANCH.NAME"
msgid "<link=\"FORESTTREE\">Arbor Tree Branch</link>"
msgstr "<link=\"FORESTTREE\">喬木樹枝</link>"

#. STRINGS.CREATURES.SPECIES.WOODDEER.BABY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.WOODDEER.BABY.DESC"
msgid "A little yipping Flox Fawn.\n\nIn time it will mature into a fully grown <link=\"WOODDEER\">Flox</link>."
msgstr "一隻嚎叫的狐鹿克斯寶寶。\n\n隨著時間經過，牠會成長為一隻成年的<link=\"WOODDEER\">狐鹿克斯</link>。"

#. STRINGS.CREATURES.SPECIES.WOODDEER.BABY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.WOODDEER.BABY.NAME"
msgid "<link=\"WOODDEER\">Flox Fawn</link>"
msgstr "<link=\"WOODDEER\">狐鹿克斯寶寶</link>"

#. STRINGS.CREATURES.SPECIES.WOODDEER.DESC
msgctxt "STRINGS.CREATURES.SPECIES.WOODDEER.DESC"
msgid "Floxes are nonhostile critters that graze on <link=\"PRICKLEFLOWER\">Bristle Blossoms</link> and <link=\"HARDSKINBERRY\">Pikeapples</link>.\n\nWhen Flox antlers are fully grown, they harden into shearable <link=\"WOOD\">Wood</link>."
msgstr "狐鹿克斯是沒有敵意的小動物，吃<link=\"PRICKLEFLOWER\">鬃花</link>和<link=\"HARDSKINBERRY\">刺殼果</link>。\n\n狐鹿克斯的角長成時，會硬化為可修剪的<link=\"WOOD\">木材</link>。"

#. STRINGS.CREATURES.SPECIES.WOODDEER.EGG_NAME
msgctxt "STRINGS.CREATURES.SPECIES.WOODDEER.EGG_NAME"
msgid "<link=\"WOODDEER\">Flox Egg</link>"
msgstr "<link=\"WOODDEER\">狐鹿克斯蛋</link>"

#. STRINGS.CREATURES.SPECIES.WOODDEER.NAME
msgctxt "STRINGS.CREATURES.SPECIES.WOODDEER.NAME"
msgid "<link=\"WOODDEER\">Flox</link>"
msgstr "<link=\"WOODDEER\">狐鹿克斯</link>"

#. STRINGS.CREATURES.SPECIES.WORMPLANT.DESC
msgctxt "STRINGS.CREATURES.SPECIES.WORMPLANT.DESC"
msgid "Spindly Grubfruit Plants produce <link=\"WORMBASICFRUIT\">Spindly Grubfruit</link> for <link=\"FOOD\">Food</link>.\n\nIf it is tended by a <link=\"DIVERGENTSPECIES\">Divergent</link> critter, it will produce high quality fruits instead."
msgstr "蕪弱蟲蜜草生產<link=\"WORMBASICFRUIT\">劣質蟲蜜果</link>可作為<link=\"FOOD\">食物</link>。\n\n如果被<link=\"DIVERGENTSPECIES\">變異蟲</link>照料，會生產高品質的果實。"

#. STRINGS.CREATURES.SPECIES.WORMPLANT.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.WORMPLANT.DOMESTICATEDDESC"
msgid "This plant produces edible <link=\"WORMBASICFRUIT\">Spindly Grubfruit</link>."
msgstr "這株植物生產可食用的<link=\"WORMBASICFRUIT\">劣質蟲蜜果</link>。"

#. STRINGS.CREATURES.SPECIES.WORMPLANT.NAME
msgctxt "STRINGS.CREATURES.SPECIES.WORMPLANT.NAME"
msgid "<link=\"WORMPLANT\">Spindly Grubfruit Plant</link>"
msgstr "<link=\"WORMPLANT\">蕪弱蟲蜜草</link>"

#. STRINGS.CREATURES.STATS.AGE.NAME
msgctxt "STRINGS.CREATURES.STATS.AGE.NAME"
msgid "Age"
msgstr "年齡"

#. STRINGS.CREATURES.STATS.AGE.TOOLTIP
msgctxt "STRINGS.CREATURES.STATS.AGE.TOOLTIP"
msgid "This critter will die when its <style=\"KKeyword\">Age</style> reaches its species' maximum lifespan"
msgstr "這隻小動物的<style=\"KKeyword\">年齡</style>到達物種的最大壽命時將會死亡"

#. STRINGS.CREATURES.STATS.AIRPRESSURE.NAME
msgctxt "STRINGS.CREATURES.STATS.AIRPRESSURE.NAME"
msgid "Air Pressure"
msgstr "氣壓"

#. STRINGS.CREATURES.STATS.AIRPRESSURE.TOOLTIP
msgctxt "STRINGS.CREATURES.STATS.AIRPRESSURE.TOOLTIP"
msgid "The average <style=\"KKeyword\">Gas</style> density of the air surrounding this plant"
msgstr "這株植物周圍平均的<style=\"KKeyword\">氣體</style>密度"

#. STRINGS.CREATURES.STATS.BECKONING.NAME
msgctxt "STRINGS.CREATURES.STATS.BECKONING.NAME"
msgid "Accu-moo-lation"
msgstr "聚集度"

#. STRINGS.CREATURES.STATS.BECKONING.TOOLTIP
msgctxt "STRINGS.CREATURES.STATS.BECKONING.TOOLTIP"
msgid "At 100% <style=\"KKeyword\">Accu-moo-lation</style>, this critter will call a friend to join them on this asteroid\n\nOnce the newcomer has landed, <style=\"KKeyword\">Accu-moo-lation</style> is rolled back to 0%"
msgstr "<style=\"KKeyword\">聚集度</style>達到 100% 時，這隻小動物就會叫一個朋友來到這顆小行星\n\n新的瓦斯牛著陸後，<style=\"KKeyword\">聚集度</style>將重置為 0%"

#. STRINGS.CREATURES.STATS.CRITTERTEMPERATURE.NAME
msgctxt "STRINGS.CREATURES.STATS.CRITTERTEMPERATURE.NAME"
msgid "Body Temperature"
msgstr "體溫"

#. STRINGS.CREATURES.STATS.CRITTERTEMPERATURE.TOOLTIP
msgctxt "STRINGS.CREATURES.STATS.CRITTERTEMPERATURE.TOOLTIP"
msgid "This critter's comfortable <style=\"KKeyword\">Body Temperature</style> range is between <b>{0}</b> and <b>{1}</b>\n\nIts livable <style=\"KKeyword\">External Temperature</style> range is between <b>{2}</b> and <b>{3}</b>"
msgstr "這隻小動物的舒適<style=\"KKeyword\">體溫</style>範圍在 <b>{0}</b> 至 <b>{1}</b> 之間\n牠適合居住在<style=\"KKeyword\">外部溫度</style>範圍介於 <b>{2}</b> 和 <b>{3}</b> 之間"

#. STRINGS.CREATURES.STATS.DOMESTICATION.NAME
msgctxt "STRINGS.CREATURES.STATS.DOMESTICATION.NAME"
msgid "Domestication"
msgstr "馴化"

#. STRINGS.CREATURES.STATS.DOMESTICATION.TOOLTIP
msgctxt "STRINGS.CREATURES.STATS.DOMESTICATION.TOOLTIP"
msgid "Fully <style=\"KKeyword\">Tame</style> critters produce more materials than wild ones, and may even provide psychological benefits to my colony\n\nThis critter is <b>{0}</b> domesticated"
msgstr "完全<style=\"KKeyword\">馴化</style>的動物會比野生動物生產更多的材料，甚至可能讓殖民地心情愉快。\n\n這隻小動物被 <b>{0}</b> 馴化"

#. STRINGS.CREATURES.STATS.ELEMENTGROWTH.NAME
msgctxt "STRINGS.CREATURES.STATS.ELEMENTGROWTH.NAME"
msgid "Quill Growth"
msgstr "毛髮成長"

#. STRINGS.CREATURES.STATS.ELEMENTGROWTH.TOOLTIP
msgctxt "STRINGS.CREATURES.STATS.ELEMENTGROWTH.TOOLTIP"
msgid "The amount of time required for this critter to regrow its <style=\"KKeyword\">Tonic Root</style>"
msgstr "這隻小動物身上的<style=\"KKeyword\">辛香根</style>重長回來的所需時間"

#. STRINGS.CREATURES.STATS.FERTILITY.NAME
msgctxt "STRINGS.CREATURES.STATS.FERTILITY.NAME"
msgid "Reproduction"
msgstr "繁殖"

#. STRINGS.CREATURES.STATS.FERTILITY.TOOLTIP
msgctxt "STRINGS.CREATURES.STATS.FERTILITY.TOOLTIP"
msgid "At 100% <style=\"KKeyword\">Reproduction</style>, critters will reach the end of their reproduction cycle and lay a new <style=\"KKeyword\">Egg</style>\n\nAfter an <style=\"KKeyword\">Egg</style> is laid, <style=\"KKeyword\">Reproduction</style> is rolled back to 0%"
msgstr "在<style=\"KKeyword\">繁殖度</style>到達 100% 時，動物將結束繁殖期並產下一個<style=\"KKeyword\">蛋</style>\n\n在產下一個<style=\"KKeyword\">蛋</style>之後，<style=\"KKeyword\">繁殖度</style>將會變回 0%"

#. STRINGS.CREATURES.STATS.FERTILIZATION.ABSORBING_MODIFIER
msgctxt "STRINGS.CREATURES.STATS.FERTILIZATION.ABSORBING_MODIFIER"
msgid "Absorbing"
msgstr "吸收"

#. STRINGS.CREATURES.STATS.FERTILIZATION.NAME
msgctxt "STRINGS.CREATURES.STATS.FERTILIZATION.NAME"
msgid "Fertilization"
msgstr "施肥"

#. STRINGS.CREATURES.STATS.HAPPINESS.NAME
msgctxt "STRINGS.CREATURES.STATS.HAPPINESS.NAME"
msgid "Happiness"
msgstr "幸福度"

#. STRINGS.CREATURES.STATS.HAPPINESS.TOOLTIP
msgctxt "STRINGS.CREATURES.STATS.HAPPINESS.TOOLTIP"
msgid "High <style=\"KKeyword\">Happiness</style> increases a critter's productivity and indirectly improves their <style=\"KKeyword\">Egg</style> laying rates\n\nIt also provides the satisfaction in knowing they're living a good little critter life"
msgstr "高<style=\"KKeyword\">幸福度</style>增加一隻動物的生產力並間接的提高<style=\"KKeyword\">產蛋率</style>\n\n也讓人們知道小動物們過著美好的生活"

#. STRINGS.CREATURES.STATS.HAPPINESS.TOOLTIP_LUX
msgctxt "STRINGS.CREATURES.STATS.HAPPINESS.TOOLTIP_LUX"
msgid "High <style=\"KKeyword\">Happiness</style> increases a critter's productivity and enables them to produce <style=\"KKeyword\">Light</style>\n\nIt also indirectly improves their <style=\"KKeyword\">Egg</style> laying rates"
msgstr "高<style=\"KKeyword\">快樂度</style>會提高小動物的產量，並使牠們能產生<style=\"KKeyword\">光線</style>\n\n這也會間接提高牠們的產<style=\"KKeyword\">卵</style>率"

