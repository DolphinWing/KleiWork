msgctxt "STRINGS.CODEX.STORY_TRAITS.FOSSILHUNT.DNADATA_ENTRY_EXPANDED.BODY.SIGNATURE"
msgid "\nSincerely,\n[REDACTED]\n<size=11>The Gravitas Facility</size>\n------------------\n"
msgstr "\n謹上\n[資料塗銷]\n<size=11>引力科技中心</size>\n------------------\n"

