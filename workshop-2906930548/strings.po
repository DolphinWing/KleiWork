msgstr "拋殼蟹"

#. STRINGS.CODEX.POLLINATORS.BODY.CONTAINER1
msgctxt "STRINGS.CODEX.POLLINATORS.BODY.CONTAINER1"
msgid "Pollination is a symbiotic interaction between <link=\"PLANTS\">Plants</link> and certain <link=\"CREATURES\">Critter</link> species, which benefits plant growth.\n\nSome <link=\"PLANTS\">Plants</link> rely on pollinators in order to grow at all, while others receive a valuable acceleration to their natural growth speed."
msgstr "授粉是<link=\"PLANTS\">植物</link>與某些<link=\"CREATURES\">小動物</link>之間的一種共生互動，有助於植物生長。\n\n有些<link=\"PLANTS\">植物</link>完全依賴授粉者才能生長，而其他植物則能獲得顯著的自然生長速度提升。"

#. STRINGS.CODEX.POLLINATORS.SUBTITLE
msgctxt "STRINGS.CODEX.POLLINATORS.SUBTITLE"
msgid "Critter-Boosted Growth"
msgstr "小動物加速生長"

#. STRINGS.CODEX.POLLINATORS.TITLE
msgctxt "STRINGS.CODEX.POLLINATORS.TITLE"
msgid "Pollination"
msgstr "授粉"

