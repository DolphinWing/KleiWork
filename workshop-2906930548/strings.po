msgstr "侏羅紀睡衣"

#. STRINGS.BLUEPRINTS.PERMIT_PJ_DINO2.DESC
msgctxt "STRINGS.BLUEPRINTS.PERMIT_PJ_DINO2.DESC"
msgid "If all beds were part of a single bed mass, colony life would be one big slumber party."
msgstr "如果所有床鋪都連成一大塊，殖民地生活就會像一場超大型睡衣派對。"

#. STRINGS.BLUEPRINTS.PERMIT_PJ_DINO2.NAME
msgctxt "STRINGS.BLUEPRINTS.PERMIT_PJ_DINO2.NAME"
msgid "Pangaea Jammies"
msgstr "盤古大陸睡衣"

#. STRINGS.BLUEPRINTS.PERMIT_PJ_DINO3.DESC
msgctxt "STRINGS.BLUEPRINTS.PERMIT_PJ_DINO3.DESC"
msgid "The label inside reads: \"If at first you can't fall asleep, tri, tri again.\""
msgstr "裡面的標籤寫著：「如果你一開始睡不著，試、試、再試。」"

#. STRINGS.BLUEPRINTS.PERMIT_PJ_DINO3.NAME
msgctxt "STRINGS.BLUEPRINTS.PERMIT_PJ_DINO3.NAME"
msgid "Triassic Jammies"
msgstr "三疊紀睡衣"

#. STRINGS.BLUEPRINTS.PERMIT_PORTA_POD_Y_AQUATIC.DESC
msgctxt "STRINGS.BLUEPRINTS.PERMIT_PORTA_POD_Y_AQUATIC.DESC"
