msgctxt "STRINGS.COLONY_ACHIEVEMENTS.ASTEROID_DESTROYED.REQUIREMENT_NAME"
msgid "Destroy Demolior asteroid"
msgstr "摧毀毀神星"

#. STRINGS.COLONY_ACHIEVEMENTS.ASTEROID_SURVIVED.DESCRIPTION
msgctxt "STRINGS.COLONY_ACHIEVEMENTS.ASTEROID_SURVIVED.DESCRIPTION"
msgid "Survive 100 cycles after Demolior asteroid collides with RelicAAAA<sup>AAAGHH</sup>."
msgstr "在毀神星撞擊遺物阿阿阿阿<sup>ㄚㄚㄚ～～</sup>後生存 100 周期。"

#. STRINGS.COLONY_ACHIEVEMENTS.ASTEROID_SURVIVED.NAME
