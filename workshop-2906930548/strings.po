msgctxt "STRINGS.BUILDINGS.PREFABS.FACILITYBACKWALLWINDOW.EFFECT"
msgid "A tall, thin window."
msgstr "一個高瘦的窗戶。"

#. STRINGS.BUILDINGS.PREFABS.FACILITYBACKWALLWINDOW.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.FACILITYBACKWALLWINDOW.NAME"
msgid "Window"
msgstr "窗戶"

#. STRINGS.BUILDINGS.PREFABS.FARMSTATION.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.FARMSTATION.DESC"
msgid "This station only has an effect on crops grown within the same room."
msgstr "農場站只對同一房間內種植的作物有影響。"

#. STRINGS.BUILDINGS.PREFABS.FARMSTATION.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.FARMSTATION.EFFECT"
msgid "Produces <link=\"FARMSTATIONTOOLS\">Micronutrient Fertilizer</link> to increase <link=\"PLANTS\">Plant</link> growth rates.\n\nAssigned Duplicants must possess the <link=\"FARMING2\">Crop Tending</link> trait.\n\nThis building is a necessary component of the Greenhouse room."
msgstr "生產<link=\"FARMSTATIONTOOLS\">肥料包</link>增加<link=\"PLANTS\">植物</link>的生長速度。\n\n分配的複製人必須有<link=\"FARMING2\">作物照料</link>技能。\n\n這個建築是打造溫室的要素之一。"

#. STRINGS.BUILDINGS.PREFABS.FARMSTATION.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.FARMSTATION.NAME"
msgid "<link=\"FARMSTATION\">Farm Station</link>"
msgstr "<link=\"FARMSTATION\">農場站</link>"

#. STRINGS.BUILDINGS.PREFABS.FARMTILE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.FARMTILE.DESC"
msgid "Duplicants can deliver fertilizer and liquids to farm tiles, accelerating plant growth."
msgstr "複製人可以運送肥料與液體到農耕磚，加速植物生長。"

#. STRINGS.BUILDINGS.PREFABS.FARMTILE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.FARMTILE.EFFECT"
msgid "Grows one <link=\"PLANTS\">Plant</link> from a <link=\"PLANTS\">Seed</link>.\n\nCan be used as floor tile and rotated before construction."
msgstr "播下<link=\"PLANTS\">種子</link>成長為<link=\"PLANTS\">植物</link>。\n\n可以當作地磚，建築前可以旋轉決定建造方向。"

#. STRINGS.BUILDINGS.PREFABS.FARMTILE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.FARMTILE.NAME"
msgid "<link=\"FARMTILE\">Farm Tile</link>"
msgstr "<link=\"FARMTILE\">農耕磚</link>"

#. STRINGS.BUILDINGS.PREFABS.FERTILIZERMAKER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.FERTILIZERMAKER.DESC"
msgid "Fertilizer synthesizers convert polluted dirt into fertilizer for domestic plants."
msgstr "肥料廠將汙水和泥土製成肥料給農田裡的植物使用。"

#. STRINGS.BUILDINGS.PREFABS.FERTILIZERMAKER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.FERTILIZERMAKER.EFFECT"
msgid "Uses <link=\"DIRTYWATER\">Polluted Water</link> and <link=\"PHOSPHORITE\">Phosphorite</link> to produce <link=\"FERTILIZER\">Fertilizer</link>."
msgstr "使用<link=\"DIRTYWATER\">汙水</link>與<link=\"PHOSPHORITE\">磷礦</link>製造 <link=\"FERTILIZER\">肥料</link>。"

#. STRINGS.BUILDINGS.PREFABS.FERTILIZERMAKER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.FERTILIZERMAKER.NAME"
msgid "<link=\"FERTILIZERMAKER\">Fertilizer Synthesizer</link>"
msgstr "<link=\"FERTILIZERMAKER\">肥料廠</link>"

#. STRINGS.BUILDINGS.PREFABS.FIREPOLE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.FIREPOLE.DESC"
msgid "Build these in addition to ladders for efficient upward and downward movement."
msgstr "建在梯子旁可以提高上下移動的效率。"

#. STRINGS.BUILDINGS.PREFABS.FIREPOLE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.FIREPOLE.EFFECT"
msgid "Allows rapid Duplicant descent.\n\nSignificantly slows upward climbing."
msgstr "讓複製人快速往下。\n\n往上爬很慢。"

#. STRINGS.BUILDINGS.PREFABS.FIREPOLE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.FIREPOLE.NAME"
msgid "<link=\"FIREPOLE\">Fire Pole</link>"
msgstr "<link=\"FIREPOLE\">消防滑桿</link>"

#. STRINGS.BUILDINGS.PREFABS.FISHDELIVERYPOINT.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.FISHDELIVERYPOINT.DESC"
msgid "A fish release must be built in liquid to prevent released fish from suffocating."
msgstr "魚類放置點必須建在液體內，避免魚類窒息。"

#. STRINGS.BUILDINGS.PREFABS.FISHDELIVERYPOINT.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.FISHDELIVERYPOINT.EFFECT"
msgid "Releases trapped aquatic critters back into the world.\n\nCan be used multiple times."
msgstr "將被捕獲的水生小動物釋放至環境中。\n\n可多次使用。"

#. STRINGS.BUILDINGS.PREFABS.FISHDELIVERYPOINT.LOGIC_INPUT.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.FISHDELIVERYPOINT.LOGIC_INPUT.DESC"
msgid "Enable/Disable"
msgstr "啟用/停用"

#. STRINGS.BUILDINGS.PREFABS.FISHDELIVERYPOINT.LOGIC_INPUT.LOGIC_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.FISHDELIVERYPOINT.LOGIC_INPUT.LOGIC_PORT_ACTIVE"
msgid "<b><style=\"logic_on\">Green Signal</style></b>: Enable fish release"
msgstr "<b><style=\"logic_on\">綠色訊號</style></b>：啟用魚類釋放"

#. STRINGS.BUILDINGS.PREFABS.FISHDELIVERYPOINT.LOGIC_INPUT.LOGIC_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.FISHDELIVERYPOINT.LOGIC_INPUT.LOGIC_PORT_INACTIVE"
msgid "<b><style=\"logic_off\">Red Signal</style></b>: Disable fish release"
msgstr "<b><style=\"logic_off\">紅色訊號</style></b>：停用魚類釋放"

#. STRINGS.BUILDINGS.PREFABS.FISHDELIVERYPOINT.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.FISHDELIVERYPOINT.NAME"
msgid "<link=\"FISHDELIVERYPOINT\">Fish Release</link>"
msgstr "<link=\"FISHDELIVERYPOINT\">魚類放置點</link>"

#. STRINGS.BUILDINGS.PREFABS.FISHFEEDER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.FISHFEEDER.DESC"
msgid "Build this feeder above a body of water to feed and tame the fish within."
msgstr "在水體上方建造此魚類餵食器，以餵食並馴服其中的魚類。"

#. STRINGS.BUILDINGS.PREFABS.FISHFEEDER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.FISHFEEDER.EFFECT"
msgid "Automatically dispenses stored <link=\"CREATURES\">Critter</link> food into the area below.\n\nDispenses continuously as food is consumed."
msgstr "自動將儲存的<link=\"CRITTERS\">小動物</link>食物投入下方區域。\n\n食物消耗後會持續投放。"

#. STRINGS.BUILDINGS.PREFABS.FISHFEEDER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.FISHFEEDER.NAME"
msgid "<link=\"FISHFEEDER\">Fish Feeder</link>"
msgstr "<link=\"FISHFEEDER\">魚類餵食器</link>"

#. STRINGS.BUILDINGS.PREFABS.FISHPICKUP.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.FISHPICKUP.DESC"
msgid "Duplicants will automatically wrangle excess fish from the pool below."
msgstr "複製人會自動套捕下方水域中過剩的魚類。"

#. STRINGS.BUILDINGS.PREFABS.FISHPICKUP.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.FISHPICKUP.EFFECT"
msgid "Ensures the prompt capture of aquatic <link=\"CREATURES\">Critters</link> that exceed the maximum amount set.\n\nMonitoring and pick-up are limited to the specified species.\n\nMust be built above a <link=\"ELEMENTSLIQUID\">Liquid</link> pool."
msgstr "確保即時捕捉超過設定上限的水生<link=\"CREATURES\">小動物</link>。\n\n僅監測與捕捉指定的物種。\n\n必須建造在<link=\"ELEMENTSLIQUID\">液體</link>池上方。"

#. STRINGS.BUILDINGS.PREFABS.FISHPICKUP.LOGIC_INPUT.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.FISHPICKUP.LOGIC_INPUT.DESC"
msgid "Enable/Disable"
msgstr "啟用/禁用"

#. STRINGS.BUILDINGS.PREFABS.FISHPICKUP.LOGIC_INPUT.LOGIC_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.FISHPICKUP.LOGIC_INPUT.LOGIC_PORT_ACTIVE"
msgid "<b><style=\"logic_on\">Green Signal</style></b>: Wrangle excess fish"
msgstr "<b><style=\"logic_on\">綠色訊號</style></b>：套捕過剩魚類"

#. STRINGS.BUILDINGS.PREFABS.FISHPICKUP.LOGIC_INPUT.LOGIC_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.FISHPICKUP.LOGIC_INPUT.LOGIC_PORT_INACTIVE"
msgid "<b><style=\"logic_off\">Red Signal</style></b>: Ignore excess fish"
msgstr "<b><style=\"logic_off\">紅色訊號</style></b>：忽略過剩魚類"

#. STRINGS.BUILDINGS.PREFABS.FISHPICKUP.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.FISHPICKUP.NAME"
msgid "<link=\"FISHPICKUP\">Fish Pick-Up</link>"
msgstr "<link=\"FISHPICKUP\">魚類移取點</link>"

#. STRINGS.BUILDINGS.PREFABS.FISHTRAP.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.FISHTRAP.DESC"
msgid "Trapped fish will automatically be bagged for transport."
msgstr "被捉住的魚會自動裝袋等待運輸。"

#. STRINGS.BUILDINGS.PREFABS.FISHTRAP.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.FISHTRAP.EFFECT"
msgid "Attracts and traps aquatic <link=\"CREATURES\">Critters</link>.\n\nSingle use."
msgstr "吸引和捕捉游動的<link=\"CREATURES\">帕庫</link>。\n\n單次使用。"

#. STRINGS.BUILDINGS.PREFABS.FISHTRAP.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.FISHTRAP.NAME"
msgid "<link=\"FISHTRAP\">Fish Trap</link>"
msgstr "<link=\"FISHTRAP\">捕魚陷阱</link>"

#. STRINGS.BUILDINGS.PREFABS.FLOORLAMP.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.FLOORLAMP.DESC"
msgid "Any building's light emitting radius can be viewed in the light overlay."
msgstr "這個建築的照明範圍可以在光照概覽中查看。"

#. STRINGS.BUILDINGS.PREFABS.FLOORLAMP.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.FLOORLAMP.EFFECT"
msgid "Provides <link=\"LIGHT\">Light</link> when <link=\"POWER\">Powered</link>.\n\nIncreases Duplicant workspeed within light radius."
msgstr "<link=\"POWER\">通電</link>時提供<link=\"LIGHT\">照明</link>。\n\n複製人在有燈光的地方工作速度會變快。"

#. STRINGS.BUILDINGS.PREFABS.FLOORLAMP.FACADES.BRISTLEBLOSSOM.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.FLOORLAMP.FACADES.BRISTLEBLOSSOM.DESC"
msgid "It's a bit prickly, but it casts a festive glow."
msgstr "有點刺人，但確實發出了節日的光芒。"

#. STRINGS.BUILDINGS.PREFABS.FLOORLAMP.FACADES.BRISTLEBLOSSOM.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.FLOORLAMP.FACADES.BRISTLEBLOSSOM.NAME"
msgid "<link=\"FLOORLAMP\">Holiday Lamp</link>"
msgstr "<link=\"FLOORLAMP\">節日電燈</link>"

#. STRINGS.BUILDINGS.PREFABS.FLOORLAMP.FACADES.DEFAULT_FLOORLAMP.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.FLOORLAMP.FACADES.DEFAULT_FLOORLAMP.DESC"
msgid "Any building's light emitting radius can be viewed in the light overlay."
msgstr "任何建築的光照範圍可在光照概覽中檢視。"

#. STRINGS.BUILDINGS.PREFABS.FLOORLAMP.FACADES.DEFAULT_FLOORLAMP.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.FLOORLAMP.FACADES.DEFAULT_FLOORLAMP.NAME"
msgid "<link=\"FLOORLAMP\">Lamp</link>"
msgstr "<link=\"FLOORLAMP\">電燈</link>"

#. STRINGS.BUILDINGS.PREFABS.FLOORLAMP.FACADES.LEG.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.FLOORLAMP.FACADES.LEG.DESC"
msgid "This lamp blazes forth in unparalleled glory."
msgstr "這盞燈閃耀著無與倫比的光輝。"

#. STRINGS.BUILDINGS.PREFABS.FLOORLAMP.FACADES.LEG.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.FLOORLAMP.FACADES.LEG.NAME"
msgid "<link=\"FLOORLAMP\">Fragile Leg Lamp</link>"
msgstr "<link=\"FLOORLAMP\">柔弱腿燈</link>"

#. STRINGS.BUILDINGS.PREFABS.FLOORLAMP.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.FLOORLAMP.NAME"
msgid "<link=\"FLOORLAMP\">Lamp</link>"
msgstr "<link=\"FLOORLAMP\">立燈</link>"

#. STRINGS.BUILDINGS.PREFABS.FLOORSWITCH.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.FLOORSWITCH.DESC"
msgid "Weight plates can be used to turn on amenities only when Duplicants pass by."
msgstr "只有當複製人通過時，重量板會開啟設施。"

#. STRINGS.BUILDINGS.PREFABS.FLOORSWITCH.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.FLOORSWITCH.EFFECT"
msgid "Sends a <b><style=\"logic_on\">Green Signal</style></b> when an object or Duplicant is placed atop of it.\n\nCannot be triggered by <link=\"ELEMENTSGAS\">Gas</link> or <link=\"ELEMENTSLIQUID\">Liquids</link>."
msgstr "當一個物件或是複製人停放在它上面的時候，發出<b><style=\"logic_on\">綠色訊號</style></b>。\n\n無法被<link=\"ELEMENTSGAS\">氣體</link>或<link=\"ELEMENTSLIQUID\">液體</link>觸發。"

#. STRINGS.BUILDINGS.PREFABS.FLOORSWITCH.LOGIC_PORT_DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.FLOORSWITCH.LOGIC_PORT_DESC"
msgid "<link=\"LOGIC\">Active</link>/<link=\"LOGIC\">Inactive</link>"
msgstr "<link=\"LOGIC\">啟動</link>/<link=\"LOGIC\">未啟動</link>"

#. STRINGS.BUILDINGS.PREFABS.FLOORSWITCH.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.FLOORSWITCH.NAME"
msgid "<link=\"FLOORSWITCH\">Weight Plate</link>"
msgstr "<link=\"FLOORSWITCH\">重量板</link>"

#. STRINGS.BUILDINGS.PREFABS.FLOWERVASE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.FLOWERVASE.DESC"
msgid "Flower pots allow decorative plants to be moved to new locations."
msgstr "花盆讓裝飾植物可移植到新的地方。"

#. STRINGS.BUILDINGS.PREFABS.FLOWERVASE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.FLOWERVASE.EFFECT"
msgid "Houses a single <link=\"PLANTS\">Plant</link> when sown with a <link=\"PLANTS\">Seed</link>.\n\nIncreases <link=\"DECOR\">Decor</link> when in use, contributing to <link=\"MORALE\">Morale</link>."
msgstr "播下<link=\"PLANTS\">種子</link>後，即可容納單株<link=\"PLANTS\">植物</link>。\n\n使用時會增加<link=\"DECOR\">裝飾度</link>，有助於<link=\"MORALE\">士氣</link>。"

#. STRINGS.BUILDINGS.PREFABS.FLOWERVASE.FACADES.DEFAULT_FLOWERVASE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.FLOWERVASE.FACADES.DEFAULT_FLOWERVASE.DESC"
msgid "The original container for plants on the move."
msgstr "用於植物移植的原始容器。"

#. STRINGS.BUILDINGS.PREFABS.FLOWERVASE.FACADES.DEFAULT_FLOWERVASE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.FLOWERVASE.FACADES.DEFAULT_FLOWERVASE.NAME"
msgid "<link=\"FLOWERVASE\">Flower Pot</link>"
msgstr "<link=\"FLOWERVASE\">花盆</link>"

#. STRINGS.BUILDINGS.PREFABS.FLOWERVASE.FACADES.RETRO_BOLD.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.FLOWERVASE.FACADES.RETRO_BOLD.DESC"
msgid "A funky red flower pot for plants on the move."
msgstr "一種時髦的紅色花盆，用於植物移植。"

#. STRINGS.BUILDINGS.PREFABS.FLOWERVASE.FACADES.RETRO_BOLD.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.FLOWERVASE.FACADES.RETRO_BOLD.NAME"
msgid "<link=\"FLOWERVASE\">Bold Retro Flower Pot</link>"
msgstr "<link=\"FLOWERVASE\">醒目復古花盆</link>"

#. STRINGS.BUILDINGS.PREFABS.FLOWERVASE.FACADES.RETRO_BRIGHT.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.FLOWERVASE.FACADES.RETRO_BRIGHT.DESC"
msgid "A funky green flower pot for plants on the move."
msgstr "一種時髦的綠色花盆，用於植物移植。"

#. STRINGS.BUILDINGS.PREFABS.FLOWERVASE.FACADES.RETRO_BRIGHT.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.FLOWERVASE.FACADES.RETRO_BRIGHT.NAME"
msgid "<link=\"FLOWERVASE\">Bright Retro Flower Pot</link>"
msgstr "<link=\"FLOWERVASE\">明亮復古花盆</link>"

#. STRINGS.BUILDINGS.PREFABS.FLOWERVASE.FACADES.RETRO_DREAMY.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.FLOWERVASE.FACADES.RETRO_DREAMY.DESC"
msgid "A funky blue flower pot for plants on the move."
msgstr "一種時髦的藍色花盆，用於植物移植。"

#. STRINGS.BUILDINGS.PREFABS.FLOWERVASE.FACADES.RETRO_DREAMY.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.FLOWERVASE.FACADES.RETRO_DREAMY.NAME"
msgid "<link=\"FLOWERVASE\">Dreamy Retro Flower Pot</link>"
msgstr "<link=\"FLOWERVASE\">夢幻復古花盆</link>"

#. STRINGS.BUILDINGS.PREFABS.FLOWERVASE.FACADES.RETRO_ELEGANT.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.FLOWERVASE.FACADES.RETRO_ELEGANT.DESC"
msgid "A funky white flower pot for plants on the move."
msgstr "一種時髦的白色花盆，用於植物移植。"

#. STRINGS.BUILDINGS.PREFABS.FLOWERVASE.FACADES.RETRO_ELEGANT.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.FLOWERVASE.FACADES.RETRO_ELEGANT.NAME"
msgid "<link=\"FLOWERVASE\">Elegant Retro Flower Pot</link>"
msgstr "<link=\"FLOWERVASE\">優雅復古花盆</link>"

#. STRINGS.BUILDINGS.PREFABS.FLOWERVASE.FACADES.RETRO_SUNNY.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.FLOWERVASE.FACADES.RETRO_SUNNY.DESC"
msgid "A funky yellow flower pot for plants on the move."
msgstr "一種時髦的黃色花盆，用於植物移植。"

#. STRINGS.BUILDINGS.PREFABS.FLOWERVASE.FACADES.RETRO_SUNNY.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.FLOWERVASE.FACADES.RETRO_SUNNY.NAME"
msgid "<link=\"FLOWERVASE\">Sunny Retro Flower Pot</link>"
msgstr "<link=\"FLOWERVASE\">陽光復古花盆</link>"

#. STRINGS.BUILDINGS.PREFABS.FLOWERVASE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.FLOWERVASE.NAME"
msgid "<link=\"FLOWERVASE\">Flower Pot</link>"
msgstr "<link=\"FLOWERVASE\">花盆</link>"

#. STRINGS.BUILDINGS.PREFABS.FLOWERVASEHANGING.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.FLOWERVASEHANGING.DESC"
msgid "Hanging pots can add some Decor to a room, without blocking buildings on the floor."
msgstr "吊掛花盆可以增加房間的裝飾，而不會擋到地板上的建築。"

#. STRINGS.BUILDINGS.PREFABS.FLOWERVASEHANGING.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.FLOWERVASEHANGING.EFFECT"
msgid "Houses a single <link=\"PLANTS\">Plant</link> when sown with a <link=\"PLANTS\">Seed</link>.\n\nIncreases <link=\"DECOR\">Decor</link> when in use, contributing to <link=\"MORALE\">Morale</link>.\n\nMust be hung from a ceiling."
msgstr "播下<link=\"PLANTS\">種子</link>後，即可容納單株<link=\"PLANTS\">植物</link>。\n\n使用時會增加<link=\"DECOR\">裝飾度</link>，有助於<link=\"MORALE\">士氣</link>。\n\n必須懸掛在天花板上。"

#. STRINGS.BUILDINGS.PREFABS.FLOWERVASEHANGING.FACADES.BEAKER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.FLOWERVASEHANGING.FACADES.BEAKER.DESC"
msgid "A measured approach to indoor plant decor."
msgstr "一種測量室內植物裝飾的方法。"

#. STRINGS.BUILDINGS.PREFABS.FLOWERVASEHANGING.FACADES.BEAKER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.FLOWERVASEHANGING.FACADES.BEAKER.NAME"
msgid "<link=\"FLOWERVASEHANGING\">Beaker Hanging Pot</link>"
msgstr "<link=\"FLOWERVASEHANGING\">燒杯垂吊花盆</link>"

#. STRINGS.BUILDINGS.PREFABS.FLOWERVASEHANGING.FACADES.RETRO_BLUE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.FLOWERVASEHANGING.FACADES.RETRO_BLUE.DESC"
msgid "Suspended vessels really elevate a plant display."
msgstr "懸掛的花盆確實提升了植物的展示。"

#. STRINGS.BUILDINGS.PREFABS.FLOWERVASEHANGING.FACADES.RETRO_BLUE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.FLOWERVASEHANGING.FACADES.RETRO_BLUE.NAME"
msgid "<link=\"FLOWERVASEHANGING\">Dreamy Hanging Pot</link>"
msgstr "<link=\"FLOWERVASEHANGING\">夢幻垂吊花盆</link>"

#. STRINGS.BUILDINGS.PREFABS.FLOWERVASEHANGING.FACADES.RETRO_GREEN.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.FLOWERVASEHANGING.FACADES.RETRO_GREEN.DESC"
msgid "Suspended vessels really elevate a plant display."
msgstr "懸掛的花盆確實提升了植物的展示。"

#. STRINGS.BUILDINGS.PREFABS.FLOWERVASEHANGING.FACADES.RETRO_GREEN.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.FLOWERVASEHANGING.FACADES.RETRO_GREEN.NAME"
msgid "<link=\"FLOWERVASEHANGING\">Bright Hanging Pot</link>"
msgstr "<link=\"FLOWERVASEHANGING\">明亮垂吊花盆</link>"

