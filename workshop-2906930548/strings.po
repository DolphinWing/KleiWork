#. STRINGS.DUPLICANTS.TRAITS.RADIATIONEATER.NAME
msgctxt "STRINGS.DUPLICANTS.TRAITS.RADIATIONEATER.NAME"
msgid "Radiation Eater"
msgstr "輻射吞噬者"

#. STRINGS.DUPLICANTS.TRAITS.RADIATIONEATER.SHORT_DESC
msgctxt "STRINGS.DUPLICANTS.TRAITS.RADIATIONEATER.SHORT_DESC"
msgid "Converts radiation exposure into calories"
msgstr "可以將輻射轉化為卡路里"

#. STRINGS.DUPLICANTS.TRAITS.RADIATIONEATER.SHORT_DESC_TOOLTIP
msgctxt "STRINGS.DUPLICANTS.TRAITS.RADIATIONEATER.SHORT_DESC_TOOLTIP"
msgid "Converts radiation exposure into calories"
msgstr "可以將輻射轉化為卡路里"

#. STRINGS.DUPLICANTS.TRAITS.RANCHINGDOWN.DESC
msgctxt "STRINGS.DUPLICANTS.TRAITS.RANCHINGDOWN.DESC"
