msgstr "潰瘍打底衣"

#. STRINGS.BLUEPRINTS.PERMIT_TOP_GOTCH_DUSKY_GRAPE.DESC
msgctxt "STRINGS.BLUEPRINTS.PERMIT_TOP_GOTCH_DUSKY_GRAPE.DESC"
