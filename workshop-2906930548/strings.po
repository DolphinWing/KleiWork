#. STRINGS.CREATURES.ATTRIBUTES.FERTILITYDELTA.DESC
msgctxt "STRINGS.CREATURES.ATTRIBUTES.FERTILITYDELTA.DESC"
msgid "Determines the amount of time needed for a <style=\"KKeyword\">Critter</style> to lay new <style=\"KKeyword\">Eggs</style>."
msgstr "決定<style=\"KKeyword\">小動物</style>產下新<style=\"KKeyword\">蛋</style>的所需時間。"

