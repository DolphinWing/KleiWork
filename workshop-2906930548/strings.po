msgstr "夜幕打底衣"

#. STRINGS.BLUEPRINTS.PERMIT_TOP_GOTCH_ENNUI_FLINT.DESC
msgctxt "STRINGS.BLUEPRINTS.PERMIT_TOP_GOTCH_ENNUI_FLINT.DESC"
