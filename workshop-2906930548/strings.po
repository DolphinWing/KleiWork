msgctxt "STRINGS.EQUIPMENT.PREFABS.LEAD_SUIT.NAME"
msgid "<link=\"LEADSUIT\">Lead Suit</link>"
msgstr "<link=\"LEADSUIT\">輻射防護衣</link>"

#. STRINGS.EQUIPMENT.PREFABS.LEAD_SUIT.RECIPE_DESC
msgctxt "STRINGS.EQUIPMENT.PREFABS.LEAD_SUIT.RECIPE_DESC"
msgid "Supplies Duplicants with <link=\"OXYGEN\">Oxygen</link> in toxic and low breathability environments.\n\nProtects Duplicants from <link=\"RADIATION\">Radiation</link>."
msgstr "在有毒與低氧的環境下供應複製人<link=\"OXYGEN\">氧氣</link>。\n\n保護複製人免於<link=\"RADIATION\">輻射</link>的危害。"

