msgstr "<link=\"EXOBASEHEADQUARTERS\">寒霜小型列印元</link>"

#. STRINGS.BLUEPRINTS.PERMIT_PORTA_POD_Y_NEUTRONIUM.DESC
msgctxt "STRINGS.BLUEPRINTS.PERMIT_PORTA_POD_Y_NEUTRONIUM.DESC"
