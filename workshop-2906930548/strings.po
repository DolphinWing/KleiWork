#. STRINGS.BLUEPRINTS.PERMIT_WALLS_BASIC_BLUE_NAUTICAL.DESC
msgctxt "STRINGS.BLUEPRINTS.PERMIT_WALLS_BASIC_BLUE_NAUTICAL.DESC"
