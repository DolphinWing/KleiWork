msgctxt "STRINGS.ELEMENTS.MATERIAL_MODIFIERS.OVERHEATTEMPERATURE"
msgid "<link=\"HEAT\">Overheat Temperature</link>: {0}"
msgstr "<link=\"HEAT\">過熱溫度</link>：{0}"

#. STRINGS.ELEMENTS.MATERIAL_MODIFIERS.TOOLTIP.DECOR
msgctxt "STRINGS.ELEMENTS.MATERIAL_MODIFIERS.TOOLTIP.DECOR"
msgid "This material will add <b>{0}</b> to the finished building's <style=\"KKeyword\">Decor</style>"
msgstr "用這種材料建造完成的建築，將會增加 <b>{0}</b> <style=\"KKeyword\">裝飾</style>"

#. STRINGS.ELEMENTS.MATERIAL_MODIFIERS.TOOLTIP.EFFECTS_HEADER
msgctxt "STRINGS.ELEMENTS.MATERIAL_MODIFIERS.TOOLTIP.EFFECTS_HEADER"
msgid "Buildings constructed from this material will have these properties"
msgstr "這種材料建造而成的建築物，將會繼承所列出的屬性"

#. STRINGS.ELEMENTS.MATERIAL_MODIFIERS.TOOLTIP.EXCELLENT_RADIATION_SHIELD
msgctxt "STRINGS.ELEMENTS.MATERIAL_MODIFIERS.TOOLTIP.EXCELLENT_RADIATION_SHIELD"
msgid "<style=\"KKeyword\">Excellent Radiation Shield</style> radiation has a hard time passing through materials with a high <style=\"KKeyword\">Radiation Absorption Factor</style> value. \n\nRadiation Absorption Factor: {1}"
msgstr "<style=\"KKeyword\">出色的輻射護盾</style>輻射難以通過具有高<style=\"KKeyword\">輻射吸收係數</style> 的材質。\n\n輻射吸收係數：{1}"

#. STRINGS.ELEMENTS.MATERIAL_MODIFIERS.TOOLTIP.HIGH_SPECIFIC_HEAT_CAPACITY
msgctxt "STRINGS.ELEMENTS.MATERIAL_MODIFIERS.TOOLTIP.HIGH_SPECIFIC_HEAT_CAPACITY"
msgid "<style=\"KKeyword\">Slow Heating</style> materials require a large amount of energy to raise in <style=\"KKeyword\">Temperature</style>, and therefore heat and cool slowly\n\nSpecific Heat Capacity: {1} DTU to raise 1g by 1K"
msgstr "<style=\"KKeyword\">緩慢升溫</style>的材料需要大量的能量才能提高<style=\"KKeyword\">溫度</style>，所以溫度變化較慢\n\n比熱容：{1} DTU 可提高 1 公克的溫度 1K"

#. STRINGS.ELEMENTS.MATERIAL_MODIFIERS.TOOLTIP.HIGH_THERMAL_CONDUCTIVITY
msgctxt "STRINGS.ELEMENTS.MATERIAL_MODIFIERS.TOOLTIP.HIGH_THERMAL_CONDUCTIVITY"
msgid "This material disperses <style=\"KKeyword\">Heat</style> because energy transfers quickly through materials with high <style=\"KKeyword\">Thermal Conductivity</style>\n\nBetween two objects, the rate of <style=\"KKeyword\">Heat</style> transfer will be determined by the object with the <i>lowest</i> <style=\"KKeyword\">Thermal Conductivity</style>\n\nThermal Conductivity: {1} W per degree K difference (Oxygen: 0.024 W)"
msgstr "這種材料會分散<style=\"KKeyword\">熱量</style>，因為能量會在高<style=\"KKeyword\">導熱係數</style>的材質中快速傳遞\n\n在兩個物件之間，<style=\"KKeyword\">熱量</style>傳遞的速率，將由<style=\"KKeyword\">導熱係數</style><b>最低</b>的物件決定\n\n導熱係數：{1} 瓦 / 每度（氧氣：0.024 瓦）"

#. STRINGS.ELEMENTS.MATERIAL_MODIFIERS.TOOLTIP.LOW_SPECIFIC_HEAT_CAPACITY
msgctxt "STRINGS.ELEMENTS.MATERIAL_MODIFIERS.TOOLTIP.LOW_SPECIFIC_HEAT_CAPACITY"
msgid "<style=\"KKeyword\">Thermally Reactive</style> materials require little energy to raise in <style=\"KKeyword\">Temperature</style>, and therefore heat and cool quickly\n\nSpecific Heat Capacity: {1} DTU to raise 1g by 1K"
msgstr "<style=\"KKeyword\">導熱</style>材料只需少量的能量來改變<style=\"KKeyword\">溫度</style>，因這個溫度變化快速\n\n比熱容：{1} DTU 可提高 1 公克的溫度 1K"

#. STRINGS.ELEMENTS.MATERIAL_MODIFIERS.TOOLTIP.LOW_THERMAL_CONDUCTIVITY
msgctxt "STRINGS.ELEMENTS.MATERIAL_MODIFIERS.TOOLTIP.LOW_THERMAL_CONDUCTIVITY"
msgid "This material retains <style=\"KKeyword\">Heat</style> because energy transfers slowly through materials with low <style=\"KKeyword\">Thermal Conductivity</style>\n\nBetween two objects, the rate of <style=\"KKeyword\">Heat</style> transfer will be determined by the object with the <i>lowest</i> <style=\"KKeyword\">Thermal Conductivity</style>\n\nThermal Conductivity: {1} W per degree K difference (Oxygen: 0.024 W)"
msgstr "這種材料會保留<style=\"KKeyword\">熱量</style>，因為能量會在低<style=\"KKeyword\">導熱係數</style>的材質中緩慢傳遞\n\n在兩個物件之間，<style=\"KKeyword\">熱量</style>傳遞速率將由<style=\"KKeyword\">導熱係數</style><b>最低</b>的物件決定\n\n導熱係數：{1} 瓦 / 每度（氧氣：0.024 瓦）"

#. STRINGS.ELEMENTS.MATERIAL_MODIFIERS.TOOLTIP.OVERHEATTEMPERATURE
msgctxt "STRINGS.ELEMENTS.MATERIAL_MODIFIERS.TOOLTIP.OVERHEATTEMPERATURE"
msgid "This material will add <b>{0}</b> to the finished building's <style=\"KKeyword\">Overheat Temperature</style>"
msgstr "用這種材料建造完成的建築，將會增加<b>{0}</b> <style=\"KKeyword\">過熱溫度</style>"

#. STRINGS.ELEMENTS.MERCURY.DESC
msgctxt "STRINGS.ELEMENTS.MERCURY.DESC"
msgid "(Hg) Mercury is a metallic <link=\"ELEMENTSLIQUID\">Liquid</link>."
msgstr "(Hg) 汞是一種金屬<link=\"ELEMENTSLIQUID\">液體</link>。"

#. STRINGS.ELEMENTS.MERCURY.NAME
msgctxt "STRINGS.ELEMENTS.MERCURY.NAME"
msgid "<link=\"MERCURY\">Mercury</link>"
msgstr "<link=\"MERCURY\">汞</link>"

#. STRINGS.ELEMENTS.MERCURYGAS.DESC
msgctxt "STRINGS.ELEMENTS.MERCURYGAS.DESC"
msgid "(Hg) Mercury Gas is a <link=\"REFINEDMETAL\">Metal</link> heated into a <link=\"ELEMENTSGAS\">Gaseous</link> state."
msgstr "(Hg) 汞氣是一種被加熱變成<link=\"ELEMENTSGAS\">氣體</link>狀態的<link=\"REFINEDMETAL\">金屬</link>。"

#. STRINGS.ELEMENTS.MERCURYGAS.NAME
msgctxt "STRINGS.ELEMENTS.MERCURYGAS.NAME"
msgid "<link=\"MERCURYGAS\">Mercury Gas</link>"
msgstr "<link=\"MERCURYGAS\">汞</link>"

#. STRINGS.ELEMENTS.METHANE.DESC
msgctxt "STRINGS.ELEMENTS.METHANE.DESC"
msgid "Natural Gas is a mixture of various alkanes in a <link=\"ELEMENTSGAS\">Gaseous</link> state.\n\nIt is useful in <link=\"POWER\">Power</link> production."
msgstr "天然氣是一種混合多種烷烴的<link=\"ELEMENTSGAS\">氣體</link>。\n\n它對<link=\"POWER\">發電</link>有幫助。"

#. STRINGS.ELEMENTS.METHANE.NAME
msgctxt "STRINGS.ELEMENTS.METHANE.NAME"
msgid "<link=\"METHANE\">Natural Gas</link>"
msgstr "<link=\"METHANE\">天然氣</link>"

#. STRINGS.ELEMENTS.MILK.DESC
msgctxt "STRINGS.ELEMENTS.MILK.DESC"
msgid "Brackene is a sodium-rich <link=\"ELEMENTSLIQUID\">Liquid</link>.\n\nIt is useful in <link=\"RANCHING\">Ranching</link>."
msgstr "鹹乳是一種富含鈉的<link=\"ELEMENTSLIQUID\">液體</link>。\n\n它可用於<link=\"RANCHING\">畜牧</link>。"

#. STRINGS.ELEMENTS.MILK.NAME
msgctxt "STRINGS.ELEMENTS.MILK.NAME"
msgid "<link=\"MILK\">Brackene</link>"
msgstr "<link=\"MILK\">鹹乳</link>"

#. STRINGS.ELEMENTS.MILKFAT.DESC
msgctxt "STRINGS.ELEMENTS.MILKFAT.DESC"
msgid "Brackwax is a <link=\"ELEMENTSSOLID\">Solid</link> byproduct of <link=\"MILK\">Brackene</link>."
msgstr "鹹乳蠟是一種<link=\"MILK\">鹹乳</link>的<link=\"ELEMENTSSOLID\">固體</link>副產物。"

#. STRINGS.ELEMENTS.MILKFAT.NAME
msgctxt "STRINGS.ELEMENTS.MILKFAT.NAME"
msgid "<link=\"MILKFAT\">Brackwax</link>"
msgstr "<link=\"MILKFAT\">鹹乳蠟</link>"

#. STRINGS.ELEMENTS.MILKICE.DESC
msgctxt "STRINGS.ELEMENTS.MILKICE.DESC"
msgid "Frozen Brackene is <link=\"MILK\">Brackene</link> frozen into a <link=\"ELEMENTSSOLID\">Solid</link> state."
msgstr "冰凍鹹乳是一種凍結成<link=\"ELEMENTSSOLID\">固體</link>狀態的<link=\"MILK\">鹹乳</link>。"

#. STRINGS.ELEMENTS.MILKICE.NAME
msgctxt "STRINGS.ELEMENTS.MILKICE.NAME"
msgid "<link=\"MILKICE\">Frozen Brackene</link>"
msgstr "<link=\"MILKICE\">鹹乳</link>"

#. STRINGS.ELEMENTS.MOLTENALUMINUM.DESC
msgctxt "STRINGS.ELEMENTS.MOLTENALUMINUM.DESC"
msgid "(Al) Molten Aluminum is a low density <link=\"REFINEDMETAL\">Metal</link> heated into a <link=\"ELEMENTSLIQUID\">Liquid</link> state."
msgstr "(Al) 熔融鋁是一種被加熱到<link=\"ELEMENTSLIQUID\">液體</link>狀態的低密度<link=\"REFINEDMETAL\">金屬</link>。"

#. STRINGS.ELEMENTS.MOLTENALUMINUM.NAME
msgctxt "STRINGS.ELEMENTS.MOLTENALUMINUM.NAME"
msgid "<link=\"MOLTENALUMINUM\">Molten Aluminum</link>"
msgstr "<link=\"MOLTENALUMINUM\">鋁</link>"

#. STRINGS.ELEMENTS.MOLTENCARBON.DESC
msgctxt "STRINGS.ELEMENTS.MOLTENCARBON.DESC"
msgid "(C) Liquid Carbon is an abundant, versatile element heated into a <link=\"ELEMENTSLIQUID\">Liquid</link> state."
msgstr "(C) 碳是一種被加熱到<link=\"ELEMENTSLIQUID\">液體</link>狀態，具有豐富功能的元素，。"

#. STRINGS.ELEMENTS.MOLTENCARBON.NAME
msgctxt "STRINGS.ELEMENTS.MOLTENCARBON.NAME"
msgid "<link=\"MOLTENCARBON\">Liquid Carbon</link>"
msgstr "<link=\"MOLTENCARBON\">碳</link>"

#. STRINGS.ELEMENTS.MOLTENCOBALT.DESC
msgctxt "STRINGS.ELEMENTS.MOLTENCOBALT.DESC"
msgid "(Co) Molten Cobalt is a <link=\"REFINEDMETAL\">Refined Metal</link> heated into a <link=\"ELEMENTSLIQUID\">Liquid</link> state."
msgstr "(Co) 熔融鈷是一種被加熱到<link=\"ELEMENTSLIQUID\">液體</link>狀態的<link=\"REFINEDMETAL\">精煉金屬</link>。"

#. STRINGS.ELEMENTS.MOLTENCOBALT.NAME
msgctxt "STRINGS.ELEMENTS.MOLTENCOBALT.NAME"
msgid "<link=\"MOLTENCOBALT\">Molten Cobalt</link>"
msgstr "<link=\"MOLTENCOBALT\">鈷</link>"

#. STRINGS.ELEMENTS.MOLTENCOPPER.DESC
msgctxt "STRINGS.ELEMENTS.MOLTENCOPPER.DESC"
msgid "(Cu) Molten Copper is a conductive <link=\"METAL\">Metal</link> heated into a <link=\"ELEMENTSLIQUID\">Liquid</link> state."
msgstr "(Cu) 熔融銅是一種被加熱到<link=\"ELEMENTSLIQUID\">液體</link>狀態的導電<link=\"METAL\">金屬</link>。"

#. STRINGS.ELEMENTS.MOLTENCOPPER.NAME
msgctxt "STRINGS.ELEMENTS.MOLTENCOPPER.NAME"
msgid "<link=\"MOLTENCOPPER\">Molten Copper</link>"
msgstr "<link=\"MOLTENCOPPER\">銅</link>"

#. STRINGS.ELEMENTS.MOLTENGLASS.DESC
msgctxt "STRINGS.ELEMENTS.MOLTENGLASS.DESC"
msgid "Molten Glass is a composite of granular rock, heated into a <link=\"ELEMENTSLIQUID\">Liquid</link> state."
msgstr "熔融玻璃是一種顆粒狀岩石合成物，被加熱到<link=\"ELEMENTSLIQUID\">液體</link>狀態。"

#. STRINGS.ELEMENTS.MOLTENGLASS.NAME
msgctxt "STRINGS.ELEMENTS.MOLTENGLASS.NAME"
msgid "<link=\"MOLTENGLASS\">Molten Glass</link>"
msgstr "<link=\"MOLTENGLASS\">玻璃</link>"

#. STRINGS.ELEMENTS.MOLTENGOLD.DESC
msgctxt "STRINGS.ELEMENTS.MOLTENGOLD.DESC"
msgid "(Au) Gold, a conductive precious <link=\"REFINEDMETAL\">Metal</link>, heated into a <link=\"ELEMENTSLIQUID\">Liquid</link> state."
msgstr "(Au) 金是一種被加熱到<link=\"ELEMENTSLIQUID\">液體</link>狀態的珍貴導電<link=\"METAL\">金屬</link>。"

#. STRINGS.ELEMENTS.MOLTENGOLD.NAME
msgctxt "STRINGS.ELEMENTS.MOLTENGOLD.NAME"
msgid "<link=\"MOLTENGOLD\">Molten Gold</link>"
msgstr "<link=\"MOLTENGOLD\">金</link>"

#. STRINGS.ELEMENTS.MOLTENIRIDIUM.DESC
msgctxt "STRINGS.ELEMENTS.MOLTENIRIDIUM.DESC"
msgid "(Ir) Molten Iridium is a highly conductive <link=\"METAL\">Metal</link> heated to a <link=\"ELEMENTSLIQUID\">Liquid</link> state."
msgstr "(Ir) 熔融銥是一種高導電性的<link=\"METAL\">金屬</link>，被加熱至<link=\"ELEMENTSLIQUID\">液體</link>狀態。"

#. STRINGS.ELEMENTS.MOLTENIRIDIUM.NAME
msgctxt "STRINGS.ELEMENTS.MOLTENIRIDIUM.NAME"
msgid "<link=\"MOLTENIRIDIUM\">Molten Iridium</link>"
msgstr "<link=\"MOLTENIRIDIUM\">銥</link>"

#. STRINGS.ELEMENTS.MOLTENIRON.DESC
msgctxt "STRINGS.ELEMENTS.MOLTENIRON.DESC"
msgid "(Fe) Molten Iron is a common industrial <link=\"METAL\">Metal</link> heated into a <link=\"ELEMENTSLIQUID\">Liquid</link> state."
msgstr "(Fe) 熔融鐵是一種常見的工業<link=\"METAL\">金屬</link>，被加熱到<link=\"ELEMENTSLIQUID\">液體</link>狀態。"

#. STRINGS.ELEMENTS.MOLTENIRON.NAME
msgctxt "STRINGS.ELEMENTS.MOLTENIRON.NAME"
msgid "<link=\"MOLTENIRON\">Molten Iron</link>"
msgstr "<link=\"MOLTENIRON\">鐵</link>"

#. STRINGS.ELEMENTS.MOLTENLEAD.DESC
msgctxt "STRINGS.ELEMENTS.MOLTENLEAD.DESC"
msgid "(Pb) Lead is an extremely dense <link=\"REFINEDMETAL\">Refined Metal</link> heated into a <link=\"ELEMENTSLIQUID\">Liquid</link> state."
msgstr "(Pb) 鉛是一種被加熱到<link=\"ELEMENTSLIQUID\">液體</link>狀態的高密度<link=\"REFINEDMETAL\">精煉金屬</link>。"

#. STRINGS.ELEMENTS.MOLTENLEAD.NAME
msgctxt "STRINGS.ELEMENTS.MOLTENLEAD.NAME"
msgid "<link=\"MOLTENLEAD\">Molten Lead</link>"
msgstr "<link=\"MOLTENLEAD\">鉛</link>"

#. STRINGS.ELEMENTS.MOLTENNICKEL.DESC
msgctxt "STRINGS.ELEMENTS.MOLTENNICKEL.DESC"
msgid "(Ni) Molten Nickel is a conductive <link=\"METAL\">Metal</link> heated into a <link=\"ELEMENTSLIQUID\">Liquid</link> state."
msgstr "(Ni) 熔融鎳是一種被加熱成<link=\"ELEMENTSLIQUID\">液態</link>的導電<link=\"METAL\">金屬</link>。"

#. STRINGS.ELEMENTS.MOLTENNICKEL.NAME
msgctxt "STRINGS.ELEMENTS.MOLTENNICKEL.NAME"
msgid "<link=\"MOLTENNICKEL\">Molten Nickel</link>"
msgstr "<link=\"MOLTENNICKEL\">鎳</link>"

#. STRINGS.ELEMENTS.MOLTENNIOBIUM.DESC
msgctxt "STRINGS.ELEMENTS.MOLTENNIOBIUM.DESC"
msgid "(Nb) Molten Niobium is a rare metal heated into a <link=\"ELEMENTSLIQUID\">Liquid</link> state."
msgstr "(Nb) 熔融鈮是一種被加熱成<link=\"ELEMENTSLIQUID\">液態</link>的稀有金屬。"

#. STRINGS.ELEMENTS.MOLTENNIOBIUM.NAME
msgctxt "STRINGS.ELEMENTS.MOLTENNIOBIUM.NAME"
msgid "<link=\"MOLTENNIOBIUM\">Molten Niobium</link>"
msgstr "<link=\"MOLTENNIOBIUM\">鈮</link>"

#. STRINGS.ELEMENTS.MOLTENSALT.DESC
msgctxt "STRINGS.ELEMENTS.MOLTENSALT.DESC"
msgid "(NaCl) Molten Salt is an edible chemical compound that has been heated into a <link=\"ELEMENTSLIQUID\">Liquid</link> state."
msgstr "(NaCl) 熔融鹽是一種可食用的化合物，遇熱變成<link=\"ELEMENTSLIQUID\">液體</link>狀態。"

#. STRINGS.ELEMENTS.MOLTENSALT.NAME
msgctxt "STRINGS.ELEMENTS.MOLTENSALT.NAME"
msgid "<link=\"MOLTENSALT\">Molten Salt</link>"
msgstr "<link=\"MOLTENSALT\">鹽</link>"

#. STRINGS.ELEMENTS.MOLTENSTEEL.DESC
msgctxt "STRINGS.ELEMENTS.MOLTENSTEEL.DESC"
msgid "Molten Steel is a <link=\"METAL\">Metal</link> alloy of iron and carbon, heated into a hazardous <link=\"ELEMENTSLIQUID\">Liquid</link> state."
msgstr "熔融鋼是一種鐵和碳的<link=\"METAL\">金屬</link>合金，加熱變成危險的<link=\"ELEMENTSLIQUID\">液體</link>狀態。"

#. STRINGS.ELEMENTS.MOLTENSTEEL.NAME
msgctxt "STRINGS.ELEMENTS.MOLTENSTEEL.NAME"
msgid "<link=\"MOLTENSTEEL\">Molten Steel</link>"
msgstr "<link=\"MOLTENSTEEL\">鋼</link>"

#. STRINGS.ELEMENTS.MOLTENSUCROSE.DESC
msgctxt "STRINGS.ELEMENTS.MOLTENSUCROSE.DESC"
msgid "(C<sub>12</sub>H<sub>22</sub>O<sub>11</sub>) Liquid Sucrose is the raw form of sugar, heated into a <link=\"ELEMENTSLIQUID\">Liquid</link> state."
msgstr "(C<sub>12</sub>H<sub>22</sub>O<sub>11</sub>) 蔗糖是糖的原始型態，遇熱變成<link=\"ELEMENTSLIQUID\">液體</link>狀態。"

#. STRINGS.ELEMENTS.MOLTENSUCROSE.NAME
msgctxt "STRINGS.ELEMENTS.MOLTENSUCROSE.NAME"
msgid "<link=\"MOLTENSUCROSE\">Liquid Sucrose</link>"
msgstr "<link=\"MOLTENSUCROSE\">蔗糖</link>"

#. STRINGS.ELEMENTS.MOLTENSYNGAS.DESC
msgctxt "STRINGS.ELEMENTS.MOLTENSYNGAS.DESC"
msgid "Molten Synthesis Gas is an artificial, unbreathable <link=\"ELEMENTSLIQUID\">Liquid</link>.\n\nIt can be converted into an efficient fuel."
msgstr "合成氣是一種人工製造，不能呼吸的<link=\"ELEMENTSGAS\">氣體</link>。\n\n它可以轉化成高效燃料。"

#. STRINGS.ELEMENTS.MOLTENSYNGAS.NAME
msgctxt "STRINGS.ELEMENTS.MOLTENSYNGAS.NAME"
msgid "<link=\"SYNGAS\">Molten Synthesis Gas</link>"
msgstr "<link=\"SYNGAS\">合成氣</link>"

#. STRINGS.ELEMENTS.MOLTENTUNGSTEN.DESC
msgctxt "STRINGS.ELEMENTS.MOLTENTUNGSTEN.DESC"
msgid "(W) Molten Tungsten is a crystalline <link=\"REFINEDMETAL\">Metal</link> heated into a <link=\"ELEMENTSLIQUID\">Liquid</link> state."
msgstr "(W) 熔融鎢是一種結晶狀的<link=\"REFINEDMETAL\">金屬</link>，加熱變成<link=\"ELEMENTSLIQUID\">液體</link>狀態。"

#. STRINGS.ELEMENTS.MOLTENTUNGSTEN.NAME
msgctxt "STRINGS.ELEMENTS.MOLTENTUNGSTEN.NAME"
msgid "<link=\"MOLTENTUNGSTEN\">Molten Tungsten</link>"
msgstr "<link=\"MOLTENTUNGSTEN\">鎢</link>"

#. STRINGS.ELEMENTS.MOLTENTUNGSTENDISELENIDE.DESC
msgctxt "STRINGS.ELEMENTS.MOLTENTUNGSTENDISELENIDE.DESC"
msgid "(WSe<sub>2</sub>) Tungsten Diselenide is an inorganic <link=\"METAL\">Metal</link> compound heated into a <link=\"ELEMENTSLIQUID\">Liquid</link> state."
msgstr "(WSe<sub>2</sub>) 二硒化鎢是一種無機<link=\"METAL\">金屬</link>化合物，加熱變成<link=\"ELEMENTSLIQUID\">液體</link>狀態。"

#. STRINGS.ELEMENTS.MOLTENTUNGSTENDISELENIDE.NAME
msgctxt "STRINGS.ELEMENTS.MOLTENTUNGSTENDISELENIDE.NAME"
msgid "<link=\"MOLTENTUNGSTENDISELENIDE\">Tungsten Diselenide</link>"
msgstr "<link=\"MOLTENTUNGSTENDISELENIDE\">二硒化鎢</link>"

#. STRINGS.ELEMENTS.MOLTENURANIUM.DESC
msgctxt "STRINGS.ELEMENTS.MOLTENURANIUM.DESC"
msgid "(U) Liquid Uranium is a highly <link=\"RADIATION\">Radioactive</link> substance, heated into a hazardous <link=\"ELEMENTSLIQUID\">Liquid</link> state.\n\nIt is a byproduct of <link=\"ENRICHEDURANIUM\">Enriched Uranium</link>."
msgstr "(U) 液態鈾是一種高<link=\"RADIATION\">輻射</link>的物質，因高溫變成危險的<link=\"ELEMENTSLIQUID\">液體</link>狀態。\n\n它是生產<link=\"ENRICHEDURANIUM\">濃縮鈾</link>的副產品。"

#. STRINGS.ELEMENTS.MOLTENURANIUM.NAME
msgctxt "STRINGS.ELEMENTS.MOLTENURANIUM.NAME"
msgid "<link=\"MOLTENURANIUM\">Liquid Uranium</link>"
msgstr "<link=\"MOLTENURANIUM\">鈾</link>"

#. STRINGS.ELEMENTS.MOLTENZINC.DESC
msgctxt "STRINGS.ELEMENTS.MOLTENZINC.DESC"
msgid "Molten Zinc is <link=\"ZINC\">Zinc</link> heated into <link=\"ELEMENTSLIQUID\">Liquid</link> state."
msgstr "熔融鋅是一種被加熱成<link=\"ELEMENTSLIQUID\">液體</link>狀態的<link=\"ZINC\">鋅</link>。"

#. STRINGS.ELEMENTS.MOLTENZINC.NAME
msgctxt "STRINGS.ELEMENTS.MOLTENZINC.NAME"
msgid "<link=\"MOLTENZINC\">Molten Zinc</link>"
msgstr "<link=\"MOLTENZINC\">鋅</link>"

#. STRINGS.ELEMENTS.MUCUS.DESC
msgctxt "STRINGS.ELEMENTS.MUCUS.DESC"
msgid "Mucin is an extremely viscous <link=\"ELEMENTSLIQUID\">Liquid</link> gel composed of natural enzymes and polysaccharides.\n\nIts unusually thick consistency can result in formations atypical of most liquids."
msgstr "黏蛋白是一種高黏度的<link=\"ELEMENTSLIQUID\">液體</link>凝膠，主要由天然酶與多醣組成。\n\n其異常濃稠的稠度，可能會導致形成不同於大多數液體的型態"

#. STRINGS.ELEMENTS.MUCUS.NAME
msgctxt "STRINGS.ELEMENTS.MUCUS.NAME"
msgid "<link=\"MUCUS\">Mucin</link>"
msgstr "<link=\"MUCUS\">黏蛋白</link>"

#. STRINGS.ELEMENTS.MUD.DESC
msgctxt "STRINGS.ELEMENTS.MUD.DESC"
msgid "A mixture of <link=\"DIRT\">Dirt</link> and <link=\"WATER\">Water</link>.\n\nCan be separated into its base elements using a <link=\"SLUDGEPRESS\">Sludge Press</link>."
msgstr "<link=\"DIRT\">泥土</link>與<link=\"WATER\">水</link>的混合物。\n\n使用<link=\"SLUDGEPRESS\">脫水機</link>可將其分離成基礎元素。"

#. STRINGS.ELEMENTS.MUD.NAME
msgctxt "STRINGS.ELEMENTS.MUD.NAME"
msgid "<link=\"MUD\">Mud</link>"
msgstr "<link=\"MUD\">泥漿</link>"

#. STRINGS.ELEMENTS.MURKYBRINE.DESC
msgctxt "STRINGS.ELEMENTS.MURKYBRINE.DESC"
msgid "Polluted Brine is a murky, concentrated solution of <link=\"SALT\">Salt</link> dissolved in <link=\"DIRTYWATER\">Polluted Water</link>.\n\nIt can be used in desalination processes, separating out usable salt."
msgstr "汙染濃鹽水是一種渾濁、溶解了高濃度<link=\"SALT\">鹽</link>的<link=\"DIRTYWATER\">汙水</link>。\n\n它可用於淡化處理，以分離出可用的鹽。"

#. STRINGS.ELEMENTS.MURKYBRINE.NAME
msgctxt "STRINGS.ELEMENTS.MURKYBRINE.NAME"
msgid "<link=\"MURKYBRINE\">Polluted Brine</link>"
msgstr "<link=\"MURKYBRINE\">汙染濃鹽水</link>"

#. STRINGS.ELEMENTS.MURKYBRINEICE.DESC
msgctxt "STRINGS.ELEMENTS.MURKYBRINEICE.DESC"
msgid "Polluted Brine Ice is a murky, concentrated solution of <link=\"SALT\">Salt</link> dissolved in <link=\"DIRTYWATER\">Polluted Water</link> and frozen into a <link=\"ELEMENTSSOLID\">Solid</link> state."
msgstr "汙染濃鹽水冰是一種渾濁的濃縮溶液，由<link=\"SALT\">鹽</link>溶解於<link=\"DIRTYWATER\">汙水</link>中，並凍結成<link=\"ELEMENTSSOLID\">固態</link>而成。\n\n可用於淡化處理，以分離出可用的鹽。"

#. STRINGS.ELEMENTS.MURKYBRINEICE.NAME
msgctxt "STRINGS.ELEMENTS.MURKYBRINEICE.NAME"
msgid "<link=\"MURKYBRINEICE\">Polluted Brine Ice</link>"
msgstr "<link=\"MURKYBRINEICE\">汙染濃鹽水冰</link>"

#. STRINGS.ELEMENTS.NAPHTHA.DESC
msgctxt "STRINGS.ELEMENTS.NAPHTHA.DESC"
msgid "Naphtha a distilled hydrocarbon mixture produced from the burning of <link=\"POLYPROPYLENE\">Plastic</link>."
msgstr "石腦油是由燃燒<link=\"POLYPROPYLENE\">塑膠</link>後所產生的碳氫化合物混合液。"

#. STRINGS.ELEMENTS.NAPHTHA.NAME
msgctxt "STRINGS.ELEMENTS.NAPHTHA.NAME"
msgid "<link=\"NAPHTHA\">Liquid Naphtha</link>"
msgstr "<link=\"NAPHTHA\">石腦油</link>"

#. STRINGS.ELEMENTS.NATURALRESIN.DESC
msgctxt "STRINGS.ELEMENTS.NATURALRESIN.DESC"
msgid "Resin is a viscous organic <link=\"ELEMENTSLIQUID\">Liquid</link>.\n\nIt can be treated to become <link=\"POLYPROPYLENE\">Plastic</link> in the <link=\"POLYMERIZER\">Polymer Press</link>."
msgstr "樹脂是一種黏稠的有機<link=\"ELEMENTSLIQUID\">液體</link>。\n\n它可以在<link=\"POLYMERIZER\">塑膠工廠</link>中處理成<link=\"POLYPROPYLENE\">塑膠</link>。"

#. STRINGS.ELEMENTS.NATURALRESIN.NAME
msgctxt "STRINGS.ELEMENTS.NATURALRESIN.NAME"
msgid "<link=\"NATURALRESIN\">Resin</link>"
msgstr "<link=\"NATURALRESIN\">樹脂</link>"

#. STRINGS.ELEMENTS.NATURALSOLIDRESIN.DESC
msgctxt "STRINGS.ELEMENTS.NATURALSOLIDRESIN.DESC"
msgid "Resin that has been cooled to a <link=\"ELEMENTSSOLID\">Solid</link> state.\n\nIt can be treated to become <link=\"POLYPROPYLENE\">Plastic</link> in the <link=\"POLYMERIZER\">Polymer Press</link>."
msgstr "冷卻至<link=\"ELEMENTSSOLID\">固態</link>的樹脂。\n\n它可以在<link=\"POLYMERIZER\">塑膠工廠</link>中處理成<link=\"POLYPROPYLENE\">塑膠</link>。"

#. STRINGS.ELEMENTS.NATURALSOLIDRESIN.NAME
msgctxt "STRINGS.ELEMENTS.NATURALSOLIDRESIN.NAME"
msgid "<link=\"NATURALSOLIDRESIN\">Solid Resin</link>"
msgstr "<link=\"NATURALSOLIDRESIN\">樹脂</link>"

#. STRINGS.ELEMENTS.NICKEL.DESC
msgctxt "STRINGS.ELEMENTS.NICKEL.DESC"
msgid "(Ni) Nickel is a conductive <link=\"METAL\">Metal</link>.\n\nIt is suitable for building <link=\"POWER\">Power</link> systems."
msgstr "(Ni) 鎳是一種導電<link=\"METAL\">金屬</link>。\n\n它可用於建造<link=\"POWER\">電力</link>系統。"

#. STRINGS.ELEMENTS.NICKEL.NAME
msgctxt "STRINGS.ELEMENTS.NICKEL.NAME"
msgid "<link=\"NICKEL\">Nickel</link>"
msgstr "<link=\"NICKEL\">鎳</link>"

#. STRINGS.ELEMENTS.NICKELGAS.DESC
msgctxt "STRINGS.ELEMENTS.NICKELGAS.DESC"
msgid "(Ni) Nickel Gas is a conductive <link=\"METAL\">Metal</link> heated into a <link=\"ELEMENTSGAS\">Gas</link> state."
msgstr "(Ni) 氣態鎳是一種被加熱成<link=\"ELEMENTSGAS\">氣態</link>的導電<link=\"METAL\">金屬</link>。"

#. STRINGS.ELEMENTS.NICKELGAS.NAME
msgctxt "STRINGS.ELEMENTS.NICKELGAS.NAME"
msgid "<link=\"NICKELGAS\">Nickel Gas</link>"
msgstr "<link=\"NICKELGAS\">鎳</link>"

#. STRINGS.ELEMENTS.NICKELORE.DESC
msgctxt "STRINGS.ELEMENTS.NICKELORE.DESC"
msgid "(Ni) Nickel Ore is a conductive <link=\"METAL\">Metal</link>.\n\nIt can be refined into <link=\"NICKEL\">Nickel</link> and is suitable for building <link=\"POWER\">Power</link> systems."
msgstr "(Ni) 鎳礦是一種導電<link=\"METAL\">金屬</link>。\n\n它可精煉為<link=\"NICKEL\">鎳</link>，並可用於建造<link=\"POWER\">電力</link>系統。"

#. STRINGS.ELEMENTS.NICKELORE.NAME
msgctxt "STRINGS.ELEMENTS.NICKELORE.NAME"
msgid "<link=\"NICKELORE\">Nickel Ore</link>"
msgstr "<link=\"NICKELORE\">鎳礦</link>"

#. STRINGS.ELEMENTS.NIOBIUM.DESC
msgctxt "STRINGS.ELEMENTS.NIOBIUM.DESC"
msgid "(Nb) Niobium is a rare metal with many practical applications in metallurgy and superconductor <link=\"RESEARCH\">Research</link>."
msgstr "(Nb) 鈮是一種稀有金屬，在冶金與超導體<link=\"RESEARCH\">研究</link>方面有很多應用。"

#. STRINGS.ELEMENTS.NIOBIUM.NAME
msgctxt "STRINGS.ELEMENTS.NIOBIUM.NAME"
msgid "<link=\"NIOBIUM\">Niobium</link>"
msgstr "<link=\"NIOBIUM\">鈮</link>"

#. STRINGS.ELEMENTS.NIOBIUMGAS.DESC
msgctxt "STRINGS.ELEMENTS.NIOBIUMGAS.DESC"
msgid "(Nb) Niobium Gas is a rare metal.\n\nThis selection is in a <link=\"ELEMENTSGAS\">Gaseous</link> state."
msgstr "(Nb) 氣態鈮是一種稀有金屬。\n\n當前選中的處於<link=\"ELEMENTSGAS\">氣體</link>狀態。"

#. STRINGS.ELEMENTS.NIOBIUMGAS.NAME
msgctxt "STRINGS.ELEMENTS.NIOBIUMGAS.NAME"
msgid "<link=\"NIOBIUMGAS\">Niobium Gas</link>"
msgstr "<link=\"NIOBIUMGAS\">鈮</link>"

#. STRINGS.ELEMENTS.NUCLEARWASTE.DESC
msgctxt "STRINGS.ELEMENTS.NUCLEARWASTE.DESC"
msgid "Highly toxic liquid full of <link=\"RADIATION\">Radioactive Contaminants</link> which emit <link=\"RADIATION\">Radiation</link> that can be absorbed by <link=\"HIGHENERGYPARTICLESPAWNER\">Radbolt Generators</link>."
msgstr "充滿<link=\"RADIATION\">放射性污染物</link>的劇毒液體，會釋放可供<link=\"HIGHENERGYPARTICLESPAWNER\">輻射粒子產生器</link>吸收的<link=\"RADIATION\">輻射</link>。"

#. STRINGS.ELEMENTS.NUCLEARWASTE.NAME
msgctxt "STRINGS.ELEMENTS.NUCLEARWASTE.NAME"
msgid "<link=\"NUCLEARWASTE\">Liquid Nuclear Waste</link>"
msgstr "<link=\"NUCLEARWASTE\">核廢料</link>"

#. STRINGS.ELEMENTS.OBSIDIAN.DESC
msgctxt "STRINGS.ELEMENTS.OBSIDIAN.DESC"
msgid "Obsidian is a brittle composite of volcanic <link=\"GLASS\">Glass</link>."
msgstr "黑曜石是一種火山<link=\"GLASS\">玻璃</link>的易碎合成物。"

#. STRINGS.ELEMENTS.OBSIDIAN.NAME
msgctxt "STRINGS.ELEMENTS.OBSIDIAN.NAME"
msgid "<link=\"OBSIDIAN\">Obsidian</link>"
msgstr "<link=\"OBSIDIAN\">黑曜石</link>"

#. STRINGS.ELEMENTS.OXYGEN.DESC
msgctxt "STRINGS.ELEMENTS.OXYGEN.DESC"
msgid "(O<sub>2</sub>) Oxygen is an atomically lightweight and breathable <link=\"ELEMENTSGAS\">Gas</link>, necessary for sustaining life.\n\nIt tends to rise above other gases."
msgstr "(O<sub>2</sub>) 氧氣是一種原子量輕且可供呼吸的<link=\"ELEMENTSGAS\">氣體</link>，是維持生命所必需。\n\n它傾向於飄升至其他氣體上方。"

#. STRINGS.ELEMENTS.OXYGEN.NAME
msgctxt "STRINGS.ELEMENTS.OXYGEN.NAME"
msgid "<link=\"OXYGEN\">Oxygen</link>"
msgstr "<link=\"OXYGEN\">氧</link>"

#. STRINGS.ELEMENTS.OXYROCK.DESC
msgctxt "STRINGS.ELEMENTS.OXYROCK.DESC"
msgid "(Ir<sub>3</sub>O<sub>2</sub>) Oxylite is a chemical compound that slowly emits breathable <link=\"OXYGEN\">Oxygen</link>.\n\nExcavating <link=\"OXYROCK\">Oxylite</link> increases its emission rate, but depletes the ore more rapidly."
msgstr "(Ir<sub>3</sub>O<sub>2</sub>) 氧石是一種化合物，會緩慢釋放可呼吸的<link=\"OXYGEN\">氧氣</link>。\n\n挖掘<link=\"OXYROCK\">氧石</link>增加它的釋放速度，但消耗速度更快。"

#. STRINGS.ELEMENTS.OXYROCK.NAME
msgctxt "STRINGS.ELEMENTS.OXYROCK.NAME"
msgid "<link=\"OXYROCK\">Oxylite</link>"
msgstr "<link=\"OXYROCK\">氧石</link>"

#. STRINGS.ELEMENTS.PALMWOOD.DESC
msgctxt "STRINGS.ELEMENTS.PALMWOOD.DESC"
msgid "Gum Wood can be processed at the <link=\"MILKPRESS\">Plant Pulverizer</link> to yield <link=\"LATEX\">Latex</link>, which is essential for <link=\"RUBBER\">Rubber</link> production.\n\nIt can also be used for <link=\"HEAT\">Heat</link> and <link=\"POWER\">Power</link>, or as a <b>Construction Material</b>."
msgstr "黏膠木材可在<link=\"MILKPRESS\">植物粉碎機</link>中處理以產出<link=\"LATEX\">膠乳</link>，這對於<link=\"RUBBER\">橡膠</link>生產至關重要。\n\n亦可用於<link=\"HEAT\">供熱</link>與<link=\"POWER\">發電</link>，或作為<b>建造材料</b>使用。"

#. STRINGS.ELEMENTS.PALMWOOD.NAME
msgctxt "STRINGS.ELEMENTS.PALMWOOD.NAME"
msgid "<link=\"PALMWOOD\">Gum Wood</link>"
msgstr "<link=\"PALMWOOD\">黏膠木材</link>"

#. STRINGS.ELEMENTS.PEARL.DESC
msgctxt "STRINGS.ELEMENTS.PEARL.DESC"
msgid "A perfectly smooth gem.\n\nIt can be eaten by <link=\"SEAHORSESPECIES\">Seaquines</link> or used as an attractive <b>Construction Material</b>."
msgstr "一種表面極其光滑的寶石。\n\n可供<link=\"SEAHORSESPECIES\">海馬</link>食用，或作為美觀的<b>建造材料</b>使用。"

#. STRINGS.ELEMENTS.PEARL.NAME
msgctxt "STRINGS.ELEMENTS.PEARL.NAME"
msgid "<link=\"PEARL\">Pearl</link>"
msgstr "<link=\"PEARL\">珍珠</link>"

#. STRINGS.ELEMENTS.PEAT.DESC
msgctxt "STRINGS.ELEMENTS.PEAT.DESC"
msgid "Peat is a densely packed material made up of partially decomposed organic matter.\n\nIt is a combustible fuel, useful in <link=\"POWER\">Power</link> production."
msgstr "泥炭是一種由部分分解的有機物組成的緻密堆積材料。\n\n它是一種可燃燃料，可用於生產<link=\"POWER\">電力</link>。"

#. STRINGS.ELEMENTS.PEAT.NAME
msgctxt "STRINGS.ELEMENTS.PEAT.NAME"
msgid "<link=\"PEAT\">Peat</link>"
msgstr "<link=\"PEAT\">泥炭</link>"

#. STRINGS.ELEMENTS.PETROLEUM.DESC
msgctxt "STRINGS.ELEMENTS.PETROLEUM.DESC"
msgid "Petroleum is a <link=\"POWER\">Power</link> source refined from <link=\"CRUDEOIL\">Crude Oil</link>.\n\nIt is also an essential ingredient in the production of <link=\"POLYPROPYLENE\">Plastic</link>."
msgstr "石油可做為<link=\"POWER\">電力</link>來源，由<link=\"CRUDEOIL\">原油</link>精煉而來。\n\n它同時也是製造<link=\"POLYPROPYLENE\">塑膠</link>的必要原料。"

#. STRINGS.ELEMENTS.PETROLEUM.NAME
msgctxt "STRINGS.ELEMENTS.PETROLEUM.NAME"
msgid "<link=\"PETROLEUM\">Petroleum</link>"
msgstr "<link=\"PETROLEUM\">石油</link>"

#. STRINGS.ELEMENTS.PETROLEUM.NAME_TWO
msgctxt "STRINGS.ELEMENTS.PETROLEUM.NAME_TWO"
msgid "<link=\"PETROLEUM\">Petroleum</link>"
msgstr "<link=\"PETROLEUM\">石油</link>"

#. STRINGS.ELEMENTS.PHOSPHATENODULES.DESC
msgctxt "STRINGS.ELEMENTS.PHOSPHATENODULES.DESC"
msgid "(PO<sup>3-</sup><sub>4</sub>) Nodules of sedimentary rock containing high concentrations of phosphate."
msgstr "(PO<sup>3-</sup><sub>4</sub>) 含高濃度磷酸鹽岩的沉積岩結核。"

#. STRINGS.ELEMENTS.PHOSPHATENODULES.NAME
msgctxt "STRINGS.ELEMENTS.PHOSPHATENODULES.NAME"
msgid "<link=\"PHOSPHATENODULES\">Phosphate Nodules</link>"
msgstr "<link=\"PHOSPHATENODULES\">磷酸鹽結核</link>"

#. STRINGS.ELEMENTS.PHOSPHORITE.DESC
msgctxt "STRINGS.ELEMENTS.PHOSPHORITE.DESC"
msgid "Phosphorite is a composite of sedimentary rock, saturated with phosphate."
msgstr "磷礦是一種沉積岩，磷酸鹽飽和的合成物。"

#. STRINGS.ELEMENTS.PHOSPHORITE.NAME
msgctxt "STRINGS.ELEMENTS.PHOSPHORITE.NAME"
msgid "<link=\"PHOSPHORITE\">Phosphorite</link>"
msgstr "<link=\"PHOSPHORITE\">磷礦</link>"

#. STRINGS.ELEMENTS.PHOSPHORUS.DESC
msgctxt "STRINGS.ELEMENTS.PHOSPHORUS.DESC"
msgid "(P) Refined Phosphorus is a chemical element in its <link=\"ELEMENTSSOLID\">Solid</link> state."
msgstr "(P) 精煉磷是一種處於<link=\"ELEMENTSSOLID\">固體</link>狀態的化學元素。"

#. STRINGS.ELEMENTS.PHOSPHORUS.NAME
msgctxt "STRINGS.ELEMENTS.PHOSPHORUS.NAME"
msgid "<link=\"PHOSPHORUS\">Refined Phosphorus</link>"
msgstr "<link=\"PHOSPHORUS\">精煉磷</link>"

#. STRINGS.ELEMENTS.PHOSPHORUSGAS.DESC
msgctxt "STRINGS.ELEMENTS.PHOSPHORUSGAS.DESC"
msgid "(P) Phosphorus Gas is the <link=\"ELEMENTSGAS\">Gaseous</link> state of <link=\"PHOSPHORUS\">Refined Phosphorus</link>."
msgstr "(P) 氣態磷是一種處於<link=\"ELEMENTSGAS\">氣體</link>狀態的<link=\"PHOSPHORUS\">精煉磷</link>。"

#. STRINGS.ELEMENTS.PHOSPHORUSGAS.NAME
msgctxt "STRINGS.ELEMENTS.PHOSPHORUSGAS.NAME"
msgid "<link=\"PHOSPHORUSGAS\">Phosphorus Gas</link>"
msgstr "<link=\"PHOSPHORUSGAS\">磷</link>"

#. STRINGS.ELEMENTS.PHYTOOIL.DESC
msgctxt "STRINGS.ELEMENTS.PHYTOOIL.DESC"
msgid "Phyto Oil is a thick, slippery <link=\"ELEMENTSLIQUID\">Liquid</link> extracted from pureed <link=\"SLIME\">Slime</link>."
msgstr "植物油是從<link=\"SLIME\">軟泥</link>中提取出來的一種濃厚滑溜的<link=\"ELEMENTSLIQUID\">液體</link>。"

#. STRINGS.ELEMENTS.PHYTOOIL.NAME
msgctxt "STRINGS.ELEMENTS.PHYTOOIL.NAME"
msgid "<link=\"PHYTOOIL\">Phyto Oil</link>"
msgstr "<link=\"PHYTOOIL\">植物油</link>"

#. STRINGS.ELEMENTS.POLYPROPYLENE.BUILD_DESC
msgctxt "STRINGS.ELEMENTS.POLYPROPYLENE.BUILD_DESC"
msgid "Buildings made of this <link=\"POLYPROPYLENE\">Plastic</link> have antiseptic properties"
msgstr "<link=\"POLYPROPYLENE\">塑膠</link>材質的建築物具有防腐性"

#. STRINGS.ELEMENTS.POLYPROPYLENE.DESC
msgctxt "STRINGS.ELEMENTS.POLYPROPYLENE.DESC"
msgid "(C<sub>3</sub>H<sub>6</sub>)<sub>n</sub> <link=\"POLYPROPYLENE\">Plastic</link> is a thermoplastic polymer.\n\nIt is useful for constructing a variety of advanced buildings and equipment."
msgstr "(C<sub>3</sub>H<sub>6</sub>)<sub>n</sub><link=\"POLYPROPYLENE\">塑膠</link>是一種熱塑性聚合物。\n\n它被用來建造大量的高級建築與裝備。"

#. STRINGS.ELEMENTS.POLYPROPYLENE.NAME
msgctxt "STRINGS.ELEMENTS.POLYPROPYLENE.NAME"
msgid "<link=\"POLYPROPYLENE\">Plastic</link>"
msgstr "<link=\"POLYPROPYLENE\">塑膠</link>"

#. STRINGS.ELEMENTS.PONDSCUM.DESC
msgctxt "STRINGS.ELEMENTS.PONDSCUM.DESC"
msgid "Pondscum is a soft, naturally occurring composite of biological nutrients.\n\nIt may be processed into <link=\"FERTILIZER\">Fertilizer</link> and aids in the growth of certain <link=\"PLANTS\">Plants</link>."
msgstr "池渣是一種柔軟、天然生成的生物營養混合體。\n\n它可以被加工成<link=\"FERTILIZER\">肥料</link>，有助於特定<link=\"PLANTS\">植物</link>生長。"

#. STRINGS.ELEMENTS.PONDSCUM.NAME
msgctxt "STRINGS.ELEMENTS.PONDSCUM.NAME"
msgid "<link=\"PONDSCUM\">Pondscum</link>"
msgstr "<link=\"PONDSCUM\">池渣</link>"

#. STRINGS.ELEMENTS.PROPANE.DESC
msgctxt "STRINGS.ELEMENTS.PROPANE.DESC"
msgid "(C<sub>3</sub>H<sub>8</sub>) Propane Gas is a natural alkane.\n\nThis selection is in a <link=\"ELEMENTSGAS\">Gaseous</link> state.\n\nIt is useful in <link=\"POWER\">Power</link> production."
msgstr "(C<sub>3</sub>H<sub>8</sub>) 丙烷是一種烷烴<link=\"ELEMENTSGAS\">氣體</link>。\n\n它適合用在<link=\"POWER\">電力</link>生產。"

#. STRINGS.ELEMENTS.PROPANE.NAME
msgctxt "STRINGS.ELEMENTS.PROPANE.NAME"
msgid "<link=\"PROPANE\">Propane Gas</link>"
msgstr "<link=\"PROPANE\">丙烷</link>"

#. STRINGS.ELEMENTS.RADIATIONPROPERTIES
msgctxt "STRINGS.ELEMENTS.RADIATIONPROPERTIES"
msgid "Radiation Absorption Factor: {0}\nRadiation Emission/1000kg: {1}"
msgstr "輻射吸收係數：{0}\n輻射量/1000 公斤：{1}"

#. STRINGS.ELEMENTS.RADIUM.DESC
msgctxt "STRINGS.ELEMENTS.RADIUM.DESC"
msgid "(Ra) Radium is a <link=\"LIGHT\">Light</link> emitting radioactive substance.\n\nIt is useful as a <link=\"POWER\">Power</link> source."
msgstr "(Ra) 鐳是一種會<link=\"LIGHT\">發光</link>的放射性物質。\n\n它適合作為<link=\"POWER\">電力</link>來源。"

#. STRINGS.ELEMENTS.RADIUM.NAME
msgctxt "STRINGS.ELEMENTS.RADIUM.NAME"
msgid "<link=\"RADIUM\">Radium</link>"
msgstr "<link=\"RADIUM\">鐳</link>"

#. STRINGS.ELEMENTS.REFINEDCARBON.DESC
msgctxt "STRINGS.ELEMENTS.REFINEDCARBON.DESC"
msgid "(C) Refined carbon is solid element purified from raw <link=\"CARBON\">Coal</link>."
msgstr "(C) 精製炭是由未加工的<link=\"CARBON\">煤炭</link>精製而成的固體元素。"

#. STRINGS.ELEMENTS.REFINEDCARBON.NAME
msgctxt "STRINGS.ELEMENTS.REFINEDCARBON.NAME"
msgid "<link=\"REFINEDCARBON\">Refined Carbon</link>"
msgstr "<link=\"REFINEDCARBON\">精製炭</link>"

#. STRINGS.ELEMENTS.REFINEDLIPID.DESC
msgctxt "STRINGS.ELEMENTS.REFINEDLIPID.DESC"
msgid "Biodiesel is a <link=\"ELEMENTSLIQUID\">Liquid</link> composed of highly processed fatty acids derived from purified natural oils.\n\nIts <link=\"COMBUSTIBLELIQUID\">combustibility</link> makes it useful for <link=\"POWER\">Power</link> production."
msgstr "生質柴油是一種<link=\"ELEMENTSLIQUID\">液體</link>，由經過高度加工、源自純化天然油的脂肪酸所組成。\n\n它的<link=\"COMBUSTIBLELIQUID\">可燃性</link>使其可用於<link=\"POWER\">電力</link>生產。"

#. STRINGS.ELEMENTS.REFINEDLIPID.NAME
msgctxt "STRINGS.ELEMENTS.REFINEDLIPID.NAME"
msgid "<link=\"REFINEDLIPID\">Biodiesel</link>"
msgstr "<link=\"REFINEDLIPID\">生質柴油</link>"

#. STRINGS.ELEMENTS.REGOLITH.DESC
msgctxt "STRINGS.ELEMENTS.REGOLITH.DESC"
msgid "Regolith is a sandy substance composed of the various particles that collect atop terrestrial objects.\n\nIt is useful as a <link=\"FILTER\">Filtration Medium</link>."
msgstr "表土是一種沙狀物質，由累積在天體表面的各種微粒組成。\n\n它適合用作<link=\"FILTER\">過濾介質</link>。"

#. STRINGS.ELEMENTS.REGOLITH.NAME
msgctxt "STRINGS.ELEMENTS.REGOLITH.NAME"
msgid "<link=\"REGOLITH\">Regolith</link>"
msgstr "<link=\"REGOLITH\">表土</link>"

#. STRINGS.ELEMENTS.RESIN.DESC
msgctxt "STRINGS.ELEMENTS.RESIN.DESC"
msgid "Sticky goo harvested from a grumpy tree.\n\nIt can be polymerized into <link=\"ISORESIN\">Isosap</link> by boiling away its excess moisture."
msgstr "從脾氣暴躁的樹上收穫的黏液。\n\n可以透過煮沸去除水份形成<link=\"ISORESIN\">異構膠晶</link>。"

#. STRINGS.ELEMENTS.RESIN.NAME
msgctxt "STRINGS.ELEMENTS.RESIN.NAME"
msgid "<link=\"RESIN\">Sap</link>"
msgstr "<link=\"RESIN\">原生膠</link>"

#. STRINGS.ELEMENTS.ROCKGAS.DESC
msgctxt "STRINGS.ELEMENTS.ROCKGAS.DESC"
msgid "Rock Gas is rock that has been superheated into a <link=\"ELEMENTSGAS\">Gaseous</link> state."
msgstr "岩氣是石頭在超高溫下變成<link=\"ELEMENTSGAS\">氣體</link>狀態。"

#. STRINGS.ELEMENTS.ROCKGAS.NAME
msgctxt "STRINGS.ELEMENTS.ROCKGAS.NAME"
msgid "<link=\"ROCKGAS\">Rock Gas</link>"
msgstr "<link=\"ROCKGAS\">岩氣</link>"

#. STRINGS.ELEMENTS.RUBBER.DESC
msgctxt "STRINGS.ELEMENTS.RUBBER.DESC"
msgid "Rubber is a viscoelastic <link=\"ELEMENTSSOLID\">Solid</link> made from vulcanized <link=\"LATEX\">Latex</link>.\n\nIt can be used to make <link=\"BUILDINGGASKET\">Gaskets</link>."
msgstr "橡膠是一種由<link=\"LATEX\">膠乳</link>經硫化製成的黏彈性<link=\"ELEMENTSSOLID\">固體</link>。\n\n可用於製造<link=\"BUILDINGGASKET\">密封墊</link>。"

#. STRINGS.ELEMENTS.RUBBER.NAME
msgctxt "STRINGS.ELEMENTS.RUBBER.NAME"
msgid "<link=\"RUBBER\">Rubber</link>"
msgstr "<link=\"RUBBER\">橡膠</link>"

#. STRINGS.ELEMENTS.RUST.DESC
msgctxt "STRINGS.ELEMENTS.RUST.DESC"
msgid "Rust is an iron oxide that forms from the breakdown of <link=\"IRON\">Iron</link>.\n\nIt is useful in some <link=\"OXYGEN\">Oxygen</link> production processes."
msgstr "鐵鏽是由<link=\"IRON\">鐵</link>氧化後變成的氧化鐵。\n\n它可用於<link=\"OXYGEN\">氧氣</link>生產過程。"

#. STRINGS.ELEMENTS.RUST.NAME
msgctxt "STRINGS.ELEMENTS.RUST.NAME"
msgid "<link=\"RUST\">Rust</link>"
msgstr "<link=\"RUST\">鐵鏽</link>"

#. STRINGS.ELEMENTS.SALT.DESC
msgctxt "STRINGS.ELEMENTS.SALT.DESC"
msgid "(NaCl) Salt, also known as sodium chloride, is an edible chemical compound.\n\nWhen refined, it can be eaten with meals to increase Duplicant <link=\"MORALE\">Morale</link>."
msgstr "(NaCl) 鹽，也稱作氯化鈉，是一種可食用的化合物。\n\n精煉後，可以用來佐餐，提升複製人的<link=\"MORALE\">士氣</link>。"

#. STRINGS.ELEMENTS.SALT.NAME
msgctxt "STRINGS.ELEMENTS.SALT.NAME"
msgid "<link=\"SALT\">Salt</link>"
msgstr "<link=\"SALT\">鹽</link>"

#. STRINGS.ELEMENTS.SALTGAS.DESC
msgctxt "STRINGS.ELEMENTS.SALTGAS.DESC"
msgid "(NaCl) Salt Gas is an edible chemical compound that has been superheated into a <link=\"ELEMENTSGAS\">Gaseous</link> state."
msgstr "(NaCl) 鹽氣是一種可食用的化合物，已被加熱至極高溫的<link=\"ELEMENTSGAS\">氣體</link>狀態。"

#. STRINGS.ELEMENTS.SALTGAS.NAME
msgctxt "STRINGS.ELEMENTS.SALTGAS.NAME"
msgid "<link=\"SALTGAS\">Salt Gas</link>"
msgstr "<link=\"SALTGAS\">鹽</link>"

#. STRINGS.ELEMENTS.SALTWATER.DESC
msgctxt "STRINGS.ELEMENTS.SALTWATER.DESC"
msgid "Salt Water is a natural, lightly concentrated solution of <link=\"SALT\">Salt</link> dissolved in <link=\"WATER\">Water</link>.\n\nIt can be used in desalination processes, separating out usable salt."
msgstr "鹽水是一種天然，低濃度的<link=\"SALT\">鹽</link>溶於<link=\"WATER\">水</link>中。\n\n可用於鹽水淡化過程，分離出可用的鹽。"

#. STRINGS.ELEMENTS.SALTWATER.NAME
msgctxt "STRINGS.ELEMENTS.SALTWATER.NAME"
msgid "<link=\"SALTWATER\">Salt Water</link>"
msgstr "<link=\"SALTWATER\">鹽水</link>"

#. STRINGS.ELEMENTS.SAND.DESC
msgctxt "STRINGS.ELEMENTS.SAND.DESC"
msgid "Sand is a composite of granular rock.\n\nIt is useful as a <link=\"FILTER\">Filtration Medium</link>."
msgstr "沙子是顆粒狀岩石的組成物。\n\n它適合用作<link=\"FILTER\">過濾介質</link>。"

#. STRINGS.ELEMENTS.SAND.NAME
msgctxt "STRINGS.ELEMENTS.SAND.NAME"
msgid "<link=\"SAND\">Sand</link>"
msgstr "<link=\"SAND\">沙子</link>"

#. STRINGS.ELEMENTS.SANDCEMENT.DESC
msgctxt "STRINGS.ELEMENTS.SANDCEMENT.DESC"
msgid ""
msgstr ""

#. STRINGS.ELEMENTS.SANDCEMENT.NAME
msgctxt "STRINGS.ELEMENTS.SANDCEMENT.NAME"
msgid "<link=\"SANDCEMENT\">Sand Cement</link>"
msgstr "<link=\"SANDCEMENT\">水泥沙</link>"

#. STRINGS.ELEMENTS.SANDSTONE.DESC
msgctxt "STRINGS.ELEMENTS.SANDSTONE.DESC"
msgid "Sandstone is a composite of relatively soft sedimentary rock.\n\nIt is useful as a <b>Construction Material</b>."
msgstr "砂岩是一種質地相對較軟的沉積岩複合物。\n\n它適合作為<b>建築材料</b>。"

#. STRINGS.ELEMENTS.SANDSTONE.NAME
msgctxt "STRINGS.ELEMENTS.SANDSTONE.NAME"
msgid "<link=\"SANDSTONE\">Sandstone</link>"
msgstr "<link=\"SANDSTONE\">砂岩</link>"

#. STRINGS.ELEMENTS.SEDIMENTARYROCK.DESC
msgctxt "STRINGS.ELEMENTS.SEDIMENTARYROCK.DESC"
msgid "Sedimentary Rock is a hardened composite of sediment layers.\n\nIt is useful as a <b>Construction Material</b>."
msgstr "沉積岩是由沉積層硬化而成的複合物。\n\n它適合作為<b>建築材料</b>。"

#. STRINGS.ELEMENTS.SEDIMENTARYROCK.NAME
msgctxt "STRINGS.ELEMENTS.SEDIMENTARYROCK.NAME"
msgid "<link=\"SEDIMENTARYROCK\">Sedimentary Rock</link>"
msgstr "<link=\"SEDIMENTARYROCK\">沉積岩</link>"

#. STRINGS.ELEMENTS.SHALE.DESC
msgctxt "STRINGS.ELEMENTS.SHALE.DESC"
msgid "Shale is a brittle composite of sediment layers.\n\nIt is useful as a <b>Construction Material</b>."
msgstr "頁岩是一種由沉積岩層組成的脆性體。\n\n它適合作為<b>建造材料</b>。"

#. STRINGS.ELEMENTS.SHALE.NAME
msgctxt "STRINGS.ELEMENTS.SHALE.NAME"
msgid "<link=\"SHALE\">Shale</link>"
msgstr "<link=\"SHALE\">頁岩</link>"

#. STRINGS.ELEMENTS.SILTSTONE.DESC
msgctxt "STRINGS.ELEMENTS.SILTSTONE.DESC"
msgid "Siltstone is a chalky mudrock made primarily of compressed silt.\n\nIt is useful as a <b>Construction Material</b>."
msgstr "粉砂岩是一種主要由壓縮粉砂組成的粉質泥岩。\n\n適合作為<b>建造材料</b>使用。"

#. STRINGS.ELEMENTS.SILTSTONE.NAME
msgctxt "STRINGS.ELEMENTS.SILTSTONE.NAME"
msgid "<link=\"SILTSTONE\">Siltstone</link>"
msgstr "<link=\"SILTSTONE\">粉砂岩</link>"

#. STRINGS.ELEMENTS.SLABS.DESC
msgctxt "STRINGS.ELEMENTS.SLABS.DESC"
msgid "Slabs are a refined mineral building block used for assembling advanced buildings."
msgstr "石板是一種精煉過的礦物建築材料，被用來建造高級建築物。"

#. STRINGS.ELEMENTS.SLABS.NAME
msgctxt "STRINGS.ELEMENTS.SLABS.NAME"
msgid "<link=\"SLABS\">Building Slab</link>"
msgstr "<link=\"SLABS\">建造石板</link>"

#. STRINGS.ELEMENTS.SLIMEMOLD.DESC
msgctxt "STRINGS.ELEMENTS.SLIMEMOLD.DESC"
msgid "Slime is a thick biomixture of algae, fungi, and mucopolysaccharides.\n\nIt can be distilled into <link=\"ALGAE\">Algae</link> and emits <link=\"CONTAMINATEDOXYGEN\">Polluted Oxygen</link> once dug up."
msgstr "軟泥是藻類，真菌和黏多醣類的有機混合物。\n\n它可以提煉<link=\"ALGAE\">藻類</link>，一旦挖開會釋放<link=\"CONTAMINATEDOXYGEN\">汙氧</link>。"

#. STRINGS.ELEMENTS.SLIMEMOLD.NAME
msgctxt "STRINGS.ELEMENTS.SLIMEMOLD.NAME"
msgid "<link=\"SLIMEMOLD\">Slime</link>"
msgstr "<link=\"SLIMEMOLD\">軟泥</link>"

#. STRINGS.ELEMENTS.SNOW.DESC
msgctxt "STRINGS.ELEMENTS.SNOW.DESC"
msgid "(H<sub>2</sub>O) Snow is a mass of loose, crystalline ice particles.\n\nIt becomes <link=\"WATER\">Water</link> when melted."
msgstr "(H<sub>2</sub>O) 雪是一團鬆散的冰晶顆粒。\n\n當它融化的時候會變成<link=\"WATER\">水</link>。"

#. STRINGS.ELEMENTS.SNOW.NAME
msgctxt "STRINGS.ELEMENTS.SNOW.NAME"
msgid "<link=\"SNOW\">Snow</link>"
msgstr "<link=\"SNOW\">雪</link>"

#. STRINGS.ELEMENTS.SOLIDCARBONDIOXIDE.DESC
msgctxt "STRINGS.ELEMENTS.SOLIDCARBONDIOXIDE.DESC"
msgid "(CO<sub>2</sub>) Carbon Dioxide is an unbreathable compound in a <link=\"ELEMENTSSOLID\">Solid</link> state."
msgstr "(CO<sub>2</sub>) 二氧化碳是一種不可呼吸的化合物，處於<link=\"ELEMENTSSOLID\">固體</link>狀態。"

#. STRINGS.ELEMENTS.SOLIDCARBONDIOXIDE.NAME
msgctxt "STRINGS.ELEMENTS.SOLIDCARBONDIOXIDE.NAME"
msgid "<link=\"SOLIDCARBONDIOXIDE\">Solid Carbon Dioxide</link>"
msgstr "<link=\"SOLIDCARBONDIOXIDE\">二氧化碳</link>"

#. STRINGS.ELEMENTS.SOLIDCHLORINE.DESC
msgctxt "STRINGS.ELEMENTS.SOLIDCHLORINE.DESC"
msgid "(Cl) Chlorine is a natural <link=\"DISEASE\">Germ</link>-killing element in a <link=\"ELEMENTSSOLID\">Solid</link> state."
msgstr "(Cl) 氯是一種天然的<link=\"DISEASE\">殺菌</link>元素，處於<link=\"ELEMENTSSOLID\">固體</link>狀態。"

#. STRINGS.ELEMENTS.SOLIDCHLORINE.NAME
msgctxt "STRINGS.ELEMENTS.SOLIDCHLORINE.NAME"
msgid "<link=\"SOLIDCHLORINE\">Solid Chlorine</link>"
msgstr "<link=\"SOLIDCHLORINE\">氯</link>"

#. STRINGS.ELEMENTS.SOLIDCRUDEOIL.DESC
msgctxt "STRINGS.ELEMENTS.SOLIDCRUDEOIL.DESC"
msgid ""
msgstr ""

#. STRINGS.ELEMENTS.SOLIDCRUDEOIL.NAME
msgctxt "STRINGS.ELEMENTS.SOLIDCRUDEOIL.NAME"
msgid "<link=\"SOLIDCRUDEOIL\">Solid Crude Oil</link>"
msgstr "<link=\"SOLIDCRUDEOIL\">原油</link>"

#. STRINGS.ELEMENTS.SOLIDETHANOL.DESC
msgctxt "STRINGS.ELEMENTS.SOLIDETHANOL.DESC"
msgid "(C<sub>2</sub>H<sub>6</sub>O) Solid Ethanol is an advanced chemical compound.\n\nIt can be used as a highly effective fuel source when burned."
msgstr "(C<sub>2</sub>H<sub>6</sub>O) 固態乙醇是一種高階化合物。\n\n燃燒時可作為一種極為高效的燃料來源。"

#. STRINGS.ELEMENTS.SOLIDETHANOL.NAME
msgctxt "STRINGS.ELEMENTS.SOLIDETHANOL.NAME"
msgid "<link=\"SOLIDETHANOL\">Solid Ethanol</link>"
msgstr "<link=\"SOLIDETHANOL\">乙醇</link>"

#. STRINGS.ELEMENTS.SOLIDHYDROGEN.DESC
msgctxt "STRINGS.ELEMENTS.SOLIDHYDROGEN.DESC"
msgid "(H) Solid Hydrogen is the universe's most common element in a <link=\"ELEMENTSSOLID\">Solid</link> state."
msgstr "(H) 固態氫是處於<link=\"ELEMENTSSOLID\">固體</link>狀態下的宇宙最常見元素。"

#. STRINGS.ELEMENTS.SOLIDHYDROGEN.NAME
msgctxt "STRINGS.ELEMENTS.SOLIDHYDROGEN.NAME"
msgid "<link=\"SOLIDHYDROGEN\">Solid Hydrogen</link>"
msgstr "<link=\"SOLIDHYDROGEN\">氫</link>"

#. STRINGS.ELEMENTS.SOLIDMERCURY.DESC
msgctxt "STRINGS.ELEMENTS.SOLIDMERCURY.DESC"
msgid "(Hg) Mercury is a rare <link=\"REFINEDMETAL\">Metal</link> in a <link=\"ELEMENTSSOLID\">Solid</link> state."
msgstr "(Hg) 汞是一種處於<link=\"ELEMENTSSOLID\">固體</link>狀態的稀有<link=\"REFINEDMETAL\">金屬</link>。"

#. STRINGS.ELEMENTS.SOLIDMERCURY.NAME
msgctxt "STRINGS.ELEMENTS.SOLIDMERCURY.NAME"
msgid "<link=\"SOLIDMERCURY\">Mercury</link>"
msgstr "<link=\"SOLIDMERCURY\">汞</link>"

#. STRINGS.ELEMENTS.SOLIDMETHANE.DESC
msgctxt "STRINGS.ELEMENTS.SOLIDMETHANE.DESC"
msgid "(CH<sub>4</sub>) Methane is an alkane in a <link=\"ELEMENTSSOLID\">Solid</link> state."
msgstr "(CH<sub>4</sub>) 甲烷是一種烷烴，處於<link=\"ELEMENTSSOLID\">固體</link>狀態。"

#. STRINGS.ELEMENTS.SOLIDMETHANE.NAME
msgctxt "STRINGS.ELEMENTS.SOLIDMETHANE.NAME"
msgid "<link=\"SOLIDMETHANE\">Solid Methane</link>"
msgstr "<link=\"SOLIDMETHANE\">甲烷</link>"

#. STRINGS.ELEMENTS.SOLIDMUCUS.DESC
msgctxt "STRINGS.ELEMENTS.SOLIDMUCUS.DESC"
msgid "Frozen Mucin is a chunk of <link=\"MUCUS\">Mucin</link> cooled to a <link=\"ELEMENTSSOLID\">Solid</link> state."
msgstr "凝凍黏蛋白是一塊凍結成<link=\"ELEMENTSSOLID\">固體</link>狀態的<link=\"MUCUS\">黏蛋白</link>。"

#. STRINGS.ELEMENTS.SOLIDMUCUS.NAME
msgctxt "STRINGS.ELEMENTS.SOLIDMUCUS.NAME"
msgid "<link=\"SOLIDMUCUS\">Frozen Mucin</link>"
msgstr "<link=\"SOLIDMUCUS\">凝凍黏蛋白</link>"

#. STRINGS.ELEMENTS.SOLIDNAPHTHA.DESC
msgctxt "STRINGS.ELEMENTS.SOLIDNAPHTHA.DESC"
msgid "Naphtha is a distilled hydrocarbon mixture in a <link=\"ELEMENTSSOLID\">Solid</link> state."
msgstr "石腦油是一種蒸餾過的有機化合物，處於<link=\"ELEMENTSSOLID\">固體</link>狀態。"

#. STRINGS.ELEMENTS.SOLIDNAPHTHA.NAME
msgctxt "STRINGS.ELEMENTS.SOLIDNAPHTHA.NAME"
msgid "<link=\"SOLIDNAPHTHA\">Solid Naphtha</link>"
msgstr "<link=\"SOLIDNAPHTHA\">石腦油</link>"

#. STRINGS.ELEMENTS.SOLIDNUCLEARWASTE.DESC
msgctxt "STRINGS.ELEMENTS.SOLIDNUCLEARWASTE.DESC"
msgid "Highly toxic solid full of <link=\"RADIATION\">Radioactive Contaminants</link>."
msgstr "充滿<link=\"RADIATION\">輻射汙染</link>的劇毒固體。"

#. STRINGS.ELEMENTS.SOLIDNUCLEARWASTE.NAME
msgctxt "STRINGS.ELEMENTS.SOLIDNUCLEARWASTE.NAME"
msgid "<link=\"SOLIDNUCLEARWASTE\">Solid Nuclear Waste</link>"
msgstr "<link=\"SOLIDNUCLEARWASTE\">核廢料</link>"

#. STRINGS.ELEMENTS.SOLIDOXYGEN.DESC
msgctxt "STRINGS.ELEMENTS.SOLIDOXYGEN.DESC"
msgid "(O<sub>2</sub>) Solid Oxygen is a breathable element in a <link=\"ELEMENTSSOLID\">Solid</link> state."
msgstr "(O<sub>2</sub>) 固態氧是一種可呼吸的元素，處於<link=\"ELEMENTSSOLID\">固體</link>狀態。"

#. STRINGS.ELEMENTS.SOLIDOXYGEN.NAME
msgctxt "STRINGS.ELEMENTS.SOLIDOXYGEN.NAME"
msgid "<link=\"SOLIDOXYGEN\">Solid Oxygen</link>"
msgstr "<link=\"SOLIDOXYGEN\">氧</link>"

#. STRINGS.ELEMENTS.SOLIDPETROLEUM.DESC
msgctxt "STRINGS.ELEMENTS.SOLIDPETROLEUM.DESC"
msgid "Petroleum is a <link=\"POWER\">Power</link> source.\n\nThis selection is in a <link=\"ELEMENTSSOLID\">Solid</link> state."
msgstr "石油是一種<link=\"POWER\">電力</link>來源\n\n目前處於<link=\"ELEMENTSSOLID\">固體</link>狀態。"

#. STRINGS.ELEMENTS.SOLIDPETROLEUM.NAME
msgctxt "STRINGS.ELEMENTS.SOLIDPETROLEUM.NAME"
msgid "<link=\"SOLIDPETROLEUM\">Solid Petroleum</link>"
msgstr "<link=\"SOLIDPETROLEUM\">石油</link>"

#. STRINGS.ELEMENTS.SOLIDPROPANE.DESC
msgctxt "STRINGS.ELEMENTS.SOLIDPROPANE.DESC"
msgid "(C<sub>3</sub>H<sub>8</sub>) Solid Propane is a natural gas in a <link=\"ELEMENTSSOLID\">Solid</link> state."
msgstr "(C<sub>3</sub>H<sub>8</sub>) 固態丙烷是處於<link=\"ELEMENTSSOLID\">固體</link>狀態下的天然氣體。"

#. STRINGS.ELEMENTS.SOLIDPROPANE.NAME
msgctxt "STRINGS.ELEMENTS.SOLIDPROPANE.NAME"
msgid "<link=\"SOLIDPROPANE\">Solid Propane</link>"
msgstr "<link=\"SOLIDPROPANE\">丙烷</link>"

#. STRINGS.ELEMENTS.SOLIDRESIN.DESC
msgctxt "STRINGS.ELEMENTS.SOLIDRESIN.DESC"
msgid "Solidified goo harvested from a grumpy tree.\n\nIt is used in the production of <link=\"ISORESIN\">Isosap</link>."
msgstr "從脾氣暴躁的樹上收穫的凝固黏液。\n可用來製造<link=\"ISORESIN\">異構膠晶</link>。"

#. STRINGS.ELEMENTS.SOLIDRESIN.NAME
msgctxt "STRINGS.ELEMENTS.SOLIDRESIN.NAME"
msgid "<link=\"SOLIDRESIN\">Solid Sap</link>"
msgstr "<link=\"SOLIDRESIN\">原生膠</link>"

#. STRINGS.ELEMENTS.SOLIDSUPERCOOLANT.DESC
msgctxt "STRINGS.ELEMENTS.SOLIDSUPERCOOLANT.DESC"
msgid "Super Coolant is an industrial-grade <link=\"FULLERENE\">Fullerene</link> coolant.\n\nThis selection is in a <link=\"ELEMENTSSOLID\">Solid</link> state."
msgstr "超級冷卻液是一種工業級的<link=\"FULLERENE\">富勒烯</link>冷卻液。\n\n目前處於<link=\"ELEMENTSSOLID\">固體</link>狀態。"

#. STRINGS.ELEMENTS.SOLIDSUPERCOOLANT.NAME
msgctxt "STRINGS.ELEMENTS.SOLIDSUPERCOOLANT.NAME"
msgid "<link=\"SOLIDSUPERCOOLANT\">Solid Super Coolant</link>"
msgstr "<link=\"SOLIDSUPERCOOLANT\">超級冷卻液</link>"

#. STRINGS.ELEMENTS.SOLIDSYNGAS.DESC
msgctxt "STRINGS.ELEMENTS.SOLIDSYNGAS.DESC"
msgid "Solid Synthesis Gas is an artificial, unbreathable <link=\"ELEMENTSSOLID\">Solid</link>.\n\nIt can be converted into an efficient fuel."
msgstr "固態合成氣是一種人工製造、不可呼吸的<link=\"ELEMENTSSOLID\">氣體</link>。\n\n它可以轉化為高效燃料。"

#. STRINGS.ELEMENTS.SOLIDSYNGAS.NAME
msgctxt "STRINGS.ELEMENTS.SOLIDSYNGAS.NAME"
msgid "<link=\"SYNGAS\">Solid Synthesis Gas</link>"
msgstr "<link=\"SYNGAS\">合成氣</link>"

#. STRINGS.ELEMENTS.SOLIDVISCOGEL.DESC
msgctxt "STRINGS.ELEMENTS.SOLIDVISCOGEL.DESC"
msgid "Visco-Gel is a polymer that has high surface tension when in <link=\"ELEMENTSLIQUID\">Liquid</link> form.\n\nThis selection is in a <link=\"ELEMENTSSOLID\">Solid</link> state."
msgstr "凝膠是一種聚合物，在<link=\"ELEMENTSLIQUID\">液體</link>形態時具有高表面張力。\n\n目前處於<link=\"ELEMENTSSOLID\">固體</link>狀態。"

#. STRINGS.ELEMENTS.SOLIDVISCOGEL.NAME
msgctxt "STRINGS.ELEMENTS.SOLIDVISCOGEL.NAME"
msgid "<link=\"SOLIDVISCOGEL\">Solid Visco-Gel</link>"
msgstr "<link=\"SOLIDVISCOGEL\">凝膠</link>"

#. STRINGS.ELEMENTS.SOURGAS.DESC
msgctxt "STRINGS.ELEMENTS.SOURGAS.DESC"
msgid "Sour Gas is a hydrocarbon <link=\"ELEMENTSGAS\">Gas</link> containing high concentrations of hydrogen sulfide.\n\nIt is a byproduct of highly heated <link=\"PETROLEUM\">Petroleum</link>."
msgstr "酸氣是一種碳氫化合物<link=\"ELEMENTSGAS\">氣體</link>含有高濃度的硫化氫。\n\n它是高溫加熱<link=\"PETROLEUM\">石油</link>的副產品。"

#. STRINGS.ELEMENTS.SOURGAS.NAME
msgctxt "STRINGS.ELEMENTS.SOURGAS.NAME"
msgid "<link=\"SOURGAS\">Sour Gas</link>"
msgstr "<link=\"SOURGAS\">酸氣</link>"

#. STRINGS.ELEMENTS.SOURGAS.NAME_TWO
msgctxt "STRINGS.ELEMENTS.SOURGAS.NAME_TWO"
msgid "<link=\"SOURGAS\">Sour Gas</link>"
msgstr "<link=\"SOURGAS\">酸氣</link>"

#. STRINGS.ELEMENTS.STABLESNOW.DESC
msgctxt "STRINGS.ELEMENTS.STABLESNOW.DESC"
msgid "(H<sub>2</sub>O) Snow is a mass of loose, crystalline ice particles.\n\nIt becomes <link=\"WATER\">Water</link> when melted."
msgstr "(H<sub>2</sub>O) 雪是一團鬆散的結晶冰粒。\n\n雪融化後變成<link=\"WATER\">水</link>。"

#. STRINGS.ELEMENTS.STABLESNOW.NAME
msgctxt "STRINGS.ELEMENTS.STABLESNOW.NAME"
msgid "Packed <link=\"SNOW\">Snow</link>"
msgstr "積<link=\"SNOW\">雪</link>"

#. STRINGS.ELEMENTS.STATE.GAS
msgctxt "STRINGS.ELEMENTS.STATE.GAS"
msgid "Gas"
msgstr "氣體"

#. STRINGS.ELEMENTS.STATE.LIQUID
msgctxt "STRINGS.ELEMENTS.STATE.LIQUID"
msgid "Liquid"
msgstr "液體"

#. STRINGS.ELEMENTS.STATE.SOLID
msgctxt "STRINGS.ELEMENTS.STATE.SOLID"
msgid "Solid"
msgstr "固體"

#. STRINGS.ELEMENTS.STATE.VACUUM
msgctxt "STRINGS.ELEMENTS.STATE.VACUUM"
msgid "None"
msgstr "無"

#. STRINGS.ELEMENTS.STEAM.DESC
msgctxt "STRINGS.ELEMENTS.STEAM.DESC"
msgid "(H<sub>2</sub>O) Steam is <link=\"WATER\">Water</link> that has been heated into a scalding <link=\"ELEMENTSGAS\">Gas</link>."
msgstr "(H<sub>2</sub>O) 蒸氣是<link=\"WATER\">水</link>被加熱至高溫變成<link=\"ELEMENTSGAS\">氣體</link>。"

#. STRINGS.ELEMENTS.STEAM.NAME
msgctxt "STRINGS.ELEMENTS.STEAM.NAME"
msgid "<link=\"STEAM\">Steam</link>"
msgstr "<link=\"STEAM\">蒸氣</link>"

#. STRINGS.ELEMENTS.STEEL.DESC
msgctxt "STRINGS.ELEMENTS.STEEL.DESC"
msgid "Steel is a <link=\"REFINEDMETAL\">Metal Alloy</link> composed of iron and carbon."
msgstr "鋼是一種<link=\"REFINEDMETAL\">金屬合金</link>，鐵和碳的合成物。"

#. STRINGS.ELEMENTS.STEEL.NAME
msgctxt "STRINGS.ELEMENTS.STEEL.NAME"
msgid "<link=\"STEEL\">Steel</link>"
msgstr "<link=\"STEEL\">鋼</link>"

#. STRINGS.ELEMENTS.STEELGAS.DESC
msgctxt "STRINGS.ELEMENTS.STEELGAS.DESC"
msgid "Steel Gas is a superheated <link=\"METAL\">Metal</link> <link=\"ELEMENTSGAS\">Gas</link> composed of iron and carbon."
msgstr "鋼氣是一種高溫加熱的<link=\"METAL\">金屬</link><link=\"ELEMENTSGAS\">氣體</link>，由鐵和碳組成的合成物。"

#. STRINGS.ELEMENTS.STEELGAS.NAME
msgctxt "STRINGS.ELEMENTS.STEELGAS.NAME"
msgid "<link=\"STEELGAS\">Steel Gas</link>"
msgstr "<link=\"STEELGAS\">鋼</link>"

#. STRINGS.ELEMENTS.SUCROSE.DESC
msgctxt "STRINGS.ELEMENTS.SUCROSE.DESC"
msgid "(C<sub>12</sub>H<sub>22</sub>O<sub>11</sub>) Sucrose is the raw form of sugar.\n\nIt can be used for cooking higher-quality <link=\"FOOD\">Food</link>."
msgstr "(C<sub>12</sub>H<sub>22</sub>O<sub>11</sub>) 蔗糖是糖的未加工形態。\n\n它可以直接用於烹飪更高品質的<link=\"FOOD\">食物</link>。"

#. STRINGS.ELEMENTS.SUCROSE.NAME
msgctxt "STRINGS.ELEMENTS.SUCROSE.NAME"
msgid "<link=\"SUCROSE\">Sucrose</link>"
msgstr "<link=\"SUCROSE\">蔗糖</link>"

#. STRINGS.ELEMENTS.SUGARWATER.DESC
msgctxt "STRINGS.ELEMENTS.SUGARWATER.DESC"
msgid "Nectar is a natural, lightly concentrated solution of <link=\"SUCROSE\">Sucrose</link> dissolved in <link=\"WATER\">Water</link>."
msgstr "花蜜是一種天然的，由<link=\"SUCROSE\">蔗糖</link>溶解在<link=\"WATER\">水</link>中形成的輕度濃縮溶液。"

#. STRINGS.ELEMENTS.SUGARWATER.NAME
msgctxt "STRINGS.ELEMENTS.SUGARWATER.NAME"
msgid "<link=\"SUGARWATER\">Nectar</link>"
msgstr "<link=\"SUGARWATER\">花蜜</link>"

#. STRINGS.ELEMENTS.SULFUR.DESC
msgctxt "STRINGS.ELEMENTS.SULFUR.DESC"
msgid "(S) Sulfur is a common chemical element and byproduct of <link=\"METHANE\">Natural Gas</link> production.\n\nThis selection is in a <link=\"ELEMENTSSOLID\">Solid</link> state."
msgstr "(S) 硫是一種常見化學元素，通常是生產<link=\"METHANE\">天然氣</link>的副產品。目前處於<link=\"ELEMENTSGAS\">固體</link>狀態。"

#. STRINGS.ELEMENTS.SULFUR.NAME
msgctxt "STRINGS.ELEMENTS.SULFUR.NAME"
msgid "<link=\"SULFUR\">Sulfur</link>"
msgstr "<link=\"SULFUR\">硫</link>"

#. STRINGS.ELEMENTS.SULFURGAS.DESC
msgctxt "STRINGS.ELEMENTS.SULFURGAS.DESC"
msgid "(S) Sulfur is a common chemical element and byproduct of <link=\"METHANE\">Natural Gas</link> production.\n\nThis selection is in a <link=\"ELEMENTSGAS\">Gaseous</link> state."
msgstr "(S) 硫是一種常見的化學元素，通常是生產<link=\"METHANE\">天然氣</link>的副產品。\n\n目前處於<link=\"ELEMENTSGAS\">氣體</link>狀態。"

#. STRINGS.ELEMENTS.SULFURGAS.NAME
msgctxt "STRINGS.ELEMENTS.SULFURGAS.NAME"
msgid "<link=\"SULFURGAS\">Sulfur Gas</link>"
msgstr "<link=\"SULFURGAS\">硫</link>"

#. STRINGS.ELEMENTS.SUPERCOOLANT.DESC
msgctxt "STRINGS.ELEMENTS.SUPERCOOLANT.DESC"
msgid "Super Coolant is an industrial-grade coolant that utilizes the unusual energy states of <link=\"FULLERENE\">Fullerene</link>.\n\nThis selection is in a <link=\"ELEMENTSLIQUID\">Liquid</link> state."
msgstr "超級冷卻液是一種工業級的冷卻液，利用了<link=\"FULLERENE\">富勒烯</link>的特殊能量狀態。目前處於<link=\"ELEMENTSGAS\">液體</link>狀態。"

#. STRINGS.ELEMENTS.SUPERCOOLANT.NAME
msgctxt "STRINGS.ELEMENTS.SUPERCOOLANT.NAME"
msgid "<link=\"SUPERCOOLANT\">Super Coolant</link>"
msgstr "<link=\"SUPERCOOLANT\">超級冷卻液</link>"

#. STRINGS.ELEMENTS.SUPERCOOLANTGAS.DESC
msgctxt "STRINGS.ELEMENTS.SUPERCOOLANTGAS.DESC"
msgid "Super Coolant is an industrial-grade <link=\"FULLERENE\">Fullerene</link> coolant.\n\nThis selection is in a <link=\"ELEMENTSGAS\">Gaseous</link> state."
msgstr "超級冷卻液是一種工業級的<link=\"FULLERENE\">富勒烯</link> 冷卻液。\n\n目前處於<link=\"ELEMENTSGAS\">氣體</link>狀態。"

#. STRINGS.ELEMENTS.SUPERCOOLANTGAS.NAME
msgctxt "STRINGS.ELEMENTS.SUPERCOOLANTGAS.NAME"
msgid "<link=\"SUPERCOOLANTGAS\">Super Coolant Gas</link>"
msgstr "<link=\"SUPERCOOLANTGAS\">超級冷卻液</link>"

#. STRINGS.ELEMENTS.SUPERINSULATOR.DESC
msgctxt "STRINGS.ELEMENTS.SUPERINSULATOR.DESC"
msgid "Insulite reduces <link=\"HEAT\">Heat Transfer</link> and is composed of recrystallized <link=\"KATAIRITE\">Abyssalite</link>."
msgstr "隔熱質能減少<link=\"HEAT\">熱量傳遞</link>，是由再結晶的<link=\"KATAIRITE\">深淵水晶</link>所組成。"

#. STRINGS.ELEMENTS.SUPERINSULATOR.NAME
msgctxt "STRINGS.ELEMENTS.SUPERINSULATOR.NAME"
msgid "<link=\"SUPERINSULATOR\">Insulite</link>"
msgstr "<link=\"SUPERINSULATOR\">隔熱質</link>"

#. STRINGS.ELEMENTS.SYNGAS.DESC
msgctxt "STRINGS.ELEMENTS.SYNGAS.DESC"
msgid "Synthesis Gas is an artificial, unbreathable <link=\"ELEMENTSGAS\">Gas</link>.\n\nIt can be converted into an efficient fuel."
msgstr "合成氣是一種不能呼吸的<link=\"ELEMENTSGAS\">氣體</link>。\n\n它可以轉化成高效燃料。"

#. STRINGS.ELEMENTS.SYNGAS.NAME
msgctxt "STRINGS.ELEMENTS.SYNGAS.NAME"
msgid "<link=\"SYNGAS\">Synthesis Gas</link>"
msgstr "<link=\"SYNGAS\">合成氣</link>"

#. STRINGS.ELEMENTS.TALLOW.DESC
msgctxt "STRINGS.ELEMENTS.TALLOW.DESC"
msgid "A chunk of raw grease that can be used in <link=\"FOOD\">Food</link> production or industrial processes."
msgstr "一大塊的生油脂，可用於<link=\"FOOD\">食物</link>生產或工業用途。"

#. STRINGS.ELEMENTS.TALLOW.NAME
msgctxt "STRINGS.ELEMENTS.TALLOW.NAME"
msgid "<link=\"TALLOW\">Tallow</link>"
msgstr "<link=\"TALLOW\">動物油脂</link>"

#. STRINGS.ELEMENTS.TEMPCONDUCTORSOLID.DESC
msgctxt "STRINGS.ELEMENTS.TEMPCONDUCTORSOLID.DESC"
msgid "Thermium is an industrial metal alloy formulated to maximize <link=\"HEAT\">Heat Transfer</link> and thermal dispersion."
msgstr "超導體是一種工業金屬合金，能最大化的<link=\"HEAT\">熱傳導</link>與散熱。"

#. STRINGS.ELEMENTS.TEMPCONDUCTORSOLID.NAME
msgctxt "STRINGS.ELEMENTS.TEMPCONDUCTORSOLID.NAME"
msgid "<link=\"TEMPCONDUCTORSOLID\">Thermium</link>"
msgstr "<link=\"TEMPCONDUCTORSOLID\">超導體</link>"

#. STRINGS.ELEMENTS.TESTELEMENT.DESC
msgctxt "STRINGS.ELEMENTS.TESTELEMENT.DESC"
msgid "((Fe,Mn)WO<sub>4</sub>) Wolframite is a dense Metallic element in a <link=\"ELEMENTSSOLID\">Solid</link> state.\n\nIt is a source of <link=\"TUNGSTEN\">Tungsten</link> and is suitable for building <link=\"POWER\">Power</link> systems."
msgstr "((Fe,Mn)WO<sub>4</sub>) 黑鎢礦一種高密度金屬元素，處於<link=\"ELEMENTSSOLID\">固體</link>狀態。\n它是<link=\"TUNGSTEN\">鎢</link>的來源，並可以用來建造<link=\"POWER\">電力</link>系統。"

#. STRINGS.ELEMENTS.TESTELEMENT.NAME
msgctxt "STRINGS.ELEMENTS.TESTELEMENT.NAME"
msgid "<link=\"TESTELEMENT\">Test Element</link>"
msgstr "<link=\"TESTELEMENT\">測試元素</link>"

#. STRINGS.ELEMENTS.THERMALPROPERTIES
msgctxt "STRINGS.ELEMENTS.THERMALPROPERTIES"
msgid "\nSpecific Heat Capacity: {SPECIFIC_HEAT_CAPACITY}\nThermal Conductivity: {THERMAL_CONDUCTIVITY}"
msgstr "\n比熱容：{SPECIFIC_HEAT_CAPACITY}\n導熱係數：{THERMAL_CONDUCTIVITY}"

#. STRINGS.ELEMENTS.TOXICMUD.DESC
msgctxt "STRINGS.ELEMENTS.TOXICMUD.DESC"
msgid "A mixture of <link=\"TOXICSAND\">Polluted Dirt</link> and <link=\"DIRTYWATER\">Polluted Water</link>.\n\nCan be separated into its base elements using a <link=\"SLUDGEPRESS\">Sludge Press</link>."
msgstr "<link=\"TOXICSAND\">汙土</link>與<link=\"DIRTYWATER\">汙水</link>的混合物。\n\n使用<link=\"SLUDGEPRESS\">脫水機</link>可以分離成基礎元素。"

#. STRINGS.ELEMENTS.TOXICMUD.NAME
msgctxt "STRINGS.ELEMENTS.TOXICMUD.NAME"
msgid "<link=\"TOXICMUD\">Polluted Mud</link>"
msgstr "<link=\"TOXICMUD\">汙泥漿</link>"

#. STRINGS.ELEMENTS.TOXICSAND.DESC
msgctxt "STRINGS.ELEMENTS.TOXICSAND.DESC"
msgid "Polluted Dirt is unprocessed biological waste.\n\nIt emits <link=\"CONTAMINATEDOXYGEN\">Polluted Oxygen</link> over time."
msgstr "汙土是未經處理的生物廢棄物。\n\n隨著時間經過，會釋放<link=\"CONTAMINATEDOXYGEN\">汙氧</link>。"

#. STRINGS.ELEMENTS.TOXICSAND.NAME
msgctxt "STRINGS.ELEMENTS.TOXICSAND.NAME"
msgid "<link=\"TOXICSAND\">Polluted Dirt</link>"
msgstr "<link=\"TOXICSAND\">汙土</link>"

#. STRINGS.ELEMENTS.TUNGSTEN.DESC
msgctxt "STRINGS.ELEMENTS.TUNGSTEN.DESC"
msgid "(W) Tungsten is an extremely tough crystalline <link=\"REFINEDMETAL\">Metal</link>.\n\nIt is suitable for building <link=\"POWER\">Power</link> systems."
msgstr "(W) 鎢是一種極其堅韌的結晶<link=\"REFINEDMETAL\">金屬</link>。\n\n它適合用來建造<link=\"POWER\">電力</link>系統。"

#. STRINGS.ELEMENTS.TUNGSTEN.NAME
msgctxt "STRINGS.ELEMENTS.TUNGSTEN.NAME"
msgid "<link=\"TUNGSTEN\">Tungsten</link>"
msgstr "<link=\"TUNGSTEN\">鎢</link>"

#. STRINGS.ELEMENTS.TUNGSTENDISELENIDE.DESC
msgctxt "STRINGS.ELEMENTS.TUNGSTENDISELENIDE.DESC"
msgid "(WSe<sub>2</sub>) Tungsten Diselenide is an inorganic <link=\"REFINEDMETAL\">Metal</link> compound with a crystalline structure.\n\nIt is suitable for building <link=\"POWER\">Power</link> systems."
msgstr "(WSe<sub>2</sub>) 二硒化鎢是一種無機的<link=\"REFINEDMETAL\">金屬</link>化合物，具有晶體結構。\n\n它適合用來建造<link=\"POWER\">電力</link>系統。"

#. STRINGS.ELEMENTS.TUNGSTENDISELENIDE.NAME
msgctxt "STRINGS.ELEMENTS.TUNGSTENDISELENIDE.NAME"
msgid "<link=\"TUNGSTENDISELENIDE\">Tungsten Diselenide</link>"
msgstr "<link=\"TUNGSTENDISELENIDE\">二硒化鎢</link>"

#. STRINGS.ELEMENTS.TUNGSTENDISELENIDEGAS.DESC
msgctxt "STRINGS.ELEMENTS.TUNGSTENDISELENIDEGAS.DESC"
msgid "(WSe<sub>2</sub>) Tungsten Diselenide Gasis a superheated <link=\"REFINEDMETAL\">Metal</link> compound in a <link=\"ELEMENTSGAS\">Gaseous</link> state."
msgstr "(WSe<sub>2</sub>) 二硒化鎢氣是一種已被加熱至極高溫、處於<link=\"ELEMENTSGAS\">氣體</link>狀態的<link=\"REFINEDMETAL\">金屬</link>化合物。"

#. STRINGS.ELEMENTS.TUNGSTENDISELENIDEGAS.NAME
msgctxt "STRINGS.ELEMENTS.TUNGSTENDISELENIDEGAS.NAME"
msgid "<link=\"TUNGSTENDISELENIDEGAS\">Tungsten Diselenide Gas</link>"
msgstr "<link=\"TUNGSTENDISELENIDEGAS\">二硒化鎢</link>"

#. STRINGS.ELEMENTS.TUNGSTENGAS.DESC
msgctxt "STRINGS.ELEMENTS.TUNGSTENGAS.DESC"
msgid "(W) Tungsten is a superheated crystalline <link=\"REFINEDMETAL\">Metal</link>.\n\nThis selection is in a <link=\"ELEMENTSGAS\">Gaseous</link> state."
msgstr "(W) 鎢是一種高溫結晶化的<link=\"REFINEDMETAL\">金屬</link>.\n\n目前處於<link=\"ELEMENTSGAS\">氣體</link>狀態。"

#. STRINGS.ELEMENTS.TUNGSTENGAS.NAME
msgctxt "STRINGS.ELEMENTS.TUNGSTENGAS.NAME"
msgid "<link=\"TUNGSTENGAS\">Tungsten Gas</link>"
msgstr "<link=\"TUNGSTENGAS\">鎢</link>"

#. STRINGS.ELEMENTS.UNOBTANIUM.DESC
msgctxt "STRINGS.ELEMENTS.UNOBTANIUM.DESC"
msgid "(Nt) Neutronium is a mysterious and extremely resilient element.\n\nIt cannot be excavated by any Duplicant mining tool."
msgstr "(Nt) 零號元素是一種神祕而極具彈性的元素。\n\n它無法被複製人的任何工具挖掘。"

#. STRINGS.ELEMENTS.UNOBTANIUM.NAME
msgctxt "STRINGS.ELEMENTS.UNOBTANIUM.NAME"
msgid "<link=\"UNOBTANIUM\">Neutronium</link>"
msgstr "<link=\"UNOBTANIUM\">零號元素</link>"

#. STRINGS.ELEMENTS.URANIUMORE.DESC
msgctxt "STRINGS.ELEMENTS.URANIUMORE.DESC"
msgid "(U) Uranium Ore is a highly <link=\"RADIATION\">Radioactive</link> substance.\n\nIt can be refined into fuel for research reactors."
msgstr "(U) 鈾礦是一種高<link=\"RADIATION\">輻射</link>的物質。\n\n它可以精煉成研究反應爐的燃料。"

#. STRINGS.ELEMENTS.URANIUMORE.NAME
msgctxt "STRINGS.ELEMENTS.URANIUMORE.NAME"
msgid "<link=\"URANIUMORE\">Uranium Ore</link>"
msgstr "<link=\"URANIUMORE\">鈾礦</link>"

#. STRINGS.ELEMENTS.VACUUM.DESC
msgctxt "STRINGS.ELEMENTS.VACUUM.DESC"
msgid "A vacuum is a space devoid of all matter."
msgstr "真空是什麼都沒有的空間。"

#. STRINGS.ELEMENTS.VACUUM.NAME
msgctxt "STRINGS.ELEMENTS.VACUUM.NAME"
msgid "<link=\"VACUUM\">Vacuum</link>"
msgstr "<link=\"VACUUM\">真空</link>"

#. STRINGS.ELEMENTS.VISCOGEL.DESC
msgctxt "STRINGS.ELEMENTS.VISCOGEL.DESC"
msgid "Visco-Gel Fluid is a <link=\"ELEMENTSLIQUID\">Liquid</link> polymer with high surface tension, preventing typical liquid flow and allowing for unusual configurations."
msgstr "凝膠是一種有高表面張力的<link=\"ELEMENTSLIQUID\">液體</link>聚合物，可避免典型的液體流動並允許不尋常的配置。"

#. STRINGS.ELEMENTS.VISCOGEL.NAME
msgctxt "STRINGS.ELEMENTS.VISCOGEL.NAME"
msgid "<link=\"VISCOGEL\">Visco-Gel Fluid</link>"
msgstr "<link=\"VISCOGEL\">凝膠</link>"

#. STRINGS.ELEMENTS.VOID.DESC
msgctxt "STRINGS.ELEMENTS.VOID.DESC"
msgid "Cold, infinite nothingness."
msgstr "寒冷而無窮的虛無。"

#. STRINGS.ELEMENTS.VOID.NAME
msgctxt "STRINGS.ELEMENTS.VOID.NAME"
msgid "<link=\"VOID\">Void</link>"
msgstr "<link=\"VOID\">虛空</link>"

#. STRINGS.ELEMENTS.WATER.DESC
msgctxt "STRINGS.ELEMENTS.WATER.DESC"
msgid "(H<sub>2</sub>O) Clean <link=\"WATER\">Water</link>, suitable for consumption."
msgstr "(H<sub>2</sub>O) 乾淨的<link=\"WATER\">水</link>，適合飲用。"

#. STRINGS.ELEMENTS.WATER.NAME
msgctxt "STRINGS.ELEMENTS.WATER.NAME"
msgid "<link=\"WATER\">Water</link>"
msgstr "<link=\"WATER\">水</link>"

#. STRINGS.ELEMENTS.WOLFRAMITE.DESC
msgctxt "STRINGS.ELEMENTS.WOLFRAMITE.DESC"
msgid "((Fe,Mn)WO<sub>4</sub>) Wolframite is a dense Metallic element in a <link=\"ELEMENTSSOLID\">Solid</link> state.\n\nIt is a source of <link=\"TUNGSTEN\">Tungsten</link> and is suitable for building <link=\"POWER\">Power</link> systems."
msgstr "((Fe,Mn)WO<sub>4</sub>) 黑鎢礦一種高密度金屬元素，處於<link=\"ELEMENTSSOLID\">固體</link>狀態。\n它是<link=\"TUNGSTEN\">鎢</link>的來源，並可以用來建造<link=\"POWER\">電力</link>系統。"

#. STRINGS.ELEMENTS.WOLFRAMITE.NAME
msgctxt "STRINGS.ELEMENTS.WOLFRAMITE.NAME"
msgid "<link=\"WOLFRAMITE\">Wolframite</link>"
msgstr "<link=\"WOLFRAMITE\">黑鎢礦</link>"

#. STRINGS.ELEMENTS.WOODLOG.DESC
msgctxt "STRINGS.ELEMENTS.WOODLOG.DESC"
msgid "Wood is a good source of <link=\"HEAT\">Heat</link> and <link=\"POWER\">Power</link>.\n\nIts insulation properties and positive <link=\"DECOR\">Decor</link> also make it a useful <b>Construction Material</b>."
msgstr "木材是很好的<link=\"HEAT\">熱量</link>和<link=\"POWER\">電力</link>來源。\n\n隔熱效能和優良的<link=\"DECOR\">裝飾度</link>使其成為有用的<b>建造材料</b>。"

#. STRINGS.ELEMENTS.WOODLOG.NAME
msgctxt "STRINGS.ELEMENTS.WOODLOG.NAME"
msgid "<link=\"WOOD\">Wood</link>"
msgstr "<link=\"WOOD\">木材</link>"

#. STRINGS.ELEMENTS.YELLOWCAKE.DESC
msgctxt "STRINGS.ELEMENTS.YELLOWCAKE.DESC"
msgid "(U<sub>3</sub>O<sub>8</sub>) Yellowcake is a byproduct of <link=\"URANIUM\">Uranium</link> mining.\n\nIt is useful in preparing fuel for <link=\"NUCLEARREACTOR\">Research Reactors</link>.\n\nNote: Do not eat."
msgstr "(U<sub>3</sub>O<sub>8</sub>) 黃餅是挖掘<link=\"URANIUM\">鈾礦</link>的副產品。\n\n它適合用於製備<link=\"NUCLEARREACTOR\">研究反應爐</link>的燃料。\n\n注意：請勿食用。"

#. STRINGS.ELEMENTS.YELLOWCAKE.NAME
msgctxt "STRINGS.ELEMENTS.YELLOWCAKE.NAME"
msgid "<link=\"YELLOWCAKE\">Yellowcake</link>"
msgstr "<link=\"YELLOWCAKE\">黃餅</link>"

#. STRINGS.ELEMENTS.ZINC.DESC
msgctxt "STRINGS.ELEMENTS.ZINC.DESC"
msgid "(Zn) Zinc is a very malleable <link=\"REFINEDMETAL\">Metal Alloy</link>."
msgstr "(Zn) 鋅是一種非常易塑的<link=\"REFINEDMETAL\">金屬合金</link>。"

#. STRINGS.ELEMENTS.ZINC.NAME
msgctxt "STRINGS.ELEMENTS.ZINC.NAME"
msgid "<link=\"ZINC\">Zinc</link>"
msgstr "<link=\"ZINC\">鋅</link>"

#. STRINGS.ELEMENTS.ZINCGAS.DESC
msgctxt "STRINGS.ELEMENTS.ZINCGAS.DESC"
msgid "(Zn) Zinc Gas is <link=\"ZINC\">Zinc</link> heated into a <link=\"ELEMENTSGAS\">Gaseous</link> state."
msgstr "(Zn) 鋅氣是一種被加熱成<link=\"ELEMENTSGAS\">氣體</link>狀態的<link=\"ZINC\">鋅</link>。"

#. STRINGS.ELEMENTS.ZINCGAS.NAME
msgctxt "STRINGS.ELEMENTS.ZINCGAS.NAME"
msgid "<link=\"ZINCGAS\">Zinc Gas</link>"
msgstr "<link=\"ZINCGAS\">鋅</link>"

#. STRINGS.ELEMENTS.ZINCORE.DESC
msgctxt "STRINGS.ELEMENTS.ZINCORE.DESC"
msgid "(Zn) Zinc Ore is a malleable raw <link=\"METALORE\">Metal</link>.\n\nIt is suitable for building <link=\"POWER\">Power</link> systems."
msgstr "(Zn) 鋅礦是一種易塑的<link=\"METAL\">金屬</link>原料。\n\n它可用於建造<link=\"POWER\">電力</link>系統。"

#. STRINGS.ELEMENTS.ZINCORE.NAME
msgctxt "STRINGS.ELEMENTS.ZINCORE.NAME"
msgid "<link=\"ZINCORE\">Zinc Ore</link>"
msgstr "<link=\"ZINCORE\">鋅礦</link>"

#. STRINGS.EQUIPMENT.PREFABS.AQUA_SUIT.DESC
msgctxt "STRINGS.EQUIPMENT.PREFABS.AQUA_SUIT.DESC"
msgid "Because breathing underwater is better than... not."
msgstr "因為能在水下呼吸好過…不能。"

#. STRINGS.EQUIPMENT.PREFABS.AQUA_SUIT.EFFECT
msgctxt "STRINGS.EQUIPMENT.PREFABS.AQUA_SUIT.EFFECT"
msgid "Supplies Duplicants with <style=\"oxygen\">Oxygen</style> in underwater environments.\n\nMust be refilled with <link=\"OXYGEN\">Oxygen</link> at an <link=\"SUITLOCKER\">Atmo Suit Dock</link> when depleted."
msgstr "在水下環境中為複製人提供<style=\"oxygen\">氧氣</style>。\n\n當耗盡時，必須在<link=\"SUITLOCKER\">潛水衣存放櫃</link>補充<link=\"OXYGEN\">氧氣</link>。"

#. STRINGS.EQUIPMENT.PREFABS.AQUA_SUIT.NAME
msgctxt "STRINGS.EQUIPMENT.PREFABS.AQUA_SUIT.NAME"
msgid "<link=\"AQUASUIT\">Aqua Suit</link>"
msgstr "<link=\"AQUASUIT\">潛水衣</link>"

#. STRINGS.EQUIPMENT.PREFABS.AQUA_SUIT.RECIPE_DESC
msgctxt "STRINGS.EQUIPMENT.PREFABS.AQUA_SUIT.RECIPE_DESC"
msgid "Supplies Duplicants with <style=\"oxygen\">Oxygen</style> in underwater environments."
msgstr "提供<style=\"oxygen\">氧氣</style>讓複製人在水下呼吸。"

#. STRINGS.EQUIPMENT.PREFABS.AQUA_SUIT.WORN_DESC
msgctxt "STRINGS.EQUIPMENT.PREFABS.AQUA_SUIT.WORN_DESC"
msgid "A worn out <link=\"AQUASUIT\">Aqua Suit</link>.\n\nSuits can be repaired at a <link=\"CRAFTINGTABLE\">Crafting Station</link>."
msgstr "破舊的<link=\"AQUASUIT\">潛水衣</link>。\n\n潛水衣可以在<link=\"CRAFTINGTABLE\">工藝台</link>修理。"

#. STRINGS.EQUIPMENT.PREFABS.AQUA_SUIT.WORN_NAME
msgctxt "STRINGS.EQUIPMENT.PREFABS.AQUA_SUIT.WORN_NAME"
msgid "<link=\"AQUASUIT\">Worn Lead Suit</link>"
msgstr "<link=\"AQUASUIT\">破舊潛水衣</link>"

#. STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT.DESC
msgctxt "STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT.DESC"
msgid "Ensures my Duplicants can breathe easy, anytime, anywhere."
msgstr "確保複製人可以在任何時間，任何地點輕鬆的呼吸。"

#. STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT.EFFECT
msgctxt "STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT.EFFECT"
msgid "Supplies Duplicants with <link=\"OXYGEN\">Oxygen</link> in toxic and low breathability environments, and protects against extreme temperatures.\n\nMust be refilled with oxygen at an <link=\"SUITLOCKER\">Atmo Suit Dock</link> when depleted."
msgstr "在有毒和低通氣性的環境中為複製人提供<link=\"OXYGEN\">氧氣</link>，並提供極端溫度保護。\n\n當氧氣耗盡時，必須在<link=\"SUITLOCKER\">太空衣存放櫃</link>補充氧氣。"

#. STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT.GENERICNAME
msgctxt "STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT.GENERICNAME"
msgid "Suit"
msgstr "太空衣"

#. STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT.NAME
msgctxt "STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT.NAME"
msgid "<link=\"ATMOSUIT\">Atmo Suit</link>"
msgstr "<link=\"ATMOSUIT\">太空衣</link>"

#. STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT.RECIPE_DESC
msgctxt "STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT.RECIPE_DESC"
msgid "Supplies Duplicants with <link=\"OXYGEN\">Oxygen</link> in toxic and low breathability environments."
msgstr "提供複製人<link=\"OXYGEN\">氧氣</link>在有毒與低氧的環境中呼吸。"

#. STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT.REPAIR_WORN_DESC
