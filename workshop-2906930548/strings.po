msgstr "<link=\"ARTTALLH\">星群征服者</link>"

#. STRINGS.BUILDINGS.PREFABS.CANVASTALL.FACADES.ART_TALL_I.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.CANVASTALL.FACADES.ART_TALL_I.DESC"
