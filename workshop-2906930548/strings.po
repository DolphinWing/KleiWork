msgstr "<link=\"STORAGELOCKER\">漣漪儲物箱</link>"

#. STRINGS.BLUEPRINTS.PERMIT_SWIMSUIT_MERM.DESC
msgctxt "STRINGS.BLUEPRINTS.PERMIT_SWIMSUIT_MERM.DESC"
msgid "The epaulettes are reinforced with real fishbones!"
msgstr "肩章可是用真正的魚骨強化過的呢！"

#. STRINGS.BLUEPRINTS.PERMIT_SWIMSUIT_MERM.NAME
msgctxt "STRINGS.BLUEPRINTS.PERMIT_SWIMSUIT_MERM.NAME"
