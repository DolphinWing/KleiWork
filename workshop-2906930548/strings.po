msgstr "俐落原子飛行衣"

#. STRINGS.BLUEPRINTS.PERMIT_JETSUIT_WHITE_CHARCOAL.DESC
msgctxt "STRINGS.BLUEPRINTS.PERMIT_JETSUIT_WHITE_CHARCOAL.DESC"
