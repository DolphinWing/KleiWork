msgstr "<link=\"GEYSERGENERICSTEAM\">低溫蒸氣噴口</link>"

#. STRINGS.CREATURES.SPECIES.GEYSER.UNDERWATERVENT.DESC
msgctxt "STRINGS.CREATURES.SPECIES.GEYSER.UNDERWATERVENT.DESC"
msgid "A subaquatic fissure that allows high-pressure <link=\"METHANE\">Natural Gas</link> to escape from the planet's crust.\n\nBlockages caused by built-up <link=\"SULFUR\">Sulfur</link> can be removed using a <link=\"UNDERWATERVENTDRILL\">Marine Drill</link>."
msgstr "一道水下裂縫，能讓高壓的<link=\"METHANE\">天然氣</link>從地殼中逸出。\n\n因<link=\"SULFUR\">硫</link>堆積而造成的阻塞，可以使用<link=\"UNDERWATERVENTDRILL\">海洋鑽機</link>來清除"

#. STRINGS.CREATURES.SPECIES.GEYSER.UNDERWATERVENT.NAME
msgctxt "STRINGS.CREATURES.SPECIES.GEYSER.UNDERWATERVENT.NAME"
msgid "<link=\"UNDERWATERVENT\">Thermal Gas Fissure</link>"
msgstr "<link=\"UNDERWATERVENT\">熱氣裂縫</link>"

#. STRINGS.CREATURES.SPECIES.GLASSDEER.BABY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.GLASSDEER.BABY.DESC"
msgid "A little yipping Shatter Flox Fawn.\n\nIn time it will mature into a fully grown <link=\"GLASSDEER\">Shatter Flox</link>."
msgstr "一隻發出尖細叫聲的小碎狐鹿克斯寶寶。\n\n隨著時間推移，牠將長大成為一隻完全成熟的<link=\"GLASSDEER\">碎狐鹿克斯</link>。"

#. STRINGS.CREATURES.SPECIES.GLASSDEER.BABY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.GLASSDEER.BABY.NAME"
msgid "<link=\"GLASSDEER\">Shatter Flox Fawn</link>"
msgstr "<link=\"GLASSDEER\">碎狐鹿克斯寶寶</link>"

#. STRINGS.CREATURES.SPECIES.GLASSDEER.DESC
msgctxt "STRINGS.CREATURES.SPECIES.GLASSDEER.DESC"
msgid "Shatter Floxes are nonhostile critters that can subsist on <link=\"PRICKLEFLOWER\">Bristle Blossom</link> and <link=\"HARDSKINBERRYPLANT\">Pikeapple Bush</link>.\n\nTheir shearable <link=\"GLASS\">Glass</link> antlers grow only when they are fed <link=\"KATAIRITE\">Abyssalite</link>."
msgstr "碎狐鹿克斯是一種無害的生物，牠們可以靠<link=\"PRICKLEFLOWER\">鬃花</link>和<link=\"HARDSKINBERRYPLANT\">刺殼果灌木</link>維持生存。\n\n牠們可剪下的<link=\"GLASS\">玻璃</link>角只有在餵食<link=\"KATAIRITE\">深淵水晶</link>時才會生長。"

#. STRINGS.CREATURES.SPECIES.GLASSDEER.EGG_NAME
msgctxt "STRINGS.CREATURES.SPECIES.GLASSDEER.EGG_NAME"
msgid "<link=\"GLASSDEER\">Shatter Flox Egg</link>"
msgstr "<link=\"GLASSDEER\">碎狐鹿克斯蛋</link>"

#. STRINGS.CREATURES.SPECIES.GLASSDEER.NAME
msgctxt "STRINGS.CREATURES.SPECIES.GLASSDEER.NAME"
msgid "<link=\"GLASSDEER\">Shatter Flox</link>"
msgstr "<link=\"GLASSDEER\">碎狐鹿克斯</link>"

#. STRINGS.CREATURES.SPECIES.GLOM.DESC
msgctxt "STRINGS.CREATURES.SPECIES.GLOM.DESC"
msgid "Morbs are attracted to unhygienic conditions and frequently excrete bursts of <link=\"CONTAMINATEDOXYGEN\">Polluted Oxygen</link>."
msgstr "莫布被生物分解的屍體所吸引，並經常釋放少量<link=\"CONTAMINATEDOXYGEN\">汙氧</link>。"

#. STRINGS.CREATURES.SPECIES.GLOM.EGG_NAME
msgctxt "STRINGS.CREATURES.SPECIES.GLOM.EGG_NAME"
msgid "<link=\"MORB\">Morb Pod</link>"
msgstr "<link=\"MORB\">莫布莢</link>"

#. STRINGS.CREATURES.SPECIES.GLOM.NAME
msgctxt "STRINGS.CREATURES.SPECIES.GLOM.NAME"
msgid "<link=\"GLOM\">Morb</link>"
msgstr "<link=\"GLOM\">莫布</link>"

#. STRINGS.CREATURES.SPECIES.GREEDYGREEN.DESC
msgctxt "STRINGS.CREATURES.SPECIES.GREEDYGREEN.DESC"
msgid "A rapidly growing, subterranean <link=\"PLANTS\">Plant</link>."
msgstr "一種快速生長的地下<link=\"PLANTS\">植物</link>。"

#. STRINGS.CREATURES.SPECIES.GREEDYGREEN.NAME
msgctxt "STRINGS.CREATURES.SPECIES.GREEDYGREEN.NAME"
msgid "<link=\"GREEDYGREEN\">Avari Vine</link>"
msgstr "<link=\"GREEDYGREEN\">阿瓦里藤</link>"

#. STRINGS.CREATURES.SPECIES.HARDSKINBERRYPLANT.DESC
msgctxt "STRINGS.CREATURES.SPECIES.HARDSKINBERRYPLANT.DESC"
msgid "Pikeapple bushes produce <link=\"HARDSKINBERRY\">Pikeapple</link>, a useful yet almost unbearably fragrant <link=\"FOOD\">Food</link>."
msgstr "刺殼果灌木可產出<link=\"HARDSKINBERRY\">刺殼果</link>，一種有用但味道香到幾乎難以忍受的<link=\"FOOD\">食物</link>。"

#. STRINGS.CREATURES.SPECIES.HARDSKINBERRYPLANT.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.HARDSKINBERRYPLANT.DOMESTICATEDDESC"
msgid "This plant produces edible <link=\"HARDSKINBERRY\">Pikeapple</link>."
msgstr "這株植物生產可食用的<link=\"HARDSKINBERRY\">刺殼果</link>。"

#. STRINGS.CREATURES.SPECIES.HARDSKINBERRYPLANT.NAME
msgctxt "STRINGS.CREATURES.SPECIES.HARDSKINBERRYPLANT.NAME"
msgid "<link=\"HARDSKINBERRYPLANT\">Pikeapple Bush</link>"
msgstr "<link=\"HARDSKINBERRYPLANT\">刺殼果灌木</link>"

#. STRINGS.CREATURES.SPECIES.HATCH.BABY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.HATCH.BABY.DESC"
msgid "An innocent little Hatchling.\n\nIn time, it will mature into an adult <link=\"HATCH\">Hatch</link>."
msgstr "一隻無辜的小哈奇寶寶。\n\n隨著時間經過，牠會成長為一隻成年的<link=\"HATCH\">哈奇</link>。"

#. STRINGS.CREATURES.SPECIES.HATCH.BABY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.HATCH.BABY.NAME"
msgid "<link=\"HATCH\">Hatchling</link>"
msgstr "<link=\"HATCH\">哈奇寶寶</link>"

#. STRINGS.CREATURES.SPECIES.HATCH.DESC
msgctxt "STRINGS.CREATURES.SPECIES.HATCH.DESC"
msgid "Hatches excrete solid <link=\"CARBON\">Coal</link> as waste and may be uncovered by digging up Buried Objects."
msgstr "哈奇會排出<link=\"CARBON\">煤炭</link>作為廢棄物，而且可能會在挖掘埋住的物件時被發現。"

#. STRINGS.CREATURES.SPECIES.HATCH.EGG_NAME
msgctxt "STRINGS.CREATURES.SPECIES.HATCH.EGG_NAME"
msgid "<link=\"HATCH\">Hatch Egg</link>"
msgstr "<link=\"HATCH\">哈奇蛋</link>"

#. STRINGS.CREATURES.SPECIES.HATCH.NAME
msgctxt "STRINGS.CREATURES.SPECIES.HATCH.NAME"
msgid "<link=\"HATCH\">Hatch</link>"
msgstr "<link=\"HATCH\">哈奇</link>"

#. STRINGS.CREATURES.SPECIES.HATCH.VARIANT_HARD.BABY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.HATCH.VARIANT_HARD.BABY.DESC"
msgid "A doofy little Stone Hatchling.\n\nIt matures into an adult Hatch morph, the <link=\"HATCHHARD\">Stone Hatch</link>, which loves nibbling on various rocks and metals."
msgstr "一隻呆呆的石頭哈奇寶寶。\n\n牠會成長為一隻成年的哈奇變種：<link=\"HATCHHARD\">石頭哈奇</link>，喜歡吃各種石頭與金屬。"

#. STRINGS.CREATURES.SPECIES.HATCH.VARIANT_HARD.BABY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.HATCH.VARIANT_HARD.BABY.NAME"
msgid "<link=\"HATCHHARD\">Stone Hatchling</link>"
msgstr "<link=\"HATCHHARD\">石頭哈奇寶寶</link>"

#. STRINGS.CREATURES.SPECIES.HATCH.VARIANT_HARD.DESC
msgctxt "STRINGS.CREATURES.SPECIES.HATCH.VARIANT_HARD.DESC"
msgid "Stone Hatches excrete solid <link=\"CARBON\">Coal</link> as waste and enjoy burrowing into the ground."
msgstr "石頭哈奇會排放<link=\"CARBON\">煤炭</link>作為廢棄物，並喜歡鑽進地底。"

#. STRINGS.CREATURES.SPECIES.HATCH.VARIANT_HARD.EGG_NAME
msgctxt "STRINGS.CREATURES.SPECIES.HATCH.VARIANT_HARD.EGG_NAME"
msgid "<link=\"HATCHHARD\">Stone Hatch Egg</link>"
msgstr "<link=\"HATCHHARD\">石頭哈奇蛋</link>"

#. STRINGS.CREATURES.SPECIES.HATCH.VARIANT_HARD.NAME
