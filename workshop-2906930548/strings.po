msgstr "可以被處理變成<link=\"RESEARCHDLC1\">資料分析研究</link>點數的原始資料。"

#. STRINGS.ITEMS.INDUSTRIAL_PRODUCTS.ORBITAL_RESEARCH_DATABANK.NAME
msgctxt "STRINGS.ITEMS.INDUSTRIAL_PRODUCTS.ORBITAL_RESEARCH_DATABANK.NAME"
msgid "<link=\"DATABANK\">Data Bank</link>"
msgstr "<link=\"DATABANK\">資料磁片</link>"

#. STRINGS.ITEMS.INDUSTRIAL_PRODUCTS.ORBITAL_RESEARCH_DATABANK.NAME_PLURAL
msgctxt "STRINGS.ITEMS.INDUSTRIAL_PRODUCTS.ORBITAL_RESEARCH_DATABANK.NAME_PLURAL"
msgid "<link=\"DATABANK\">Data Banks</link>"
msgstr "<link=\"DATABANK\">資料磁片</link>"

#. STRINGS.ITEMS.INDUSTRIAL_PRODUCTS.ORBITAL_RESEARCH_DATABANK.RECIPE_DESC
msgctxt "STRINGS.ITEMS.INDUSTRIAL_PRODUCTS.ORBITAL_RESEARCH_DATABANK.RECIPE_DESC"
msgid "Data Banks of raw data generated from exploring, either by exploring new areas with Duplicants, or by using an <link=\"ORBITALRESEARCHCENTER\">Orbital Data Collection Lab</link>.\n\nUsed by the <link=\"DLC1COSMICRESEARCHCENTER\">Virtual Planetarium</link> to conduct research."
msgstr "資料磁片的原始資料源自於探索，可以是複製人探索新區域，或是使用<link=\"ORBITALRESEARCHCENTER\">軌道資料收集儀</link>產生。\n\n使用在<link=\"DLC1COSMICRESEARCHCENTER\">虛擬天文館</link>進行研究。"

#. STRINGS.ITEMS.INDUSTRIAL_PRODUCTS.PLANKTON_CORAL_PRODUCT.DESC
msgctxt "STRINGS.ITEMS.INDUSTRIAL_PRODUCTS.PLANKTON_CORAL_PRODUCT.DESC"
msgid "A chunk of hardened mineral.\n\nIt can be eaten by <link=\"PARROTFISHSPECIES\">Beakons</link>."
