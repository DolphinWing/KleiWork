msgstr "鈕扣數量是平常的兩倍，而且完全沒有口袋。"

#. STRINGS.BLUEPRINTS.PERMIT_PANTS_NAUTICAL_WHITE.NAME
msgctxt "STRINGS.BLUEPRINTS.PERMIT_PANTS_NAUTICAL_WHITE.NAME"
msgid "High-Waisted Nautical Pants"
msgstr "高腰航海褲子"

#. STRINGS.BLUEPRINTS.PERMIT_PANTS_SNAPJACKET_BRINE.DESC
msgctxt "STRINGS.BLUEPRINTS.PERMIT_PANTS_SNAPJACKET_BRINE.DESC"
