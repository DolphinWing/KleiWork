msgstr "她沒有生氣，只是失望。"

#. STRINGS.BUILDINGS.PREFABS.CANVAS.FACADES.ART_M.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.CANVAS.FACADES.ART_M.NAME"
