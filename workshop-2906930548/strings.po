msgstr "<link=\"ARTN\">希望永存</link>"

#. STRINGS.BUILDINGS.PREFABS.CANVAS.FACADES.ART_O.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.CANVAS.FACADES.ART_O.DESC"
msgid "It's all about cooperation, really."
msgstr "這只是有關合作的畫，真的。"

#. STRINGS.BUILDINGS.PREFABS.CANVAS.FACADES.ART_O.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.CANVAS.FACADES.ART_O.NAME"
msgid "<link=\"ARTO\">Hands-On</link>"
msgstr "<link=\"ARTO\">親手實踐</link>"

#. STRINGS.BUILDINGS.PREFABS.CANVAS.FACADES.ART_P.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.CANVAS.FACADES.ART_P.DESC"
msgid "It is a cruel guest who does not RSVP."
msgstr "不回覆的客人真是殘酷。"

#. STRINGS.BUILDINGS.PREFABS.CANVAS.FACADES.ART_P.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.CANVAS.FACADES.ART_P.NAME"
msgid "<link=\"ARTP\">Pour Soul</link>"
msgstr "<link=\"ARTP\">傾倒靈魂</link>"

#. STRINGS.BUILDINGS.PREFABS.CANVAS.FACADES.ART_Q.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.CANVAS.FACADES.ART_Q.DESC"
