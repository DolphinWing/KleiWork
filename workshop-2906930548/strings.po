msgstr "使仿生複製人能夠最大限度地提高所裝備的<link=\"EQUIPMENT\">太空衣</link>的耐用性並保持其移動速度。"

#. STRINGS.ITEMS.BIONIC_BOOSTERS.BOOSTER_SUITS1.NAME
msgctxt "STRINGS.ITEMS.BIONIC_BOOSTERS.BOOSTER_SUITS1.NAME"
msgid "<link=\"BOOSTERSUITS1\">Suit Training Booster</link>"
msgstr "<link=\"BOOSTERSUITS1\">服裝訓練增效卡匣</link>"

#. STRINGS.ITEMS.BIONIC_BOOSTERS.BOOSTER_TIDY1.DESC
msgctxt "STRINGS.ITEMS.BIONIC_BOOSTERS.BOOSTER_TIDY1.DESC"
msgid "Grants a Bionic Duplicant the full range of tidying skills, including blasting unwanted meteors out of the sky."
msgstr "賦予仿生複製人全方位的整理技能，包括從天空中炸掉不需要的流星。"

#. STRINGS.ITEMS.BIONIC_BOOSTERS.BOOSTER_TIDY1.NAME
msgctxt "STRINGS.ITEMS.BIONIC_BOOSTERS.BOOSTER_TIDY1.NAME"
msgid "<link=\"BOOSTERTIDY1\">Tidying Booster</link>"
msgstr "<link=\"BOOSTERTIDY1\">整理增效卡匣</link>"

#. STRINGS.ITEMS.BIONIC_BOOSTERS.FABRICATION_SOURCE
msgctxt "STRINGS.ITEMS.BIONIC_BOOSTERS.FABRICATION_SOURCE"
msgid "This booster can be manufactured at the {0}."
msgstr "這個增效卡匣可以在{0}製作。"

#. STRINGS.ITEMS.CARGO_CAPSULE.DESC
msgctxt "STRINGS.ITEMS.CARGO_CAPSULE.DESC"
msgid "A delivery system for recently printed resources.\n\nIt will dematerialize shortly."
msgstr "由貨運系統所列印的資源。\n\n它很快就會消失。"

#. STRINGS.ITEMS.CARGO_CAPSULE.NAME
msgctxt "STRINGS.ITEMS.CARGO_CAPSULE.NAME"
msgid "Care Package"
msgstr "補給包裹"

#. STRINGS.ITEMS.DEBRISPAYLOAD.DESC
msgctxt "STRINGS.ITEMS.DEBRISPAYLOAD.DESC"
msgid "Whatever is left over from a Rocket Self-Destruct can be recovered once it has crash-landed."
msgstr "火箭自爆遺留下來的任何東西都可以在墜毀後回收。"

#. STRINGS.ITEMS.DEBRISPAYLOAD.NAME
msgctxt "STRINGS.ITEMS.DEBRISPAYLOAD.NAME"
msgid "Rocket Debris"
msgstr "火箭殘骸"

#. STRINGS.ITEMS.DEHYDRATEDFOODPACKAGE.CONSUMED
msgctxt "STRINGS.ITEMS.DEHYDRATEDFOODPACKAGE.CONSUMED"
msgid "Ate Rehydrated Food"
msgstr "吃了補水的食物"

#. STRINGS.ITEMS.DEHYDRATEDFOODPACKAGE.CONTENTS
msgctxt "STRINGS.ITEMS.DEHYDRATEDFOODPACKAGE.CONTENTS"
msgid "Dried {0}"
msgstr "乾燥的{0}"

#. STRINGS.ITEMS.DEHYDRATEDFOODPACKAGE.DESC
msgctxt "STRINGS.ITEMS.DEHYDRATEDFOODPACKAGE.DESC"
msgid "A package of non-perishable dehydrated food.\n\nIt requires no refrigeration, but must be rehydrated before consumption."
msgstr "一包不易腐爛的脫水食物。\n\n乾燥食物不需要冷藏，但在食用前必須補充水分。"

#. STRINGS.ITEMS.DEHYDRATEDFOODPACKAGE.NAME
msgctxt "STRINGS.ITEMS.DEHYDRATEDFOODPACKAGE.NAME"
msgid "Dry Ration"
msgstr "乾燥口糧"

#. STRINGS.ITEMS.DREAMJOURNAL.DESC
msgctxt "STRINGS.ITEMS.DREAMJOURNAL.DESC"
msgid "A hand-scrawled account of <link=\"SLEEPCLINICPAJAMAS\">Pajama</link>-induced dreams.\n\nCan be analyzed using a <link=\"MEGABRAINTANK\">Somnium Synthesizer</link>."
msgstr "一份手寫的日誌，記錄著關於<link=\"SLEEPCLINICPAJAMAS\">睡衣</link>誘導的夢境。\n\n可以使用<link=\"MEGABRAINTANK\">夢境合成器</link>分析。"

#. STRINGS.ITEMS.DREAMJOURNAL.NAME
msgctxt "STRINGS.ITEMS.DREAMJOURNAL.NAME"
msgid "<link=\"STORYTRAITMEGABRAINTANK\">Dream Journal</link>"
msgstr "<link=\"STORYTRAITMEGABRAINTANK\">夢境日誌</link>"

#. STRINGS.ITEMS.FOOD.AQUATICFORAGEPLANT.DESC
msgctxt "STRINGS.ITEMS.FOOD.AQUATICFORAGEPLANT.DESC"
msgid "A seedless plant with a gummy texture.\n\nIt cannot be replanted.\n\nDigging up Buried Objects may uncover a <link=\"AQUATICFORAGEPLANT\">Mussel Tongue</link>."
msgstr "一種具有黏膠質感的無籽植物。\n\n無法再進行種植。\n\n挖掘埋住的物件可能會發現<link=\"AQUATICFORAGEPLANT\">貽貝舌</link>。"

#. STRINGS.ITEMS.FOOD.AQUATICFORAGEPLANT.NAME
msgctxt "STRINGS.ITEMS.FOOD.AQUATICFORAGEPLANT.NAME"
msgid "<link=\"AQUATICFORAGEPLANT\">Mussel Tongue</link>"
msgstr "<link=\"AQUATICFORAGEPLANT\">貽貝舌</link>"

#. STRINGS.ITEMS.FOOD.BASICFORAGEPLANT.DESC
msgctxt "STRINGS.ITEMS.FOOD.BASICFORAGEPLANT.DESC"
msgid "A seedless fruit with an upsettingly bland aftertaste.\n\nIt cannot be replanted.\n\nDigging up Buried Objects may uncover a <link=\"BASICFORAGEPLANT\">Muckroot</link>."
msgstr "一種沒有種子的果實，吃起來沒什麼味道。\n\n無法重新種植。\n\n挖掘被埋住的物件可能會發現<link=\"BASICFORAGEPLANT\">塊根</link>。"

#. STRINGS.ITEMS.FOOD.BASICFORAGEPLANT.NAME
msgctxt "STRINGS.ITEMS.FOOD.BASICFORAGEPLANT.NAME"
msgid "<link=\"BASICFORAGEPLANT\">Muckroot</link>"
msgstr "<link=\"BASICFORAGEPLANT\">塊根</link>"

#. STRINGS.ITEMS.FOOD.BASICPLANTBAR.DESC
msgctxt "STRINGS.ITEMS.FOOD.BASICPLANTBAR.DESC"
msgid "<link=\"BASICPLANTFOOD\">Meal Lice</link> compacted into a dense, immobile loaf."
msgstr "<link=\"BASICPLANTFOOD\">米虱</link>壓製而成的糕點。"

#. STRINGS.ITEMS.FOOD.BASICPLANTBAR.NAME
msgctxt "STRINGS.ITEMS.FOOD.BASICPLANTBAR.NAME"
msgid "<link=\"BASICPLANTBAR\">Liceloaf</link>"
msgstr "<link=\"BASICPLANTBAR\">米虱糕</link>"

#. STRINGS.ITEMS.FOOD.BASICPLANTBAR.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.BASICPLANTBAR.RECIPEDESC"
msgid "<link=\"BASICPLANTFOOD\">Meal Lice</link> compacted into a dense, immobile loaf."
msgstr "<link=\"BASICPLANTFOOD\">米虱</link>壓製而成的糕點。"

#. STRINGS.ITEMS.FOOD.BASICPLANTFOOD.DESC
msgctxt "STRINGS.ITEMS.FOOD.BASICPLANTFOOD.DESC"
msgid "A flavorless grain that almost never wiggles on its own."
msgstr "一種沒有味道的穀粒，它幾乎不會自己蠕動。"

#. STRINGS.ITEMS.FOOD.BASICPLANTFOOD.NAME
msgctxt "STRINGS.ITEMS.FOOD.BASICPLANTFOOD.NAME"
msgid "<link=\"BASICPLANTFOOD\">Meal Lice</link>"
msgstr "<link=\"BASICPLANTFOOD\">米虱</link>"

#. STRINGS.ITEMS.FOOD.BEAN.DESC
msgctxt "STRINGS.ITEMS.FOOD.BEAN.DESC"
msgid "The crisp bean of a <link=\"BEANPLANT\">Nosh Sprout</link>.\n\nEach bite tastes refreshingly natural and wholesome."
msgstr "脆口的豆子來自<link=\"BEANPLANT\">小吃芽</link>。\n\n每一口都清新自然，有益健康。"

#. STRINGS.ITEMS.FOOD.BEAN.NAME
msgctxt "STRINGS.ITEMS.FOOD.BEAN.NAME"
msgid "<link=\"BEAN\">Nosh Bean</link>"
msgstr "<link=\"BEAN\">小吃豆</link>"

#. STRINGS.ITEMS.FOOD.BEANPLANTSEED.DESC
msgctxt "STRINGS.ITEMS.FOOD.BEANPLANTSEED.DESC"
msgid "An inedible bean that can be processed into delicious foods."
msgstr "一種不能食用的豆類，可以被加工成美味的食物。"

#. STRINGS.ITEMS.FOOD.BEANPLANTSEED.NAME
msgctxt "STRINGS.ITEMS.FOOD.BEANPLANTSEED.NAME"
msgid "<link=\"BEANPLANTSEED\">Nosh Bean</link>"
msgstr "<link=\"BEANPLANTSEED\">小吃豆</link>"

#. STRINGS.ITEMS.FOOD.BERRYPIE.DEHYDRATED.DESC
msgctxt "STRINGS.ITEMS.FOOD.BERRYPIE.DEHYDRATED.DESC"
msgid "A dehydrated <link=\"BERRYPIE\">Mixed Berry Pie</link> ration. It must be rehydrated in order to be considered <link=\"FOOD\">Food</link>.\n\nDry rations have no expiry date."
msgstr "脫水<link=\"BERRYPIE\">混合漿果派</link>補給。必須重新補水才能視為<link=\"FOOD\">食品</link>。\n\n乾糧沒有有效期限。"

#. STRINGS.ITEMS.FOOD.BERRYPIE.DEHYDRATED.NAME
msgctxt "STRINGS.ITEMS.FOOD.BERRYPIE.DEHYDRATED.NAME"
msgid "<link=\"BERRYPIE\">Dried Berry Pie</link>"
msgstr "<link=\"BERRYPIE\">乾燥漿果派</link>"

#. STRINGS.ITEMS.FOOD.BERRYPIE.DESC
msgctxt "STRINGS.ITEMS.FOOD.BERRYPIE.DESC"
msgid "A pie made primarily of <link=\"WORMSUPERFRUIT\">Grubfruit</link> and <link=\"PRICKLEFRUIT\">Gristle Berries</link>.\n\nThe mixture of berries creates a fragrant, colorful filling that packs a sweet punch."
msgstr "主要由<link=\"WORMSUPERFRUIT\">蟲蜜果</link>與<link=\"PRICKLEFRUIT\">鬃果</link>製成的漿果派。\n\n混合了多種漿果，填滿了多彩香甜的餡料。"

#. STRINGS.ITEMS.FOOD.BERRYPIE.NAME
msgctxt "STRINGS.ITEMS.FOOD.BERRYPIE.NAME"
msgid "<link=\"BERRYPIE\">Mixed Berry Pie</link>"
msgstr "<link=\"BERRYPIE\">綜合漿果派</link>"

#. STRINGS.ITEMS.FOOD.BERRYPIE.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.BERRYPIE.RECIPEDESC"
msgid "A pie made primarily of <link=\"WORMSUPERFRUIT\">Grubfruit</link> and <link=\"PRICKLEFRUIT\">Gristle Berries</link>."
msgstr "主要由<link=\"WORMSUPERFRUIT\">蟲蜜果</link>與<link=\"PRICKLEFRUIT\">鬃果</link>所製成的漿果派。"

#. STRINGS.ITEMS.FOOD.BURGER.DEHYDRATED.DESC
msgctxt "STRINGS.ITEMS.FOOD.BURGER.DEHYDRATED.DESC"
msgid "A dehydrated <link=\"BURGER\">Frost Burger</link> ration. It must be rehydrated in order to be considered <link=\"FOOD\">Food</link>.\n\nDry rations have no expiry date."
msgstr "脫水<link=\"BURGER\">雪麥漢堡</link>補給。必須重新補水才能視為<link=\"FOOD\">食品</link>。\n\n乾糧沒有有效期限。"

#. STRINGS.ITEMS.FOOD.BURGER.DEHYDRATED.NAME
msgctxt "STRINGS.ITEMS.FOOD.BURGER.DEHYDRATED.NAME"
msgid "<link=\"BURGER\">Dried Frost Burger</link>"
msgstr "<link=\"BURGER\">乾燥雪麥堡</link>"

#. STRINGS.ITEMS.FOOD.BURGER.DESC
msgctxt "STRINGS.ITEMS.FOOD.BURGER.DESC"
msgid "<link=\"MEAT\">Meat</link> and <link=\"LETTUCE\">Lettuce</link> on a chilled <link=\"COLDWHEATBREAD\">Frost Bun</link>.\n\nIt's the only burger best served cold."
msgstr "冰涼的<link=\"COLDWHEATBREAD\">冰霜麵包</link>夾著<link=\"MEAT\">肉</link>與<link=\"LETTUCE\">生菜</link>。\n\n這可是最適合冰著吃的漢堡喔。"

#. STRINGS.ITEMS.FOOD.BURGER.NAME
msgctxt "STRINGS.ITEMS.FOOD.BURGER.NAME"
msgid "<link=\"BURGER\">Frost Burger</link>"
msgstr "<link=\"BURGER\">雪麥漢堡</link>"

#. STRINGS.ITEMS.FOOD.BURGER.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.BURGER.RECIPEDESC"
msgid "<link=\"MEAT\">Meat</link> and <link=\"LETTUCE\">Lettuce</link> on a chilled <link=\"COLDWHEATBREAD\">Frost Bun</link>."
msgstr "冰涼的<link=\"COLDWHEATBREAD\">冰霜麵包</link>夾著<link=\"MEAT\">肉</link>與<link=\"LETTUCE\">生菜</link>。"

#. STRINGS.ITEMS.FOOD.BUTTERFLYFOOD.DESC
msgctxt "STRINGS.ITEMS.FOOD.BUTTERFLYFOOD.DESC"
msgid "A lightly toasted <link=\"BUTTERFLYPLANTSEED\">Mimillet</link>.\n\nIt makes the tummy feel a bit fluttery."
msgstr "一份稍稍烤過的<link=\"BUTTERFLYPLANTSEED\">擬葉種</link>。\n\n肚子裡感覺飄飄的。"

#. STRINGS.ITEMS.FOOD.BUTTERFLYFOOD.NAME
msgctxt "STRINGS.ITEMS.FOOD.BUTTERFLYFOOD.NAME"
msgid "<link=\"BUTTERFLYFOOD\">Toasted Mimillet</link>"
msgstr "<link=\"BUTTERFLYFOOD\">烘烤擬葉種</link>"

#. STRINGS.ITEMS.FOOD.BUTTERFLYFOOD.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.BUTTERFLYFOOD.RECIPEDESC"
msgid "A lightly toasted <link=\"BUTTERFLYPLANTSEED\">Mimillet</link>."
msgstr "一份稍稍烤過的<link=\"BUTTERFLYPLANTSEED\">擬葉種</link>。"

#. STRINGS.ITEMS.FOOD.BUTTERFLYPLANTSEED.DESC
msgctxt "STRINGS.ITEMS.FOOD.BUTTERFLYPLANTSEED.DESC"
msgid "An inedible seed from a <link=\"BUTTERFLYPLANT\">Mimika Bud</link>.\n\nIt can be sown to cultivate more plants, or processed into <link=\"FOOD\">Food</link>.\n\nDigging up Buried Objects may uncover a Mimillet Seed."
msgstr "來自<link=\"BUTTERFLYPLANT\">擬葉蛾芽</link>的一種不可食用的種子\n\n它可以播種以種植更多植物，或加工成<link=\"FOOD\">食物</link>。\n\n挖掘被埋住的物件可能會發現擬葉種種子。"

#. STRINGS.ITEMS.FOOD.BUTTERFLYPLANTSEED.NAME
msgctxt "STRINGS.ITEMS.FOOD.BUTTERFLYPLANTSEED.NAME"
msgid "<link=\"BUTTERFLYPLANTSEED\">Mimillet</link>"
msgstr "<link=\"BUTTERFLYPLANTSEED\">擬葉種</link>"

#. STRINGS.ITEMS.FOOD.BUTTERFLYPLANTSEED.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.BUTTERFLYPLANTSEED.RECIPEDESC"
msgid "An inedible <link=\"BUTTERFLYPLANTSEED\">Mimillet</link> seed."
msgstr "一顆不可食用的<link=\"BUTTERFLYPLANTSEED\">擬葉種</link>種子。"

#. STRINGS.ITEMS.FOOD.CARROT.DESC
msgctxt "STRINGS.ITEMS.FOOD.CARROT.DESC"
msgid "An edible tuber with an earthy, elegant flavor."
msgstr "一種可食用塊莖，有著泥土和優雅的味道。"

#. STRINGS.ITEMS.FOOD.CARROT.NAME
msgctxt "STRINGS.ITEMS.FOOD.CARROT.NAME"
msgid "<link=\"CARROT\">Plume Squash</link>"
msgstr "<link=\"CARROT\">羽葉南瓜</link>"

#. STRINGS.ITEMS.FOOD.CAVIAR.DESC
msgctxt "STRINGS.ITEMS.FOOD.CAVIAR.DESC"
msgid "Shelf-stable eggs from an aquatic critter.\n\nIt can be added to <link=\"FOOD\">Food</link> at a <link=\"DININGTABLE\">Mess Table</link> to boost <link=\"MORALE\">Morale</link>.\n\nDuplicants will automatically use Caviar while sitting at a <link=\"DININGTABLE\">Mess Table</link> during mealtime."
msgstr "來自水生動物、耐儲存的卵。\n\n可在<link=\"DININGTABLE\">單人餐桌</link>將其加入<link=\"FOOD\">食物</link>中以提升<link=\"MORALE\">士氣</link>。\n\n複製人在用餐時間坐在<link=\"DININGTABLE\">單人餐桌</link>旁時，會自動使用魚子醬。"

#. STRINGS.ITEMS.FOOD.CAVIAR.NAME
msgctxt "STRINGS.ITEMS.FOOD.CAVIAR.NAME"
msgid "<link=\"CAVIAR\">Caviar</link>"
msgstr "<link=\"CAVIAR\">魚子醬</link>"

#. STRINGS.ITEMS.FOOD.COLDWHEATBREAD.DESC
msgctxt "STRINGS.ITEMS.FOOD.COLDWHEATBREAD.DESC"
msgid "A simple bun baked from <link=\"COLDWHEATSEED\">Sleet Wheat Grain</link>.\n\nEach bite leaves a mild cooling sensation in one's mouth, even when the bun itself is warm."
msgstr "使用<link=\"COLDWHEATSEED\">雪麥穀粒</link>製作做的簡單烤小圓麵包。\n\n就算麵包熱熱的，咬下去還是會有點涼涼的。"

#. STRINGS.ITEMS.FOOD.COLDWHEATBREAD.NAME
msgctxt "STRINGS.ITEMS.FOOD.COLDWHEATBREAD.NAME"
msgid "<link=\"COLDWHEATBREAD\">Frost Bun</link>"
msgstr "<link=\"COLDWHEATBREAD\">冰霜麵包</link>"

#. STRINGS.ITEMS.FOOD.COLDWHEATBREAD.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.COLDWHEATBREAD.RECIPEDESC"
msgid "A simple bun baked from <link=\"COLDWHEATSEED\">Sleet Wheat Grain</link>."
msgstr "使用<link=\"COLDWHEATSEED\">雪麥穀粒</link>製作做的簡單烤小圓麵包。"

#. STRINGS.ITEMS.FOOD.COLDWHEATSEED.DESC
msgctxt "STRINGS.ITEMS.FOOD.COLDWHEATSEED.DESC"
msgid "An edible grain that leaves a cool taste on the tongue."
msgstr "一種在舌頭上留下涼爽味道的可食用穀粒。"

#. STRINGS.ITEMS.FOOD.COLDWHEATSEED.NAME
msgctxt "STRINGS.ITEMS.FOOD.COLDWHEATSEED.NAME"
msgid "<link=\"COLDWHEATSEED\">Sleet Wheat Grain</link>"
msgstr "<link=\"COLDWHEATSEED\">雪麥穀粒</link>"

#. STRINGS.ITEMS.FOOD.COMPOST
msgctxt "STRINGS.ITEMS.FOOD.COMPOST"
msgid "Compost"
msgstr "堆肥"

#. STRINGS.ITEMS.FOOD.COOKEDEGG.DESC
msgctxt "STRINGS.ITEMS.FOOD.COOKEDEGG.DESC"
msgid "Fluffed and folded Egg innards.\n\nIt turns out you do, in fact, have to break a few eggs to make it."
msgstr "打發並輕柔摺疊的蛋液。\n\n看來，想做出這道美味，還真得打破幾個蛋。"

#. STRINGS.ITEMS.FOOD.COOKEDEGG.NAME
msgctxt "STRINGS.ITEMS.FOOD.COOKEDEGG.NAME"
msgid "<link=\"COOKEDEGG\">Omelette</link>"
msgstr "<link=\"COOKEDEGG\">歐姆蛋</link>"

#. STRINGS.ITEMS.FOOD.COOKEDEGG.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.COOKEDEGG.RECIPEDESC"
msgid "Fluffed and folded egg innards."
msgstr "打發並輕柔摺疊的蛋液。"

#. STRINGS.ITEMS.FOOD.COOKEDFISH.DESC
msgctxt "STRINGS.ITEMS.FOOD.COOKEDFISH.DESC"
msgid "A cooked piece of freshly caught aquatic critter.\n\nUnsurprisingly, it tastes a bit fishy."
msgstr "一塊新鮮的煮熟海鮮。\n\n不出所料，它嘗起來有點魚腥味。"

#. STRINGS.ITEMS.FOOD.COOKEDFISH.NAME
msgctxt "STRINGS.ITEMS.FOOD.COOKEDFISH.NAME"
msgid "<link=\"COOKEDFISH\">Cooked Seafood</link>"
msgstr "<link=\"COOKEDFISH\">熟海鮮</link>"

#. STRINGS.ITEMS.FOOD.COOKEDFISH.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.COOKEDFISH.RECIPEDESC"
msgid "A cooked piece of freshly caught aquatic critter."
msgstr "一塊煮熟的新鮮水生動物肉。"

#. STRINGS.ITEMS.FOOD.COOKEDMEAT.DESC
msgctxt "STRINGS.ITEMS.FOOD.COOKEDMEAT.DESC"
msgid "The cooked meat of a defeated critter.\n\nIt has a delightful smoky aftertaste."
msgstr "被擊敗生物的熟肉。\n\n它有一個令人愉快的煙燻味。"

#. STRINGS.ITEMS.FOOD.COOKEDMEAT.NAME
msgctxt "STRINGS.ITEMS.FOOD.COOKEDMEAT.NAME"
msgid "<link=\"COOKEDMEAT\">Barbeque</link>"
msgstr "<link=\"COOKEDMEAT\">烤肉</link>"

#. STRINGS.ITEMS.FOOD.COOKEDMEAT.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.COOKEDMEAT.RECIPEDESC"
msgid "The cooked meat of a defeated critter."
msgstr "被擊敗動物的熟肉。"

#. STRINGS.ITEMS.FOOD.COOKEDPIKEAPPLE.DESC
msgctxt "STRINGS.ITEMS.FOOD.COOKEDPIKEAPPLE.DESC"
msgid "Grilling a <link=\"HARDSKINBERRY\">Pikeapple</link> softens its spikes, making it slighly less awkward to eat.\n\nIt does not diminish the smell."
msgstr "烤<link=\"HARDSKINBERRY\">刺殼果</link>可軟化其尖刺，使吃起來沒那麼尷尬。\n\n氣味一點沒少。"

#. STRINGS.ITEMS.FOOD.COOKEDPIKEAPPLE.NAME
msgctxt "STRINGS.ITEMS.FOOD.COOKEDPIKEAPPLE.NAME"
msgid "<link=\"COOKEDPIKEAPPLE\">Pikeapple Skewer</link>"
msgstr "<link=\"COOKEDPIKEAPPLE\">刺殼果烤串</link>"

#. STRINGS.ITEMS.FOOD.COOKEDPIKEAPPLE.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.COOKEDPIKEAPPLE.RECIPEDESC"
msgid "A grilled dish made with a fruiting <link=\"HARDSKINBERRY\">Pikeapple</link>."
msgstr "一種用<link=\"HARDSKINBERRY\">刺殼果</link>做的烤菜。"

#. STRINGS.ITEMS.FOOD.CURRY.DEHYDRATED.DESC
msgctxt "STRINGS.ITEMS.FOOD.CURRY.DEHYDRATED.DESC"
msgid "A dehydrated <link=\"CURRY\">Curried Beans</link> ration. It must be rehydrated in order to be considered <link=\"FOOD\">Food</link>.\n\nDry rations have no expiry date."
msgstr "脫水<link=\"CURRY\">咖哩豆</link>補給。必須重新補水才能視為<link=\"FOOD\">食品</link>。\n\n乾糧沒有有效期限。"

#. STRINGS.ITEMS.FOOD.CURRY.DEHYDRATED.NAME
msgctxt "STRINGS.ITEMS.FOOD.CURRY.DEHYDRATED.NAME"
msgid "<link=\"CURRY\">Dried Curried Beans</link>"
msgstr "<link=\"CURRY\">乾燥咖哩豆</link>"

#. STRINGS.ITEMS.FOOD.CURRY.DESC
msgctxt "STRINGS.ITEMS.FOOD.CURRY.DESC"
msgid "Chewy <link=\"BEANPLANTSEED\">Nosh Beans</link> simmered with chunks of <link=\"GINGERCONFIG\">Tonic Root</link>.\n\nIt's so spicy!"
msgstr "可口的<link=\"BEANPLANTSEED\">小吃豆</link>與<link=\"GINGERCONFIG\">辛香根</link>一起燉煮。\n\n真是太辣了！"

#. STRINGS.ITEMS.FOOD.CURRY.NAME
msgctxt "STRINGS.ITEMS.FOOD.CURRY.NAME"
msgid "<link=\"CURRY\">Curried Beans</link>"
msgstr "<link=\"CURRY\">咖哩豆</link>"

#. STRINGS.ITEMS.FOOD.CURRY.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.CURRY.RECIPEDESC"
msgid "Chewy <link=\"BEANPLANTSEED\">Nosh Beans</link> simmered with chunks of <link=\"GINGERCONFIG\">Tonic Root</link>."
msgstr "可口的<link=\"BEANPLANTSEED\">小吃豆</link>與<link=\"GINGERCONFIG\">辛香根</link>一起燉煮。"

#. STRINGS.ITEMS.FOOD.DEEPFRIEDFISH.DESC
msgctxt "STRINGS.ITEMS.FOOD.DEEPFRIEDFISH.DESC"
msgid "Deep-fried fish cradled in a crunchy fin."
msgstr "油炸的魚肉，包裹在酥脆的魚翅中。"

#. STRINGS.ITEMS.FOOD.DEEPFRIEDFISH.NAME
msgctxt "STRINGS.ITEMS.FOOD.DEEPFRIEDFISH.NAME"
msgid "<link=\"DEEPFRIEDFISH\">Fish Taco</link>"
msgstr "<link=\"DEEPFRIEDFISH\">魚塔可</link>"

#. STRINGS.ITEMS.FOOD.DEEPFRIEDFISH.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.DEEPFRIEDFISH.RECIPEDESC"
msgid "<link=\"FISHMEAT\">Fish Fillet</link> lightly battered and deep-fried in <link=\"TALLOW\">Tallow</link>."
msgstr "裹上薄層麵衣後，以<link=\"TALLOW\">動物油脂</link>油炸而成的<link=\"FISHMEAT\">魚片</link>。"

#. STRINGS.ITEMS.FOOD.DEEPFRIEDMEAT.DESC
msgctxt "STRINGS.ITEMS.FOOD.DEEPFRIEDMEAT.DESC"
msgid "A juicy slab of meat with a crunchy deep-fried upper layer."
msgstr "一份多汁的肉塊，上層油炸得很酥脆。"

#. STRINGS.ITEMS.FOOD.DEEPFRIEDMEAT.NAME
msgctxt "STRINGS.ITEMS.FOOD.DEEPFRIEDMEAT.NAME"
msgid "<link=\"DEEPFRIEDMEAT\">Deep Fried Steak</link>"
msgstr "<link=\"DEEPFRIEDMEAT\">炸肉塊</link>"

#. STRINGS.ITEMS.FOOD.DEEPFRIEDMEAT.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.DEEPFRIEDMEAT.RECIPEDESC"
msgid "A juicy slab of <link=\"MEAT\">Raw Meat</link> deep-fried in <link=\"TALLOW\">Tallow</link>."
msgstr "在<link=\"TALLOW\">動物油脂</link>中油炸過的多汁<link=\"MEAT\">生肉</link>塊。"

#. STRINGS.ITEMS.FOOD.DEEPFRIEDNOSH.DESC
msgctxt "STRINGS.ITEMS.FOOD.DEEPFRIEDNOSH.DESC"
msgid "A snackable handful of crunchy beans."
msgstr "一把脆脆的豆子，可以當零食吃。"

#. STRINGS.ITEMS.FOOD.DEEPFRIEDNOSH.NAME
msgctxt "STRINGS.ITEMS.FOOD.DEEPFRIEDNOSH.NAME"
msgid "<link=\"DEEPFRIEDNOSH\">Nosh Noms</link>"
msgstr "<link=\"DEEPFRIEDNOSH\">炸豆豆</link>"

#. STRINGS.ITEMS.FOOD.DEEPFRIEDNOSH.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.DEEPFRIEDNOSH.RECIPEDESC"
msgid "A crunchy stack of <link=\"BEANPLANTSEED\">Nosh Beans</link> deep-fried in <link=\"TALLOW\">Tallow</link>."
msgstr "一疊鬆脆的<link=\"BEANPLANTSEED\">小吃豆</link>，已在<link=\"TALLOW\">動物油脂</link>中油炸。"

#. STRINGS.ITEMS.FOOD.DEEPFRIEDSHELLFISH.DESC
msgctxt "STRINGS.ITEMS.FOOD.DEEPFRIEDSHELLFISH.DESC"
msgid "A crispy deep-fried critter claw."
msgstr "一份酥脆的油炸小動物爪。"

#. STRINGS.ITEMS.FOOD.DEEPFRIEDSHELLFISH.NAME
msgctxt "STRINGS.ITEMS.FOOD.DEEPFRIEDSHELLFISH.NAME"
msgid "<link=\"DEEPFRIEDSHELLFISH\">Shellfish Tempura</link>"
msgstr "<link=\"DEEPFRIEDSHELLFISH\">貝肉天婦羅</link>"

#. STRINGS.ITEMS.FOOD.DEEPFRIEDSHELLFISH.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.DEEPFRIEDSHELLFISH.RECIPEDESC"
msgid "A tender chunk of battered <link=\"SHELLFISHMEAT\">Raw Shellfish</link> deep-fried in <link=\"TALLOW\">Tallow</link>."
msgstr "一塊嫩嫩的<link=\"SHELLFISHMEAT\">生貝肉</link>在<link=\"TALLOW\">動物油脂</link>中油炸。"

#. STRINGS.ITEMS.FOOD.DINOSAURMEAT.DESC
msgctxt "STRINGS.ITEMS.FOOD.DINOSAURMEAT.DESC"
msgid "Uncooked meat from a very dead critter.\n\nIt's inedible until cooked in the <link=\"SMOKER\">Smoker</link>."
msgstr "從死透的小動物身上得來的生肉。\n\n在<link=\"SMOKER\">煙燻爐</link>中煮熟之前都無法食用。"

#. STRINGS.ITEMS.FOOD.DINOSAURMEAT.NAME
msgctxt "STRINGS.ITEMS.FOOD.DINOSAURMEAT.NAME"
msgid "<link=\"DINOSAURMEAT\">Tough Meat</link>"
msgstr "<link=\"DINOSAURMEAT\">硬肉</link>"

#. STRINGS.ITEMS.FOOD.DRECKOEGG.DESC
msgctxt "STRINGS.ITEMS.FOOD.DRECKOEGG.DESC"
msgid "An egg laid by a <link=\"DRECKO\">Drecko</link>.\n\nIf incubated, it will hatch into a new <link=\"DRECKO\">Drecklet</link>."
msgstr "<link=\"DRECKO\">龍鱗蜥</link>產下的蛋。\n\n如果孵化，它將會成為一隻新<link=\"DRECKO\">龍鱗蜥寶寶</link>。"

#. STRINGS.ITEMS.FOOD.DRECKOEGG.NAME
msgctxt "STRINGS.ITEMS.FOOD.DRECKOEGG.NAME"
msgid "<link=\"DRECKO\">Drecko Egg</link>"
msgstr "<link=\"DRECKO\">龍鱗蜥蛋</link>"

#. STRINGS.ITEMS.FOOD.DRECKOEGG.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.DRECKOEGG.RECIPEDESC"
msgid "An egg laid by a <link=\"DRECKO\">Drecko</link>."
msgstr "<link=\"DRECKO\">龍鱗蜥</link>產下的蛋。"

#. STRINGS.ITEMS.FOOD.EDAMAME.DESC
msgctxt "STRINGS.ITEMS.FOOD.EDAMAME.DESC"
msgid "Raw <link=\"BEANPLANTSEED\">Nosh Beans</link> sprinkled with <link=\"SALTYSTICKSPLANT\">Sodicane</link> shavings.\n\nSimple and satisfying."
msgstr "撒了<link=\"SALTYSTICKSPLANT\">鹹蔗</link>的生<link=\"BEANPLANTSEED\">小吃豆</link>。\n\n簡單而令人滿足。"

#. STRINGS.ITEMS.FOOD.EDAMAME.NAME
msgctxt "STRINGS.ITEMS.FOOD.EDAMAME.NAME"
msgid "<link=\"EDAMAME\">Edamame</link>"
msgstr "<link=\"EDAMAME\">毛豆</link>"

#. STRINGS.ITEMS.FOOD.EDAMAME.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.EDAMAME.RECIPEDESC"
msgid "Raw <link=\"BEANPLANTSEED\">Nosh Beans</link> with <link=\"SALTYSTICKSPLANT\">Sodicane</link>."
msgstr "撒了<link=\"SALTYSTICKSPLANT\">鹹蔗</link>的生<link=\"BEANPLANTSEED\">小吃豆</link>。"

#. STRINGS.ITEMS.FOOD.FERNFOOD.DESC
msgctxt "STRINGS.ITEMS.FOOD.FERNFOOD.DESC"
msgid "An ancient grain that can be processed into <link=\"FOOD\">Food</link>."
msgstr "一種可以加工成<link=\"FOOD\">食物</link>的古老穀物。"

#. STRINGS.ITEMS.FOOD.FERNFOOD.NAME
msgctxt "STRINGS.ITEMS.FOOD.FERNFOOD.NAME"
msgid "<link=\"FERNFOOD\">Megafrond Grain</link>"
msgstr "<link=\"FERNFOOD\">巨蕨穀粒</link>"

#. STRINGS.ITEMS.FOOD.FIELDRATION.DESC
msgctxt "STRINGS.ITEMS.FOOD.FIELDRATION.DESC"
msgid "A nourishing nutrient paste, sandwiched between thin wafer layers."
msgstr "薄脆威化層之間，夾著含有營養的內餡。"

#. STRINGS.ITEMS.FOOD.FIELDRATION.NAME
msgctxt "STRINGS.ITEMS.FOOD.FIELDRATION.NAME"
msgid "<link=\"FIELDRATION\">Nutrient Bar</link>"
msgstr "<link=\"FIELDRATION\">營養口糧</link>"

#. STRINGS.ITEMS.FOOD.FISHFOOD.DESC
msgctxt "STRINGS.ITEMS.FOOD.FISHFOOD.DESC"
msgid "A gourmet loaf of ground seeds and <link=\"WATER\">Water</link>, formulated to delight <link=\"PACUSPECIES\">Pacus</link>."
msgstr "由種子粉與<link=\"WATER\">水</link>混合而成的「精緻」飼料，專為討好<link=\"PACUSPECIES\">帕庫</link>而調配。"

#. STRINGS.ITEMS.FOOD.FISHFOOD.NAME
msgctxt "STRINGS.ITEMS.FOOD.FISHFOOD.NAME"
msgid "<link=\"PACUTREAT\">Pacu Treat</link>"
msgstr "<link=\"PACUTREAT\">帕庫魚食</link>"

#. STRINGS.ITEMS.FOOD.FISHFOOD.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.FISHFOOD.RECIPEDESC"
msgid "A gourmet loaf of ground seeds, specially formulated for Pacus."
msgstr "由種子粉壓製而成的「精緻」飼料塊，專為帕庫調配。"

#. STRINGS.ITEMS.FOOD.FISHMEAT.DESC
msgctxt "STRINGS.ITEMS.FOOD.FISHMEAT.DESC"
msgid "An uncooked fillet from a very dead aquatic critter. Yum!"
msgstr "取自某種已死透的水生生物的生魚片。美味！"

#. STRINGS.ITEMS.FOOD.FISHMEAT.NAME
msgctxt "STRINGS.ITEMS.FOOD.FISHMEAT.NAME"
msgid "<link=\"FISHMEAT\">Fish Fillet</link>"
msgstr "<link=\"FISHMEAT\">魚片</link>"

#. STRINGS.ITEMS.FOOD.FOODSPLAT.DESC
msgctxt "STRINGS.ITEMS.FOOD.FOODSPLAT.DESC"
msgid "Food smeared on the wall from a recent Food Fight"
msgstr "最近的一場食物大戰中食物被塗在牆上"

#. STRINGS.ITEMS.FOOD.FOODSPLAT.NAME
msgctxt "STRINGS.ITEMS.FOOD.FOODSPLAT.NAME"
msgid "Food Splatter"
msgstr "食物飛濺"

#. STRINGS.ITEMS.FOOD.FORESTFORAGEPLANT.DESC
msgctxt "STRINGS.ITEMS.FOOD.FORESTFORAGEPLANT.DESC"
msgid "A seedless fruit with an unusual rubbery texture.\n\nIt cannot be replanted.\n\nHexalent fruit is much more calorie dense than Muckroot fruit."
msgstr "一種帶有特殊膠質且沒有種子的果實。\n\n無法重新種植。\n\n蜂巢仙人掌的果實，卡路里比塊根高。"

#. STRINGS.ITEMS.FOOD.FORESTFORAGEPLANT.NAME
msgctxt "STRINGS.ITEMS.FOOD.FORESTFORAGEPLANT.NAME"
msgid "<link=\"FORESTFORAGEPLANT\">Hexalent Fruit</link>"
msgstr "<link=\"FORESTFORAGEPLANT\">蜂巢仙人掌果</link>"

#. STRINGS.ITEMS.FOOD.FRIEDMUSHBAR.DESC
msgctxt "STRINGS.ITEMS.FOOD.FRIEDMUSHBAR.DESC"
msgid "Pan-fried, solidified mudslop.\n\nThe inside is almost completely uncooked, despite the crunch on the outside."
msgstr "煎過之後變硬的泥漿糊。\n\n裡面幾乎沒有煮熟，儘管外面酥脆。"

#. STRINGS.ITEMS.FOOD.FRIEDMUSHBAR.NAME
msgctxt "STRINGS.ITEMS.FOOD.FRIEDMUSHBAR.NAME"
msgid "<link=\"FRIEDMUSHBAR\">Mush Fry</link>"
msgstr "<link=\"FRIEDMUSHBAR\">煎泥糕</link>"

#. STRINGS.ITEMS.FOOD.FRIEDMUSHBAR.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.FRIEDMUSHBAR.RECIPEDESC"
msgid "Pan-fried, solidified mudslop."
msgstr "煎過之後變硬的泥漿糊。"

#. STRINGS.ITEMS.FOOD.FRIEDMUSHROOM.DESC
msgctxt "STRINGS.ITEMS.FOOD.FRIEDMUSHROOM.DESC"
msgid "A pan-fried dish made with a fruiting <link=\"MUSHROOM\">Dusk Cap</link>.\n\nIt has a thick, savory flavor with subtle earthy undertones."
msgstr "一盤煎過的<link=\"MUSHROOM\">蘑菇</link>。\n\n它有一種濃厚、自然的微妙風味。"

#. STRINGS.ITEMS.FOOD.FRIEDMUSHROOM.NAME
msgctxt "STRINGS.ITEMS.FOOD.FRIEDMUSHROOM.NAME"
msgid "<link=\"FRIEDMUSHROOM\">Fried Mushroom</link>"
msgstr "<link=\"FRIEDMUSHROOM\">炸蘑菇</link>"

#. STRINGS.ITEMS.FOOD.FRIEDMUSHROOM.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.FRIEDMUSHROOM.RECIPEDESC"
msgid "A pan-fried dish made with a fruiting <link=\"MUSHROOM\">Dusk Cap</link>."
msgstr "一盤煎過的<link=\"MUSHROOM\">蘑菇</link>。"

#. STRINGS.ITEMS.FOOD.FRIESCARROT.DESC
msgctxt "STRINGS.ITEMS.FOOD.FRIESCARROT.DESC"
msgid "Irresistibly crunchy.\n\nBest eaten hot."
msgstr "鬆脆，無法抗拒。\n\n最好趁熱吃。"

#. STRINGS.ITEMS.FOOD.FRIESCARROT.NAME
msgctxt "STRINGS.ITEMS.FOOD.FRIESCARROT.NAME"
msgid "<link=\"FRIESCARROT\">Squash Fries</link>"
msgstr "<link=\"FRIESCARROT\">南瓜條</link>"

#. STRINGS.ITEMS.FOOD.FRIESCARROT.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.FRIESCARROT.RECIPEDESC"
msgid "Crunchy sticks of <link=\"CARROT\">Plume Squash</link> deep-fried in <link=\"TALLOW\">Tallow</link>."
msgstr "酥脆的<link=\"CARROTPLANT\">羽葉南瓜</link>條在<link=\"TALLOW\">動物油脂</link>中油炸。"

#. STRINGS.ITEMS.FOOD.FRUITCAKE.DESC
msgctxt "STRINGS.ITEMS.FOOD.FRUITCAKE.DESC"
msgid "A mashed up <link=\"PRICKLEFRUIT\">Bristle Berry</link> sludge with an exceptionally long shelf life.\n\nIts aggressive, overbearing sweetness can leave the tongue feeling temporarily numb."
msgstr "一種壓製的<link=\"PRICKLEFRUIT\">鬃果</link>製成的糕餅，有異常地長的保存期限。\n\n它的甜度非常高，會讓舌頭暫時感到麻木。"

#. STRINGS.ITEMS.FOOD.FRUITCAKE.NAME
msgctxt "STRINGS.ITEMS.FOOD.FRUITCAKE.NAME"
msgid "<link=\"FRUITCAKE\">Berry Sludge</link>"
msgstr "<link=\"FRUITCAKE\">鬃果糕</link>"

#. STRINGS.ITEMS.FOOD.FRUITCAKE.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.FRUITCAKE.RECIPEDESC"
msgid "A mashed up <link=\"PRICKLEFRUIT\">Bristle Berry</link> sludge with an exceptionally long shelf life."
msgstr "一種壓製的<link=\"PRICKLEFRUIT\">鬃果</link>製成的糕餅，有異常地長的保存期限。"

#. STRINGS.ITEMS.FOOD.GAMMAMUSH.DESC
msgctxt "STRINGS.ITEMS.FOOD.GAMMAMUSH.DESC"
msgid "A disturbingly delicious mixture of irradiated dirt and water."
msgstr "一種令人不安的食品，由受輻射汙染的泥土與水調製而成。"

#. STRINGS.ITEMS.FOOD.GAMMAMUSH.NAME
msgctxt "STRINGS.ITEMS.FOOD.GAMMAMUSH.NAME"
msgid "<link=\"GAMMAMUSH\">Gamma Mush</link>"
msgstr "<link=\"GAMMAMUSH\">伽瑪泥糊</link>"

#. STRINGS.ITEMS.FOOD.GAMMAMUSH.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.GAMMAMUSH.RECIPEDESC"
msgid "<link=\"FRIEDMUSHBAR\">Mush Fry</link> reheated in a <link=\"GAMMARAYOVEN\">Gamma Ray Oven</link>."
msgstr "<link=\"FRIEDMUSHBAR\">煎泥糕</link>在<link=\"GAMMARAYOVEN\">伽瑪射線烤箱</link>中重新加熱。"

#. STRINGS.ITEMS.FOOD.GARDENFOODPLANTFOOD.DESC
msgctxt "STRINGS.ITEMS.FOOD.GARDENFOODPLANTFOOD.DESC"
msgid "The sugary vegetable produced by <link=\"GARDENFOODPLANT\">Sweatcorn Stalks</link>.\n\nIt tastes a lot better deep-fried."
msgstr "採摘自<link=\"GARDENFOODPLANT\">津甜玉米稈</link>的甜味蔬菜。\n\n它經過深度油炸後味道會好得多。"

#. STRINGS.ITEMS.FOOD.GARDENFOODPLANTFOOD.NAME
msgctxt "STRINGS.ITEMS.FOOD.GARDENFOODPLANTFOOD.NAME"
msgid "<link=\"GARDENFOODPLANTFOOD\">Sweatcorn</link>"
msgstr "<link=\"GARDENFOODPLANTFOOD\">津甜玉米</link>"

#. STRINGS.ITEMS.FOOD.GARDENFORAGEPLANT.DESC
msgctxt "STRINGS.ITEMS.FOOD.GARDENFORAGEPLANT.DESC"
msgid "A seedless fruit that loses its flavor long before it is fully chewed.\n\nIt cannot be replanted.\n\nDigging up Buried Objects may uncover a <link=\"GARDENFORAGEPLANT\">Snac Fruit</link>."
msgstr "一種無子果實，還沒怎麼咀嚼就沒味道了。\n\n無法再種植。\n\n挖掘被埋住的物件可能會發現<link=\"GARDENFORAGEPLANT\">食仙掌果</link>。"

#. STRINGS.ITEMS.FOOD.GARDENFORAGEPLANT.NAME
msgctxt "STRINGS.ITEMS.FOOD.GARDENFORAGEPLANT.NAME"
msgid "<link=\"GARDENFORAGEPLANT\">Snac Fruit</link>"
msgstr "<link=\"GARDENFORAGEPLANT\">食仙掌果</link>"

#. STRINGS.ITEMS.FOOD.GRILLEDPRICKLEFRUIT.DESC
msgctxt "STRINGS.ITEMS.FOOD.GRILLEDPRICKLEFRUIT.DESC"
msgid "The grilled bud of a <link=\"PRICKLEFRUIT\">Bristle Berry</link>.\n\nHeat unlocked an exquisite taste in the fruit, though the burnt spines leave something to be desired."
msgstr "烤過的<link=\"PRICKLEFRUIT\">鬃果</link>花苞。\n\n高溫激發了這水果的美味，只可惜燒焦的刺有些美中不足。"

#. STRINGS.ITEMS.FOOD.GRILLEDPRICKLEFRUIT.NAME
msgctxt "STRINGS.ITEMS.FOOD.GRILLEDPRICKLEFRUIT.NAME"
msgid "<link=\"GRILLEDPRICKLEFRUIT\">Gristle Berry</link>"
msgstr "<link=\"GRILLEDPRICKLEFRUIT\">烤鬃果</link>"

#. STRINGS.ITEMS.FOOD.GRILLEDPRICKLEFRUIT.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.GRILLEDPRICKLEFRUIT.RECIPEDESC"
msgid "The grilled bud of a <link=\"PRICKLEFRUIT\">Bristle Berry</link>."
msgstr "烤過的<link=\"PRICKLEFRUIT\">鬃果</link>。"

#. STRINGS.ITEMS.FOOD.HARDSKINBERRY.DESC
msgctxt "STRINGS.ITEMS.FOOD.HARDSKINBERRY.DESC"
msgid "An edible fruit encased in a thorny husk."
msgstr "一種包裹在帶刺外殼中的可食用水果。"

#. STRINGS.ITEMS.FOOD.HARDSKINBERRY.NAME
msgctxt "STRINGS.ITEMS.FOOD.HARDSKINBERRY.NAME"
msgid "<link=\"HARDSKINBERRY\">Pikeapple</link>"
msgstr "<link=\"HARDSKINBERRY\">刺殼果</link>"

#. STRINGS.ITEMS.FOOD.HATCHEGG.DESC
msgctxt "STRINGS.ITEMS.FOOD.HATCHEGG.DESC"
msgid "An egg laid by a <link=\"HATCH\">Hatch</link>.\n\nIf incubated, it will hatch into a <link=\"HATCH\">Hatchling</link>."
msgstr "<link=\"HATCH\">哈奇</link>產下的蛋。\n\n如果孵化，它將會成為一隻<link=\"HATCH\">哈奇寶寶</link>。"

#. STRINGS.ITEMS.FOOD.HATCHEGG.NAME
msgctxt "STRINGS.ITEMS.FOOD.HATCHEGG.NAME"
msgid "<link=\"HATCH\">Hatch Egg</link>"
msgstr "<link=\"HATCH\">哈奇蛋</link>"

#. STRINGS.ITEMS.FOOD.HATCHEGG.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.HATCHEGG.RECIPEDESC"
msgid "An egg laid by a <link=\"HATCH\">Hatch</link>."
msgstr "<link=\"HATCH\">哈奇</link>產下的蛋。"

#. STRINGS.ITEMS.FOOD.ICECAVESFORAGEPLANT.DESC
msgctxt "STRINGS.ITEMS.FOOD.ICECAVESFORAGEPLANT.DESC"
msgid "A cold seedless fruit that triggers mild brain freeze.\n\nIt cannot be replanted."
msgstr "一種會引起輕度冷食頭痛的無子水果。\n\n無法再種植。"

#. STRINGS.ITEMS.FOOD.ICECAVESFORAGEPLANT.NAME
msgctxt "STRINGS.ITEMS.FOOD.ICECAVESFORAGEPLANT.NAME"
msgid "<link=\"ICECAVESFORAGEPLANT\">Sherberry</link>"
msgstr "<link=\"ICECAVESFORAGEPLANT\">雪漿果</link>"

#. STRINGS.ITEMS.FOOD.LETTUCE.DESC
msgctxt "STRINGS.ITEMS.FOOD.LETTUCE.DESC"
msgid "Crunchy, slightly salty leaves from a <link=\"SEALETTUCE\">Waterweed</link> plant."
msgstr "來自<link=\"SEALETTUCE\">水草</link>爽口帶點鹹味的葉子。"

#. STRINGS.ITEMS.FOOD.LETTUCE.NAME
msgctxt "STRINGS.ITEMS.FOOD.LETTUCE.NAME"
msgid "<link=\"LETTUCE\">Lettuce</link>"
msgstr "<link=\"LETTUCE\">生菜</link>"

#. STRINGS.ITEMS.FOOD.LETTUCE.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.LETTUCE.RECIPEDESC"
msgid "Edible roughage from a <link=\"SEALETTUCE\">Waterweed</link>."
msgstr "來自<link=\"SEALETTUCE\">水草</link>可食用的部分。"

#. STRINGS.ITEMS.FOOD.LIGHTBUGEGG.DESC
msgctxt "STRINGS.ITEMS.FOOD.LIGHTBUGEGG.DESC"
msgid "An egg laid by a <link=\"LIGHTBUG\">Shine Bug</link>.\n\nIf incubated, it will hatch into a <link=\"LIGHTBUG\">Shine Nymph</link>."
msgstr "<link=\"LIGHTBUG\">發光蟲</link>產下的蛋。\n\n如果孵化，將會成長為<link=\"LIGHTBUG\">發光蟲寶寶</link>。"

#. STRINGS.ITEMS.FOOD.LIGHTBUGEGG.NAME
msgctxt "STRINGS.ITEMS.FOOD.LIGHTBUGEGG.NAME"
msgid "<link=\"LIGHTBUG\">Shine Bug Egg</link>"
msgstr "<link=\"LIGHTBUG\">發光蟲蛋</link>"

#. STRINGS.ITEMS.FOOD.LIGHTBUGEGG.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.LIGHTBUGEGG.RECIPEDESC"
msgid "An egg laid by a <link=\"LIGHTBUG\">Shine Bug</link>."
msgstr "一隻圓滾滾的<link=\"LIGHTBUG\">發光蟲</link>寶寶。"

#. STRINGS.ITEMS.FOOD.MAKI.DESC
msgctxt "STRINGS.ITEMS.FOOD.MAKI.DESC"
msgid "Raw <link=\"FISHMEAT\">Fish Fillet</link> paired with <link=\"BASICPLANTBAR\">Liceloaf</link> and wrapped in <link=\"NORI\">Nori</link>.\n\nThe salty, crispy wrap balances perfectly with the juicy proteins inside."
msgstr "將生<link=\"FISHMEAT\">魚片</link>搭配<link=\"BASICPLANTBAR\">米虱糕</link>，並以<link=\"NORI\">海苔</link>包裹而成。\n\n鹹香酥脆的海苔與內餡多汁的蛋白質形成了完美平衡。"

#. STRINGS.ITEMS.FOOD.MAKI.NAME
msgctxt "STRINGS.ITEMS.FOOD.MAKI.NAME"
msgid "<link=\"MAKI\">Sushi Roll</link>"
msgstr "<link=\"MAKI\">壽司卷</link>"

#. STRINGS.ITEMS.FOOD.MAKI.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.MAKI.RECIPEDESC"
msgid "Raw <link=\"FISHMEAT\">Fish Fillet</link> paired with <link=\"BASICPLANTBAR\">Liceloaf</link> and <link=\"NORI\">Nori</link>."
msgstr "生<link=\"FISHMEAT\">魚片</link>搭配<link=\"BASICPLANTBAR\">米虱糕</link>和<link=\"NORI\">海苔</link>."

#. STRINGS.ITEMS.FOOD.MEAT.DESC
msgctxt "STRINGS.ITEMS.FOOD.MEAT.DESC"
msgid "Uncooked meat from a very dead critter. Yum!"
msgstr "生的動物肉。好吃！"

#. STRINGS.ITEMS.FOOD.MEAT.NAME
msgctxt "STRINGS.ITEMS.FOOD.MEAT.NAME"
msgid "<link=\"MEAT\">Meat</link>"
msgstr "<link=\"MEAT\">肉</link>"

#. STRINGS.ITEMS.FOOD.MICROWAVEDLETTUCE.DESC
msgctxt "STRINGS.ITEMS.FOOD.MICROWAVEDLETTUCE.DESC"
msgid "<link=\"LETTUCE\">Lettuce</link> scrumptiously wilted in the <link=\"GAMMARAYOVEN\">Gamma Ray Oven</link>."
msgstr "<link=\"LETTUCE\">生菜</link>在<link=\"GAMMARAYOVEN\">伽瑪射線烤箱</link>中快速乾燥。"

#. STRINGS.ITEMS.FOOD.MICROWAVEDLETTUCE.NAME
msgctxt "STRINGS.ITEMS.FOOD.MICROWAVEDLETTUCE.NAME"
msgid "<link=\"MICROWAVEDLETTUCE\">Microwaved Lettuce</link>"
msgstr "<link=\"MICROWAVEDLETTUCE\">烤生菜</link>"

#. STRINGS.ITEMS.FOOD.MICROWAVEDLETTUCE.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.MICROWAVEDLETTUCE.RECIPEDESC"
msgid "<link=\"LETTUCE\">Lettuce</link> scrumptiously wilted in the <link=\"GAMMARAYOVEN\">Gamma Ray Oven</link>."
msgstr "<link=\"LETTUCE\">生菜</link>在<link=\"GAMMARAYOVEN\">伽瑪射線烤箱</link>中快速乾燥。"

#. STRINGS.ITEMS.FOOD.MUSHBAR.DESC
msgctxt "STRINGS.ITEMS.FOOD.MUSHBAR.DESC"
msgid "An edible, putrefied mudslop.\n\nMush Bars are preferable to starvation, but only just barely."
msgstr "一種可以勉強下嚥的腐爛泥漿糊。\n\n泥糊糕比餓死好，但也只是勉強而已。"

#. STRINGS.ITEMS.FOOD.MUSHBAR.NAME
msgctxt "STRINGS.ITEMS.FOOD.MUSHBAR.NAME"
msgid "<link=\"MUSHBAR\">Mush Bar</link>"
msgstr "<link=\"MUSHBAR\">泥糊糕</link>"

#. STRINGS.ITEMS.FOOD.MUSHBAR.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.MUSHBAR.RECIPEDESC"
msgid "An edible, putrefied mudslop.\n\n<link=\"MUSHBAR\">Mush Bar</link>s are preferable to starvation, but only just barely."
msgstr "一種可以勉強下嚥的腐爛泥漿糊。\n\n<link=\"MUSHBAR\">泥糊糕</link>比餓死好，但也只是勉強而已。"

#. STRINGS.ITEMS.FOOD.MUSHROOM.DESC
msgctxt "STRINGS.ITEMS.FOOD.MUSHROOM.DESC"
msgid "An edible, flavorless fungus that grew in the dark."
msgstr "一種可食用，生長在黑暗中，無味的菌類。"

#. STRINGS.ITEMS.FOOD.MUSHROOM.NAME
msgctxt "STRINGS.ITEMS.FOOD.MUSHROOM.NAME"
msgid "<link=\"MUSHROOM\">Mushroom</link>"
msgstr "<link=\"MUSHROOM\">蘑菇</link>"

#. STRINGS.ITEMS.FOOD.MUSHROOMWRAP.DEHYDRATED.DESC
msgctxt "STRINGS.ITEMS.FOOD.MUSHROOMWRAP.DEHYDRATED.DESC"
msgid "A dehydrated <link=\"MUSHROOMWRAP\">Mushroom Wrap</link> ration. It must be rehydrated in order to be considered <link=\"FOOD\">Food</link>.\n\nDry rations have no expiry date."
msgstr "脫水<link=\"MUSHROOMWRAP\">蘑菇生菜包</link>補給。必須重新補水才能視為<link=\"FOOD\">食品</link>。\n\n乾糧沒有有效期限。"

#. STRINGS.ITEMS.FOOD.MUSHROOMWRAP.DEHYDRATED.NAME
msgctxt "STRINGS.ITEMS.FOOD.MUSHROOMWRAP.DEHYDRATED.NAME"
msgid "<link=\"MUSHROOMWRAP\">Dried Mushroom Wrap</link>"
msgstr "<link=\"MUSHROOMWRAP\">乾燥蘑菇包</link>"

#. STRINGS.ITEMS.FOOD.MUSHROOMWRAP.DESC
msgctxt "STRINGS.ITEMS.FOOD.MUSHROOMWRAP.DESC"
msgid "Flavorful <link=\"MUSHROOM\">Mushrooms</link> wrapped in <link=\"LETTUCE\">Lettuce</link>.\n\nIt has an earthy flavor punctuated by a refreshing crunch."
msgstr "<link=\"LETTUCE\">生菜</link>包著美味的<link=\"MUSHROOM\">蘑菇</link>。\n\n它嘗起來有著清爽自然的風味。"

#. STRINGS.ITEMS.FOOD.MUSHROOMWRAP.NAME
msgctxt "STRINGS.ITEMS.FOOD.MUSHROOMWRAP.NAME"
msgid "<link=\"MUSHROOMWRAP\">Mushroom Wrap</link>"
msgstr "<link=\"MUSHROOMWRAP\">蘑菇生菜包</link>"

#. STRINGS.ITEMS.FOOD.MUSHROOMWRAP.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.MUSHROOMWRAP.RECIPEDESC"
msgid "Flavorful <link=\"MUSHROOM\">Mushrooms</link> wrapped in <link=\"LETTUCE\">Lettuce</link>."
msgstr "<link=\"LETTUCE\">生菜</link>包著美味的<link=\"MUSHROOM\">蘑菇</link>。"

#. STRINGS.ITEMS.FOOD.MUSSELTONGUE.DESC
msgctxt "STRINGS.ITEMS.FOOD.MUSSELTONGUE.DESC"
msgid "Edible tongue of a <link=\"MUSSELSPROUT\">Mussel Sprout</link>.\n\nIt's bitter and chewy, but better than starvation."
msgstr "<link=\"MUSSELSPROUT\">貽貝芽</link>的可食部分，口感如同舌頭。\n\n雖苦澀且難以咀嚼，但總比餓肚子好。"

#. STRINGS.ITEMS.FOOD.MUSSELTONGUE.NAME
msgctxt "STRINGS.ITEMS.FOOD.MUSSELTONGUE.NAME"
msgid "<link=\"MUSSELTONGUE\">Mussel Tongue</link>"
msgstr "<link=\"MUSSELTONGUE\">貽貝舌</link>"

#. STRINGS.ITEMS.FOOD.MUSSELTONGUE.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.MUSSELTONGUE.RECIPEDESC"
msgid "Uncooked meat from a <link=\"MUSSELSPROUT\">Mussel Sprout</link>."
msgstr "取自<link=\"MUSSELSPROUT\">貽貝芽</link>的生肉。"

#. STRINGS.ITEMS.FOOD.NIGIRI.DESC
msgctxt "STRINGS.ITEMS.FOOD.NIGIRI.DESC"
msgid "Tenderized <link=\"SQUIDMEAT\">Calamari</link> and <link=\"BASICPLANTBAR\">Liceloaf</link> wrapped in <link=\"NORI\">Nori</link>.\n\nExpert preparation highlights the meat's delicate sweetness and soft, chewy texture."
msgstr "以<link=\"NORI\">海苔</link>將處理軟化的<link=\"SQUIDMEAT\">魷魚肉</link>與<link=\"BASICPLANTBAR\">米虱糕</link>包裹而成。\n\n專業的烹調手法，凸顯了肉質細膩的甘甜以及柔軟且富有嚼勁的口感。"

#. STRINGS.ITEMS.FOOD.NIGIRI.NAME
msgctxt "STRINGS.ITEMS.FOOD.NIGIRI.NAME"
msgid "<link=\"NIGIRI\">Nigiri</link>"
msgstr "<link=\"NIGIRI\">握壽司</link>"

#. STRINGS.ITEMS.FOOD.NIGIRI.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.NIGIRI.RECIPEDESC"
msgid "Tenderized <link=\"SQUIDMEAT\">Calamari</link> with <link=\"BASICPLANTBAR\">Liceloaf</link> and <link=\"NORI\">Nori</link>."
msgstr "在<link=\"BASICPLANTBAR\">米虱糕</link>上鋪上一層軟化的<link=\"SQUIDMEAT\">魷魚肉</link>。"

#. STRINGS.ITEMS.FOOD.NORI.DESC
msgctxt "STRINGS.ITEMS.FOOD.NORI.DESC"
msgid "A bundle of slightly salty dried greenery from a <link=\"SEATREE\">Tower Kelp</link> or <link=\"SEAFAIRY\">Kelpole</link>.\n\nIt's most commonly used as an ingredient in higher-tier dishes."
msgstr "一束採自<link=\"SEATREE\">塔藻</link>或<link=\"SEAFAIRY\">藻蝌蚪</link>，略帶鹹味的乾燥綠色植物。\n\n最常被用於製作高等級料理的配料。"

#. STRINGS.ITEMS.FOOD.NORI.NAME
msgctxt "STRINGS.ITEMS.FOOD.NORI.NAME"
msgid "<link=\"NORI\">Nori</link>"
msgstr "<link=\"NORI\">海苔</link>"

#. STRINGS.ITEMS.FOOD.OILFLOATEREGG.DESC
msgctxt "STRINGS.ITEMS.FOOD.OILFLOATEREGG.DESC"
msgid "An egg laid by a <link=\"OILFLOATER\">Slickster</link>.\n\nIf incubated, it will hatch into a <link=\"OILFLOATER\">Slickster Larva</link>."
msgstr "<link=\"OILFLOATER\">小油怪</link>產下的蛋。\n\n如果孵化，將會成為一隻<link=\"OILFLOATER\">小油怪寶寶</link>。"

#. STRINGS.ITEMS.FOOD.OILFLOATEREGG.NAME
msgctxt "STRINGS.ITEMS.FOOD.OILFLOATEREGG.NAME"
msgid "<link=\"OILFLOATER\">Slickster Egg</link>"
msgstr "<link=\"OILFLOATER\">小油怪蛋</link>"

#. STRINGS.ITEMS.FOOD.OILFLOATEREGG.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.OILFLOATEREGG.RECIPEDESC"
msgid "An egg laid by a <link=\"OILFLOATER\">Slickster</link>."
msgstr "<link=\"OILFLOATER\">小油怪</link>產下的蛋。"

#. STRINGS.ITEMS.FOOD.PANCAKES.DESC
msgctxt "STRINGS.ITEMS.FOOD.PANCAKES.DESC"
msgid "Sweet discs made from <link=\"RAWEGG\">Raw Egg</link> and <link=\"COLDWHEATSEED\">Sleet Wheat Grain</link>.\n\nThey're so thick!"
msgstr "由<link=\"RAWEGG\">生蛋</link>和<link=\"COLDWHEATSEED\">雪麥穀粒</link>製成的甜品。\n\n有點太厚了！"

#. STRINGS.ITEMS.FOOD.PANCAKES.NAME
msgctxt "STRINGS.ITEMS.FOOD.PANCAKES.NAME"
msgid "<link=\"PANCAKES\">Soufflé Pancakes</link>"
msgstr "<link=\"PANCAKES\">舒芙蕾鬆餅</link>"

#. STRINGS.ITEMS.FOOD.PANCAKES.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.PANCAKES.RECIPEDESC"
msgid "Sweet discs made from <link=\"RAWEGG\">Raw Egg</link> and <link=\"COLDWHEATSEED\">Sleet Wheat Grain</link>."
msgstr "由<link=\"RAWEGG\">生蛋</link>和<link=\"COLDWHEATSEED\">雪麥穀粒</link>製成的甜品。"

#. STRINGS.ITEMS.FOOD.PASTA.DESC
msgctxt "STRINGS.ITEMS.FOOD.PASTA.DESC"
msgid "pasta made from egg and wheat"
msgstr "義大利麵是由雞蛋和小麥製成"

#. STRINGS.ITEMS.FOOD.PASTA.NAME
msgctxt "STRINGS.ITEMS.FOOD.PASTA.NAME"
msgid "<link=\"PASTA\">Pasta</link>"
msgstr "<link=\"PASTA\">義大利麵</link>"

#. STRINGS.ITEMS.FOOD.PASTA.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.PASTA.RECIPEDESC"
msgid "pasta made from egg and wheat"
msgstr "義大利麵是由雞蛋和小麥製成"

#. STRINGS.ITEMS.FOOD.PEMMICAN.DESC
msgctxt "STRINGS.ITEMS.FOOD.PEMMICAN.DESC"
msgid "<link=\"MEAT\">Meat</link> and <link=\"TALLOW\">Tallow</link> pounded into a calorie-dense brick with an exceptionally long shelf life.\n\nSurvival never tasted so good."
msgstr "將<link=\"MEAT\">肉</link>和<link=\"TALLOW\">動物油脂</link>搗碎製成的高卡路里的磚形食物，保質期極長。\n\n生存的滋味從未如此美妙。"

#. STRINGS.ITEMS.FOOD.PEMMICAN.NAME
msgctxt "STRINGS.ITEMS.FOOD.PEMMICAN.NAME"
msgid "<link=\"PEMMICAN\">Pemmican</link>"
msgstr "<link=\"PEMMICAN\">乾肉餅</link>"

#. STRINGS.ITEMS.FOOD.PEMMICAN.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.PEMMICAN.RECIPEDESC"
msgid "<link=\"MEAT\">Meat</link> and <link=\"TALLOW\">Tallow</link> pounded into a nutrient-dense brick with an exceptionally long shelf life."
msgstr "將<link=\"MEAT\">肉</link>和<link=\"TALLOW\">動物油脂</link>搗碎製成的營養豐富的磚形食物，保質期極長。"

#. STRINGS.ITEMS.FOOD.PICKLEDMEAL.DESC
msgctxt "STRINGS.ITEMS.FOOD.PICKLEDMEAL.DESC"
msgid "Meal Lice preserved in vinegar.\n\nIt's a rarely acquired taste."
msgstr "米虱保存在醋中。\n\n有著特別的風味。"

#. STRINGS.ITEMS.FOOD.PICKLEDMEAL.NAME
msgctxt "STRINGS.ITEMS.FOOD.PICKLEDMEAL.NAME"
msgid "<link=\"PICKLEDMEAL\">Pickled Meal</link>"
msgstr "<link=\"PICKLEDMEAL\">醃米虱</link>"

#. STRINGS.ITEMS.FOOD.PICKLEDMEAL.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.PICKLEDMEAL.RECIPEDESC"
msgid "<link=\"BASICPLANTFOOD\">Meal Lice</link> regrettably preserved in vinegar."
msgstr "<link=\"BASICPLANTFOOD\">米虱</link>保存在醋中。"

#. STRINGS.ITEMS.FOOD.PLANTMEAT.DESC
msgctxt "STRINGS.ITEMS.FOOD.PLANTMEAT.DESC"
msgid "Planty plant meat from a plant. How nice!"
msgstr "栽種植物獲得植物肉，多好！"

#. STRINGS.ITEMS.FOOD.PLANTMEAT.NAME
msgctxt "STRINGS.ITEMS.FOOD.PLANTMEAT.NAME"
msgid "<link=\"PLANTMEAT\">Plant Meat</link>"
msgstr "<link=\"PLANTMEAT\">植物肉</link>"

#. STRINGS.ITEMS.FOOD.POPCORN.DESC
msgctxt "STRINGS.ITEMS.FOOD.POPCORN.DESC"
msgid "<link=\"COLDWHEATSEED\">Sleet Wheat Grain</link> popped in a <link=\"GAMMARAYOVEN\">Gamma Ray Oven</link>.\n\nCompletely devoid of any fancy flavorings."
msgstr "<link=\"COLDWHEATSEED\">雪麥穀粒</link>在<link=\"GAMMARAYOVEN\">伽瑪射線烤箱</link>跳舞。\n\n完全沒有任何花俏的調味。"

#. STRINGS.ITEMS.FOOD.POPCORN.NAME
msgctxt "STRINGS.ITEMS.FOOD.POPCORN.NAME"
msgid "<link=\"POPCORN\">Popcorn</link>"
msgstr "<link=\"POPCORN\">爆米花</link>"

#. STRINGS.ITEMS.FOOD.POPCORN.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.POPCORN.RECIPEDESC"
msgid "Gamma-radiated <link=\"COLDWHEATSEED\">Sleet Wheat Grain</link>."
msgstr "伽瑪射線照射過的<link=\"COLDWHEATSEED\">雪麥穀粒</link>。"

#. STRINGS.ITEMS.FOOD.PREHISTORICPACUFILLET.DESC
msgctxt "STRINGS.ITEMS.FOOD.PREHISTORICPACUFILLET.DESC"
msgid "An uncooked fillet from a very dead <link=\"PREHISTORICPACU\">Jawbo</link>. It has a silky texture."
msgstr "從死透的<link=\"PREHISTORICPACU\">顎魚</link>身上取下的生魚片。它有著絲滑的口感。"

#. STRINGS.ITEMS.FOOD.PREHISTORICPACUFILLET.NAME
msgctxt "STRINGS.ITEMS.FOOD.PREHISTORICPACUFILLET.NAME"
msgid "<link=\"PREHISTORICPACUFILLET\">Jawbo Fillet</link>"
msgstr "<link=\"PREHISTORICPACUFILLET\">顎魚魚片</link>"

#. STRINGS.ITEMS.FOOD.PRICKLEFRUIT.DESC
msgctxt "STRINGS.ITEMS.FOOD.PRICKLEFRUIT.DESC"
msgid "A sweet, mostly pleasant-tasting fruit covered in prickly barbs."
msgstr "一種甜美覆蓋著尖刺，吃起來令人愉悅的水果。"

#. STRINGS.ITEMS.FOOD.PRICKLEFRUIT.NAME
msgctxt "STRINGS.ITEMS.FOOD.PRICKLEFRUIT.NAME"
msgid "<link=\"PRICKLEFRUIT\">Bristle Berry</link>"
msgstr "<link=\"PRICKLEFRUIT\">鬃果</link>"

#. STRINGS.ITEMS.FOOD.PUFTEGG.DESC
msgctxt "STRINGS.ITEMS.FOOD.PUFTEGG.DESC"
msgid "An egg laid by a <link=\"PUFT\">Puft</link>.\n\nIf incubated, it will hatch into a <link=\"PUFT\">Puftlet</link>."
msgstr "<link=\"PUFT\">帕夫</link>產下的蛋。\n\n如果孵化，將會成為一隻<link=\"PUFT\">帕夫寶寶</link>。"

#. STRINGS.ITEMS.FOOD.PUFTEGG.NAME
msgctxt "STRINGS.ITEMS.FOOD.PUFTEGG.NAME"
msgid "<link=\"PUFT\">Puft Egg</link>"
msgstr "<link=\"PUFT\">帕夫蛋</link>"

#. STRINGS.ITEMS.FOOD.PUFTEGG.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.PUFTEGG.RECIPEDESC"
msgid "An egg laid by a <link=\"PUFT\">Puft</link>."
msgstr "<link=\"PUFT\">帕夫</link>產下的蛋。"

#. STRINGS.ITEMS.FOOD.QUICHE.DEHYDRATED.DESC
msgctxt "STRINGS.ITEMS.FOOD.QUICHE.DEHYDRATED.DESC"
msgid "A dehydrated <link=\"QUICHE\">Mushroom Quiche</link> ration. It must be rehydrated in order to be considered <link=\"FOOD\">Food</link>.\n\nDry rations have no expiry date."
msgstr "脫水<link=\"QUICHE\">蘑菇鹹派</link>補給。必須重新補水才能視為<link=\"FOOD\">食品</link>。\n\n乾糧沒有有效期限。"

#. STRINGS.ITEMS.FOOD.QUICHE.DEHYDRATED.NAME
msgctxt "STRINGS.ITEMS.FOOD.QUICHE.DEHYDRATED.NAME"
msgid "<link=\"QUICHE\">Dried Mushroom Quiche</link>"
msgstr "<link=\"QUICHE\">乾燥蘑菇派</link>"

#. STRINGS.ITEMS.FOOD.QUICHE.DESC
msgctxt "STRINGS.ITEMS.FOOD.QUICHE.DESC"
msgid "<link=\"COOKEDEGG\">Omelette</link>, <link=\"FRIEDMUSHROOM\">Fried Mushroom</link> and <link=\"LETTUCE\">Lettuce</link> piled onto a yummy crust.\n\nSomehow, it's both soggy <i>and</i> crispy."
msgstr "<link=\"COOKEDEGG\">歐姆蛋</link>、<link=\"FRIEDMUSHROOM\">炸蘑菇</link>和<link=\"LETTUCE\">生菜</link>都堆在了美味的餅皮上。\n\n不知為何，吃起來既溼軟又酥脆。"

#. STRINGS.ITEMS.FOOD.QUICHE.NAME
msgctxt "STRINGS.ITEMS.FOOD.QUICHE.NAME"
msgid "<link=\"QUICHE\">Mushroom Quiche</link>"
msgstr "<link=\"QUICHE\">蘑菇鹹派</link>"

#. STRINGS.ITEMS.FOOD.QUICHE.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.QUICHE.RECIPEDESC"
msgid "<link=\"COOKEDEGG\">Omelette</link>, <link=\"FRIEDMUSHROOM\">Fried Mushroom</link> and <link=\"LETTUCE\">Lettuce</link> piled onto a yummy crust."
msgstr "<link=\"COOKEDEGG\">歐姆蛋</link>、<link=\"FRIEDMUSHROOM\">炸蘑菇</link>和<link=\"LETTUCE\">生菜</link>都堆在了美味的餅皮上。"

#. STRINGS.ITEMS.FOOD.RAWEGG.DESC
msgctxt "STRINGS.ITEMS.FOOD.RAWEGG.DESC"
msgid "A raw Egg that has been cracked open for use in <link=\"FOOD\">Food</link> preparation.\n\nIt will never hatch."
msgstr "一個打破的生蛋可用來料理<link=\"FOOD\">食物</link>。\n\n它不能孵化了。"

#. STRINGS.ITEMS.FOOD.RAWEGG.NAME
msgctxt "STRINGS.ITEMS.FOOD.RAWEGG.NAME"
msgid "<link=\"RAWEGG\">Raw Egg</link>"
msgstr "<link=\"RAWEGG\">生蛋</link>"

#. STRINGS.ITEMS.FOOD.RAWEGG.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.RAWEGG.RECIPEDESC"
msgid "A raw egg that has been cracked open for use in <link=\"FOOD\">Food</link> preparation."
msgstr "一個打破的生蛋可用來料理<link=\"FOOD\">食物</link>。"

#. STRINGS.ITEMS.FOOD.ROTPILE.DESC
msgctxt "STRINGS.ITEMS.FOOD.ROTPILE.DESC"
msgid "An inedible glop of former foodstuff.\n\n<link=\"COMPOST\">Rot Pile</link>s break down into <link=\"TOXICSAND\">Polluted Dirt</link> over time."
msgstr "不可食用的過期食品。\n\n<link=\"COMPOST\">腐壞物</link>隨著時間會變成<link=\"TOXICSAND\">汙土</link>。"

#. STRINGS.ITEMS.FOOD.ROTPILE.NAME
msgctxt "STRINGS.ITEMS.FOOD.ROTPILE.NAME"
msgid "<link=\"COMPOST\">Rot Pile</link>"
msgstr "<link=\"COMPOST\">腐壞物</link>"

#. STRINGS.ITEMS.FOOD.SALSA.DEHYDRATED.DESC
msgctxt "STRINGS.ITEMS.FOOD.SALSA.DEHYDRATED.DESC"
msgid "A dehydrated <link=\"SALSA\">Stuffed Berry</link> ration. It must be rehydrated in order to be considered <link=\"FOOD\">Food</link>.\n\nDry rations have no expiry date."
msgstr "脫水<link=\"SALSA\">鬃果塔</link>補給。必須重新補水才能視為<link=\"FOOD\">食品</link>。\n\n乾糧沒有有效期限。"

#. STRINGS.ITEMS.FOOD.SALSA.DEHYDRATED.NAME
msgctxt "STRINGS.ITEMS.FOOD.SALSA.DEHYDRATED.NAME"
msgid "<link=\"SALSA\">Dried Stuffed Berry</link>"
msgstr "<link=\"SALSA\">乾燥鬃果塔</link>"

#. STRINGS.ITEMS.FOOD.SALSA.DESC
msgctxt "STRINGS.ITEMS.FOOD.SALSA.DESC"
msgid "A baked <link=\"PRICKLEFRUIT\">Bristle Berry</link> stuffed with delectable spices and vibrantly flavored."
msgstr "一種烤過的<link=\"PRICKLEFRUIT\">鬃果</link>，充滿美味的香料和充滿活力的風味。"

#. STRINGS.ITEMS.FOOD.SALSA.NAME
msgctxt "STRINGS.ITEMS.FOOD.SALSA.NAME"
msgid "<link=\"SALSA\">Stuffed Berry</link>"
msgstr "<link=\"SALSA\">鬃果塔</link>"

#. STRINGS.ITEMS.FOOD.SALSA.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.SALSA.RECIPEDESC"
msgid "A baked <link=\"PRICKLEFRUIT\">Bristle Berry</link> stuffed with delectable spices and vibrantly flavored."
msgstr "一種烤過的<link=\"PRICKLEFRUIT\">鬃果</link>，充滿美味的香料和充滿活力的風味。"

#. STRINGS.ITEMS.FOOD.SALTYSTICKSFOOD.DESC
msgctxt "STRINGS.ITEMS.FOOD.SALTYSTICKSFOOD.DESC"
msgid "An extremely salty snack harvested from a <link=\"SALTYSTICKSPLANT\">Sodicane</link>.\n\nVisiting a <link=\"WATERCOOLER\">Water Cooler</link> will counteract the <link=\"IDFOODEFFECTS\">Thirst</link> caused by eating Salty Sticks."
msgstr "一種採自<link=\"SALTYSTICKSPLANT\">鹹蔗</link>的極鹹零食。\n\n前往<link=\"WATERCOOLER\">飲水機</link>處飲水，可緩解食用鹽棒後產生的<link=\"IDFOODEFFECTS\">口渴</link>狀態。"

#. STRINGS.ITEMS.FOOD.SALTYSTICKSFOOD.NAME
msgctxt "STRINGS.ITEMS.FOOD.SALTYSTICKSFOOD.NAME"
msgid "<link=\"SALTYSTICKSFOOD\">Salty Sticks</link>"
msgstr "<link=\"SALTYSTICKSFOOD\">鹽棒</link>"

#. STRINGS.ITEMS.FOOD.SHELLFISHMEAT.DESC
msgctxt "STRINGS.ITEMS.FOOD.SHELLFISHMEAT.DESC"
msgid "An uncooked chunk of very dead <link=\"CRABFRESHWATER\">Sanishell</link>. Yum!"
msgstr "一塊未煮熟的<link=\"CRABFRESHWATER\">淨水蟹</link>或其他甲殼類動物肉。好吃！"

#. STRINGS.ITEMS.FOOD.SHELLFISHMEAT.NAME
msgctxt "STRINGS.ITEMS.FOOD.SHELLFISHMEAT.NAME"
msgid "<link=\"SHELLFISHMEAT\">Raw Shellfish</link>"
msgstr "<link=\"SHELLFISHMEAT\">生貝肉</link>"

#. STRINGS.ITEMS.FOOD.SMOKEDDINOSAURMEAT.DESC
msgctxt "STRINGS.ITEMS.FOOD.SMOKEDDINOSAURMEAT.DESC"
msgid "A cooked stack of tough meat that's been marinated and slow-smoked to tender perfection."
msgstr "一疊經過烹飪的硬肉，經過醃製與慢燻已鮮嫩無比。"

#. STRINGS.ITEMS.FOOD.SMOKEDDINOSAURMEAT.NAME
msgctxt "STRINGS.ITEMS.FOOD.SMOKEDDINOSAURMEAT.NAME"
msgid "<link=\"SMOKEDDINOSAURMEAT\">Tender Brisket</link>"
msgstr "<link=\"SMOKEDDINOSAURMEAT\">嫩胸肉</link>"

#. STRINGS.ITEMS.FOOD.SMOKEDDINOSAURMEAT.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.SMOKEDDINOSAURMEAT.RECIPEDESC"
msgid "A stack of tender, slow-smoked meat."
msgstr "一疊鮮嫩的慢燻肉。"

#. STRINGS.ITEMS.FOOD.SMOKEDFISH.DESC
msgctxt "STRINGS.ITEMS.FOOD.SMOKEDFISH.DESC"
msgid "A buttery smoked fish fillet.\n\nIt flakes nicely when pulled apart with a fork."
msgstr "奶油煙燻魚片。\n\n用叉子拉開時很好剝下。"

#. STRINGS.ITEMS.FOOD.SMOKEDFISH.NAME
msgctxt "STRINGS.ITEMS.FOOD.SMOKEDFISH.NAME"
msgid "<link=\"SMOKEDFISH\">Smoked Fish</link>"
msgstr "<link=\"SMOKEDFISH\">煙燻魚</link>"

#. STRINGS.ITEMS.FOOD.SMOKEDFISH.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.SMOKEDFISH.RECIPEDESC"
msgid "A buttery smoked fish fillet."
msgstr "奶油煙燻魚片。"

#. STRINGS.ITEMS.FOOD.SMOKEDVEGETABLES.DESC
msgctxt "STRINGS.ITEMS.FOOD.SMOKEDVEGETABLES.DESC"
msgid "Crisp vegetables stuffed with herbs and smoked for hours."
msgstr "塞滿香草的酥脆玉米，燻製數小時。"

#. STRINGS.ITEMS.FOOD.SMOKEDVEGETABLES.NAME
msgctxt "STRINGS.ITEMS.FOOD.SMOKEDVEGETABLES.NAME"
msgid "<link=\"SMOKEDVEGETABLES\">Veggie Poppers</link>"
msgstr "<link=\"SMOKEDVEGETABLES\">爆米花</link>"

#. STRINGS.ITEMS.FOOD.SMOKEDVEGETABLES.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.SMOKEDVEGETABLES.RECIPEDESC"
msgid "Crisp vegetables stuffed with herbs."
msgstr "塞滿香草的酥脆玉米。"

#. STRINGS.ITEMS.FOOD.SPICEBREAD.DEHYDRATED.DESC
msgctxt "STRINGS.ITEMS.FOOD.SPICEBREAD.DEHYDRATED.DESC"
msgid "A dehydrated <link=\"SPICEBREAD\">Pepper Bread</link> ration. It must be rehydrated in order to be considered <link=\"FOOD\">Food</link>.\n\nDry rations have no expiry date."
msgstr "脫水<link=\"SPICEBREAD\">胡椒麵包</link>補給。必須重新補水才能視為<link=\"FOOD\">食品</link>。\n\n乾糧沒有有效期限。"

#. STRINGS.ITEMS.FOOD.SPICEBREAD.DEHYDRATED.NAME
msgctxt "STRINGS.ITEMS.FOOD.SPICEBREAD.DEHYDRATED.NAME"
msgid "<link=\"SPICEBREAD\">Dried Pepper Bread</link>"
msgstr "<link=\"SPICEBREAD\">乾胡椒麵包</link>"

#. STRINGS.ITEMS.FOOD.SPICEBREAD.DESC
msgctxt "STRINGS.ITEMS.FOOD.SPICEBREAD.DESC"
msgid "A loaf of bread, lightly spiced with <link=\"SPICENUT\">Pincha Peppernut</link> for a mild bite.\n\nThere's a simple joy to be had in pulling it apart in one's fingers."
msgstr "一條麵包，吃起來有淡淡的<link=\"SPICENUT\">胡椒</link>香氣。\n\n把它用手指撕開有一種簡單的幸福。"

#. STRINGS.ITEMS.FOOD.SPICEBREAD.NAME
msgctxt "STRINGS.ITEMS.FOOD.SPICEBREAD.NAME"
msgid "<link=\"SPICEBREAD\">Pepper Bread</link>"
msgstr "<link=\"SPICEBREAD\">胡椒麵包</link>"

#. STRINGS.ITEMS.FOOD.SPICEBREAD.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.SPICEBREAD.RECIPEDESC"
msgid "A loaf of bread, lightly spiced with <link=\"SPICENUT\">Pincha Peppernut</link> for a mild bite."
msgstr "一條麵包，吃起來有淡淡的<link=\"SPICENUT\">胡椒</link>香氣。"

#. STRINGS.ITEMS.FOOD.SPICENUT.DESC
msgctxt "STRINGS.ITEMS.FOOD.SPICENUT.DESC"
msgid "The flavorful nut of a <link=\"SPICEVINE\">Pincha Pepperplant</link>.\n\nThe bitter outer rind hides a rich, peppery core that is useful in cooking."
msgstr "<link=\"SPICEVINE\">胡椒藤</link>的果實。\n\n苦澀的外皮隱藏著豐富的胡椒果核，在料理中很有幫助。"

#. STRINGS.ITEMS.FOOD.SPICENUT.NAME
msgctxt "STRINGS.ITEMS.FOOD.SPICENUT.NAME"
msgid "<link=\"SPICENUT\">Pincha Peppernut</link>"
msgstr "<link=\"SPICENUT\">胡椒</link>"

#. STRINGS.ITEMS.FOOD.SPICYTOFU.DEHYDRATED.DESC
msgctxt "STRINGS.ITEMS.FOOD.SPICYTOFU.DEHYDRATED.DESC"
msgid "A dehydrated <link=\"SPICYTOFU\">Spicy Tofu</link> ration. It must be rehydrated in order to be considered <link=\"FOOD\">Food</link>.\n\nDry rations have no expiry date."
msgstr "脫水<link=\"SPICYTOFU\">麻婆豆腐</link>補給。必須重新補水才能視為<link=\"FOOD\">食品</link>。\n\n乾糧沒有有效期限。"

#. STRINGS.ITEMS.FOOD.SPICYTOFU.DEHYDRATED.NAME
msgctxt "STRINGS.ITEMS.FOOD.SPICYTOFU.DEHYDRATED.NAME"
msgid "<link=\"SPICYTOFU\">Dried Spicy Tofu</link>"
msgstr "<link=\"SPICYTOFU\">乾麻婆豆腐</link>"

#. STRINGS.ITEMS.FOOD.SPICYTOFU.DESC
msgctxt "STRINGS.ITEMS.FOOD.SPICYTOFU.DESC"
msgid "<link=\"TOFU\">Tofu</link> marinated in a flavorful <link=\"SPICENUT\">Pincha Peppernut</link> sauce.\n\nIt packs a delightful punch."
msgstr "<link=\"TOFU\">豆腐</link>佐以美味的<link=\"SPICENUT\">胡椒</link>醬汁調味。\n\n是一道重口味的美味料理。"

#. STRINGS.ITEMS.FOOD.SPICYTOFU.NAME
msgctxt "STRINGS.ITEMS.FOOD.SPICYTOFU.NAME"
msgid "<link=\"SPICYTOFU\">Spicy Tofu</link>"
msgstr "<link=\"SPICYTOFU\">麻婆豆腐</link>"

#. STRINGS.ITEMS.FOOD.SPICYTOFU.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.SPICYTOFU.RECIPEDESC"
msgid "<link=\"TOFU\">Tofu</link> marinated in a flavorful <link=\"SPICENUT\">Pincha Peppernut</link> sauce."
msgstr "<link=\"TOFU\">豆腐</link>佐以美味的<link=\"SPICENUT\">椒麻</link>醬汁調味。"

#. STRINGS.ITEMS.FOOD.SQUIDMEAT.DESC
msgctxt "STRINGS.ITEMS.FOOD.SQUIDMEAT.DESC"
msgid "Uncooked meat from a very dead <link=\"SQUID\">Glo Squid</link>.\n\nIt's a little slippery."
msgstr "取自死透的<link=\"SQUID\">彩斑魷</link>身上的生肉。\n\n摸起來滑溜溜的。"

#. STRINGS.ITEMS.FOOD.SQUIDMEAT.NAME
msgctxt "STRINGS.ITEMS.FOOD.SQUIDMEAT.NAME"
msgid "<link=\"SQUIDMEAT\">Calamari</link>"
msgstr "<link=\"SQUIDMEAT\">魷魚肉</link>"

#. STRINGS.ITEMS.FOOD.SQUIDMEAT.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.SQUIDMEAT.RECIPEDESC"
msgid "Uncooked meat from a very dead <link=\"SQUID\">Glo Squid</link>."
msgstr "從死去的<link=\"SQUID\">彩斑魷</link>身上弄來的生肉。"

#. STRINGS.ITEMS.FOOD.SURFANDTURF.DEHYDRATED.DESC
msgctxt "STRINGS.ITEMS.FOOD.SURFANDTURF.DEHYDRATED.DESC"
msgid "A dehydrated <link=\"SURFANDTURF\">Surf'n'Turf</link> ration. It must be rehydrated in order to be considered <link=\"FOOD\">Food</link>.\n\nDry rations have no expiry date."
msgstr "脫水<link=\"SURFANDTURF\">海陸大餐</link>補給。必須重新補水才能視為<link=\"FOOD\">食品</link>。\n\n乾糧沒有有效期限。"

#. STRINGS.ITEMS.FOOD.SURFANDTURF.DEHYDRATED.NAME
msgctxt "STRINGS.ITEMS.FOOD.SURFANDTURF.DEHYDRATED.NAME"
msgid "<link=\"SURFANDTURF\">Dried Surf'n'Turf</link>"
msgstr "<link=\"SURFANDTURF\">乾燥海陸餐</link>"

#. STRINGS.ITEMS.FOOD.SURFANDTURF.DESC
msgctxt "STRINGS.ITEMS.FOOD.SURFANDTURF.DESC"
msgid "A bit of <link=\"MEAT\">Meat</link> from the land and <link=\"COOKEDFISH\">Cooked Seafood</link> from the sea.\n\nIt's hearty and satisfying."
msgstr "一點來自陸地上的<link=\"MEAT\">肉</link>，與來自海洋的<link=\"COOKEDFISH\">熟海鮮</link>。\n\n豐盛和滿足。"

#. STRINGS.ITEMS.FOOD.SURFANDTURF.NAME
msgctxt "STRINGS.ITEMS.FOOD.SURFANDTURF.NAME"
msgid "<link=\"SURFANDTURF\">Surf'n'Turf</link>"
msgstr "<link=\"SURFANDTURF\">海陸大餐</link>"

#. STRINGS.ITEMS.FOOD.SURFANDTURF.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.SURFANDTURF.RECIPEDESC"
msgid "A bit of <link=\"MEAT\">Meat</link> from the land and <link=\"COOKEDFISH\">Cooked Seafood</link> from the sea."
msgstr "一點<link=\"MEAT\">肉類</link>與<link=\"COOKEDFISH\">熟海鮮</link>。"

#. STRINGS.ITEMS.FOOD.SUSHI.DESC
msgctxt "STRINGS.ITEMS.FOOD.SUSHI.DESC"
msgid "Raw <link=\"FISHMEAT\">Fish Fillet</link> wrapped with fresh <link=\"LETTUCE\">Lettuce</link>.\n\nWhile the salt of the lettuce may initially overpower the flavor, a keen palate can discern the subtle sweetness of the fillet beneath."
msgstr "生的<link=\"FISHMEAT\">魚片</link>被新鮮<link=\"LETTUCE\">生菜</link>包著。\n\n剛入口最先嘗到的是生菜上的鹽味，接著可以感受到魚肉的鮮甜。"

#. STRINGS.ITEMS.FOOD.SUSHI.NAME
msgctxt "STRINGS.ITEMS.FOOD.SUSHI.NAME"
msgid "<link=\"SUSHI\">Sushi</link>"
msgstr "<link=\"SUSHI\">壽司</link>"

#. STRINGS.ITEMS.FOOD.SUSHI.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.SUSHI.RECIPEDESC"
msgid "Raw <link=\"FISHMEAT\">Fish Fillet</link> wrapped with fresh <link=\"LETTUCE\">Lettuce</link>."
msgstr "生的<link=\"FISHMEAT\">魚片</link>被新鮮<link=\"LETTUCE\">生菜</link>包著。"

#. STRINGS.ITEMS.FOOD.SWAMPDELIGHTS.DESC
msgctxt "STRINGS.ITEMS.FOOD.SWAMPDELIGHTS.DESC"
msgid "Dried gelatinous cubes from a <link=\"SWAMPFRUIT\">Bog Jelly</link>.\n\nEach cube has a wonderfully chewy texture and is lightly coated in a delicate powder."
msgstr "<link=\"SWAMPFRUIT\">沼澤果凍</link>乾燥後的膠狀立方體。\n\n每個立方體都有個嚼勁且淡淡灑上一層調味粉。"

#. STRINGS.ITEMS.FOOD.SWAMPDELIGHTS.NAME
msgctxt "STRINGS.ITEMS.FOOD.SWAMPDELIGHTS.NAME"
msgid "<link=\"SWAMPDELIGHTS\">Swampy Delights</link>"
msgstr "<link=\"SWAMPDELIGHTS\">沼澤果乾</link>"

#. STRINGS.ITEMS.FOOD.SWAMPDELIGHTS.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.SWAMPDELIGHTS.RECIPEDESC"
msgid "Dried gelatinous cubes from a <link=\"SWAMPFRUIT\">Bog Jelly</link>."
msgstr "<link=\"SWAMPFRUIT\">沼澤果凍</link>乾掉後的膠狀立方體。"

#. STRINGS.ITEMS.FOOD.SWAMPFORAGEPLANT.DESC
msgctxt "STRINGS.ITEMS.FOOD.SWAMPFORAGEPLANT.DESC"
msgid "A seedless plant with a squishy, juicy center and an awful smell.\n\nIt cannot be replanted."
msgstr "一種沒有種子的植物，中間空心且氣味難聞。\n\n不能重新種植。"

#. STRINGS.ITEMS.FOOD.SWAMPFORAGEPLANT.NAME
msgctxt "STRINGS.ITEMS.FOOD.SWAMPFORAGEPLANT.NAME"
msgid "<link=\"SWAMPFORAGEPLANT\">Swamp Chard Heart</link>"
msgstr "<link=\"SWAMPFORAGEPLANT\">沼澤甜菜心</link>"

#. STRINGS.ITEMS.FOOD.SWAMPFRUIT.DESC
msgctxt "STRINGS.ITEMS.FOOD.SWAMPFRUIT.DESC"
msgid "A fruit with an outer film that contains chewy gelatinous cubes."
msgstr "一種有薄膜耐嚼的膠狀立方體果實。"

#. STRINGS.ITEMS.FOOD.SWAMPFRUIT.NAME
msgctxt "STRINGS.ITEMS.FOOD.SWAMPFRUIT.NAME"
msgid "<link=\"SWAMPFRUIT\">Bog Jelly</link>"
msgstr "<link=\"SWAMPFRUIT\">沼澤果凍</link>"

#. STRINGS.ITEMS.FOOD.TOFU.DESC
msgctxt "STRINGS.ITEMS.FOOD.TOFU.DESC"
msgid "A bland curd made from <link=\"BEANPLANTSEED\">Nosh Beans</link>.\n\nIt has an unusual but pleasant consistency."
msgstr "一種溫和的凝乳，由<link=\"BEANPLANTSEED\">小吃豆</link>製作而成。\n\n它有著特殊又令人愉快的口感。"

#. STRINGS.ITEMS.FOOD.TOFU.NAME
msgctxt "STRINGS.ITEMS.FOOD.TOFU.NAME"
msgid "<link=\"TOFU\">Tofu</link>"
msgstr "<link=\"TOFU\">豆腐</link>"

#. STRINGS.ITEMS.FOOD.TOFU.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.TOFU.RECIPEDESC"
msgid "A bland curd made from <link=\"BEANPLANTSEED\">Nosh Beans</link>."
msgstr "一種溫和的凝乳，由<link=\"BEANPLANTSEED\">小吃豆</link>製作而成。"

#. STRINGS.ITEMS.FOOD.URCHINMEAT.DESC
msgctxt "STRINGS.ITEMS.FOOD.URCHINMEAT.DESC"
msgid "The edible flesh of a <link=\"URCHIN\">Pinpoki</link>.\n\nA rare delicacy whose safe preparation involves destroying the valuable outer spikes."
msgstr "<link=\"URCHIN\">針膽</link>的可食用肉塊。\n\n這是一種極為罕見的珍饈，若要安全地進行處理，必須破壞其外層珍貴的尖刺。"

#. STRINGS.ITEMS.FOOD.URCHINMEAT.NAME
msgctxt "STRINGS.ITEMS.FOOD.URCHINMEAT.NAME"
msgid "<link=\"URCHINMEAT\">Uni</link>"
msgstr "<link=\"URCHINMEAT\">針膽黃</link>"

#. STRINGS.ITEMS.FOOD.URCHINMEAT.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.URCHINMEAT.RECIPEDESC"
msgid "The edible flesh of a <link=\"URCHIN\">Pinpoki</link> prepared at the <link=\"SUSHIBAR\">Sushi Bar</link>."
msgstr "在<link=\"SUSHIBAR\">壽司吧</link>準備的可食用<link=\"URCHIN\">針膽</link>肉。"

#. STRINGS.ITEMS.FOOD.VINEFRUIT.DESC
msgctxt "STRINGS.ITEMS.FOOD.VINEFRUIT.DESC"
msgid "The fruit from an <link=\"VINEMOTHER\">Ovagro Vine</link>.\n\nIt's fun to squeeze as many as possible into a single mouthful."
msgstr "這些果實生長於<link=\"VINEMOTHER\">蔓殖藤</link>。\n\n一口氣塞越多越有趣。"

#. STRINGS.ITEMS.FOOD.VINEFRUIT.NAME
msgctxt "STRINGS.ITEMS.FOOD.VINEFRUIT.NAME"
msgid "<link=\"VINEFRUIT\">Ovagro Fig</link>"
msgstr "<link=\"VINEFRUIT\">蔓殖燈籠果</link>"

#. STRINGS.ITEMS.FOOD.VINEFRUITJAM.DESC
msgctxt "STRINGS.ITEMS.FOOD.VINEFRUITJAM.DESC"
msgid ""
msgstr ""

#. STRINGS.ITEMS.FOOD.VINEFRUITJAM.NAME
msgctxt "STRINGS.ITEMS.FOOD.VINEFRUITJAM.NAME"
msgid "<link=\"VINEFRUITJAM\"></link>"
msgstr "<link=\"VINEFRUITJAM\">蔓殖燈籠果醬</link>"

#. STRINGS.ITEMS.FOOD.VINEFRUITJAM.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.VINEFRUITJAM.RECIPEDESC"
msgid ""
msgstr ""

#. STRINGS.ITEMS.FOOD.WORMBASICFOOD.DESC
msgctxt "STRINGS.ITEMS.FOOD.WORMBASICFOOD.DESC"
msgid "Slow roasted <link=\"WORMBASICFRUIT\">Spindly Grubfruit</link>.\n\nIt has a smoky aroma and tastes of coziness."
msgstr "慢慢烤熟的<link=\"WORMBASICFRUIT\">劣質蟲蜜果</link>。\n\n它有煙燻味且嘗起來可口。"

#. STRINGS.ITEMS.FOOD.WORMBASICFOOD.NAME
msgctxt "STRINGS.ITEMS.FOOD.WORMBASICFOOD.NAME"
msgid "<link=\"WORMBASICFOOD\">Roast Grubfruit Nut</link>"
msgstr "<link=\"WORMBASICFOOD\">烤蟲蜜果</link>"

#. STRINGS.ITEMS.FOOD.WORMBASICFOOD.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.WORMBASICFOOD.RECIPEDESC"
msgid "Slow roasted <link=\"WORMBASICFRUIT\">Spindly Grubfruit</link>."
msgstr "慢慢烤熟的<link=\"WORMBASICFRUIT\">劣質蟲蜜果</link>。"

#. STRINGS.ITEMS.FOOD.WORMBASICFRUIT.DESC
msgctxt "STRINGS.ITEMS.FOOD.WORMBASICFRUIT.DESC"
msgid "A <link=\"WORMSUPERFRUIT\">Grubfruit</link> that failed to develop properly.\n\nIt is nonetheless edible, and vaguely tasty."
msgstr "發育不良的<link=\"WORMSUPERFRUIT\">蟲蜜果</link>。\n\n還是可以吃，但沒什麼味道。"

#. STRINGS.ITEMS.FOOD.WORMBASICFRUIT.NAME
msgctxt "STRINGS.ITEMS.FOOD.WORMBASICFRUIT.NAME"
msgid "<link=\"WORMBASICFRUIT\">Spindly Grubfruit</link>"
msgstr "<link=\"WORMBASICFRUIT\">劣質蟲蜜果</link>"

#. STRINGS.ITEMS.FOOD.WORMSUPERFOOD.DESC
msgctxt "STRINGS.ITEMS.FOOD.WORMSUPERFOOD.DESC"
msgid "A long lasting <link=\"WORMSUPERFRUIT\">Grubfruit</link> jam preserved in <link=\"SUCROSE\">Sucrose</link>.\n\nThe thick, goopy jam retains the shape of the jar when poured out, but the sweet taste can't be matched."
msgstr "用<link=\"SUCROSE\">蔗糖</link>長期保存的<link=\"WORMSUPERFRUIT\">蟲蜜果</link>果醬\n\n這濃稠黏膩的果醬倒出時仍能保持罐子的形狀，其甜味無與倫比。"

#. STRINGS.ITEMS.FOOD.WORMSUPERFOOD.NAME
msgctxt "STRINGS.ITEMS.FOOD.WORMSUPERFOOD.NAME"
msgid "<link=\"WORMSUPERFOOD\">Grubfruit Preserve</link>"
msgstr "<link=\"WORMSUPERFOOD\">蟲蜜果醬</link>"

#. STRINGS.ITEMS.FOOD.WORMSUPERFOOD.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.WORMSUPERFOOD.RECIPEDESC"
msgid "A long lasting <link=\"WORMSUPERFRUIT\">Grubfruit</link> jam preserved in <link=\"SUCROSE\">Sucrose</link>."
msgstr "用<link=\"SUCROSE\">蔗糖</link>製作，可長時間保存的<link=\"WORMSUPERFRUIT\">蟲蜜果</link>罐頭。"

#. STRINGS.ITEMS.FOOD.WORMSUPERFRUIT.DESC
msgctxt "STRINGS.ITEMS.FOOD.WORMSUPERFRUIT.DESC"
msgid "A plump, healthy fruit with a honey-like taste."
msgstr "一顆飽滿、健康的果實嘗起來像蜂蜜。"

#. STRINGS.ITEMS.FOOD.WORMSUPERFRUIT.NAME
msgctxt "STRINGS.ITEMS.FOOD.WORMSUPERFRUIT.NAME"
msgid "<link=\"WORMSUPERFRUIT\">Grubfruit</link>"
msgstr "<link=\"WORMSUPERFRUIT\">蟲蜜果</link>"

