msgctxt "STRINGS.DUPLICANTS.TRAITS.IRRITABLEBOWEL.DESC"
msgid "This Duplicant needs a little extra time to \"do their business\""
msgstr "這名複製人需要比平常更長的時間來「上廁所」"

#. STRINGS.DUPLICANTS.TRAITS.IRRITABLEBOWEL.NAME
msgctxt "STRINGS.DUPLICANTS.TRAITS.IRRITABLEBOWEL.NAME"
msgid "Irritable Bowel"
msgstr "腸躁症"

#. STRINGS.DUPLICANTS.TRAITS.LONER.DESC
msgctxt "STRINGS.DUPLICANTS.TRAITS.LONER.DESC"
msgid "This Duplicant prefers solitary pursuits"
msgstr "這名複製人更喜歡追求獨自一人"

#. STRINGS.DUPLICANTS.TRAITS.LONER.NAME
msgctxt "STRINGS.DUPLICANTS.TRAITS.LONER.NAME"
msgid "Loner"
msgstr "獨行俠"

#. STRINGS.DUPLICANTS.TRAITS.LONER.SHORT_DESC
msgctxt "STRINGS.DUPLICANTS.TRAITS.LONER.SHORT_DESC"
msgid "Attribute bonuses while alone"
msgstr "獨處時的屬性加成"

#. STRINGS.DUPLICANTS.TRAITS.LONER.SHORT_DESC_TOOLTIP
msgctxt "STRINGS.DUPLICANTS.TRAITS.LONER.SHORT_DESC_TOOLTIP"
msgid "Only Duplicant on a world: <b>+4</b> bonus to all <style=\"KKeyword\">Attributes</style>"
msgstr "世界中僅有一位複製人時：全部<style=\"KKeyword\">屬性</style> <b>+4</b>"

#. STRINGS.DUPLICANTS.TRAITS.MACHINERYDOWN.DESC
msgctxt "STRINGS.DUPLICANTS.TRAITS.MACHINERYDOWN.DESC"
msgid "This Duplicant always invites friends over just to make them hook up their electronics"
msgstr "這名複製人總是邀請朋友們，只是為了讓他們幫忙連接電子設備"

#. STRINGS.DUPLICANTS.TRAITS.MACHINERYDOWN.NAME
msgctxt "STRINGS.DUPLICANTS.TRAITS.MACHINERYDOWN.NAME"
msgid "Luddite"
msgstr "盧德主義者"

#. STRINGS.DUPLICANTS.TRAITS.METEORPHILE.DESC
msgctxt "STRINGS.DUPLICANTS.TRAITS.METEORPHILE.DESC"
msgid "Meteor showers get this Duplicant really, really hyped"
msgstr "流星雨真的會讓這名複製人十分激動"

#. STRINGS.DUPLICANTS.TRAITS.METEORPHILE.EXTENDED_DESC
msgctxt "STRINGS.DUPLICANTS.TRAITS.METEORPHILE.EXTENDED_DESC"
msgid "• During meteor showers: <b>{0}</b> bonus to all <style=\"KKeyword\">Attributes</style>"
msgstr "• 流星雨期間：全部<style=\"KKeyword\">屬性</style><b>{0}</b>"

#. STRINGS.DUPLICANTS.TRAITS.METEORPHILE.NAME
msgctxt "STRINGS.DUPLICANTS.TRAITS.METEORPHILE.NAME"
msgid "Rock Fan"
msgstr "岩石迷"

#. STRINGS.DUPLICANTS.TRAITS.METEORPHILE.SHORT_DESC
msgctxt "STRINGS.DUPLICANTS.TRAITS.METEORPHILE.SHORT_DESC"
msgid "Gains Attribute bonuses during meteor showers."
msgstr "流星雨期間會有屬性加成。"

#. STRINGS.DUPLICANTS.TRAITS.METEORPHILE.SHORT_DESC_TOOLTIP
msgctxt "STRINGS.DUPLICANTS.TRAITS.METEORPHILE.SHORT_DESC_TOOLTIP"
msgid "During meteor showers: <b>+3</b> bonus to all <style=\"KKeyword\">Attributes</style>"
msgstr "流星雨期間：全部<style=\"KKeyword\">屬性</style> <b>+3</b>"

#. STRINGS.DUPLICANTS.TRAITS.MOLEHANDS.DESC
msgctxt "STRINGS.DUPLICANTS.TRAITS.MOLEHANDS.DESC"
msgid "They're great for tunneling, but finding good gloves is a nightmare"
msgstr "這雙手對挖掘隧道有莫大幫助，但找到合適的手套卻極度困難"

#. STRINGS.DUPLICANTS.TRAITS.MOLEHANDS.NAME
msgctxt "STRINGS.DUPLICANTS.TRAITS.MOLEHANDS.NAME"
msgid "Mole Hands"
msgstr "田鼠手"

#. STRINGS.DUPLICANTS.TRAITS.MOUTHBREATHER.DESC
msgctxt "STRINGS.DUPLICANTS.TRAITS.MOUTHBREATHER.DESC"
msgid "This Duplicant sucks up way more than their fair share of <link=\"OXYGEN\">Oxygen</link>"
msgstr "這名複製人消耗更多的<link=\"OXYGEN\">氧氣</link>"

#. STRINGS.DUPLICANTS.TRAITS.MOUTHBREATHER.NAME
msgctxt "STRINGS.DUPLICANTS.TRAITS.MOUTHBREATHER.NAME"
msgid "Mouth Breather"
msgstr "用嘴呼吸"

#. STRINGS.DUPLICANTS.TRAITS.NARCOLEPSY.DESC
msgctxt "STRINGS.DUPLICANTS.TRAITS.NARCOLEPSY.DESC"
msgid "This Duplicant can and will fall asleep anytime, anyplace"
msgstr "這名複製人可以在任何時間、任何地點睡覺"

#. STRINGS.DUPLICANTS.TRAITS.NARCOLEPSY.NAME
msgctxt "STRINGS.DUPLICANTS.TRAITS.NARCOLEPSY.NAME"
msgid "Narcoleptic"
msgstr "嗜睡症"

#. STRINGS.DUPLICANTS.TRAITS.NARCOLEPSY.SHORT_DESC
msgctxt "STRINGS.DUPLICANTS.TRAITS.NARCOLEPSY.SHORT_DESC"
msgid "Falls asleep periodically"
msgstr "週期性地睡著"

#. STRINGS.DUPLICANTS.TRAITS.NARCOLEPSY.SHORT_DESC_TOOLTIP
msgctxt "STRINGS.DUPLICANTS.TRAITS.NARCOLEPSY.SHORT_DESC_TOOLTIP"
msgid "This Duplicant's work will be periodically interrupted by naps"
msgstr "這名複製人的工作將會被週期性的小睡打斷"

#. STRINGS.DUPLICANTS.TRAITS.NEEDS.CLAUSTROPHOBIC.DESC
msgctxt "STRINGS.DUPLICANTS.TRAITS.NEEDS.CLAUSTROPHOBIC.DESC"
