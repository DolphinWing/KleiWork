msgstr "<link=\"ARTWIDEE\">看吶，一把叉子</link>"

#. STRINGS.BUILDINGS.PREFABS.CANVASWIDE.FACADES.ART_WIDE_F.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.CANVASWIDE.FACADES.ART_WIDE_F.DESC"
