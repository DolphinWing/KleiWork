msgstr "這名複製人<style=\"KKeyword\">樂歪了</style>時會留下一串歡樂閃光"

#. STRINGS.DUPLICANTS.TRAITS.SPARKLESTREAKER.NAME
msgctxt "STRINGS.DUPLICANTS.TRAITS.SPARKLESTREAKER.NAME"
msgid "Sparkle Streaker"
msgstr "閃閃發光"

#. STRINGS.DUPLICANTS.TRAITS.STARRYEYED.DESC
msgctxt "STRINGS.DUPLICANTS.TRAITS.STARRYEYED.DESC"
msgid "This Duplicant loves being in space"
msgstr "這名複製人喜愛在太空中"

#. STRINGS.DUPLICANTS.TRAITS.STARRYEYED.NAME
msgctxt "STRINGS.DUPLICANTS.TRAITS.STARRYEYED.NAME"
msgid "Starry Eyed"
msgstr "星光閃閃"

#. STRINGS.DUPLICANTS.TRAITS.STARRYEYED.SHORT_DESC
msgctxt "STRINGS.DUPLICANTS.TRAITS.STARRYEYED.SHORT_DESC"
msgid "Morale bonus while in space"
msgstr "在太空中時的士氣加成"

#. STRINGS.DUPLICANTS.TRAITS.STARRYEYED.SHORT_DESC_TOOLTIP
msgctxt "STRINGS.DUPLICANTS.TRAITS.STARRYEYED.SHORT_DESC_TOOLTIP"
msgid "In outer space: <b>+10</b> <style=\"KKeyword\">Morale</style>"
msgstr "在外太空：<b>+10</b> <style=\"KKeyword\">士氣</style>"

#. STRINGS.DUPLICANTS.TRAITS.STARTING_BIONIC_BOOSTER_SHARED_DESC_TOOLTIP
msgctxt "STRINGS.DUPLICANTS.TRAITS.STARTING_BIONIC_BOOSTER_SHARED_DESC_TOOLTIP"
