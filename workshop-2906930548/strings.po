#. STRINGS.ITEMS.INDUSTRIAL_PRODUCTS.PLASTIC_GASKET.DESC
msgctxt "STRINGS.ITEMS.INDUSTRIAL_PRODUCTS.PLASTIC_GASKET.DESC"
msgid "A flexible <link=\"POLYPROPYLENE\">Plastic</link> seal, made at the <link=\"CRAFTINGTABLE\">Crafting Station</link>.\n\nPrevents unwanted <link=\"ELEMENTSLIQUID\">Liquid</link> leakage."
msgstr "一種由<link=\"CRAFTINGTABLE\">工藝台</link>製作，具備彈性的<link=\"POLYPROPYLENE\">塑膠</link>密封墊。\n\n用於防止不必要的<link=\"ELEMENTSLIQUID\">液體</link>洩漏。"

#. STRINGS.ITEMS.INDUSTRIAL_PRODUCTS.PLASTIC_GASKET.NAME
msgctxt "STRINGS.ITEMS.INDUSTRIAL_PRODUCTS.PLASTIC_GASKET.NAME"
msgid "<link=\"PLASTICGASKET\">Plastic Gasket</link>"
msgstr "<link=\"PLASTICGASKET\">塑膠密封墊</link>"

#. STRINGS.ITEMS.INDUSTRIAL_PRODUCTS.POWER_STATION_TOOLS.DESC
msgctxt "STRINGS.ITEMS.INDUSTRIAL_PRODUCTS.POWER_STATION_TOOLS.DESC"
msgid "A specialized <link=\"POWERSTATIONTOOLS\">Microchip</link> created by a professional engineer.\n\nTunes up <link=\"REQUIREMENTCLASSGENERATORTYPE\">Generators</link> to increase their <link=\"POWER\">Power</link> output.\n\nAlso used in the production of <link=\"BOOSTER\">Boosters</link> for Bionic Duplicants."
msgstr "由專業工程師製造專用的<link=\"POWERSTATIONTOOLS\">微晶片</link>。\n\n用於檢修保養<link=\"REQUIREMENTCLASSGENERATORTYPE\">發電機</link>以增加它們的<link=\"POWER\">電力</link>輸出。\n\n也用於生產給仿生複製人使用的<link=\"BOOSTER\">增效卡匣</link>。"

#. STRINGS.ITEMS.INDUSTRIAL_PRODUCTS.POWER_STATION_TOOLS.NAME
msgctxt "STRINGS.ITEMS.INDUSTRIAL_PRODUCTS.POWER_STATION_TOOLS.NAME"
msgid "<link=\"POWERSTATIONTOOLS\">Microchip</link>"
msgstr "<link=\"POWERSTATIONTOOLS\">微晶片</link>"

#. STRINGS.ITEMS.INDUSTRIAL_PRODUCTS.POWER_STATION_TOOLS.RECIPE_DESCRIPTION
msgctxt "STRINGS.ITEMS.INDUSTRIAL_PRODUCTS.POWER_STATION_TOOLS.RECIPE_DESCRIPTION"
msgid "Make <link=\"POWERSTATIONTOOLS\">Microchip</link> from {0}"
msgstr "使用{0}製作<link=\"POWERSTATIONTOOLS\">微晶片</link>"

#. STRINGS.ITEMS.INDUSTRIAL_PRODUCTS.POWER_STATION_TOOLS.TINKER_EFFECT_NAME
msgctxt "STRINGS.ITEMS.INDUSTRIAL_PRODUCTS.POWER_STATION_TOOLS.TINKER_EFFECT_NAME"
msgid "Engie's Tune-Up: {0} {1}"
msgstr "優化調整：{0} {1}"

#. STRINGS.ITEMS.INDUSTRIAL_PRODUCTS.POWER_STATION_TOOLS.TINKER_EFFECT_TOOLTIP
msgctxt "STRINGS.ITEMS.INDUSTRIAL_PRODUCTS.POWER_STATION_TOOLS.TINKER_EFFECT_TOOLTIP"
msgid "Can be used to <style=\"KKeyword\">Tune Up</style> a generator, increasing its {0} by <b>{1}</b>."
msgstr "用於<style=\"KKeyword\">檢修保養</style>發電機，藉由<b>{1}</b>增加{0}"

#. STRINGS.ITEMS.INDUSTRIAL_PRODUCTS.POWER_STATION_TOOLS.TINKER_REQUIREMENT_NAME
msgctxt "STRINGS.ITEMS.INDUSTRIAL_PRODUCTS.POWER_STATION_TOOLS.TINKER_REQUIREMENT_NAME"
msgid "Skill: <link=\"TECHNICALS2\">Electrical Engineering</link>"
msgstr "技能：<link=\"TECHNICALS2\">電氣工程</link>"

#. STRINGS.ITEMS.INDUSTRIAL_PRODUCTS.POWER_STATION_TOOLS.TINKER_REQUIREMENT_TOOLTIP
msgctxt "STRINGS.ITEMS.INDUSTRIAL_PRODUCTS.POWER_STATION_TOOLS.TINKER_REQUIREMENT_TOOLTIP"
msgid "Can only be used by a Duplicant with <link=\"TECHNICALS2\">Electrical Engineering</link> to apply a <style=\"KKeyword\">Tune Up</style>."
msgstr "只有學會<link=\"TECHNICALS2\">電氣工程</link>的複製人，能進行<style=\"KKeyword\">檢修保養</style>。"

#. STRINGS.ITEMS.INDUSTRIAL_PRODUCTS.REFINED_SUGAR.DESC
msgctxt "STRINGS.ITEMS.INDUSTRIAL_PRODUCTS.REFINED_SUGAR.DESC"
msgid "A seasoning that Duplicants can add to their <link=\"FOOD\">Food</link> to boost <link=\"MORALE\">Morale</link>.\n\nDuplicants will automatically use Refined Sugar while sitting at a <link=\"DININGTABLE\">Mess Table</link> during mealtime.\n\n<i>Only the finest grains are chosen.</i>"
msgstr "一種調味料，複製人可加到他們的<link=\"FOOD\">食物</link>中，可提升<link=\"MORALE\">士氣</link>。\n\n複製人在<link=\"DININGTABLE\">單人餐桌</link>用餐時會使用精製糖。\n\n<b>精選最好的顆粒。</b>"

#. STRINGS.ITEMS.INDUSTRIAL_PRODUCTS.REFINED_SUGAR.NAME
msgctxt "STRINGS.ITEMS.INDUSTRIAL_PRODUCTS.REFINED_SUGAR.NAME"
msgid "Refined Sugar"
msgstr "精製糖"

#. STRINGS.ITEMS.INDUSTRIAL_PRODUCTS.RESEARCH_DATABANK.DESC
msgctxt "STRINGS.ITEMS.INDUSTRIAL_PRODUCTS.RESEARCH_DATABANK.DESC"
msgid "Raw data that can be processed into <link=\"RESEARCH\">Interstellar Research</link> points."
msgstr "原始資料可被處理變成<link=\"RESEARCH\">星際研究</link>點數。"

#. STRINGS.ITEMS.INDUSTRIAL_PRODUCTS.RESEARCH_DATABANK.NAME
msgctxt "STRINGS.ITEMS.INDUSTRIAL_PRODUCTS.RESEARCH_DATABANK.NAME"
msgid "<link=\"DATABANK\">Data Bank</link>"
msgstr "<link=\"DATABANK\">資料磁片</link>"

#. STRINGS.ITEMS.INDUSTRIAL_PRODUCTS.RESEARCH_DATABANK.NAME_PLURAL
msgctxt "STRINGS.ITEMS.INDUSTRIAL_PRODUCTS.RESEARCH_DATABANK.NAME_PLURAL"
msgid "<link=\"DATABANK\">Data Banks</link>"
msgstr "<link=\"DATABANK\">資料磁片</link>"

#. STRINGS.ITEMS.INDUSTRIAL_PRODUCTS.RUBBER_GASKET.DESC
msgctxt "STRINGS.ITEMS.INDUSTRIAL_PRODUCTS.RUBBER_GASKET.DESC"
msgid "A flexible <link=\"RUBBER\">Rubber</link> seal, made at the <link=\"CRAFTINGTABLE\">Crafting Station</link>.\n\nPrevents unwanted <link=\"ELEMENTSLIQUID\">Liquid</link> leakage."
msgstr "一種由<link=\"CRAFTINGTABLE\">工藝台</link>製作，具備彈性的<link=\"RUBBER\">橡膠</link>密封墊。\n\n用於防止不必要的<link=\"ELEMENTSLIQUID\">液體</link>洩漏。"

#. STRINGS.ITEMS.INDUSTRIAL_PRODUCTS.RUBBER_GASKET.NAME
msgctxt "STRINGS.ITEMS.INDUSTRIAL_PRODUCTS.RUBBER_GASKET.NAME"
msgid "<link=\"RUBBERGASKET\">Rubber Gasket</link>"
msgstr "<link=\"RUBBERGASKET\">橡膠密封墊</link>"

#. STRINGS.ITEMS.INDUSTRIAL_PRODUCTS.SNAIL_IRON_SHELL.DESC
msgctxt "STRINGS.ITEMS.INDUSTRIAL_PRODUCTS.SNAIL_IRON_SHELL.DESC"
msgid "Can be crushed to produce <link=\"GOLDAMALGAM\">Gold Amalgam</link>."
msgstr "可經由粉碎加工生產<link=\"GOLDAMALGAM\">金汞齊</link>。"

#. STRINGS.ITEMS.INDUSTRIAL_PRODUCTS.SNAIL_IRON_SHELL.NAME
msgctxt "STRINGS.ITEMS.INDUSTRIAL_PRODUCTS.SNAIL_IRON_SHELL.NAME"
msgid "<link=\"SNAILIRONSHELL\">Gildgo Molt</link>"
msgstr "<link=\"SNAILIRONSHELL\">金曜螺殼</link>"

#. STRINGS.ITEMS.INDUSTRIAL_PRODUCTS.SNAIL_SHELL.DESC
msgctxt "STRINGS.ITEMS.INDUSTRIAL_PRODUCTS.SNAIL_SHELL.DESC"
msgid "Can be crushed to produce <link=\"LIME\">Lime</link>."
msgstr "可粉碎成<link=\"LIME\">石灰</link>。"

#. STRINGS.ITEMS.INDUSTRIAL_PRODUCTS.SNAIL_SHELL.NAME
msgctxt "STRINGS.ITEMS.INDUSTRIAL_PRODUCTS.SNAIL_SHELL.NAME"
msgid "<link=\"SNAILSHELL\">Slogo Molt</link>"
msgstr "<link=\"SNAILSHELL\">緩螺殼</link>"

#. STRINGS.ITEMS.INDUSTRIAL_PRODUCTS.TABLE_SALT.DESC
msgctxt "STRINGS.ITEMS.INDUSTRIAL_PRODUCTS.TABLE_SALT.DESC"
msgid "A seasoning that Duplicants can add to their <link=\"FOOD\">Food</link> to boost <link=\"MORALE\">Morale</link>.\n\nDuplicants will automatically use Table Salt while sitting at a <link=\"DININGTABLE\">Mess Table</link> during mealtime.\n\n<i>Only the finest grains are chosen.</i>"
msgstr "一種調味料，複製人可加到他們的<link=\"FOOD\">食物</link>中，可提升<link=\"MORALE\">士氣</link>。\n\n複製人在<link=\"DININGTABLE\">單人餐桌</link>用餐時會使用食鹽。\n\n<b>精選最好的顆粒。</b>"

#. STRINGS.ITEMS.INDUSTRIAL_PRODUCTS.TABLE_SALT.NAME
msgctxt "STRINGS.ITEMS.INDUSTRIAL_PRODUCTS.TABLE_SALT.NAME"
msgid "<link=\"IDTABLESALT\">Table Salt</link>"
msgstr "<link=\"IDTABLESALT\">食鹽</link>"

#. STRINGS.ITEMS.INDUSTRIAL_PRODUCTS.TRAP_PARTS.DESC
msgctxt "STRINGS.ITEMS.INDUSTRIAL_PRODUCTS.TRAP_PARTS.DESC"
msgid "These components can be assembled into a <link=\"CREATURETRAP\">Critter Trap</link> and used to catch <link=\"CREATURES\">Critters</link>."
msgstr "這些零件能組成<link=\"CREATURETRAP\">動物陷阱</link>並用來捕捉<link=\"CREATURES\">小動物</link>。"

#. STRINGS.ITEMS.INDUSTRIAL_PRODUCTS.TRAP_PARTS.NAME
msgctxt "STRINGS.ITEMS.INDUSTRIAL_PRODUCTS.TRAP_PARTS.NAME"
msgid "Trap Components"
msgstr "陷阱組件"

#. STRINGS.ITEMS.INDUSTRIAL_PRODUCTS.URCHIN.DESC
msgctxt "STRINGS.ITEMS.INDUSTRIAL_PRODUCTS.URCHIN.DESC"
msgid "Pinpoki are aquatic organisms grown in <link=\"URCHINPLANT\">Pinpokets</link>.\n\nThey can be processed into <link=\"DIAMOND\">Diamond</link> or <link=\"URCHINMEAT\">Uni</link>, or used as <link=\"DECOR\">Decor</link>."
msgstr "針膽是生長在<link=\"URCHINPLANT\">針膽團</link>中的水生生物。\n\n它可以被加工為<link=\"DIAMOND\">鑽石</link>或<link=\"URCHINMEAT\">針膽黃</link>，或是作為<link=\"DECOR\">裝飾物</link>進行擺放。"

#. STRINGS.ITEMS.INDUSTRIAL_PRODUCTS.URCHIN.NAME
msgctxt "STRINGS.ITEMS.INDUSTRIAL_PRODUCTS.URCHIN.NAME"
msgid "<link=\"URCHIN\">Pinpoki</link>"
msgstr "<link=\"URCHIN\">針膽</link>"

#. STRINGS.ITEMS.INDUSTRIAL_PRODUCTS.WOOD.DESC
msgctxt "STRINGS.ITEMS.INDUSTRIAL_PRODUCTS.WOOD.DESC"
msgid "Natural resource harvested from certain <link=\"CREATURES\">Critters</link> and <link=\"PLANTS\">Plants</link>.\n\nUsed in construction or <link=\"HEAT\">Heat</link> production."
msgstr "從某些<link=\"CREATURES\">小動物</link>和<link=\"PLANTS\">植物</link>上收穫來的自然資源。\n\n用於建造或<link=\"HEAT\">熱量</link>生產。"

#. STRINGS.ITEMS.INDUSTRIAL_PRODUCTS.WOOD.NAME
msgctxt "STRINGS.ITEMS.INDUSTRIAL_PRODUCTS.WOOD.NAME"
msgid "<link=\"WOOD\">Wood</link>"
msgstr "<link=\"WOOD\">木材</link>"

#. STRINGS.ITEMS.INGREDIENTS.GINGER.DESC
msgctxt "STRINGS.ITEMS.INGREDIENTS.GINGER.DESC"
msgid "A chewy, fibrous rhizome with a fiery aftertaste."
msgstr "一種有嚼勁、纖維狀的根莖，帶有火辣的口感。\n\n它可以緩解脹氣。"

#. STRINGS.ITEMS.INGREDIENTS.GINGER.NAME
msgctxt "STRINGS.ITEMS.INGREDIENTS.GINGER.NAME"
msgid "<link=\"GINGERCONFIG\">Tonic Root</link>"
msgstr "<link=\"GINGERCONFIG\">辛香根</link>"

#. STRINGS.ITEMS.INGREDIENTS.KELP.DESC
msgctxt "STRINGS.ITEMS.INGREDIENTS.KELP.DESC"
msgid "The leaf of a <link=\"KELPPLANT\">Seakomb</link>.\n\nIt can be processed into <link=\"PHYTOOIL\">Phyto Oil</link> or used as an ingredient in <link=\"ANTIHISTAMINE\">Allergy Medication</link>."
msgstr "<link=\"KELPPLANT\">海梳蕨</link>的葉子。\n\n它可以加工成<link=\"PHYTOOIL\">植物油</link>，或作為<link=\"ANTIHISTAMINE\">抗過敏藥</link>的成分。"

#. STRINGS.ITEMS.INGREDIENTS.KELP.NAME
msgctxt "STRINGS.ITEMS.INGREDIENTS.KELP.NAME"
msgid "<link=\"KELP\">Seakomb Leaf</link>"
msgstr "<link=\"KELP\">海梳葉</link>"

#. STRINGS.ITEMS.INGREDIENTS.SWAMPLILYFLOWER.DESC
msgctxt "STRINGS.ITEMS.INGREDIENTS.SWAMPLILYFLOWER.DESC"
msgid "A medicinal flower that soothes most minor maladies.\n\nIt is exceptionally fragrant."
msgstr "一種藥用花朵，可治療大部分的輕微疾病。\n\n它特別香。"

#. STRINGS.ITEMS.INGREDIENTS.SWAMPLILYFLOWER.NAME
msgctxt "STRINGS.ITEMS.INGREDIENTS.SWAMPLILYFLOWER.NAME"
msgid "<link=\"SWAMPLILYFLOWER\">Balm Lily Flower</link>"
msgstr "<link=\"SWAMPLILYFLOWER\">香水百合</link>"

#. STRINGS.ITEMS.LUBRICATIONSTICK.DESC
msgctxt "STRINGS.ITEMS.LUBRICATIONSTICK.DESC"
msgid "Provides a small amount of lubricating <link=\"LUBRICATINGOIL\">Gear Oil</link>.\n\nCan be produced at the <link=\"APOTHECARY\">Apothecary</link>."
msgstr "提供少量的潤滑<link=\"LUBRICATINGOIL\">齒輪油</link>。\n\n可以在<link=\"APOTHECARY\">製藥桌</link>生產。"

#. STRINGS.ITEMS.LUBRICATIONSTICK.NAME
msgctxt "STRINGS.ITEMS.LUBRICATIONSTICK.NAME"
msgid "<link=\"LUBRICATIONSTICK\">Gear Balm</link>"
msgstr "<link=\"LUBRICATIONSTICK\">齒輪膏</link>"

#. STRINGS.ITEMS.LUBRICATIONSTICK.RECIPEDESC
msgctxt "STRINGS.ITEMS.LUBRICATIONSTICK.RECIPEDESC"
msgid "A self-administered mechanical lubricant for Duplicants with bionic parts."
msgstr "一種用於具有仿生部件的複製人的自主管理機械潤滑劑。"

#. STRINGS.ITEMS.LUBRICATIONSTICK.SUBHEADER
msgctxt "STRINGS.ITEMS.LUBRICATIONSTICK.SUBHEADER"
msgid "Mechanical Lubricant"
msgstr "機械潤滑油"

#. STRINGS.ITEMS.MISSILE_BASIC.DESC
msgctxt "STRINGS.ITEMS.MISSILE_BASIC.DESC"
msgid "An explosive projectile designed to defend against meteor showers.\n\nMust be launched by a <link=\"MISSILELAUNCHER\">Meteor Blaster</link>."
msgstr "一種爆炸性彈道體，用於抵禦流星雨。\n\n必須透過<link=\"MISSILELAUNCHER\">流星爆破炮</link>發射。"

#. STRINGS.ITEMS.MISSILE_BASIC.NAME
msgctxt "STRINGS.ITEMS.MISSILE_BASIC.NAME"
msgid "<link=\"MISSILEBASIC\">Blastshot</link>"
msgstr "<link=\"MISSILEBASIC\">爆破彈</link>"

#. STRINGS.ITEMS.MISSILE_LONGRANGE.DESC
msgctxt "STRINGS.ITEMS.MISSILE_LONGRANGE.DESC"
msgid "A long-range explosive projectile that defends against distant space objects.\n\nMust be launched by <link=\"MISSILELAUNCHER\">Meteor Blaster</link>."
msgstr "一種長程爆炸性投射物，用於抵禦遠處的太空物體。\n\n必須透過<link=\"MISSILELAUNCHER\">流星爆破炮</link>發射。"

#. STRINGS.ITEMS.MISSILE_LONGRANGE.NAME
msgctxt "STRINGS.ITEMS.MISSILE_LONGRANGE.NAME"
msgid "<link=\"MISSILELONGRANGE\">Intracosmic Blastshot</link>"
msgstr "<link=\"MISSILELONGRANGE\">星際爆破彈</link>"

#. STRINGS.ITEMS.MISSILE_LONGRANGE_VANILLADLC4.DESC
msgctxt "STRINGS.ITEMS.MISSILE_LONGRANGE_VANILLADLC4.DESC"
msgid "A long-range explosive projectile that defends against distant space objects.\n\nMust be launched by <link=\"MISSILELAUNCHER\">Meteor Blaster</link>."
msgstr "一種長程爆炸性投射物，用於抵禦遠處的太空物體。\n\n必須透過<link=\"MISSILELAUNCHER\">流星爆破炮</link>發射。"

#. STRINGS.ITEMS.MISSILE_LONGRANGE_VANILLADLC4.NAME
msgctxt "STRINGS.ITEMS.MISSILE_LONGRANGE_VANILLADLC4.NAME"
msgid "<link=\"MISSILELONGRANGEVANILLADLC4\">Intracosmic Blastshot</link>"
msgstr "<link=\"MISSILELAUNCHER\">星際爆破彈</link>"

#. STRINGS.ITEMS.PILLS.ADVANCEDCURE.DESC
msgctxt "STRINGS.ITEMS.PILLS.ADVANCEDCURE.DESC"
msgid "A doctor-administered cure for severe ailments."
msgstr "醫生治療嚴重疾病的物品。"

#. STRINGS.ITEMS.PILLS.ADVANCEDCURE.NAME
msgctxt "STRINGS.ITEMS.PILLS.ADVANCEDCURE.NAME"
msgid "<link=\"ADVANCEDCURE\">Serum Vial</link>"
msgstr "<link=\"ADVANCEDCURE\">血清瓶</link>"

#. STRINGS.ITEMS.PILLS.ADVANCEDCURE.RECIPEDESC
msgctxt "STRINGS.ITEMS.PILLS.ADVANCEDCURE.RECIPEDESC"
msgid "An extremely powerful medication created to treat severe <link=\"DISEASE\">Diseases</link>. <link=\"ADVANCEDCURE\">Serum Vial</link> is very effective against <link=\"ZOMBIESPORES\">Zombie Spores</link>.\n\nMust be administered by a Duplicant with the <link=\"MEDICINE3\">Advanced Medical Care</link> Skill."
msgstr "一種極其強效的藥物，用於治療嚴重的<link=\"DISEASE\">疾病</link>。<link=\"ADVANCEDCURE\">血清瓶</link>用來治療<link=\"ZOMBIESPORES\">殭屍病毒</link>非常有效。\n\n複製人必須有<link=\"MEDICINE3\">進階醫療照顧</link>技能才能製作。"

#. STRINGS.ITEMS.PILLS.ANTIHISTAMINE.DESC
msgctxt "STRINGS.ITEMS.PILLS.ANTIHISTAMINE.DESC"
msgid "Suppresses and prevents allergic reactions."
msgstr "抑制和預防過敏反應。"

#. STRINGS.ITEMS.PILLS.ANTIHISTAMINE.NAME
msgctxt "STRINGS.ITEMS.PILLS.ANTIHISTAMINE.NAME"
msgid "<link=\"ANTIHISTAMINE\">Allergy Medication</link>"
msgstr "<link=\"ANTIHISTAMINE\">抗過敏藥</link>"

#. STRINGS.ITEMS.PILLS.ANTIHISTAMINE.RECIPEDESC
msgctxt "STRINGS.ITEMS.PILLS.ANTIHISTAMINE.RECIPEDESC"
msgid "A strong antihistamine Duplicants can take to halt an allergic reaction. <link=\"ANTIHISTAMINE\">Allergy Medication</link> will also prevent further reactions from occurring for a short time after ingestion."
msgstr "強效抗過敏藥，可治療複製人的過敏反應。<link=\"ANTIHISTAMINE\">抗過敏藥</link>在服用後，也可以在短時間內預防進一步的過敏反應。"

#. STRINGS.ITEMS.PILLS.BASICBOOSTER.DESC
msgctxt "STRINGS.ITEMS.PILLS.BASICBOOSTER.DESC"
msgid "Minorly reduces the chance of becoming sick."
msgstr "稍微減少生病的機率。"

#. STRINGS.ITEMS.PILLS.BASICBOOSTER.NAME
msgctxt "STRINGS.ITEMS.PILLS.BASICBOOSTER.NAME"
msgid "<link=\"BASICBOOSTER\">Vitamin Chews</link>"
msgstr "<link=\"BASICBOOSTER\">維生素咀嚼錠</link>"

#. STRINGS.ITEMS.PILLS.BASICBOOSTER.RECIPEDESC
msgctxt "STRINGS.ITEMS.PILLS.BASICBOOSTER.RECIPEDESC"
msgid "A supplement that minorly reduces the chance of contracting a <style=\"KKeyword\">Germ</style>-based <link=\"DISEASE\">Disease</link>.\n\nMust be taken daily."
msgstr "一種能輕微降低感染<style=\"KKeyword\">病菌</style>性<link=\"DISEASE\">疾病</link>機率的補充劑。\n\n必須每日服用。"

#. STRINGS.ITEMS.PILLS.BASICCURE.DESC
msgctxt "STRINGS.ITEMS.PILLS.BASICCURE.DESC"
msgid "A simple, easy-to-take remedy for minor germ-based diseases."
msgstr "簡單、輕鬆的治療輕微的病菌類疾病。"

#. STRINGS.ITEMS.PILLS.BASICCURE.NAME
msgctxt "STRINGS.ITEMS.PILLS.BASICCURE.NAME"
msgid "<link=\"BASICCURE\">Curative Tablet</link>"
msgstr "<link=\"BASICCURE\">治療藥片</link>"

#. STRINGS.ITEMS.PILLS.BASICCURE.RECIPEDESC
msgctxt "STRINGS.ITEMS.PILLS.BASICCURE.RECIPEDESC"
msgid "Duplicants can take this to cure themselves of minor <style=\"KKeyword\">Germ</style>-based <link=\"DISEASE\">Diseases</link>.\n\nCurative Tablets are very effective against <link=\"FOODPOISONING\">Food Poisoning</link>."
msgstr "複製人可以服用此藥以治癒輕微的<style=\"KKeyword\">病菌</style>性<link=\"DISEASE\">疾病</link>。\n\n治療藥片對抗<link=\"FOODSICKNESS\">腸病毒</link>非常有效。"

#. STRINGS.ITEMS.PILLS.BASICRADPILL.DESC
msgctxt "STRINGS.ITEMS.PILLS.BASICRADPILL.DESC"
msgid "Increases a Duplicant's natural radiation absorption rate."
msgstr "加快複製人的自然輻射吸收率。"

#. STRINGS.ITEMS.PILLS.BASICRADPILL.NAME
msgctxt "STRINGS.ITEMS.PILLS.BASICRADPILL.NAME"
msgid "<link=\"BASICRADPILL\">Basic Rad Pill</link>"
msgstr "<link=\"BASICRADPILL\">基本輻射藥片</link>"

#. STRINGS.ITEMS.PILLS.BASICRADPILL.RECIPEDESC
msgctxt "STRINGS.ITEMS.PILLS.BASICRADPILL.RECIPEDESC"
msgid "A supplement that speeds up the rate at which a Duplicant body absorbs radiation, allowing them to manage increased radiation exposure.\n\nMust be taken daily."
msgstr "一種能加速複製人身體處理輻射速度的補充劑，使其能應對增加的輻射暴露。\n\n必須每日服用。"

#. STRINGS.ITEMS.PILLS.INTERMEDIATEBOOSTER.DESC
msgctxt "STRINGS.ITEMS.PILLS.INTERMEDIATEBOOSTER.DESC"
msgid "Significantly reduces the chance of becoming sick."
msgstr "大大降低生病的機率。"

#. STRINGS.ITEMS.PILLS.INTERMEDIATEBOOSTER.NAME
msgctxt "STRINGS.ITEMS.PILLS.INTERMEDIATEBOOSTER.NAME"
msgid "<link=\"INTERMEDIATEBOOSTER\">Immuno Booster</link>"
msgstr "<link=\"INTERMEDIATEBOOSTER\">免疫增強劑</link>"

#. STRINGS.ITEMS.PILLS.INTERMEDIATEBOOSTER.RECIPEDESC
msgctxt "STRINGS.ITEMS.PILLS.INTERMEDIATEBOOSTER.RECIPEDESC"
msgid "A supplement that significantly reduces the chance of contracting a <style=\"KKeyword\">Germ</style>-based <link=\"DISEASE\">Disease</link>.\n\nMust be taken daily."
msgstr "一種補給品，可以減少感染<style=\"KKeyword\">病菌</style>性<link=\"DISEASE\">疾病</link>的機率。\n\n必須每日服用。"

#. STRINGS.ITEMS.PILLS.INTERMEDIATECURE.DESC
msgctxt "STRINGS.ITEMS.PILLS.INTERMEDIATECURE.DESC"
msgid "A doctor-administered cure for moderate ailments."
msgstr "醫生用來施行治療緩解疾病的物品。"

#. STRINGS.ITEMS.PILLS.INTERMEDIATECURE.NAME
msgctxt "STRINGS.ITEMS.PILLS.INTERMEDIATECURE.NAME"
msgid "<link=\"INTERMEDIATECURE\">Medical Pack</link>"
msgstr "<link=\"INTERMEDIATECURE\">醫療包</link>"

#. STRINGS.ITEMS.PILLS.INTERMEDIATECURE.RECIPEDESC
msgctxt "STRINGS.ITEMS.PILLS.INTERMEDIATECURE.RECIPEDESC"
msgid "A doctor-administered cure for moderate <link=\"DISEASE\">Diseases</link>. <link=\"INTERMEDIATECURE\">Medical Pack</link>s are very effective against <link=\"SLIMESICKNESS\">Slimelung</link>.\n\nMust be administered by a Duplicant with the <link=\"MEDICINE2\">Bedside Manner</link> Skill."
msgstr "一種醫生用來治療中度<link=\"DISEASE\">疾病</link>的治療劑。使用<link=\"INTERMEDIATECURE\">醫療包</link>對抗<link=\"SLIMESICKNESS\">黏液肺</link>非常有效。\n\n必須由具備<link=\"MEDICINE2\">床邊照護</link>技能的複製人施用。"

#. STRINGS.ITEMS.PILLS.INTERMEDIATERADPILL.DESC
msgctxt "STRINGS.ITEMS.PILLS.INTERMEDIATERADPILL.DESC"
msgid "Increases a Duplicant's natural radiation absorption rate."
msgstr "加快複製人的自然輻射吸收率。"

#. STRINGS.ITEMS.PILLS.INTERMEDIATERADPILL.NAME
msgctxt "STRINGS.ITEMS.PILLS.INTERMEDIATERADPILL.NAME"
msgid "<link=\"INTERMEDIATERADPILL\">Intermediate Rad Pill</link>"
msgstr "<link=\"INTERMEDIATERADPILL\">中級輻射藥片</link>"

#. STRINGS.ITEMS.PILLS.INTERMEDIATERADPILL.RECIPEDESC
msgctxt "STRINGS.ITEMS.PILLS.INTERMEDIATERADPILL.RECIPEDESC"
msgid "A supplement that speeds up the rate at which a Duplicant body absorbs radiation, allowing them to manage increased radiation exposure.\n\nMust be taken daily."
msgstr "一種能加速複製人身體處理輻射速度的補充劑，使其能應對增加的輻射暴露。\n\n必須每日服用。"

#. STRINGS.ITEMS.PILLS.PLACEBO.DESC
msgctxt "STRINGS.ITEMS.PILLS.PLACEBO.DESC"
msgid "A general, all-purpose <link=\"MEDICINE\">Medicine</link>.\n\nThe less one knows about it, the better it works."
msgstr "一種普通的、通用<link=\"MEDICINE\">藥物</link>。\n\n你知道的越少，它的效果越好。"

#. STRINGS.ITEMS.PILLS.PLACEBO.NAME
msgctxt "STRINGS.ITEMS.PILLS.PLACEBO.NAME"
msgid "Placebo"
msgstr "安慰劑"

#. STRINGS.ITEMS.PILLS.PLACEBO.RECIPEDESC
msgctxt "STRINGS.ITEMS.PILLS.PLACEBO.RECIPEDESC"
msgid "All-purpose <link=\"MEDICINE\">Medicine</link>."
msgstr "通用 <link=\"MEDICINE\">藥物</link>。"

#. STRINGS.ITEMS.RADIATION.HIGHENERGYPARITCLE.DESC
msgctxt "STRINGS.ITEMS.RADIATION.HIGHENERGYPARITCLE.DESC"
msgid "A concentrated field of <style=\"KKeyword\">Radbolts</style> that can be largely redirected using a <link=\"HIGHENERGYPARTICLEREDIRECTOR\">Radbolt Reflector</link>."
msgstr "一團高度集中的<style=\"KKeyword\">輻射粒子</style>可以使用<link=\"HIGHENERGYPARTICLEREDIRECTOR\">輻射粒子反射器</link>最大程度將其轉向。"

#. STRINGS.ITEMS.RADIATION.HIGHENERGYPARITCLE.NAME
msgctxt "STRINGS.ITEMS.RADIATION.HIGHENERGYPARITCLE.NAME"
msgid "Radbolts"
msgstr "輻射粒子"

#. STRINGS.ITEMS.RAILGUNPAYLOAD.DESC
msgctxt "STRINGS.ITEMS.RAILGUNPAYLOAD.DESC"
msgid "Contains resources packed for interstellar shipping.\n\nCan be launched by a <link=\"RAILGUN\">Interplanetary Launcher</link> or unpacked with a <link=\"RAILGUNPAYLOADOPENER\">Payload Opener</link>."
msgstr "將資源裝箱供星際運輸。\n\n可用<link=\"RAILGUN\">行星軌道炮</link>發射或用<link=\"RAILGUNPAYLOADOPENER\">星際貨箱拆封機</link>拆開。"

#. STRINGS.ITEMS.RAILGUNPAYLOAD.NAME
msgctxt "STRINGS.ITEMS.RAILGUNPAYLOAD.NAME"
msgid "<link=\"RAILGUNPAYLOAD\">Interplanetary Payload</link>"
msgstr "<link=\"RAILGUNPAYLOAD\">星際貨箱</link>"

#. STRINGS.ITEMS.SPICES.MACHINERY_SPICE.DESC
