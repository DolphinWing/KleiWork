msgstr "每個故事都有自己的起源。"

#. STRINGS.BUILDINGS.PREFABS.CANVASWIDE.FACADES.ART_WIDE_B.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.CANVASWIDE.FACADES.ART_WIDE_B.NAME"
msgid "<link=\"ARTWIDEB\">Ground Zero</link>"
msgstr "<link=\"ARTWIDEB\">爆炸的起點</link>"

#. STRINGS.BUILDINGS.PREFABS.CANVASWIDE.FACADES.ART_WIDE_C.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.CANVASWIDE.FACADES.ART_WIDE_C.DESC"
