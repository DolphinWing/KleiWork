#. STRINGS.WORLD_TRAITS.IRREGULAR_OIL.NAME
msgctxt "STRINGS.WORLD_TRAITS.IRREGULAR_OIL.NAME"
msgid "Irregular Oil"
msgstr "原油藏量不一"

#. STRINGS.WORLD_TRAITS.LUSH_CORE.DESCRIPTION
msgctxt "STRINGS.WORLD_TRAITS.LUSH_CORE.DESCRIPTION"
msgid "This world has a lush forest core"
msgstr "這個世界有茂密的森林核心"

#. STRINGS.WORLD_TRAITS.LUSH_CORE.NAME
msgctxt "STRINGS.WORLD_TRAITS.LUSH_CORE.NAME"
msgid "Lush Core"
msgstr "茂密核心"

#. STRINGS.WORLD_TRAITS.MAGMA_VENTS.DESCRIPTION
msgctxt "STRINGS.WORLD_TRAITS.MAGMA_VENTS.DESCRIPTION"
msgid "The <link=\"MAGMA\">Magma</link> from this world's core has leaked into the mantle and crust"
msgstr "核心的<link=\"MAGMA\">岩漿</link>已經滲入此世界的地幔和地殼"

#. STRINGS.WORLD_TRAITS.MAGMA_VENTS.NAME
msgctxt "STRINGS.WORLD_TRAITS.MAGMA_VENTS.NAME"
msgid "Magma Channels"
msgstr "岩漿通道"

#. STRINGS.WORLD_TRAITS.METAL_CAVES.DESCRIPTION
msgctxt "STRINGS.WORLD_TRAITS.METAL_CAVES.DESCRIPTION"
msgid "This world has caves of metal ore"
msgstr "這個世界內有金屬礦脈洞穴"

#. STRINGS.WORLD_TRAITS.METAL_CAVES.NAME
msgctxt "STRINGS.WORLD_TRAITS.METAL_CAVES.NAME"
msgid "Metallic Caves"
msgstr "金屬礦洞"

#. STRINGS.WORLD_TRAITS.METAL_POOR.DESCRIPTION
msgctxt "STRINGS.WORLD_TRAITS.METAL_POOR.DESCRIPTION"
msgid "There is a reduced amount of <style=\"KKeyword\">Metal Ore</style> on this world, proceed with caution!"
msgstr "這裡的<style=\"KKeyword\">金屬礦物</style>藏量比預期的少，請小心行事！"

#. STRINGS.WORLD_TRAITS.METAL_POOR.NAME
msgctxt "STRINGS.WORLD_TRAITS.METAL_POOR.NAME"
msgid "Metal Poor"
msgstr "金屬藏量稀少"

#. STRINGS.WORLD_TRAITS.METAL_RICH.DESCRIPTION
msgctxt "STRINGS.WORLD_TRAITS.METAL_RICH.DESCRIPTION"
msgid "This asteroid is an abundant source of <style=\"KKeyword\">Metal Ore</style>"
msgstr "此小行星蘊藏了豐富的<style=\"KKeyword\">金屬礦物</style>資源"

#. STRINGS.WORLD_TRAITS.METAL_RICH.NAME
msgctxt "STRINGS.WORLD_TRAITS.METAL_RICH.NAME"
msgid "Metal Rich"
msgstr "金屬藏量豐富"

#. STRINGS.WORLD_TRAITS.MISALIGNED_START.DESCRIPTION
msgctxt "STRINGS.WORLD_TRAITS.MISALIGNED_START.DESCRIPTION"
msgid "The <link=\"HEADQUARTERS\">Printing Pod</link> didn't end up in the asteroid's exact center this time... but it's still nowhere near the surface"
msgstr "這次<link=\"HEADQUARTERS\">列印元</link>並未落於小行星的確切中心…但距離地表依然遙遠"

#. STRINGS.WORLD_TRAITS.MISALIGNED_START.NAME
msgctxt "STRINGS.WORLD_TRAITS.MISALIGNED_START.NAME"
msgid "Alternate Pod Location"
msgstr "列印原點偏移"

#. STRINGS.WORLD_TRAITS.MISSING_TRAIT
msgctxt "STRINGS.WORLD_TRAITS.MISSING_TRAIT"
msgid "<missing traits>"
msgstr "<缺少特質>"

#. STRINGS.WORLD_TRAITS.NO_TRAITS.DESCRIPTION
msgctxt "STRINGS.WORLD_TRAITS.NO_TRAITS.DESCRIPTION"
msgid "This world exists in a particularly stable configuration each time it is encountered"
msgstr "每次遇到此世界，其地理結構都相當穩定"

#. STRINGS.WORLD_TRAITS.NO_TRAITS.NAME
msgctxt "STRINGS.WORLD_TRAITS.NO_TRAITS.NAME"
msgid "<i>This world is stable and has no unusual features.</i>"
msgstr "<b>此世界很穩定且沒異常特色。</b>"

#. STRINGS.WORLD_TRAITS.NO_TRAITS.NAME_SHORTHAND
msgctxt "STRINGS.WORLD_TRAITS.NO_TRAITS.NAME_SHORTHAND"
msgid "No unusual features"
msgstr "沒有異常特徵"

#. STRINGS.WORLD_TRAITS.RADIOACTIVE_CRUST.DESCRIPTION
msgctxt "STRINGS.WORLD_TRAITS.RADIOACTIVE_CRUST.DESCRIPTION"
msgid "Deposits of <link=\"URANIUMORE\">Uranium Ore</link> are found in this world's crust"
msgstr "在這個世界的地殼中發現了<link=\"URANIUMORE\">鈾礦</link>礦床"

#. STRINGS.WORLD_TRAITS.RADIOACTIVE_CRUST.NAME
msgctxt "STRINGS.WORLD_TRAITS.RADIOACTIVE_CRUST.NAME"
msgid "Radioactive Crust"
msgstr "放射性地殼"

#. STRINGS.WORLD_TRAITS.SLIME_SPLATS.DESCRIPTION
msgctxt "STRINGS.WORLD_TRAITS.SLIME_SPLATS.DESCRIPTION"
msgid "Sickly <link=\"SLIMEMOLD\">Slime</link> growths have crept all over this world"
msgstr "含有病毒的<link=\"SLIMEMOLD\">軟泥</link>已經蔓延到世界各地"

#. STRINGS.WORLD_TRAITS.SLIME_SPLATS.NAME
msgctxt "STRINGS.WORLD_TRAITS.SLIME_SPLATS.NAME"
msgid "Slime Molds"
msgstr "軟泥遍佈"

#. STRINGS.WORLD_TRAITS.SUBSURFACE_OCEAN.DESCRIPTION
msgctxt "STRINGS.WORLD_TRAITS.SUBSURFACE_OCEAN.DESCRIPTION"
msgid "Below the crust of this world is a <link=\"SALTWATER\">Salt Water</link> sea"
msgstr "在這個世界的地殼之下是<link=\"SALTWATER\">鹽水</link>海"

#. STRINGS.WORLD_TRAITS.SUBSURFACE_OCEAN.NAME
msgctxt "STRINGS.WORLD_TRAITS.SUBSURFACE_OCEAN.NAME"
msgid "Subsurface Ocean"
msgstr "地下洋流"

#. STRINGS.WORLD_TRAITS.VOLCANOES.DESCRIPTION
msgctxt "STRINGS.WORLD_TRAITS.VOLCANOES.DESCRIPTION"
msgid "Several active <style=\"KKeyword\">Volcanoes</style> have been detected in this world"
msgstr "在這個世界上已偵測到多座活躍的<style=\"KKeyword\">火山</style>"

#. STRINGS.WORLD_TRAITS.VOLCANOES.NAME
msgctxt "STRINGS.WORLD_TRAITS.VOLCANOES.NAME"
msgid "Volcanic Activity"
msgstr "火山活動"

#. STRINGS.WORLDS.AQUATICBASEGAME.DESCRIPTION
msgctxt "STRINGS.WORLDS.AQUATICBASEGAME.DESCRIPTION"
msgid "A salty water-rich starting world with abundant food resources.\n\n<smallcaps>Marinea's biodiversity makes reliable food production more attainable for new colonies, provided they can navigate its ubiquitous liquid pools. Construction materials are a bit limited.</smallcaps>"
msgstr "一顆富含鹽水的初始星球，擁有豐沛的食物資源。\n\n<smallcaps>只要能克服無處不在的液體池，汪洋星的生物多樣性將使新殖民地更容易取得可靠的食物來源。建築材料則較為匱乏。</smallcaps>"

#. STRINGS.WORLDS.AQUATICBASEGAME.NAME
msgctxt "STRINGS.WORLDS.AQUATICBASEGAME.NAME"
msgid "Marinea"
msgstr "汪洋星"

#. STRINGS.WORLDS.AQUATICCLASSIC.DESCRIPTION
msgctxt "STRINGS.WORLDS.AQUATICCLASSIC.DESCRIPTION"
msgid "A salty water-rich starting world with abundant food resources.\n\n<smallcaps>Marinea's biodiversity makes reliable food production more attainable for new colonies, provided they can navigate its ubiquitous liquid pools. Construction materials are a bit limited.</smallcaps>"
msgstr "一顆富含鹽水的初始星球，擁有豐沛的食物資源。\n\n<smallcaps>只要能克服無處不在的液體池，汪洋星的生物多樣性將使新殖民地更容易取得可靠的食物來源。建築材料則較為匱乏。</smallcaps>"

#. STRINGS.WORLDS.AQUATICCLASSIC.NAME
msgctxt "STRINGS.WORLDS.AQUATICCLASSIC.NAME"
msgid "Marinea Asteroid"
msgstr "汪洋小行星"

#. STRINGS.WORLDS.AQUATICMIXING.DESCRIPTION
msgctxt "STRINGS.WORLDS.AQUATICMIXING.DESCRIPTION"
msgid "A fragment of an aquatic starting world. It has abundant food resources.\n\n<smallcaps>Marinea's biodiversity makes reliable food production more attainable for new colonies, provided they can navigate its many liquid pools. Construction materials are a bit limited.</smallcaps>"
msgstr "一顆汪洋初始星球的殘骸碎片，擁有豐沛的食物資源。\n\n<smallcaps>只要能克服其眾多的液體池，汪洋星的生物多樣性將使新殖民地更容易取得可靠的食物來源。建築材料則較為匱乏。</smallcaps>"

#. STRINGS.WORLDS.AQUATICMIXING.NAME
msgctxt "STRINGS.WORLDS.AQUATICMIXING.NAME"
msgid "Marinea Fragment"
msgstr "汪洋星碎片"

#. STRINGS.WORLDS.AQUATICSPACEDOUT.DESCRIPTION
msgctxt "STRINGS.WORLDS.AQUATICSPACEDOUT.DESCRIPTION"
msgid "A smaller inundated starting world with abundant food resources.\n\n<smallcaps>Marinea's biodiversity makes reliable food production more attainable for new colonies, provided they can navigate its ubiquitous liquid pools. Construction materials are a bit limited.</smallcaps>"
msgstr "一顆規模較小且浸沒於水中的初始星球，擁有豐沛的食物資源。\n\n<smallcaps>只要能克服無處不在的液體池，汪洋星的生物多樣性將使新殖民地更容易取得可靠的食物來源。建築材料則較為匱乏。</smallcaps>"

#. STRINGS.WORLDS.AQUATICSPACEDOUT.NAME
msgctxt "STRINGS.WORLDS.AQUATICSPACEDOUT.NAME"
msgid "Marinea Minor"
msgstr "小汪洋星"

#. STRINGS.WORLDS.BADLANDS.DESCRIPTION
msgctxt "STRINGS.WORLDS.BADLANDS.DESCRIPTION"
msgid "A barren location with an overabundance of mineral resources.\n\n<smallcaps>The rocky terrain of The Badlands poses no immediate threats, but sparse resource availability will make expansion and technological progress challenging.</smallcaps>\n\n"
msgstr "一個荒蕪但有豐富礦物資源的地方。\n\n<smallcaps>「惡地」的岩石地型不會構成即時威脅，但稀缺的資源將使殖民地擴張和科技發展面臨挑戰。</smallcaps>\n\n"

#. STRINGS.WORLDS.BADLANDS.NAME
msgctxt "STRINGS.WORLDS.BADLANDS.NAME"
msgid "The Badlands"
msgstr "惡地行星"

#. STRINGS.WORLDS.BIGEMPTY.DESCRIPTION
msgctxt "STRINGS.WORLDS.BIGEMPTY.DESCRIPTION"
msgid "A big ol' biome-free spacerock for claustrophobic devs."
msgstr "一個無生態的大型太空岩石，適合有幽閉恐懼症的開發者。"

#. STRINGS.WORLDS.BIGEMPTY.NAME
msgctxt "STRINGS.WORLDS.BIGEMPTY.NAME"
msgid "Big Empty FOR DEVS"
msgstr "大型空洞，開發人員用"

#. STRINGS.WORLDS.CERESBASEGAME.DESCRIPTION
msgctxt "STRINGS.WORLDS.CERESBASEGAME.DESCRIPTION"
msgid "A frosty location with sub-zero temperatures throughout.\n\n<smallcaps>Duplicants who work in Ceres's sub-zero temperatures will need to wear or build warming equipment. Abundant natural fuel sources could lead to a well-powered colony.</smallcaps>"
msgstr "冰霜覆蓋之地，到處都是低於冰點的溫度。\n\n<smallcaps>在穀神星酷寒溫度中工作的複製人需要穿戴或建造保暖裝備。豐富的天然燃料能使殖民地供能充足。</smallcaps>"

#. STRINGS.WORLDS.CERESBASEGAME.NAME
msgctxt "STRINGS.WORLDS.CERESBASEGAME.NAME"
msgid "Ceres"
msgstr "穀神星"

#. STRINGS.WORLDS.CERESBASEGAMESHATTERED.DESCRIPTION
msgctxt "STRINGS.WORLDS.CERESBASEGAMESHATTERED.DESCRIPTION"
msgid "The heavily damaged remnants of a frosty location with sub-zero temperatures throughout.\n\n<smallcaps>Exploring the rubble of Blasted Ceres's sub-zero temperatures is particularly challenging, yet natural fuel sources provide a valuable payoff.</smallcaps>"
msgstr "一個冰霜覆蓋、遭遇嚴重受損後的遺骸，到處都是低於冰點的溫度。\n\n<smallcaps>在酷寒溫度中探索破碎的穀神星相當具有挑戰性，但天然燃料源可作為寶貴的回報。</smallcaps>"

#. STRINGS.WORLDS.CERESBASEGAMESHATTERED.NAME
msgctxt "STRINGS.WORLDS.CERESBASEGAMESHATTERED.NAME"
msgid "Blasted Ceres"
msgstr "被炸毀的穀神星"

#. STRINGS.WORLDS.CERESCLASSIC.DESCRIPTION
msgctxt "STRINGS.WORLDS.CERESCLASSIC.DESCRIPTION"
msgid "A frosty starting world with sub-zero temperatures throughout.\n\n<smallcaps>Duplicants who work in Ceres's sub-zero temperatures will need to wear or build warming equipment. Abundant natural fuel sources could lead to a well-powered colony.</smallcaps>"
msgstr "一顆冰霜覆蓋的初始星球，到處都是低於冰點的溫度。\n\n<smallcaps>在穀神星在酷寒溫度中工作的複製人需要穿戴或建造保暖裝備。豐沛的天然燃料有助於建立能源充足的殖民地。</smallcaps>"

#. STRINGS.WORLDS.CERESCLASSIC.NAME
msgctxt "STRINGS.WORLDS.CERESCLASSIC.NAME"
msgid "Ceres Asteroid"
msgstr "穀神小行星"

#. STRINGS.WORLDS.CERESCLASSICSHATTERED.DESCRIPTION
msgctxt "STRINGS.WORLDS.CERESCLASSICSHATTERED.DESCRIPTION"
msgid "The heavily damaged remnants of a frosty location with sub-zero temperatures throughout.\n\n<smallcaps>Exploring the rubble of Blasted Ceres's sub-zero temperatures is particularly challenging, yet natural fuel sources provide a valuable payoff.</smallcaps>"
msgstr "一個冰霜覆蓋、遭遇嚴重受損後的遺骸，到處都是低於冰點的溫度。\n\n<smallcaps>在酷寒溫度中探索破碎的穀神星相當具有挑戰性，但天然燃料源可作為寶貴的回報。</smallcaps>"

#. STRINGS.WORLDS.CERESCLASSICSHATTERED.NAME
msgctxt "STRINGS.WORLDS.CERESCLASSICSHATTERED.NAME"
msgid "Blasted Ceres"
msgstr "被炸毀的穀神星"

#. STRINGS.WORLDS.CERESMIXING.DESCRIPTION
msgctxt "STRINGS.WORLDS.CERESMIXING.DESCRIPTION"
msgid "A fragment of a frosty starting world with sub-zero temperatures throughout.\n\n<smallcaps>Duplicants who work in sub-zero temperatures will need to wear or build warming equipment. Abundant natural fuel sources could lead to a well-powered colony.</smallcaps>"
msgstr "冰霜初始星球的碎片，到處都是低於冰點的溫度。\n\n<smallcaps>在酷寒溫度中工作的複製人需要穿戴或建造保暖裝備。豐沛的天然燃料有助於建立能源充足的殖民地。</smallcaps>"

#. STRINGS.WORLDS.CERESMIXING.NAME
msgctxt "STRINGS.WORLDS.CERESMIXING.NAME"
msgid "Ceres Fragment"
msgstr "穀神星碎片"

#. STRINGS.WORLDS.CERESSPACEDOUT.DESCRIPTION
msgctxt "STRINGS.WORLDS.CERESSPACEDOUT.DESCRIPTION"
msgid "A smaller frosty starting world with sub-zero temperatures throughout.\n\n<smallcaps>Duplicants who work in Ceres's sub-zero temperatures will need to wear or build warming equipment. Abundant natural fuel sources could lead to a well-powered colony.</smallcaps>"
msgstr "冰霜覆蓋，一顆較小的初始星球，到處都是低於冰點的溫度。\n\n<smallcaps>在穀神星酷寒溫度中工作的複製人需要穿戴或建造保暖裝備。豐沛的天然燃料有助於建立能源充足的殖民地。</smallcaps>"

#. STRINGS.WORLDS.CERESSPACEDOUT.NAME
msgctxt "STRINGS.WORLDS.CERESSPACEDOUT.NAME"
msgid "Ceres Minor"
msgstr "小穀神星"

#. STRINGS.WORLDS.FOREST_DEFAULT.DESCRIPTION
msgctxt "STRINGS.WORLDS.FOREST_DEFAULT.DESCRIPTION"
msgid "A location with a natural abundance of trees.\n\n<smallcaps>Colonizing Arboria will require careful planning right from the start. Because of its lack of metals, finding biological solutions to problems is a must.</smallcaps>\n\n"
msgstr "一個天然樹木資源豐富的地方。\n\n<smallcaps>殖民「喬木行星」需要從一開始就仔細規劃。由於其金屬資源匱乏，尋找生物性的解決方案勢在必行。</smallcaps>\n\n"

#. STRINGS.WORLDS.FOREST_DEFAULT.NAME
msgctxt "STRINGS.WORLDS.FOREST_DEFAULT.NAME"
msgid "Arboria"
msgstr "喬木行星"

#. STRINGS.WORLDS.FOREST_HOT.DESCRIPTION
msgctxt "STRINGS.WORLDS.FOREST_HOT.DESCRIPTION"
msgid "A location with oppressively hot temperatures.\n\n<smallcaps>Temperatures on Aridio are much higher than expected. While resources are abundant, maintaining food and infrastructure could be difficult as our colony warms.</smallcaps>\n\n"
msgstr "一個氣溫高得令人窒息的地方。\n\n<smallcaps>「熱帶森林行星」的氣溫遠比預期來得高。儘管資源豐沛，但隨著殖民地溫度持續升高，維持食物與基礎設施將會面臨挑戰。</smallcaps>\n\n"

#. STRINGS.WORLDS.FOREST_HOT.NAME
msgctxt "STRINGS.WORLDS.FOREST_HOT.NAME"
msgid "Aridio"
msgstr "熱帶森林行星"

#. STRINGS.WORLDS.FOREST_LUSH.DESCRIPTION
msgctxt "STRINGS.WORLDS.FOREST_LUSH.DESCRIPTION"
msgid "A lush location rich in wildlife and life-sustaining resources.\n\n<smallcaps>Establishing a foothold on Verdante will be challenging due to reduced food and oxygen options. However, abundant biological and mineral resources should afford excellent long-term growth.</smallcaps>\n\n"
msgstr "一個生機盎然且富含野生動物與維生資源的地方。\n\n<smallcaps>由於食物與氧氣選項的減少，在「森林行星」上建立立足點將會充滿挑戰。然而，豐沛的生物與礦物資源應能帶來卓越的長期發展。</smallcaps>\n\n"

#. STRINGS.WORLDS.FOREST_LUSH.NAME
msgctxt "STRINGS.WORLDS.FOREST_LUSH.NAME"
msgid "Verdante"
msgstr "森林行星"

#. STRINGS.WORLDS.FORESTMOONLET.DESCRIPTION
msgctxt "STRINGS.WORLDS.FORESTMOONLET.DESCRIPTION"
msgid "A small moon with a forest start.\n\n<smallcaps>Folia Asteroids have plenty of organic material but Duplicants will have to venture outside their starting biome quickly to find any metal.</smallcaps>"
msgstr "一顆以森林作為起始地的小衛星。\n\n<smallcaps>「森林小行星」雖然擁有大量的有機材料，但複製人必須迅速探索起始生態域之外的區域，才能找到所需的金屬。</smallcaps>"

#. STRINGS.WORLDS.FORESTMOONLET.NAME
msgctxt "STRINGS.WORLDS.FORESTMOONLET.NAME"
msgid "Folia Asteroid"
msgstr "森林小行星"

#. STRINGS.WORLDS.HELICONA.DESCRIPTION
msgctxt "STRINGS.WORLDS.HELICONA.DESCRIPTION"
msgid "Due to its highly elliptical orbit around its host star, this rock is cold. Oh so very cold.\n\n<smallcaps></smallcaps>\n\n"
msgstr "由於其圍繞主星的高度橢圓軌道，這塊岩石極其寒冷。喔，是冷得徹骨的那種冷。\n\n<smallcaps></smallcaps>\n\n"

#. STRINGS.WORLDS.HELICONA.NAME
msgctxt "STRINGS.WORLDS.HELICONA.NAME"
msgid "Helicona"
msgstr "繆斯冰星"

#. STRINGS.WORLDS.IDEALLANDINGSITE.DESCRIPTION
msgctxt "STRINGS.WORLDS.IDEALLANDINGSITE.DESCRIPTION"
msgid "A sandstone and forest world with significant radiation.\n\n<smallcaps>Irradiated Forest Asteroids have an abundance of metal for the taking if Duplicants can withstand the planetoid's radiation.</smallcaps>"
msgstr "一個廣布砂岩與森林、並承受著大量輻射影響的世界。\n\n<smallcaps>「受輻森林小行星」蘊藏豐富金屬，只要複製人能承受得住這顆小型行星的輻射，即可開採利用。</smallcaps>"

#. STRINGS.WORLDS.IDEALLANDINGSITE.NAME
msgctxt "STRINGS.WORLDS.IDEALLANDINGSITE.NAME"
msgid "Irradiated Forest Asteroid"
msgstr "受輻森林小行星"

#. STRINGS.WORLDS.MARSHYMOONLET.DESCRIPTION
msgctxt "STRINGS.WORLDS.MARSHYMOONLET.DESCRIPTION"
msgid "A small location with an abundance of marshland.\n\n<smallcaps>While Marshy Asteroids offer an abundance of organic resources like Slime Mold and Algae, their air quality poses a significant disease risk for Duplicants.</smallcaps>"
msgstr "一個富含沼澤地的小行星。\n\n<smallcaps>「草澤小行星」雖然提供了豐富的有機資源，像是軟泥與藻類，但其空氣品質對複製人構成嚴重的疾病風險。</smallcaps>"

#. STRINGS.WORLDS.MARSHYMOONLET.NAME
msgctxt "STRINGS.WORLDS.MARSHYMOONLET.NAME"
msgid "Marshy Asteroid"
msgstr "草澤小行星"

#. STRINGS.WORLDS.MEDIUMFORESTYRADIOACTIVEVANILLAWARPPLANET.DESCRIPTION
msgctxt "STRINGS.WORLDS.MEDIUMFORESTYRADIOACTIVEVANILLAWARPPLANET.DESCRIPTION"
msgid "A large-ish forested asteroid with a frozen radioactive core.\n\n<smallcaps>While Radioactive Forest Asteroid are largely foresty, they also contain a great deal of rust.</smallcaps>"
msgstr "一個廣闊且擁有冰凍放射性核心的森林小行星。\n\n<smallcaps>「放射森林小行星」雖然大部分區域為森林地帶，但也同時蘊藏著大量的鐵鏽。</smallcaps>"

#. STRINGS.WORLDS.MEDIUMFORESTYRADIOACTIVEVANILLAWARPPLANET.NAME
msgctxt "STRINGS.WORLDS.MEDIUMFORESTYRADIOACTIVEVANILLAWARPPLANET.NAME"
msgid "Radioactive Forest Asteroid"
msgstr "放射森林小行星"

#. STRINGS.WORLDS.MEDIUMFORESTYWASTELAND.DESCRIPTION
msgctxt "STRINGS.WORLDS.MEDIUMFORESTYWASTELAND.DESCRIPTION"
msgid "A large-ish forested asteroid with a frozen radioactive core.\n\n<smallcaps>While Glowood Wasteland Asteroids are largely foresty, they also contain a great deal of rust and wasteland.</smallcaps>"
msgstr "一個廣闊且擁有冰凍放射性核心的森林小行星。\n\n<smallcaps>「森林荒地小行星」雖然大部分區域為森林地帶，但也同時蘊藏著大量的鐵鏽與荒蕪之地。</smallcaps>"

#. STRINGS.WORLDS.MEDIUMFORESTYWASTELAND.NAME
msgctxt "STRINGS.WORLDS.MEDIUMFORESTYWASTELAND.NAME"
msgid "Glowood Wasteland Asteroid"
msgstr "森林荒地小行星"

#. STRINGS.WORLDS.MEDIUMRADIOACTIVEVANILLAWARPPLANET.DESCRIPTION
msgctxt "STRINGS.WORLDS.MEDIUMRADIOACTIVEVANILLAWARPPLANET.DESCRIPTION"
msgid "A large-ish partially frozen world with a radioactive core.\n\n<smallcaps>While Radioactive Swamp Asteroids are largely swampy, they also contain a great deal of rust.</smallcaps>"
msgstr "一個廣闊且部分凍結、擁有放射性核心的世界。\n\n<smallcaps>「輻射沼澤小行星」雖然大部分區域為沼澤地帶，但也同時蘊藏著大量的鐵鏽。</smallcaps>"

#. STRINGS.WORLDS.MEDIUMRADIOACTIVEVANILLAWARPPLANET.NAME
msgctxt "STRINGS.WORLDS.MEDIUMRADIOACTIVEVANILLAWARPPLANET.NAME"
msgid "Radioactive Swamp Asteroid"
msgstr "輻射沼澤小行星"

#. STRINGS.WORLDS.MEDIUMSANDYRADIOACTIVEVANILLAWARPPLANET.DESCRIPTION
msgctxt "STRINGS.WORLDS.MEDIUMSANDYRADIOACTIVEVANILLAWARPPLANET.DESCRIPTION"
msgid "A large-ish terra world with a radioactive core.\n\n<smallcaps>The Radioactive Terra Asteroid is fairly dry and sandy, but does contain areas of jungle.</smallcaps>"
msgstr "一個廣闊且擁有放射性核心的類地世界。\n\n<smallcaps>「輻射類地小行星」雖然相當乾燥多沙，但也確實存在著叢林區域。</smallcaps>"

#. STRINGS.WORLDS.MEDIUMSANDYRADIOACTIVEVANILLAWARPPLANET.NAME
msgctxt "STRINGS.WORLDS.MEDIUMSANDYRADIOACTIVEVANILLAWARPPLANET.NAME"
msgid "Radioactive Terra Asteroid"
msgstr "輻射類地小行星"

#. STRINGS.WORLDS.MEDIUMSANDYSWAMP.DESCRIPTION
msgctxt "STRINGS.WORLDS.MEDIUMSANDYSWAMP.DESCRIPTION"
msgid "A large-ish terra world with a radioactive core.\n\n<smallcaps>The Radioactive Terrabog Asteroid is fairly dry and sandy, but does contain swampy areas with a partially frozen surface.</smallcaps>"
msgstr "一個廣闊且擁有放射性核心的類地世界。\n\n<smallcaps>「輻射泥沼小行星」雖然相當乾燥多沙，但也確實存在著部分表面凍結的沼澤區域。</smallcaps>"

#. STRINGS.WORLDS.MEDIUMSANDYSWAMP.NAME
msgctxt "STRINGS.WORLDS.MEDIUMSANDYSWAMP.NAME"
msgid "Radioactive Terrabog Asteroid"
msgstr "輻射泥沼小行星"

#. STRINGS.WORLDS.MEDIUMSWAMPY.DESCRIPTION
msgctxt "STRINGS.WORLDS.MEDIUMSWAMPY.DESCRIPTION"
msgid "A large-ish, polluted swamp world.\n\n<smallcaps>Stinko Swamp Asteroids are full of swampy and marshy areas, but also contain a variety of other biomes diverse enough to keep a determined colony supplied with essentials.</smallcaps>"
msgstr "一個廣闊且受汙染的沼澤世界。\n\n<smallcaps>「臭臭沼澤小行星」雖然充斥著沼澤與溼地，但也同時囊括了足夠多樣的生態，足以讓堅毅的殖民地獲得基本補給。</smallcaps>"

#. STRINGS.WORLDS.MEDIUMSWAMPY.NAME
msgctxt "STRINGS.WORLDS.MEDIUMSWAMPY.NAME"
msgid "Stinko Swamp Asteroid"
msgstr "臭臭沼澤小行星"

#. STRINGS.WORLDS.METALHEAVYLANDINGSITE.DESCRIPTION
msgctxt "STRINGS.WORLDS.METALHEAVYLANDINGSITE.DESCRIPTION"
msgid "A marshy world with significant radiation.\n\n<smallcaps>Irradiated Marsh Asteroids have an abundance of metal for the taking if Duplicants can withstand the planetoid's radiation.</smallcaps>"
msgstr "一個擁有大量輻射的沼澤世界。\n\n<smallcaps>「輻射草澤小行星」蘊藏豐富的金屬，只要複製人能承受這顆小型行星的輻射，即可開採利用。</smallcaps>"

#. STRINGS.WORLDS.METALHEAVYLANDINGSITE.NAME
msgctxt "STRINGS.WORLDS.METALHEAVYLANDINGSITE.NAME"
msgid "Irradiated Marsh Asteroid"
msgstr "輻射草澤小行星"

#. STRINGS.WORLDS.MINIBADLANDS.DESCRIPTION
msgctxt "STRINGS.WORLDS.MINIBADLANDS.DESCRIPTION"
msgid "A barren location with an overabundance of mineral resources and oil.\n\n<smallcaps>The rocky terrain of The Desolands poses no immediate threats, but the limited variety of resources will make expansion and technological progress challenging.</smallcaps>\n\n"
msgstr "一個荒蕪卻富含礦物資源與原油的地方。\n\n<smallcaps>此處的岩石地形本身不構成立即威脅，但資源種類有限將使擴張與科技發展面臨挑戰。</smallcaps>\n\n"

#. STRINGS.WORLDS.MINIBADLANDS.NAME
msgctxt "STRINGS.WORLDS.MINIBADLANDS.NAME"
msgid "The Desolands Asteroid"
msgstr "荒涼小行星"

#. STRINGS.WORLDS.MINIFLIPPED.DESCRIPTION
msgctxt "STRINGS.WORLDS.MINIFLIPPED.DESCRIPTION"
msgid "An asteroid in which the surface is molten hot lava and the core is livable.\n\n<smallcaps>The lava surface of the Flipped Asteroid will make it challenging to start a rocketry program.</smallcaps>\n\n"
msgstr "一顆表面布滿熔岩，但核心卻宜居的小行星。\n\n<smallcaps>「顛倒小行星」的熔岩表面將會讓啟動火箭計畫變得極具挑戰。</smallcaps>\n\n"

#. STRINGS.WORLDS.MINIFLIPPED.NAME
msgctxt "STRINGS.WORLDS.MINIFLIPPED.NAME"
msgid "Flipped Asteroid"
msgstr "顛倒小行星"

#. STRINGS.WORLDS.MINIFORESTFROZEN.DESCRIPTION
msgctxt "STRINGS.WORLDS.MINIFORESTFROZEN.DESCRIPTION"
msgid "A frigid location marked by inhospitably low temperatures throughout.\n\n<smallcaps>The Frozen Forest Asteroid's low temperatures will make finding water and establishing farms or ranches problematic.</smallcaps>\n\n"
msgstr "一個遍布著嚴酷低溫的冰冷地點。\n\n<smallcaps>「冰凍森林小行星」的低溫將使尋找水源及建立農場或牧場變得困難重重。</smallcaps>\n\n"

#. STRINGS.WORLDS.MINIFORESTFROZEN.NAME
msgctxt "STRINGS.WORLDS.MINIFORESTFROZEN.NAME"
msgid "Frozen Forest Asteroid"
msgstr "冰凍森林小行星"

#. STRINGS.WORLDS.MINIMETALLICSWAMPY.DESCRIPTION
msgctxt "STRINGS.WORLDS.MINIMETALLICSWAMPY.DESCRIPTION"
msgid "A small swampy world with an abundance of renewable metal.\n\n<smallcaps>Metallic Swampy Asteroids have a high concentration of metal and a swampy, polluted atmosphere.</smallcaps>"
msgstr "一個蘊藏著豐富可再生金屬的小型沼澤世界。\n\n<smallcaps>「金屬沼澤小行星」不僅金屬濃度高，大氣層也充滿沼氣和汙染物。</smallcaps>"

#. STRINGS.WORLDS.MINIMETALLICSWAMPY.NAME
msgctxt "STRINGS.WORLDS.MINIMETALLICSWAMPY.NAME"
msgid "Metallic Swampy Asteroid"
msgstr "金屬沼澤小行星"

#. STRINGS.WORLDS.MINIRADIOACTIVEOCEAN.DESCRIPTION
msgctxt "STRINGS.WORLDS.MINIRADIOACTIVEOCEAN.DESCRIPTION"
msgid "An irradiated world with renewable water sources.\n\n<smallcaps>Both the radioactive biome and the ocean biome present unique challenges yet considerable payoffs.</smallcaps>\n\n"
msgstr "一個擁有可再生水源的輻射世界。\n\n<smallcaps>輻射生態與海洋生態都帶來了獨特的挑戰，但也同時蘊含著可觀的回報。</smallcaps>\n\n"

#. STRINGS.WORLDS.MINIRADIOACTIVEOCEAN.NAME
msgctxt "STRINGS.WORLDS.MINIRADIOACTIVEOCEAN.NAME"
msgid "Radioactive Ocean Asteroid"
msgstr "輻射海洋小行星"

#. STRINGS.WORLDS.MINISHATTEREDGEO.DESCRIPTION
msgctxt "STRINGS.WORLDS.MINISHATTEREDGEO.DESCRIPTION"
msgid "A molten mini asteroid with a failed experiment buried inside.\n\n<smallcaps>Extremely high temperatures threaten colony safety but could yield an unimaginably powerful payoff.</smallcaps>"
msgstr "一顆熔融的迷你小行星，內部埋藏著一項失敗的實驗。\n\n<smallcaps>極高的溫度威脅著殖民地的安全，但這也可能帶來難以想像的巨大回報。</smallcaps>"

#. STRINGS.WORLDS.MINISHATTEREDGEO.NAME
msgctxt "STRINGS.WORLDS.MINISHATTEREDGEO.NAME"
msgid "Ceres Core Asteroid"
msgstr "穀神星核心小行星"

#. STRINGS.WORLDS.MINISHATTEREDSTART.DESCRIPTION
msgctxt "STRINGS.WORLDS.MINISHATTEREDSTART.DESCRIPTION"
msgid "A battered chunk of a smaller frosty starting world with sub-zero temperatures throughout.\n\n<smallcaps>Surviving Ceres Mantle's frigid landscape is no easy task, but natural fuel sources provide a valuable payoff.</smallcaps>"
msgstr "一個冰封小型起始世界的殘破碎片，全境皆為零度以下嚴寒。\n\n<smallcaps>要在穀神星地幔的酷寒環境中生存並非易事，但其豐富的天然燃料來源將帶來豐厚的回報。</smallcaps>"

#. STRINGS.WORLDS.MINISHATTEREDSTART.NAME
msgctxt "STRINGS.WORLDS.MINISHATTEREDSTART.NAME"
msgid "Ceres Mantle Asteroid"
msgstr "穀神星地幔小行星"

#. STRINGS.WORLDS.MINISHATTEREDWARP.DESCRIPTION
msgctxt "STRINGS.WORLDS.MINISHATTEREDWARP.DESCRIPTION"
msgid "A small, snow-laden world rich with oil and nectar resources.\n\n<smallcaps>Sub-zero temperatures pose unique challenges but the potential for power production is very valuable.</smallcaps>"
msgstr "一顆白雪皚皚的小世界，富含原油和花蜜資源。\n\n<smallcaps>零度以下的氣溫帶來了獨特的挑戰，但其發電潛力極具價值。</smallcaps>"

#. STRINGS.WORLDS.MINISHATTEREDWARP.NAME
msgctxt "STRINGS.WORLDS.MINISHATTEREDWARP.NAME"
msgid "Sweet Ceres Asteroid"
msgstr "甜蜜穀神小行星"

#. STRINGS.WORLDS.MOOMOONLET.DESCRIPTION
msgctxt "STRINGS.WORLDS.MOOMOONLET.DESCRIPTION"
msgid "A small world with unique local lifeforms.\n\n<smallcaps>Moo Asteroids are the natural breeding ground of Gassy Moos due to their abundance of Gas Grass and Methane.</smallcaps>"
msgstr "一個擁有獨特當地生命形式的小世界\n\n<smallcaps>「牛牛小行星」是瓦斯牛的天然繁殖地，因為此地瓦斯草與甲烷資源豐富。</smallcaps>"

#. STRINGS.WORLDS.MOOMOONLET.NAME
msgctxt "STRINGS.WORLDS.MOOMOONLET.NAME"
msgid "Moo Asteroid"
msgstr "牛牛小行星"

#. STRINGS.WORLDS.MOON_BARREN.DESCRIPTION
msgctxt "STRINGS.WORLDS.MOON_BARREN.DESCRIPTION"
msgid "A smaller planetoid in orbit around a larger, resource rich world.\n\n<smallcaps>Barren Moons are rich in minerals, but Duplicants will need to branch out into space early to find the resources the colony needs to stay alive.</smallcaps>\n\n"
msgstr "一顆環繞著一個較大、資源豐富世界運行的小型行星。\n\n<smallcaps>「荒蕪衛星」富含礦物，但複製人必須提早進入太空，才能找到維持殖民地生存所需的資源。</smallcaps>\n\n"

#. STRINGS.WORLDS.MOON_BARREN.NAME
msgctxt "STRINGS.WORLDS.MOON_BARREN.NAME"
msgid "Barren Moon"
msgstr "荒蕪衛星"

#. STRINGS.WORLDS.NIOBIUMMOONLET.DESCRIPTION
msgctxt "STRINGS.WORLDS.NIOBIUMMOONLET.DESCRIPTION"
msgid "A small location with an abundance of solid Niobium.\n\n<smallcaps>Superconductive Asteroids offer rich veins of Niobium to Duplicants that can withstand its molten rivers of magma.</smallcaps>"
msgstr "一個富含固態鈮的小小地方。\n\n<smallcaps>超導小行星有豐富的鈮礦脈，供能夠抵禦其熔岩流的複製人開採利用。</smallcaps>"

#. STRINGS.WORLDS.NIOBIUMMOONLET.NAME
msgctxt "STRINGS.WORLDS.NIOBIUMMOONLET.NAME"
msgid "Superconductive Asteroid"
msgstr "超導小行星"

#. STRINGS.WORLDS.OASIS.DESCRIPTION
msgctxt "STRINGS.WORLDS.OASIS.DESCRIPTION"
msgid "A desolate location with a cache of life-sustaining water trapped beneath the surface.\n\n<smallcaps>A wide underground desert will pose temperature threats and strain the resources of a colony on Oasisse. However, surviving the challenge should present great industrial opportunities.</smallcaps>\n\n"
msgstr "一個荒涼的星球，地表之下蘊藏著維持生命所需的水源。\n\n<smallcaps>廣闊的地下沙漠將對殖民地構成溫度威脅並耗盡其資源。然而，成功應對挑戰應能帶來巨大的工業發展機會。</smallcaps>\n\n"

#. STRINGS.WORLDS.OASIS.NAME
msgctxt "STRINGS.WORLDS.OASIS.NAME"
msgid "Oasisse"
msgstr "綠洲行星"

#. STRINGS.WORLDS.OCEANIA.DESCRIPTION
msgctxt "STRINGS.WORLDS.OCEANIA.DESCRIPTION"
msgid "A location with vast quantities of undrinkable salt water.\n\n<smallcaps>Oceania is quite stable and resource rich, but the majority of the area is covered in a saltwater ocean. Careful expansion and resource usage should lead to a successful colony.</smallcaps>\n\n"
msgstr "一個擁有大量不可飲用鹹水的地方。\n\n<smallcaps>這裡相當穩定並且資源豐富，但大部分地區都被鹽水海洋覆蓋。仔細規劃擴張並謹慎利用資源，應能引導殖民地走向成功。</smallcaps>\n\n"

#. STRINGS.WORLDS.OCEANIA.NAME
msgctxt "STRINGS.WORLDS.OCEANIA.NAME"
msgid "Oceania"
msgstr "海洋行星"

#. STRINGS.WORLDS.OILRICHWARPTARGET.DESCRIPTION
msgctxt "STRINGS.WORLDS.OILRICHWARPTARGET.DESCRIPTION"
msgid "A rusty world with an oily core.\n\n<smallcaps>Duplicants must sift through a great deal of rust and ocean to reach the prize of this planetoid's oil.</smallcaps>"
msgstr "一個帶有油質核心的鏽蝕世界。\n\n<smallcaps>複製人必須層層篩選大量鐵鏽與海洋，才能獲得這顆小行星上珍貴的原油。</smallcaps>"

#. STRINGS.WORLDS.OILRICHWARPTARGET.NAME
msgctxt "STRINGS.WORLDS.OILRICHWARPTARGET.NAME"
msgid "Rusty Oil Asteroid"
msgstr "鐵鏽原油小行星"

#. STRINGS.WORLDS.OILYMOONLET.DESCRIPTION
msgctxt "STRINGS.WORLDS.OILYMOONLET.DESCRIPTION"
msgid "A small location with an abundance of fossil fuels.\n\n<smallcaps>Viscosia Asteroids are filled with valuable crude oil, natural gas, and ethanol deposits at the expense of other essential resources. Early expansion to other planetoids will be essential for survival.</smallcaps>"
msgstr "一個富含化石燃料的小地方。\n\n<smallcaps>「原油小行星」蘊藏著大量的珍貴原油、天然氣和乙醇礦床，卻犧牲了其他必需資源。因此，提早向其他小型行星擴張將是生存的關鍵。</smallcaps>"

#. STRINGS.WORLDS.OILYMOONLET.NAME
msgctxt "STRINGS.WORLDS.OILYMOONLET.NAME"
msgid "Viscosia Asteroid"
msgstr "原油小行星"

#. STRINGS.WORLDS.PREHISTORICBASEGAME.DESCRIPTION
msgctxt "STRINGS.WORLDS.PREHISTORICBASEGAME.DESCRIPTION"
msgid "An endangered location with abundant food resources.\n\n<smallcaps>Relica's biodiversity makes reliable food production more attainable for new colonies. Construction materials and fuels are also ample. Surface defence must be prioritized to minimize damage from an incoming impactor asteroid.</smallcaps>"
msgstr "一個瀕臨滅絕但食物資源豐富的地點。\n\n<smallcaps>其生物多樣性讓新殖民地更容易獲得可靠的食物生產。建築材料和燃料也供應充足。必須優先考慮地表防禦，以最大程度地減少來自即將到來的殺手小行星所造成的損害。</smallcaps>"

#. STRINGS.WORLDS.PREHISTORICBASEGAME.NAME
msgctxt "STRINGS.WORLDS.PREHISTORICBASEGAME.NAME"
msgid "Relica"
msgstr "遺物行星"

#. STRINGS.WORLDS.PREHISTORICCLASSIC.DESCRIPTION
msgctxt "STRINGS.WORLDS.PREHISTORICCLASSIC.DESCRIPTION"
msgid "An endangered starting world with abundant food resources.\n\n<smallcaps>Relica's biodiversity makes reliable food production more attainable for new colonies. Construction materials and fuels are also ample. Surface defence must be prioritized to minimize damage from an incoming impactor asteroid.</smallcaps>"
msgstr "一個瀕臨滅絕但食物資源豐富的起始世界。\n\n<smallcaps>其生物多樣性讓新殖民地更容易獲得可靠的食物生產。建築材料和燃料也供應充足。必須優先考慮地表防禦，以最大程度地減少來自即將到來的殺手小行星所造成的損害。</smallcaps>"

#. STRINGS.WORLDS.PREHISTORICCLASSIC.NAME
msgctxt "STRINGS.WORLDS.PREHISTORICCLASSIC.NAME"
msgid "Relica Asteroid"
msgstr "遺物小行星"

#. STRINGS.WORLDS.PREHISTORICMIXING.DESCRIPTION
msgctxt "STRINGS.WORLDS.PREHISTORICMIXING.DESCRIPTION"
msgid "A fragment of a prehistoric starting world.\n\n<smallcaps>Its biodiversity makes reliable food production more attainable for new colonies. Construction materials and fuels are also ample. </smallcaps>"
msgstr "一個史前起始世界的殘片。\n\n<smallcaps>其生物多樣性讓新殖民地更容易獲得可靠的食物生產。建築材料和燃料也供應充足。</smallcaps>"

#. STRINGS.WORLDS.PREHISTORICMIXING.NAME
msgctxt "STRINGS.WORLDS.PREHISTORICMIXING.NAME"
msgid "Relica Fragment"
msgstr "遺物星碎片"

#. STRINGS.WORLDS.PREHISTORICSHATTERED.DESCRIPTION
msgctxt "STRINGS.WORLDS.PREHISTORICSHATTERED.DESCRIPTION"
msgid "A geyser-rich location that will be struck by an impactor asteroid almost immediately.\n\n<smallcaps>Impact-related damage will trigger the eruption of this world's unusually high number of geysers. Colonies that survive the volatile aftermath will reap the benefits of the abundant natural resources released into the environment.</smallcaps>"
msgstr "一處間歇泉資源豐富，但幾乎立刻會被撞擊小行星擊中的地點。\n\n<smallcaps>撞擊所造成的損害將會引發這個星球上數量異常龐大的間歇泉全面噴發。能夠在劇烈餘波中倖存下來的殖民地，將能坐享這些被釋放到環境中的豐沛自然資源。</smallcaps>"

#. STRINGS.WORLDS.PREHISTORICSHATTERED.NAME
msgctxt "STRINGS.WORLDS.PREHISTORICSHATTERED.NAME"
msgid "RelicAAAA<sup>AAAGHH</sup>"
msgstr "遺物阿阿阿阿<sup>ㄚㄚㄚ～～</sup>"

#. STRINGS.WORLDS.PREHISTORICSPACEDOUT.DESCRIPTION
msgctxt "STRINGS.WORLDS.PREHISTORICSPACEDOUT.DESCRIPTION"
msgid "A smaller endangered starting world with abundant food resources.\n\n<smallcaps>Relica's biodiversity makes reliable food production more attainable for new colonies. Construction materials and fuels are also ample. Surface defence must be prioritized to minimize damage from an incoming impactor asteroid.</smallcaps>"
msgstr "一個較小的瀕臨滅絕但擁有豐富食物資源的起始世界。\n\n<smallcaps>其生物多樣性讓新殖民地更容易獲得可靠的食物生產。建築材料和燃料也供應充足。必須優先考慮地表防禦，以最大程度地減少來自即將到來的殺手小行星所造成的損害。</smallcaps>"

#. STRINGS.WORLDS.PREHISTORICSPACEDOUT.NAME
msgctxt "STRINGS.WORLDS.PREHISTORICSPACEDOUT.NAME"
msgid "Relica Minor"
msgstr "小遺物星"

#. STRINGS.WORLDS.REGOLITHMOONLET.DESCRIPTION
msgctxt "STRINGS.WORLDS.REGOLITHMOONLET.DESCRIPTION"
msgid "A small, cold world with plenty of craters.\n\n<smallcaps>Regolith Asteroids have frequent meteor showers and are chock-full of Regolith, an incredibly useful filtration material. </smallcaps>"
msgstr "一個佈滿大量隕石坑的小型冰冷世界。\n\n<smallcaps>「風化小行星」有頻繁的流星雨，且富含風化層，這是一種極為有用的過濾材料。</smallcaps>"

#. STRINGS.WORLDS.REGOLITHMOONLET.NAME
msgctxt "STRINGS.WORLDS.REGOLITHMOONLET.NAME"
msgid "Regolith Asteroid"
msgstr "風化小行星"

#. STRINGS.WORLDS.SANDSTONE_DEFAULT.DESCRIPTION
msgctxt "STRINGS.WORLDS.SANDSTONE_DEFAULT.DESCRIPTION"
msgid "A promising location with a balanced variety of resources.\n\n<smallcaps>Terra meets all the requirements for Duplicant life and holds no surprises. It's an ideal location for a first attempt at establishing a colony.</smallcaps>\n\n"
msgstr "一個資源分佈均衡且充滿希望的地方。\n\n<smallcaps>「類地行星」符合複製人生活的所有條件，且沒有任何意外。這是首次嘗試建立殖民地的理想地點。</smallcaps>\n\n"

#. STRINGS.WORLDS.SANDSTONE_DEFAULT.NAME
msgctxt "STRINGS.WORLDS.SANDSTONE_DEFAULT.NAME"
msgid "Terra"
msgstr "類地行星"

#. STRINGS.WORLDS.SANDSTONE_FROZEN.DESCRIPTION
msgctxt "STRINGS.WORLDS.SANDSTONE_FROZEN.DESCRIPTION"
msgid "A frigid location marked by inhospitably low temperatures throughout.\n\n<smallcaps>Rime's low temperatures will make finding water and establishing farms or ranches problematic. However, the wide spectrum of minerals and cool environment could lead to thriving industry.</smallcaps>\n\n"
msgstr "一個遍布著嚴酷低溫的冰冷地點。\n\n<smallcaps>寒冷的氣候讓尋找水源與建造農場或是牧場變得困難。然而，廣泛的礦物種類和涼爽的環境卻可能促成工業的蓬勃發展。</smallcaps>\n\n"

#. STRINGS.WORLDS.SANDSTONE_FROZEN.NAME
msgctxt "STRINGS.WORLDS.SANDSTONE_FROZEN.NAME"
msgid "Rime"
msgstr "冰霜行星"

#. STRINGS.WORLDS.STRANGE_ASTEROID_KF23.DESCRIPTION
msgctxt "STRINGS.WORLDS.STRANGE_ASTEROID_KF23.DESCRIPTION"
msgid "A tilted world, at once strange and...strangely familiar. Its singular terrain is consistent across all universes.\n\nThis resistance to the fluidity of temporal shifts has the cosmos buzzing, as individual colonies compare notes on successes, failures and the bizarre redistribution of resources.\n\n<smallcaps>Released for Klei Fest 2023."
msgstr "一顆傾斜的星球，既陌生…又有種奇怪的熟悉感。它奇異的地形在所有宇宙中都是一致的。\n\n<smallcaps>這種對時間偏移流動性的抵抗使整個宇宙嗡嗡作響，產生了各個殖民地對於成功案例、失敗案例和稀奇古怪的資源重新分配方案的對比記錄。</smallcaps>\n\n為 2023 年科雷節釋出。"

#. STRINGS.WORLDS.STRANGE_ASTEROID_KF23.NAME
msgctxt "STRINGS.WORLDS.STRANGE_ASTEROID_KF23.NAME"
msgid "Skewed Asteroid"
msgstr "歪斜小行星"

#. STRINGS.WORLDS.STRANGERICHSANDSTONE.DESCRIPTION
msgctxt "STRINGS.WORLDS.STRANGERICHSANDSTONE.DESCRIPTION"
msgid "A petite rocky world with an oily core.\n\n<smallcaps>Though it looks deceptively nondescript from space, readings from this planet suggest a strong fuel source lurks somewhere beneath the surface.</smallcaps>"
msgstr "一個帶有油質核心的袖珍岩石世界。\n\n<smallcaps>儘管從太空中看來其貌不揚，但從這顆行星的讀數顯示，地表下某處潛藏著豐富的燃料來源。</smallcaps>"

#. STRINGS.WORLDS.STRANGERICHSANDSTONE.NAME
msgctxt "STRINGS.WORLDS.STRANGERICHSANDSTONE.NAME"
msgid "Rocky Asteroid"
msgstr "岩石小行星"

#. STRINGS.WORLDS.SULFURMOONLET.DESCRIPTION
msgctxt "STRINGS.WORLDS.SULFURMOONLET.DESCRIPTION"
msgid "A smaller landmass with a distinct odor.\n\n<smallcaps>Brimstonia Asteroids contain an abundant supply of Sulfur.</smallcaps>"
msgstr "一塊帶有獨特氣味的較小陸地。\n\n<smallcaps>「硫磺小行星」蘊藏著大量的硫。</smallcaps>"

#. STRINGS.WORLDS.SULFURMOONLET.NAME
msgctxt "STRINGS.WORLDS.SULFURMOONLET.NAME"
msgid "Brimstonia Asteroid"
msgstr "硫磺小行星"

#. STRINGS.WORLDS.SURVIVAL_CHANCE.CLUSTERNAME
msgctxt "STRINGS.WORLDS.SURVIVAL_CHANCE.CLUSTERNAME"
msgid "<b>Cluster Name</b>: {0}"
msgstr "<b>星團名稱</b>：{0}"

#. STRINGS.WORLDS.SURVIVAL_CHANCE.HIGH
msgctxt "STRINGS.WORLDS.SURVIVAL_CHANCE.HIGH"
msgid "Likely"
msgstr "合適"

#. STRINGS.WORLDS.SURVIVAL_CHANCE.LEASTHOSPITABLE
msgctxt "STRINGS.WORLDS.SURVIVAL_CHANCE.LEASTHOSPITABLE"
msgid "Inhospitable"
msgstr "難以居住"

#. STRINGS.WORLDS.SURVIVAL_CHANCE.LOW
msgctxt "STRINGS.WORLDS.SURVIVAL_CHANCE.LOW"
msgid "Marginal"
msgstr "微小"

#. STRINGS.WORLDS.SURVIVAL_CHANCE.MOONNAMES
msgctxt "STRINGS.WORLDS.SURVIVAL_CHANCE.MOONNAMES"
msgid "\n<b>Surrounding Planetoids</b>:"
msgstr "\n<b>周圍小行星</b>："

#. STRINGS.WORLDS.SURVIVAL_CHANCE.MOSTHOSPITABLE
msgctxt "STRINGS.WORLDS.SURVIVAL_CHANCE.MOSTHOSPITABLE"
msgid "Ideal"
msgstr "理想"

#. STRINGS.WORLDS.SURVIVAL_CHANCE.NEUTRAL
msgctxt "STRINGS.WORLDS.SURVIVAL_CHANCE.NEUTRAL"
msgid "Moderate"
msgstr "中等"

#. STRINGS.WORLDS.SURVIVAL_CHANCE.PLANETNAME
msgctxt "STRINGS.WORLDS.SURVIVAL_CHANCE.PLANETNAME"
msgid "<b>Starting Asteroid</b>: {0}\n"
msgstr "<b>初始小行星</b>：{0}\n"

#. STRINGS.WORLDS.SURVIVAL_CHANCE.TITLE
msgctxt "STRINGS.WORLDS.SURVIVAL_CHANCE.TITLE"
msgid "\nSurvival Chance: <b><color=#{1}>{0}</color></b>"
msgstr "\n生存機率：<b><color=#{1}>{0}</color></b>"

#. STRINGS.WORLDS.SURVIVAL_CHANCE.VERYHIGH
msgctxt "STRINGS.WORLDS.SURVIVAL_CHANCE.VERYHIGH"
msgid "Probable"
msgstr "很有機會"

#. STRINGS.WORLDS.SURVIVAL_CHANCE.VERYLOW
msgctxt "STRINGS.WORLDS.SURVIVAL_CHANCE.VERYLOW"
msgid "Slim"
msgstr "渺茫"

#. STRINGS.WORLDS.SWAMPMOONLET.DESCRIPTION
msgctxt "STRINGS.WORLDS.SWAMPMOONLET.DESCRIPTION"
msgid "A large, polluted swamp world.\n\n<smallcaps>Quagmiris Asteroids are a great mass of frozen slush and wasteland. With a short distance to the surface, inter-world travel can be achieved quickly.</smallcaps>"
msgstr "一個巨大受汙染的沼澤世界。\n\n<smallcaps>「沼澤小行星」是冰凍泥漿和荒地的巨大集合體。由於地表距離較短，可以快速實現星際旅行。</smallcaps>"

#. STRINGS.WORLDS.SWAMPMOONLET.NAME
msgctxt "STRINGS.WORLDS.SWAMPMOONLET.NAME"
msgid "Quagmiris Asteroid"
msgstr "沼澤小行星"

#. STRINGS.WORLDS.SWAMPYLANDINGSITE.DESCRIPTION
msgctxt "STRINGS.WORLDS.SWAMPYLANDINGSITE.DESCRIPTION"
msgid "A small swampy world with a radioactive core.\n\n<smallcaps>Irradiated Swamps have a high concentration of rare swampy and radioactive resources but are also chocked full of dangers.</smallcaps>"
msgstr "一個擁有輻射核心的小型沼澤世界。\n\n<smallcaps>「輻射沼澤小行星」擁有高度集中的稀有沼澤和輻射資源，但同時也充滿了重重危險。</smallcaps>"

#. STRINGS.WORLDS.SWAMPYLANDINGSITE.NAME
msgctxt "STRINGS.WORLDS.SWAMPYLANDINGSITE.NAME"
msgid "Irradiated Swampy Asteroid"
msgstr "輻射沼澤小行星"

#. STRINGS.WORLDS.TERRAMOONLET.DESCRIPTION
msgctxt "STRINGS.WORLDS.TERRAMOONLET.DESCRIPTION"
msgid "A balanced variety of resources on a smaller sandstone world.\n\n<smallcaps>Terrania Asteroids have everything needed to start a colony in a compact area. With a short distance to the surface, inter-world travel can be achieved quickly.</smallcaps>"
msgstr "一個資源種類均衡的小型砂岩世界。\n\n<smallcaps>「類地小行星」擁有建立殖民地所需的一切資源，且分佈於緊湊的區域。由於地表距離較短，可以快速實現星際旅行。</smallcaps>"

#. STRINGS.WORLDS.TERRAMOONLET.NAME
msgctxt "STRINGS.WORLDS.TERRAMOONLET.NAME"
msgid "Terrania Asteroid"
msgstr "類地小行星"

#. STRINGS.WORLDS.THE_ROCK.DESCRIPTION
msgctxt "STRINGS.WORLDS.THE_ROCK.DESCRIPTION"
msgid "This place really rocks.\n\n<smallcaps></smallcaps>\n\n"
msgstr "這地方真的「岩」力四射。\n\n<smallcaps></smallcaps>\n\n"

#. STRINGS.WORLDS.THE_ROCK.NAME
msgctxt "STRINGS.WORLDS.THE_ROCK.NAME"
msgid "The Rock"
msgstr "起始塊石頭"

#. STRINGS.WORLDS.TINYEMPTY.DESCRIPTION
msgctxt "STRINGS.WORLDS.TINYEMPTY.DESCRIPTION"
msgid "A fun-sized 'fixer upper', perfect for game devs."
msgstr "一個有趣「待裝修」的世界，適合遊戲開發。"

#. STRINGS.WORLDS.TINYEMPTY.NAME
msgctxt "STRINGS.WORLDS.TINYEMPTY.NAME"
msgid "Tiny Empty FOR DEVS"
msgstr "開發者用的小型空世界"

#. STRINGS.WORLDS.TINYFOREST.DESCRIPTION
msgctxt "STRINGS.WORLDS.TINYFOREST.DESCRIPTION"
msgid "A petite forest world for nature loving devs."
msgstr "小型森林世界可供熱愛大自然的人開發。"

#. STRINGS.WORLDS.TINYFOREST.NAME
msgctxt "STRINGS.WORLDS.TINYFOREST.NAME"
msgid "Tiny Forest FOR DEVS"
msgstr "開發者用的小型森林世界"

#. STRINGS.WORLDS.TINYICE.DESCRIPTION
msgctxt "STRINGS.WORLDS.TINYICE.DESCRIPTION"
msgid "A tiny ice cold world for dev snow forts."
msgstr "小型冰雪世界可開發一個雪地要塞。"

#. STRINGS.WORLDS.TINYICE.NAME
msgctxt "STRINGS.WORLDS.TINYICE.NAME"
msgid "Tiny Ice FOR DEVS"
msgstr "開發者用的小型冰雪世界"

#. STRINGS.WORLDS.TINYMAGMA.DESCRIPTION
msgctxt "STRINGS.WORLDS.TINYMAGMA.DESCRIPTION"
msgid "A small hellscape just for devs."
msgstr "僅供開發者的小型地獄。"

#. STRINGS.WORLDS.TINYMAGMA.NAME
msgctxt "STRINGS.WORLDS.TINYMAGMA.NAME"
msgid "Tiny Magma FOR DEVS"
msgstr "開發者用的小型岩漿世界"

#. STRINGS.WORLDS.TINYSTART.DESCRIPTION
msgctxt "STRINGS.WORLDS.TINYSTART.DESCRIPTION"
msgid "A cozy little starter location, just for devs."
msgstr "舒適的新手小世界，僅供開發者。"

#. STRINGS.WORLDS.TINYSTART.NAME
msgctxt "STRINGS.WORLDS.TINYSTART.NAME"
msgid "Tiny Start FOR DEVS"
msgstr "開發者用的小世界"

#. STRINGS.WORLDS.TINYSURFACE.DESCRIPTION
msgctxt "STRINGS.WORLDS.TINYSURFACE.DESCRIPTION"
msgid "A cute little Dev location, with scenic space views."
msgstr "可愛的小世界，可以觀賞美麗的太空。"

#. STRINGS.WORLDS.TINYSURFACE.NAME
msgctxt "STRINGS.WORLDS.TINYSURFACE.NAME"
msgid "Tiny Surface FOR DEVS"
msgstr "開發者用的小型的地表"

#. STRINGS.WORLDS.TUNDRAMOONLET.DESCRIPTION
msgctxt "STRINGS.WORLDS.TUNDRAMOONLET.DESCRIPTION"
msgid "A small frozen planetoid with sub-zero temperatures.\n\n<smallcaps>Duplicants that travel to Tundra Asteroids will need to wear protective gear due to its harsh environment.</smallcaps>"
msgstr "一顆氣溫長期處於零度以下的冰凍小行星\n\n<smallcaps>由於環境嚴苛，複製人到凍原小行星旅行需要穿著防護設備。</smallcaps>"

#. STRINGS.WORLDS.TUNDRAMOONLET.NAME
msgctxt "STRINGS.WORLDS.TUNDRAMOONLET.NAME"
msgid "Tundra Asteroid"
msgstr "凍原小行星"

#. STRINGS.WORLDS.TWINMOONLET.DESCRIPTION
msgctxt "STRINGS.WORLDS.TWINMOONLET.DESCRIPTION"
msgid "Two small dev worlds for the price of one."
msgstr "開發兩個小型世界，只要付出一次代價。"

#. STRINGS.WORLDS.TWINMOONLET.NAME
msgctxt "STRINGS.WORLDS.TWINMOONLET.NAME"
msgid "Tiny Twin Asteroid FOR DEVS"
msgstr "開發者用的小小雙子行星"

#. STRINGS.WORLDS.VANILLAARBORIA.DESCRIPTION
msgctxt "STRINGS.WORLDS.VANILLAARBORIA.DESCRIPTION"
msgid "A location with a natural abundance of trees.\n\n<smallcaps>Colonizing Arboria will require careful planning right from the start. Because of its lack of metals, finding biological solutions to problems is a must.</smallcaps>"
msgstr "一個擁有天然豐富樹木的地方。\n\n<smallcaps>殖民喬木星需要從一開始就仔細規劃。由於此地缺乏金屬，因此必須找到生物性的解決方案來應對各種挑戰。</smallcaps>"

#. STRINGS.WORLDS.VANILLAARBORIA.NAME
msgctxt "STRINGS.WORLDS.VANILLAARBORIA.NAME"
msgid "Arboria Asteroid"
msgstr "喬木小行星"

#. STRINGS.WORLDS.VANILLAARIDIO.DESCRIPTION
msgctxt "STRINGS.WORLDS.VANILLAARIDIO.DESCRIPTION"
msgid "A location with oppressively hot temperatures.\n\n<smallcaps>Temperatures on Aridio are much higher than expected. While resources are abundant, maintaining food and infrastructure could be difficult as our colony warms.</smallcaps>"
msgstr "一個擁有嚴酷高溫的地方。\n\n<smallcaps>這裡的環境溫度遠高於預期。儘管資源豐富，但隨著殖民地溫度升高，要維持食物生產和基礎設施可能會變得困難。</smallcaps>"

#. STRINGS.WORLDS.VANILLAARIDIO.NAME
msgctxt "STRINGS.WORLDS.VANILLAARIDIO.NAME"
msgid "Aridio Asteroid"
msgstr "熱帶小行星"

#. STRINGS.WORLDS.VANILLABADLANDS.DESCRIPTION
msgctxt "STRINGS.WORLDS.VANILLABADLANDS.DESCRIPTION"
msgid "A barren location with an overabundance of mineral resources.\n\n<smallcaps>The rocky terrain of The Badlands poses no immediate threats, but sparse resource availability will make expansion and technological progress challenging.</smallcaps>"
msgstr "一個荒蕪但有豐富礦物資源的地方。\n\n<smallcaps>「惡地」的岩石地型不會構成即時威脅，但稀缺的資源將使殖民地擴張和科技發展面臨挑戰。</smallcaps>"

#. STRINGS.WORLDS.VANILLABADLANDS.NAME
msgctxt "STRINGS.WORLDS.VANILLABADLANDS.NAME"
msgid "The Badlands Asteroid"
msgstr "惡地小行星"

#. STRINGS.WORLDS.VANILLAFORESTDEFAULT.DESCRIPTION
msgctxt "STRINGS.WORLDS.VANILLAFORESTDEFAULT.DESCRIPTION"
msgid "A lush location rich in wildlife and life-sustaining resources.\n\n<smallcaps>Establishing a foothold on Verdante will be challenging due to reduced food and oxygen options. However, abundant biological and mineral resources should afford excellent long-term growth.</smallcaps>\n\n"
msgstr "一個動植物繁盛、生命資源豐富的蔥鬱之地。\n\n<smallcaps>由於食物與氧氣的選項較少，在這裡立足會成為一種挑戰。不過豐富的生物與礦物資源，應該能為殖民地帶來出色的長期成長。</smallcaps>\n\n"

#. STRINGS.WORLDS.VANILLAFORESTDEFAULT.NAME
msgctxt "STRINGS.WORLDS.VANILLAFORESTDEFAULT.NAME"
msgid "Verdante Asteroid"
msgstr "翠綠小行星"

#. STRINGS.WORLDS.VANILLAOASIS.DESCRIPTION
msgctxt "STRINGS.WORLDS.VANILLAOASIS.DESCRIPTION"
msgid "A desolate location with a cache of life-sustaining water trapped beneath the surface.\n\n<smallcaps>A wide underground desert will pose temperature threats and strain the resources of a colony on Oasisse. However, surviving the challenge should present great industrial opportunities.</smallcaps>"
msgstr "一個荒涼的地方，地表下儲藏著維繫生命的珍貴水源。\n\n<smallcaps>廣闊的地下沙漠將對殖民地構成溫度威脅並耗盡其資源。然而，成功應對挑戰應能帶來巨大的工業發展機會。</smallcaps>"

#. STRINGS.WORLDS.VANILLAOASIS.NAME
msgctxt "STRINGS.WORLDS.VANILLAOASIS.NAME"
msgid "Oasisse Asteroid"
msgstr "綠洲小行星"

#. STRINGS.WORLDS.VANILLAOCEANIA.DESCRIPTION
msgctxt "STRINGS.WORLDS.VANILLAOCEANIA.DESCRIPTION"
msgid "A location with vast quantities of unpotable salt water.\n\n<smallcaps>Oceania is quite stable and resource rich, but the majority of the area is covered in a saltwater ocean. Careful expansion and resource usage should lead to a successful colony.</smallcaps>"
msgstr "含有大量不可飲用的鹽水的地方。\n\n<smallcaps>這裡相當穩定並且資源豐富，但大部分地區都被鹽水海洋覆蓋。仔細擴展與利用資源應該能成功建立殖民地。</smallcaps>"

#. STRINGS.WORLDS.VANILLAOCEANIA.NAME
msgctxt "STRINGS.WORLDS.VANILLAOCEANIA.NAME"
msgid "Oceania Asteroid"
msgstr "海洋小行星"

#. STRINGS.WORLDS.VANILLASANDSTONEDEFAULT.DESCRIPTION
msgctxt "STRINGS.WORLDS.VANILLASANDSTONEDEFAULT.DESCRIPTION"
msgid "A promising location with a balanced variety of resources.\n\n<smallcaps>Terra meets all the requirements for Duplicant life and holds no surprises. It's an ideal location for a first attempt at establishing a colony.</smallcaps>\n\n"
msgstr "一個資源分佈平均且充滿希望的地方。\n\n<smallcaps>這裡符合複製人生活的所有條件，且沒有任何意外。這是首次嘗試建立殖民地的理想地點。</smallcaps>\n\n"

#. STRINGS.WORLDS.VANILLASANDSTONEDEFAULT.NAME
msgctxt "STRINGS.WORLDS.VANILLASANDSTONEDEFAULT.NAME"
msgid "Terra Asteroid"
msgstr "類地小行星"

#. STRINGS.WORLDS.VANILLASANDSTONEFROZEN.DESCRIPTION
msgctxt "STRINGS.WORLDS.VANILLASANDSTONEFROZEN.DESCRIPTION"
msgid "A frigid location marked by inhospitably low temperatures throughout.\n\n<smallcaps>Rime's low temperatures will make finding water and establishing farms or ranches problematic. However, the wide spectrum of minerals and cool environment could lead to thriving industry.</smallcaps>"
msgstr "一個遍布著嚴酷低溫的冰冷地點。\n\n<smallcaps>這裡的低溫將使尋找水源、建立農場或牧場變得困難重重。然而，廣泛的礦物種類和涼爽的環境卻可能促成工業的蓬勃發展。</smallcaps>"

#. STRINGS.WORLDS.VANILLASANDSTONEFROZEN.NAME
msgctxt "STRINGS.WORLDS.VANILLASANDSTONEFROZEN.NAME"
msgid "Rime Asteroid"
msgstr "冰霜小行星"

#. STRINGS.WORLDS.VANILLASWAMPDEFAULT.DESCRIPTION
msgctxt "STRINGS.WORLDS.VANILLASWAMPDEFAULT.DESCRIPTION"
msgid "A large, polluted swamp world.\n\n<smallcaps>Squelchy Asteroids are a great mass of frozen slush and wasteland. With a short distance to the surface, inter-world travel can be achieved quickly.</smallcaps>"
msgstr "一個巨大受汙染的沼澤世界。\n\n<smallcaps>「濕軟小行星」是一個有大量冰凍泥漿與荒地的巨大集合體。由於地表距離較短，可在快速實現星際旅行。</smallcaps>"

#. STRINGS.WORLDS.VANILLASWAMPDEFAULT.NAME
msgctxt "STRINGS.WORLDS.VANILLASWAMPDEFAULT.NAME"
msgid "Squelchy Asteroid"
msgstr "濕軟小行星"

#. STRINGS.WORLDS.VANILLAVOLCANIC.DESCRIPTION
msgctxt "STRINGS.WORLDS.VANILLAVOLCANIC.DESCRIPTION"
msgid "A location rife with molten lava pockets and intense heat.\n\n<smallcaps>Volcanea would be perfect if it wasn't for the volcanoes. Digging carefully and managing the temperatures in our colony will be essential to success.</smallcaps>"
msgstr "一個充斥著熔岩室和劇烈高溫的地方。\n\n<smallcaps>如果不是因為有火山，「火山小行星」簡直完美。小心翼翼地挖掘並管理殖民地的溫度，將是成功的關鍵。</smallcaps>"

#. STRINGS.WORLDS.VANILLAVOLCANIC.NAME
msgctxt "STRINGS.WORLDS.VANILLAVOLCANIC.NAME"
msgid "Volcanea Asteroid"
msgstr "火山小行星"

#. STRINGS.WORLDS.VOLCANIC.DESCRIPTION
msgctxt "STRINGS.WORLDS.VOLCANIC.DESCRIPTION"
msgid "A location rife with molten lava pockets and intense heat.\n\n<smallcaps>Volcanea would be perfect if it wasn't for the volcanoes. Digging carefully and managing the temperatures in our colony will be essential to success.</smallcaps>\n\n"
msgstr "一個充斥著熔岩室和劇烈高溫的地方。\n\n<smallcaps>如果不是因為有火山，「火山行星」簡直完美。小心翼翼地挖掘並管理殖民地的溫度，將是成功的關鍵。</smallcaps>\n\n"

#. STRINGS.WORLDS.VOLCANIC.NAME
msgctxt "STRINGS.WORLDS.VOLCANIC.NAME"
msgid "Volcanea"
msgstr "火山行星"

#. STRINGS.WORLDS.WARPOILYSANDYSWAMP.DESCRIPTION
msgctxt "STRINGS.WORLDS.WARPOILYSANDYSWAMP.DESCRIPTION"
msgid "A mildly frozen world with an oily core.\n\n<smallcaps>While Oily Sandy Swamp Asteroids are largely swampy, they also contain a great deal of wasteland.</smallcaps>"
msgstr "一個輕度結冰且擁有油質核心的世界。\n\n<smallcaps>雖然「油沙沼澤小行星」主要為沼澤地帶，但也含有大量荒地。</smallcaps>"

#. STRINGS.WORLDS.WARPOILYSANDYSWAMP.NAME
msgctxt "STRINGS.WORLDS.WARPOILYSANDYSWAMP.NAME"
msgid "Oily Sandy Swamp Asteroid"
msgstr "油沙沼澤小行星"

#. STRINGS.WORLDS.WARPOILYSWAMP.DESCRIPTION
msgctxt "STRINGS.WORLDS.WARPOILYSWAMP.DESCRIPTION"
msgid "A partially frozen world with an oily core.\n\n<smallcaps>While Oily Swamp Asteroids are largely swampy, they also contain a great deal of rust.</smallcaps>"
msgstr "一個部分凍結且帶有油質核心的世界。\n\n<smallcaps>整個「原油沼澤小行星」是大型的沼澤地帶，也有著大量的鐵鏽。</smallcaps>"

#. STRINGS.WORLDS.WARPOILYSWAMP.NAME
msgctxt "STRINGS.WORLDS.WARPOILYSWAMP.NAME"
msgid "Oily Swamp Asteroid"
msgstr "原油沼澤小行星"

#. STRINGS.WORLDS.WATERMOONLET.DESCRIPTION
msgctxt "STRINGS.WORLDS.WATERMOONLET.DESCRIPTION"
msgid "A small, water-submerged world.\n\n<smallcaps>Water Asteroids possess a variety of liquid resources and are a natural source of Graphite, but Duplicants should come prepared for a swim.</smallcaps>"
msgstr "一個被水淹沒的小世界。\n\n<smallcaps>「水水小行星」擁有多種液體資源，同時也是石墨的天然來源，但複製人前往此處應做好游泳的準備。</smallcaps>"

#. STRINGS.WORLDS.WATERMOONLET.NAME
msgctxt "STRINGS.WORLDS.WATERMOONLET.NAME"
msgid "Water Asteroid"
msgstr "水水小行星"
