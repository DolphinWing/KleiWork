msgstr "哈奇石飛行頭盔"

#. STRINGS.BLUEPRINTS.PERMIT_JET_HELMET_00_KELLY_OBELUS.DESC
msgctxt "STRINGS.BLUEPRINTS.PERMIT_JET_HELMET_00_KELLY_OBELUS.DESC"
