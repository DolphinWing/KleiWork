#. STRINGS.COLONY_ACHIEVEMENTS.ACTIVATEGEOTHERMALPLANT.STATUSITEMS.VENT.OVERPRESSURE_NAME
msgctxt "STRINGS.COLONY_ACHIEVEMENTS.ACTIVATEGEOTHERMALPLANT.STATUSITEMS.VENT.OVERPRESSURE_NAME"
msgid "Overpressure"
msgstr "壓力過大"

#. STRINGS.COLONY_ACHIEVEMENTS.ACTIVATEGEOTHERMALPLANT.STATUSITEMS.VENT.OVERPRESSURE_TOOLTIP
msgctxt "STRINGS.COLONY_ACHIEVEMENTS.ACTIVATEGEOTHERMALPLANT.STATUSITEMS.VENT.OVERPRESSURE_TOOLTIP"
msgid "High <style=\"KKeyword\">Liquid</style> or <style=\"KKeyword\">Gas</style> pressure in this area is preventing further emissions\n\nReduce pressure by pumping <style=\"KKeyword\">Liquids</style> or <style=\"KKeyword\">Gases</style> away or clearing more space\n\nClick here to show this vent"
msgstr "這片區域的<style=\"KKeyword\">氣體</style>或<style=\"KKeyword\">液體</style>壓力過高，阻止了進一步的排放。\n\n透過抽出<style=\"KKeyword\">液體</style>或<style=\"KKeyword\">氣體</style>，或騰出更多空間以減小壓力。\n\n點選此處以顯示該排氣口"

