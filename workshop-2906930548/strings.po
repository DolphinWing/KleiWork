msgstr "一件黑色飛行衣，搭配一件光滑灰色的胸骨護甲。"

#. STRINGS.BLUEPRINTS.PERMIT_JETSUIT_BLACK_TORPOR.NAME
msgctxt "STRINGS.BLUEPRINTS.PERMIT_JETSUIT_BLACK_TORPOR.NAME"
msgid "Torpor Stealth Jet Suit"
msgstr "遲鈍隱形飛行衣"

#. STRINGS.BLUEPRINTS.PERMIT_JETSUIT_BLACK_ULTRA.DESC
msgctxt "STRINGS.BLUEPRINTS.PERMIT_JETSUIT_BLACK_ULTRA.DESC"
