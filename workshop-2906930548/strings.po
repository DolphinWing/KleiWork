msgstr "<link=\"ARTTALLG\">日出辭行</link>"

#. STRINGS.BUILDINGS.PREFABS.CANVASTALL.FACADES.ART_TALL_H.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.CANVASTALL.FACADES.ART_TALL_H.DESC"
