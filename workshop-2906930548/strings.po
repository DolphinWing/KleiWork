msgstr "亞麻法蘭絨襯衫"

#. STRINGS.BLUEPRINTS.PERMIT_TOP_GOTCH_ASH_CHARCOAL.DESC
msgctxt "STRINGS.BLUEPRINTS.PERMIT_TOP_GOTCH_ASH_CHARCOAL.DESC"
