msgid "Liam Noggin"
msgstr "Liam 頭部"

#. STRINGS.BLUEPRINTS.PERMIT_PAINTING_ART_AQUATIC.DESC
msgctxt "STRINGS.BLUEPRINTS.PERMIT_PAINTING_ART_AQUATIC.DESC"
msgid "A peaceful meditation on the nature of life, love, and the universe."
msgstr "一場關於生命、愛與宇宙本質的靜謐冥想。"

#. STRINGS.BLUEPRINTS.PERMIT_PAINTING_ART_AQUATIC.NAME
msgctxt "STRINGS.BLUEPRINTS.PERMIT_PAINTING_ART_AQUATIC.NAME"
msgid "Serenity Swim"
msgstr "寧靜暢游"

#. STRINGS.BLUEPRINTS.PERMIT_PAINTING_ART_CERES_A.DESC
msgctxt "STRINGS.BLUEPRINTS.PERMIT_PAINTING_ART_CERES_A.DESC"
msgid "You cannot choose your family, but you can choose your friends."
msgstr "你無法選擇你的家人，但你可以選擇你的朋友。"

#. STRINGS.BLUEPRINTS.PERMIT_PAINTING_ART_CERES_A.NAME
msgctxt "STRINGS.BLUEPRINTS.PERMIT_PAINTING_ART_CERES_A.NAME"
msgid "Lady With a Bammini"
msgstr "帶著絨兔的女士"

#. STRINGS.BLUEPRINTS.PERMIT_PAINTING_ART_STEGO.DESC
msgctxt "STRINGS.BLUEPRINTS.PERMIT_PAINTING_ART_STEGO.DESC"
msgid "If this Duplicant had their own private fridge, this is the picture that would be displayed on it."
msgstr "如果這名複製人有他們自己的私人冰箱，這就是會貼在上面的圖片。"

#. STRINGS.BLUEPRINTS.PERMIT_PAINTING_ART_STEGO.NAME
msgctxt "STRINGS.BLUEPRINTS.PERMIT_PAINTING_ART_STEGO.NAME"
msgid "Safari Selfie"
msgstr "野生自拍"

#. STRINGS.BLUEPRINTS.PERMIT_PAINTING_TALL_ART_AQUATIC.DESC
msgctxt "STRINGS.BLUEPRINTS.PERMIT_PAINTING_TALL_ART_AQUATIC.DESC"
msgid "A ship can weather many storms with the right captain at the helm."
msgstr "只要有合適的船長掌舵，船隻便能挺過無數場暴風雨。"

#. STRINGS.BLUEPRINTS.PERMIT_PAINTING_TALL_ART_AQUATIC.NAME
msgctxt "STRINGS.BLUEPRINTS.PERMIT_PAINTING_TALL_ART_AQUATIC.NAME"
