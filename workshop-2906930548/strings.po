msgid "Lumbs"
msgstr "豐劍龍類"

#. STRINGS.CODEX.STEGO.SUBTITLE
msgctxt "STRINGS.CODEX.STEGO.SUBTITLE"
msgid "Domesticable Critter"
msgstr "可馴化的小動物"

#. STRINGS.CODEX.STEGO.TITLE
