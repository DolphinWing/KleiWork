msgstr "<link=\"EXTERIORWALL\">霸王鸚雕刻</link>"

#. STRINGS.BLUEPRINTS.PERMIT_WALLS_FOSSIL_STEGO.DESC
msgctxt "STRINGS.BLUEPRINTS.PERMIT_WALLS_FOSSIL_STEGO.DESC"
